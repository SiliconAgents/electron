#!/usr/bin/env python3
"""Refuse to let a customer design name or a foundry library name into the repo.

    name-check --staged          what `git commit` is about to record
    name-check --range A..B      every file touched by a range of commits
    name-check --all             every tracked file
    name-check FILE [FILE ...]

This repository is AGPL-3.0 and public. The work gets done against customer
designs on foundry PDKs under NDA, and neither may be named in it -- not in a
commit message, not in a comment, not in a docstring, not in an example command
line. Names got in once already and had to be swept out by hand; this is so
that is the last time.

WHY THE NAMES ARE NOT IN THIS FILE

A checker that lists what it is looking for is itself the leak, and it would be
the most quotable file in the repository. So the names live OUTSIDE version
control and this file carries only shapes:

    $ELECTRON_NAME_DENYLIST   a file of regexes, one per line, # for comments
    .git/name-denylist        the default -- inside .git, so never committed

Without a denylist the structural rules below still run, and those catch the
leak that actually happened: PDK cell names pasted into a docstring.

WHAT IS ALLOWED

TESTS/ designs, because they are the repository's own testcases and naming them
is the point. nangate, for the same reason. CONFIG/library.config keeps its
foundry keys because they are functional data rather than prose.

ESCAPE HATCH

    ELECTRON_SKIP_NAMECHECK=1

Use it to commit a fix TO this checker, not to get a name past it.
"""

import argparse
import os
import re
import subprocess
import sys

# Paths the rules do not apply to.
#   TESTS/        the repo's own designs, named on purpose
#   CONFIG/       library.config's foundry keys are data, not prose
#   lib64/, GUI/*.pdf, INSTALL/podman/*.sif   vendored or binary
#   this file     it describes the shapes it hunts for
# NOTE: this file is NOT exempt. An earlier version exempted itself on the
# grounds that it describes the shapes it hunts for -- and two real PDK codes
# then sat in a comment here for exactly as long as that exemption did,
# invisible to the only tool that would have found them. The shapes are written
# as regex source (C\d+L\d{2,}), which the literal rules do not match, so there
# was never anything to exempt.
#
# Fully exempt: functional data and vendored code.
ALLOW_PATHS = (
    "CONFIG/", "lib64/",
)

# PARTLY exempt. TESTS/ designs are allowed to be named -- that is the whole
# point of a testcase -- so the design denylist does not apply there. The
# LIBRARY rules still do. An earlier version exempted TESTS/ outright, and a
# tcl naming a foundry, a process node and a /tech path passed the check
# clean: the exemption meant for design names was silently covering library
# names too. A testcase may say what it multiplies; it may not say which PDK
# it was run against.
DESIGN_EXEMPT = ("TESTS/",)
ALLOW_SUFFIX = (".pdf", ".sif", ".png", ".gif", ".jpg", ".so", ".tar", ".gz")

# Terms that look like a hit but are the ones we are allowed to say.
ALLOW_TERMS = re.compile(r"nangate|45nm", re.I)

RULES = [
    # A PDK standard cell carries a drive-strength segment and then more
    # library-specific segments: <FUNC>_D<n>_<...>_<...>. Deliberately narrow
    # enough that nangate's AND2_X1 / DFF_X1 do not match -- those are allowed
    # and a checker that cried wolf on them would be turned off within a day.
    ("standard cell name",
     re.compile(r"\b[A-Z][A-Z0-9]+_D\d+(?:_[A-Z0-9]+){2,}\b")),

    # Library/site/track codes: <LIB>, <SITE>. Shapes, not names.
    ("library or site code",
     re.compile(r"\b(?:C\d+L\d{2,}|S\d+P\d+T[A-Z]{0,3})\b")),

    # A process node that is not the one nangate ships at.
    ("process node",
     re.compile(r"\b(?:[0-9]|[1-3][0-9]|4[0-4])nm\b")),
]

# NOT A RULE: an absolute work-area path. A first version flagged
# /proj/... and /proj_pd/user_dev/..., and got 28 hits across the existing
# tree -- container build arguments, the scala directory, the default paths
# for the placer wrappers. All infrastructure, none of it a design or a
# library. A hook with 28 standing failures is a hook everyone turns off, and
# pre-push next door says so in as many words: do not cry wolf about known
# noise. A work-area path that DOES name a customer is caught anyway, by the
# design name inside it.


def denylist():
    """Extra regexes, from outside version control."""
    path = os.environ.get("ELECTRON_NAME_DENYLIST")
    if not path:
        root = subprocess.run(["git", "rev-parse", "--git-dir"],
                              capture_output=True, text=True).stdout.strip()
        path = os.path.join(root or ".git", "name-denylist")
    out = []
    if os.path.isfile(path):
        for n, line in enumerate(open(path), 1):
            line = line.split("#", 1)[0].strip()
            if line:
                try:
                    out.append(("denylist", re.compile(line, re.I)))
                except re.error as e:
                    print(f"name-check: {path}:{n}: bad regex: {e}", file=sys.stderr)
    return out


def skip(path):
    return (path.startswith(ALLOW_PATHS)
            or path.endswith(ALLOW_SUFFIX)
            or not os.path.isfile(path))


def rules_for(path, rules, design_rules):
    """The structural rules always; the design denylist only outside TESTS/."""
    if path.startswith(DESIGN_EXEMPT):
        return rules
    return rules + design_rules


def scan(path, rules, text=None):
    """[(line number, rule, the matched text, the line)]"""
    hits = []
    if text is None:
        try:
            with open(path, errors="replace") as fh:
                text = fh.read()
        except OSError:
            return hits
    if "\0" in text[:8000]:          # binary
        return hits
    for n, line in enumerate(text.splitlines(), 1):
        for what, rx in rules:
            for m in rx.finditer(line):
                if ALLOW_TERMS.search(m.group(0)):
                    continue
                hits.append((n, what, m.group(0), line.strip()[:110]))
    return hits


def files_from_git(args):
    if args.staged:
        cmd = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"]
    elif args.all:
        cmd = ["git", "ls-files"]
    else:
        return args.files
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    return [f for f in out.splitlines() if f]


def blobs_in_range(rng):
    """(label, path, text) for every version of every file a range introduces.

    NOT the working tree. A first version of --range listed the files the range
    touches and then read them from disk, which is the current content and says
    nothing about what the push would publish: a name that was added in one
    commit and swept out in a later one is still in the history, still fetched
    by anyone who clones, and that was precisely the state this repository was
    in when the check was written. The point of the range mode is the blobs.
    """
    shas = subprocess.run(["git", "rev-list", rng],
                          capture_output=True, text=True).stdout.split()
    for sha in shas:
        names = subprocess.run(
            ["git", "show", "--format=", "--name-only", "--diff-filter=ACMR", sha],
            capture_output=True, text=True).stdout.splitlines()
        for path in sorted(set(n for n in names if n)):
            if path.startswith(ALLOW_PATHS) or path.endswith(ALLOW_SUFFIX):
                continue
            blob = subprocess.run(["git", "show", f"{sha}:{path}"],
                                  capture_output=True, text=True,
                                  errors="replace")
            if blob.returncode == 0:
                yield f"{sha[:8]}:{path}", path, blob.stdout


def main():
    ap = argparse.ArgumentParser(description="no customer or library names in the repo")
    ap.add_argument("files", nargs="*")
    ap.add_argument("--staged", action="store_true")
    ap.add_argument("--range", metavar="A..B")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--messages", metavar="A..B",
                    help="also check the commit MESSAGES in this range")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    if os.environ.get("ELECTRON_SKIP_NAMECHECK") == "1":
        print("name-check: ELECTRON_SKIP_NAMECHECK=1, skipped", file=sys.stderr)
        return 0

    design_rules = denylist()
    rules = RULES
    bad = 0

    if args.range:
        seen = set()
        for label, path, text in blobs_in_range(args.range):
            for n, what, hit, line in scan(path, rules_for(path, rules, design_rules), text=text):
                key = (path, what, hit)
                if key in seen:       # the same name in ten commits is one leak
                    continue
                seen.add(key)
                bad += 1
                print(f"{label}:{n}: {what}: {hit}\n    {line}", file=sys.stderr)
    else:
        for path in files_from_git(args):
            if skip(path):
                continue
            for n, what, hit, line in scan(path, rules_for(path, rules, design_rules)):
                bad += 1
                print(f"{path}:{n}: {what}: {hit}\n    {line}", file=sys.stderr)

    if args.messages:
        out = subprocess.run(["git", "rev-list", args.messages],
                             capture_output=True, text=True).stdout.split()
        for sha in out:
            msg = subprocess.run(["git", "log", "-1", "--format=%B", sha],
                                 capture_output=True, text=True).stdout
            for n, what, hit, line in scan(f"commit {sha[:8]}", rules + design_rules, text=msg):
                bad += 1
                print(f"commit {sha[:8]} message line {n}: {what}: {hit}\n"
                      f"    {line}", file=sys.stderr)

    if bad:
        print(f"\nname-check: {bad} reference(s) that may not be in a public "
              f"repo.\nname-check: write what the thing IS, not what it is "
              f"called -- \"a 119,351-module design\" says more than the name "
              f"did.\nname-check: ELECTRON_SKIP_NAMECHECK=1 overrides, for "
              f"fixing this checker only.", file=sys.stderr)
        return 1
    if not args.quiet:
        print("name-check: clean", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
