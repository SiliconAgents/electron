#---------------------------------------------------------------------#
#<!-- The pitch and offset that actually govern this layer's track grid.
#
#     LEF gives a pitch per axis, and which one matters depends on the
#     preferred direction: a HORIZONTAL layer's wires run in x, so consecutive
#     parallel wires are separated in y and the y pitch is the track pitch.  A
#     VERTICAL layer is the other way round.  Nangate45 metal1 is HORIZONTAL
#     with "PITCH 0.19 0.14", and 0.14 is the real routing pitch -- the cell is
#     1.4 um tall, which is the ten tracks that library is named for.  Reading
#     the x value for it, as everything here used to, under-counts the tracks
#     on every horizontal layer by a quarter.
#
#     A LEF that gave one number leaves the y field 0, and then the single
#     value applies to both axes. -->
sub dbTechGetLayerRoutePitch {
my ($self) = @_;
my $dir = $self->{Ldir};
my $py  = $self->{LpitchY};
if ( defined $dir && $dir =~ /HORIZ/i && defined $py && $py =~ /\d/ && $py > 0 ) {
  return($py);
}
return($self->{Lpitch});
}#sub dbTechGetLayerRoutePitch

sub dbTechGetLayerRouteOffset {
my ($self) = @_;
my $dir = $self->{Ldir};
my $oy  = $self->{LoffsetY};
if ( defined $dir && $dir =~ /HORIZ/i && defined $oy && $oy =~ /\d/ && $oy > 0 ) {
  return($oy);
}
my $ox = $self->{Loffset};
return(0) unless ( defined $ox && $ox =~ /\d/ );
return($ox);
}#sub dbTechGetLayerRouteOffset

