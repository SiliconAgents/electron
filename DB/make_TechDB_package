package TechDB;

####  explanation of database ####

sub new {
    
my $layer = {
              Lname => "UND",
              Lnum => "UND",
              Lpitch => 0,
              #<!-- LEF allows "PITCH xPitch yPitch" and "OFFSET xOff yOff".
              #     Lpitch and Loffset hold the x value, these hold the y.  They
              #     stay 0 when the LEF gave a single number, which means the
              #     same value applies to both axes. -->
              LpitchY => 0,
              LoffsetY => 0,
              #<!-- Larea, not LArea: dbTechSetLayerArea and GetLayerArea both
              #     use Larea, so the capitalised key here was initialising a
              #     field nothing reads and leaving GetLayerArea undef until
              #     something set it. -->
              Larea => 0,
              Lspacing => 0,
              Lwidth => 0,
              Ltype => "UND",
              Ldir => "UND",
              Lcolor => "UND",
              Loffset => "UND",
              Lresis => 0, 
              Llenforspacingtable => "UND",
              width_sp => [],
              };
bless $layer, 'TechDB';
return $layer;
}#sub new


