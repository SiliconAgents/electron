my ($help, $debug, $verbose) = (0,0,0);
my ($libfile, $fpfile);

use strict;
use Getopt::Long;


########################################################################
sub gen_footprint {

  ($help, $debug, $verbose) = (0,0,0);
  my (@args) =  @_;
  my $args = join(' ',@args);
  my $parseResult = Getopt::Long::GetOptionsFromString
    ($args ,
     # read args here
     "lib=s"      => \$libfile,
     "fp=s"       => \$fpfile,  #footprint file
     "h"          => \$help,
     "help"       => \$help,
     "HELP"       => \$help,
     "debug"      => \$debug,
     "verbose"    => \$verbose,
    );

  $verbose = 1 if ($debug);

  # Check for parsing errors
  if (!$parseResult) {
    print "Error: Invalid command line arguments for gen_footprint\n";
    &gen_footprint_usage;
    return(0);
  }

  if ($help) {
    &gen_footprint_usage;
    return(1);
  }

  # Validate required arguments
  if (!defined($libfile) || $libfile eq '') {
    print "Error: Missing required argument -lib (library file)\n";
    &gen_footprint_usage;
    return(0);
  }

  if (!defined($fpfile) || $fpfile eq '') {
    print "Error: Missing required argument -fp (footprint file)\n";
    &gen_footprint_usage;
    return(0);
  }

  # Check if library file exists and is readable
  if (!-r $libfile) {
    print "Error: Cannot read library file '$libfile'\n";
    return(0);
  }

  # Try to open files with better error handling
  if (!open(LIBFILE, "<", $libfile)) {
    print "Error: Cannot open library file '$libfile': $!\n";
    return(0);
  }

  if (!open(FPFILE, "> $fpfile")) {
    print "Error: Cannot create footprint file '$fpfile': $!\n";
    close(LIBFILE);
    return(0);
  }

  my ($linecount) = (0);
  my %lib;
  my ($cell, $pin, %pin);

  if ($verbose) {
    print "Starting to parse library file: $libfile\n";
  }

  while (<LIBFILE>) {
    chomp($_);
    my $line = $_ ;
    print "$line\n";
    $linecount++;

    if ($line =~ /^cell\s*\(([\w_]+)\)/) { #starting a new cell
      $cell = $1;
      if ($verbose) {
        print "Found cell: $cell (line $linecount)\n";
      }
      $lib{$cell}{'type'}='comb';
    }
    if ($line =~ /^\s*pin\s*\(([\w\d_]+)\)/) { #starting a new pin
      $pin = $1;
      if ($verbose) {
        print "  Found pin: $pin in cell $cell\n";
      }
    }
    if ($line =~ /^\s*direction\s*:\s*(\w+)\s*;/) { #get direction
      $lib{$cell}{'pin'}{$pin}{'dir'} = $1;
    }
    if ($line =~ /^\s*clock\s*:\s*true/) { #get clocks
      $lib{$cell}{'type'}='seq';
      push(@{$lib{$cell}{'clk'}},$pin);
    }
    if ($line =~ /^\s*timing\s*:\s*true/) { #comb or seq
      $lib{$cell}{'type'}='seq';
    }
    if ($line =~ /^\s*ff\s*\((.*)\s*,.*\)/) { #get seq type and outputs
      $lib{$cell}{'subtype'}='reg';
      $lib{$cell}{'po'}=$1;
    }
    if ($line =~ /^\s*latch\s*\((.*)\s*,.*\)/) { #get seq type and outputs
      $lib{$cell}{'subtype'}='latch';
      $lib{$cell}{'po'}=$1;
    }
    if ($line =~ /^\s*function\s*:\s*"([^"]+)"\s*;/) { #get function expression
      my $func_expr = $1;
      $lib{$cell}{'func'}{$pin} = $func_expr;
      if ($verbose) {
        print "    Function for pin $pin: $func_expr\n";
      }
    }
    if ($line =~ /^\s*timing_type\s*:\s*setup/) { #primary input
      if ($lib{$cell}{'pin'}{$pin}{'dir'} =~ /in/) {
	if (($pin ne "E") and ($pin ne "SE") and ($pin ne "SI") and ($pin ne "RN")) {
	  $lib{$cell}{'pi'}{$pin} = 1;
	}
      }
    }
    if ($line =~ /^\s*timing_type\s*:\s*hold/) { #primary input
      if ($lib{$cell}{'pin'}{$pin}{'dir'} =~ /in/) {
	if (($pin ne "E") and ($pin ne "SE") and ($pin ne "SI")) {
	  $lib{$cell}{'pi'}{$pin} = 1;
	}
      }
    }
  }

  my ($type, $subtype, $clk, $pi);
  foreach $cell (sort keys %lib) {
    $type = $lib{$cell}{type};
    if ($type eq "comb") {
      $subtype = "UNK";
      if    ($cell =~ /INV/)  {$subtype = 'inv';}
      elsif ($cell =~ /BUF/)  {$subtype = 'buf';}
      elsif ($cell =~ /MUX/)  {$subtype = 'mux';}
      elsif ($cell =~ /MX/)   {$subtype = 'mux';}
      elsif ($cell =~ /NAND/) {$subtype = 'nand';}
      elsif ($cell =~ /XNOR/) {$subtype = 'xnor';}
      elsif ($cell =~ /NOR/)  {$subtype = 'nor';}
      elsif ($cell =~ /XOR/)  {$subtype = 'xor';}
      elsif ($cell =~ /AND/)  {$subtype = 'and';}
      elsif ($cell =~ /ADD/)  {$subtype = 'add';}
      elsif ($cell =~ /AOI/)  {$subtype = 'aoi';}
      elsif ($cell =~ /OAI/)  {$subtype = 'oai';}
      elsif ($cell =~ /OR/)   {$subtype = 'or';}
      printf FPFILE ("%-10s; %-6s; %-6s;\n",$cell,$subtype,$type);
    } elsif ($type eq "seq") {
      $subtype = $lib{$cell}{subtype};
      $clk = join(',',@{$lib{$cell}{'clk'}});
      my $po = $lib{$cell}{'po'};
      if ($subtype eq "reg") {
	if (defined($lib{$cell}{'pi'}{RN})) {
	  delete $lib{$cell}{'pi'}{RN};
	}
      }
      my @pi = sort keys %{$lib{$cell}{'pi'}};
      my $pi = join(',',@pi);
      printf FPFILE ("%-10s; %-6s; %-6s; %-6s; %-6s; %-6s;\n", 
		     $cell,$subtype,$type,$pi,$po,$clk);
    }
  }
  close(LIBFILE);
  close(FPFILE);

  if ($verbose) {
    print "Processed $linecount lines\n";
    print "Found " . (scalar keys %lib) . " cells\n";
  }
  print "gen_footprint: Finished generating footprint file $fpfile\n";
}

sub gen_footprint_usage {
  print qq^
gen_footprint  -lib=libfile         # input library file
	       -fp=fpfile           # output footprint file
               -help                # help, print this message
               -debug               # debug mode
               -verbose             # verbose mode
^;
}

1;
