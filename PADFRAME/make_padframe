     if(!-e $centreFile){
        print "\nWARN-PAD-FRM : 002 : file $centreFile does not exists !\n";
        return;
     }

     my $data;
     if(open (my $json_str, $jsonFile)){
       local $/ = undef;
       my $json = JSON->new;
       $data = $json->decode(<$json_str>);
       close($json_str);
     }
     #print Dumper($data);
     #print Dumper($data->{"pins"}[0]);

     my $dbu = $GLOBAL->dbfGlobalGetDBU;
     open(READ, "$centreFile");
     while(<READ>){
        chomp();
        my ($x, $y) = split(/\s+/, $_);
        $x = $x*$dbu;
        $y = $y*$dbu;
        $points{"$x,$y"} = 1;
        #print "centre:$x,$y\n";
     }
     close(READ);

     foreach my $element (@{$data->{"pins"}}){
        my $side = $element->{"side"};
        if($side eq "TL" || $side eq "BL" || $side eq "TR" || $side eq "BR" || $side eq "TRR"){next;}
        foreach my $pinEle (@{$element->{"pin"}}){
           my $padName = $pinEle->{"name"};
           my $label = $pinEle->{"label"};
           $pad_vs_label{$padName} = $label;
        }#foreach pin
     }#foreach element

     open(WRITE, ">$outFile");
     foreach my $pad (keys %pad_vs_label){
        my $label = $pad_vs_label{$pad};
        #print "$pad=>$label\n";
        if(exists $CADB{$pad}){
           my @bbox = $CADB{$pad}->dbCadbGetbBox;
           my @new_poly = ([$bbox[0], $bbox[1]], [$bbox[2], $bbox[1]], [$bbox[2], $bbox[3]], [$bbox[0], $bbox[3]], [$bbox[0], $bbox[1]]); #making array in the form of Math:Polygon
           my $poly = Math::Polygon->new(points => \@new_poly);
           foreach my $p (keys %points){
              my @point = split(/\,/, $p);
              my $isInside = $poly->contains(\@point);
              if($isInside == 1){
                 $_ /= $dbu for @point;
                 print WRITE "layout_text $label @point\n";
                 delete $points{$p};
                 last;
              }
           }

        }
     }
     close(WRITE);
  }#if correct num of arg

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command generate_pads_label_file took:",timestr($td),"\n";
}#sub generate_pads_label_file     

#######################################################################################################################
########################################## Create PAD Ring for Cobalt #################################################
#######################################################################################################################
sub create_pad_ring_cobalt {
  use Benchmark;
  my $t0 = new Benchmark;

  my $noOfArg = @_;
  if($noOfArg < 2 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP"){
     print "Usage: create_pad_ring_cobalt -f <json file>\n";
     print "                              --add_filler\n";
     return;
  }else{
     my ($jsonFile, $addFillers, $fillerCnt) = ("", 0, 0);
     for(my $i=0; $i<$noOfArg; $i++){
         if($_[$i] eq "-f" )            {$jsonFile = $_[$i+1]; }
         if($_[$i] eq "--add_filler" )  {$addFillers = 1; }
     }

     if(!-e $jsonFile){
        print "\nWARN-PAD-FRM : 001 : file $jsonFile does not exists !\n";
        return;
     }

     my $data;
     if(open (my $json_str, $jsonFile)){
       local $/ = undef;
       my $json = JSON->new;
       $data = $json->decode(<$json_str>);
       close($json_str);
     }
     #print Dumper($data);
     #print Dumper($data->{"pins"}[0]);

     my $dbu = $GLOBAL->dbfGlobalGetDBU;
     if(exists $DIE_ALREADY{dieArea}){
        my $diellx = $DIE_ALREADY{dieArea}[0];
        my $dielly = $DIE_ALREADY{dieArea}[1];
        my $dieurx = $DIE_ALREADY{dieArea}[2];
        my $dieury = $DIE_ALREADY{dieArea}[3];
        #print "dieArea is:@{$DIE_ALREADY{dieArea}} \n";
     
        my $dieWidth = abs($dieurx - $diellx)/$dbu ;
        my $dieHeight = abs($dieury - $dielly)/$dbu ;
        #print "die:$dieWidth,$dieHeight\n";

        ######################## Making hash of filler cells ########################
        my %FILLERS = ();
        foreach my $cell (keys %PLDB){
           my $class = $PLDB{$cell}->dbMdbGetClass;
           if($class eq "PAD SPACER" && $cell !~ /A$/){
              my @size = $PLDB{$cell}->dbMdbGetSize;
              $FILLERS{$size[0]*$dbu} = $cell;
           } 
        }
        my @fillersWidthArr = sort{$b<=>$a} keys %FILLERS;
        my @fillerCells = @FILLERS{@fillersWidthArr};
        #print "fillers:@fillerCells Width:@fillersWidthArr\n";

        
        #############################################################################
        my ($lPadIndex, $rPadIndex, $tPadIndex, $bPadIndex, $tlPadIndex, $trPadIndex, $blPadIndex, $brPadIndex, $trrPadIndex) = (0, 0, 0, 0, 0, 0, 0, 0, 0);
        my $index = 0;
        foreach my $element (@{$data->{"pins"}}){
           my $side = $element->{"side"};

           if   ($side eq "L"){$lPadIndex = $index ;}
           elsif($side eq "R"){$rPadIndex = $index ;}
           elsif($side eq "T"){$tPadIndex = $index ;}
           elsif($side eq "B"){$bPadIndex = $index ;}
           elsif($side eq "TL"){$tlPadIndex = $index ;}
           elsif($side eq "TR"){$trPadIndex = $index ;}
           elsif($side eq "BL"){$blPadIndex = $index ;}
           elsif($side eq "BR"){$brPadIndex = $index ;}
           elsif($side eq "TRR"){$trrPadIndex = $index ;}
           else {next;}

           foreach my $pinEle (@{$element->{"pin"}}){
              my $cellName = $pinEle->{"cell"};
              if(!exists $PLDB{$cellName}){
                 print "WARN-PAD-FRM : 002 : cell $cellName does not found !\n";
                 return;
              }
           }#foreach pin
           $index++;
        }#foreach pins

        my $llx = $diellx;
        my $lly = $dielly;
        #################################### Adding bottom-left corner pads ################################
        my $tlSpace = $dieHeight*$dbu;
        my $brSpace = $dieWidth*$dbu;
        my $blCornerPad = $data->{"pins"}->[$blPadIndex]->{"pin"}->[0]->{"name"};
        my $blCornerCell = $data->{"pins"}->[$blPadIndex]->{"pin"}->[0]->{"cell"};
        my $blCornerPadOrient = $data->{"pins"}->[$blPadIndex]->{"pin"}->[0]->{"orient"};

        print "INFO: adding BOTTOM_LEFT_PAD $blCornerPad $blCornerCell ". ($llx,  $lly) ."\n";
        my ($blx1, $bly1, $blx2, $bly2) = &add_pad_in_db($blCornerPad, $blCornerCell, "FIXED", $llx, $lly, $blCornerPadOrient);
        $lly = $bly2;
        $tlSpace -= ($bly2 - $bly1);
        $brSpace -= ($blx2 - $blx1);

        ####################################### Adding Left Pads ###########################################
        foreach my $pin (@{$data->{"pins"}[$lPadIndex]->{"pin"}}){
            my ($name, $cell, $orient) = ($pin->{name}, $pin->{cell}, $pin->{orient});
            print "INFO: adding LEFT_PAD $name $cell $llx $lly\n";
            my ($x1,$y1,$x2,$y2) = &add_pad_in_db($name, $cell, "FIXED", $llx, $lly, $orient);
            $lly = $y2;
            $tlSpace -= ($y2 - $y1);
        }

        my $tlCornerPad = $data->{"pins"}->[$tlPadIndex]->{"pin"}->[0]->{"name"};
        my $tlCornerCell = $data->{"pins"}->[$tlPadIndex]->{"pin"}->[0]->{"cell"};
        my $tlCornerPadOrient = $data->{"pins"}->[$tlPadIndex]->{"pin"}->[0]->{"orient"};

        my @tlCornerCelliSize = $PLDB{$tlCornerCell}->dbMdbGetSize;
        $tlSpace -= ($tlCornerCelliSize[0]*$dbu);
        if($addFillers == 1){
           ################### adding horizontal fillers before each pad if space is given #################
           my @lPadFillers = get_num_fillers($tlSpace, @hFillersWidthArr);
           #print "name:$name lS: $tlSpace lFill:@lPadFillers\n";
           for(my $i=0; $i<@lPadFillers; $i++){
               my $fillerCellName = $H_FILLERS{$lPadFillers[$i]};
               if(!defined($fillerCellName) || !exists $PLDB{$fillerCellName}){
                   print "ERROR: Horizontal filler cell for width $lPadFillers[$i] not found in PLDB\n";
                   print "       Available H_FILLERS keys: " . join(", ", keys %H_FILLERS) . "\n";
                   next;
               }
               print "INFO: adding filler IOFILLER_" .$fillerCnt. " $fillerCellName $llx $lly\n";
               my ($x1,$y1,$x2,$y2) = &add_pad_in_db("IOFILLER_".$fillerCnt, $fillerCellName, "FIXED", $llx, $lly, "FW");
               $lly = $y2;
               $fillerCnt++;
           } 
        } 

        ###################################### Adding top-left corner pads ##################################
        my $trSpace = $dieWidth*$dbu;
        print "INFO: adding TOP_LEFT_PAD $tlCornerPad $tlCornerCell ". ($lly , $lly) ."\n";
        my ($tlx1, $tly1, $tlx2, $tly2) = &add_pad_in_db($tlCornerPad, $tlCornerCell, "FIXED", $llx, $lly, $tlCornerPadOrient);
        $llx = $tlx2; 
        $trSpace -= ($tlx2 - $tlx1);

        ######################################## Adding Top Pads ###########################################
        foreach my $pin (@{$data->{"pins"}[$tPadIndex]->{"pin"}}){
            my ($name, $cell, $orient) = ($pin->{name}, $pin->{cell}, $pin->{orient});
            my @cellSize = $PLDB{$cell}->dbMdbGetSize;
            $lly = $dieury - $cellSize[1]*$dbu; 
            print "INFO: adding TOP_PAD $name $cell $llx $lly\n";
            my ($x1,$y1,$x2,$y2) = &add_pad_in_db($name, $cell, "FIXED", $llx, $lly, $orient);
            $trSpace -= ($x2 - $x1);
            $llx = $x2;
        }

        my $trCornerPad = $data->{"pins"}->[$trPadIndex]->{"pin"}->[0]->{"name"};
        my $trCornerCell = $data->{"pins"}->[$trPadIndex]->{"pin"}->[0]->{"cell"};
        my $trCornerPadOrient = $data->{"pins"}->[$trPadIndex]->{"pin"}->[0]->{"orient"};

        my @trCornerCelliSize = $PLDB{$trCornerCell}->dbMdbGetSize;
        $trSpace -= ($trCornerCelliSize[0]*$dbu);
        if($addFillers == 1){
           ################### adding fillers after each pad if space is given ################# 
           my @tPadFillers = get_num_fillers($trSpace, @fillersWidthArr);
           #print "name:$name tS: $trSpace tFill:@tPadFillers\n";
           for(my $i=0; $i<@tPadFillers; $i++){
               my $fillerCellName = $FILLERS{$tPadFillers[$i]};
               print "INFO: adding filler IOFILLER_" .$fillerCnt. " $fillerCellName $llx $lly\n";
               my ($x1,$y1,$x2,$y2) = &add_pad_in_db("IOFILLER_".$fillerCnt, $fillerCellName, "FIXED", $llx, $lly, "S");
               $llx = $x2;
               $fillerCnt++;
           } 
        } 

        #################################### Adding top-right corner pads ####################################
        my $trrSpace = $dieHeight*$dbu;
        print "INFO: adding TOP_RIGHT_PAD $trCornerPad $trCornerCell ".($llx , $lly). "\n";
        my ($trx1, $try1, $trx2, $try2) = &add_pad_in_db($trCornerPad, $trCornerCell, "FIXED", $llx, $lly, $trCornerPadOrient);
        $trrSpace -= ($try2 - $try1);

        ####################################### Adding Bottom Pads #########################################
        $llx = $blx2;
        $lly = $diellx; 
        foreach my $pin (@{$data->{"pins"}[$bPadIndex]->{"pin"}}){
            my ($name, $cell, $orient) = ($pin->{name}, $pin->{cell}, $pin->{orient});
            print "INFO: adding BOTTOM_PAD $name $cell $llx $lly\n";
            my ($x1,$y1,$x2,$y2) = &add_pad_in_db($name, $cell, "FIXED", $llx, $lly, $orient);
            $brSpace -= ($x2 - $x1);
            $llx = $x2;
        }

        my $brCornerPad = $data->{"pins"}->[$brPadIndex]->{"pin"}->[0]->{"name"};
        my $brCornerCell = $data->{"pins"}->[$brPadIndex]->{"pin"}->[0]->{"cell"};
        my $brCornerPadOrient = $data->{"pins"}->[$brPadIndex]->{"pin"}->[0]->{"orient"};

        my @brCornerCelliSize = $PLDB{$brCornerCell}->dbMdbGetSize;
        $brSpace -= ($brCornerCelliSize[0]*$dbu);
        if($addFillers == 1){
           ################### adding fillers before each pad if space is given ################# 
           my @bPadFillers = get_num_fillers($brSpace, @fillersWidthArr);
           #print "name:$name bS: $brSpace bFill:@bPadFillers\n";
           for(my $i=0; $i<@bPadFillers; $i++){
               my $fillerCellName = $FILLERS{$bPadFillers[$i]};
               print "INFO: adding filler IOFILLER_" .$fillerCnt. " $fillerCellName $llx $lly\n";
               my ($x1,$y1,$x2,$y2) = &add_pad_in_db("IOFILLER_".$fillerCnt, $fillerCellName, "FIXED", $llx, $lly, "N");
               $llx = $x2;
               $fillerCnt++;
           } 
        } 

        ################################### Adding bottom-right corner pads ##################################
        print "INFO: adding BOTTOM_RIGHT_PAD $brCornerPad $brCornerCell ".($llx , $lly). "\n";
        my ($brx1, $bry1, $brx2, $bry2) = &add_pad_in_db($brCornerPad, $brCornerCell, "FIXED", $llx, $lly, $brCornerPadOrient);
        $lly = $bry2;
        $trrSpace -= ($bry2 - $bry1);

        ######################################## Adding Right Pads ###########################################
        foreach my $pin (@{$data->{"pins"}[$rPadIndex]->{"pin"}}){
            my ($name, $cell, $orient) = ($pin->{name}, $pin->{cell}, $pin->{orient});
            my @cellSize = $PLDB{$cell}->dbMdbGetSize;
            $llx = $dieurx - $cellSize[1]*$dbu; 
            print "INFO: adding RIGHT_PAD $name $cell $llx $lly\n";
            my ($x1,$y1,$x2,$y2) = &add_pad_in_db($name, $cell, "FIXED", $llx, $lly, $orient);
            $trrSpace -= ($y2 - $y1);
            $lly = $y2;
        }

        if($addFillers == 1){
           ################### adding horizontal fillers after each pad if space is given #################
           my @rPadFillers = get_num_fillers($trrSpace, @hFillersWidthArr);
           #print "name:$name rS: $trrSpace rFill:@rPadFillers\n";
           for(my $i=0; $i<@rPadFillers; $i++){
               my $fillerCellName = $H_FILLERS{$rPadFillers[$i]};
               if(!defined($fillerCellName) || !exists $PLDB{$fillerCellName}){
                   print "ERROR: Horizontal filler cell for width $rPadFillers[$i] not found in PLDB\n";
                   print "       Available H_FILLERS keys: " . join(", ", keys %H_FILLERS) . "\n";
                   next;
               }
               print "INFO: adding filler IOFILLER_" .$fillerCnt. " $fillerCellName $llx $lly\n";
               my ($x1,$y1,$x2,$y2) = &add_pad_in_db("IOFILLER_".$fillerCnt, $fillerCellName, "FIXED", $llx, $lly, "FE");
               $lly = $y2;
               $fillerCnt++;
           } 
        } 

        ################################### changing dieArea to fit pad ring #################################
        ##$DIE_ALREADY{dieArea}[2] = $startX + $cornerSize[0]*$dbu;
        ##$DIE_ALREADY{dieArea}[3] = $startY + $cornerSize[0]*$dbu;
        ###print "Updated dieArea is:@{$DIE_ALREADY{dieArea}} \n";

        ######################################################################################################
     }#if die area exists
  }#if correct num of arg

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command create_pad_ring_cobalt took:",timestr($td),"\n";
}#sub create_pad_ring_cobalt

