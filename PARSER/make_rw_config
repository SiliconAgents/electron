sub read_config_file {

use Benchmark;
my $t0 = new Benchmark;

my $config_file;
my $tech_node;
my $foundry;
my $layer;
my $read_macro_lefs = 0;  # Default: don't read macro LEFs
my $read_io_lefs = 0;     # Default: don't read IO cell LEFs

my $noOfArguments = @_;

if( $noOfArguments == 2 || $noOfArguments >= 4 ) {

my $READ_TECHNOLOGY = "dont";
my $file_list = 0;
for(my $i = 0; $i < $noOfArguments; $i++){
if($_[$i] eq "-config"){$config_file = $_[$i+1];}
if($_[$i] eq "-technode"){$tech_node = $_[$i+1];}
if($_[$i] eq "-foundary"){$foundry = $_[$i+1];}
if($_[$i] eq "-layer"){$layer = $_[$i+1];}
if($_[$i] eq "-read_macro_lefs"){$read_macro_lefs = 1;}
if($_[$i] eq "-read_io_lefs"){$read_io_lefs = 1;}
                                         } # for


    die "Error: Config file not specified\n" unless $config_file;
    die "Error: Config file '$config_file' not found\n" unless -f $config_file;
    die "Error: Tech node not specified\n" unless $tech_node;
    die "Error: Foundry not specified\n" unless $foundry;
    die "Error: Layer not specified\n" unless defined $layer;

    my $config = parse_config($config_file);
    my $output_file = "load_lefs.tcl";

    open(my $fh, '>', $output_file) or die "Cannot open $output_file: $!\n";

    my $found_lefs = 0;
    #<!-- liberty paths collected, not opened; see the std-cell-libs block -->
    my $found_libs = 0;
    %STDCELL_LIB_ALREADY = ();
    #<!-- read after every LEF, since it stamps cells that only exist in PLDB
    #     once a LEF has been read -->
    my @func_maps = ();

    if (!exists $config->{$foundry}) {
        close($fh);
        unlink $output_file;
        die "Error: Foundry '$foundry' not found in configuration\n";
    }

    if (!exists $config->{$foundry}{node}) {
        close($fh);
        unlink $output_file;
        die "Error: No nodes found for foundry '$foundry'\n";
    }

    foreach my $node (@{$config->{$foundry}{node}}) {
        next unless $node->{type} =~ /$tech_node/i;

        foreach my $file_group (@{$node->{files}}) {
            my $file_layer = $file_group->{layer};

            if ($layer eq $file_layer) {
                if (exists $file_group->{tech}) {
                    my $tech_files = ref($file_group->{tech}) eq 'ARRAY' ?
                                   $file_group->{tech} : [$file_group->{tech}];

                    foreach my $lef_file (@$tech_files) {
                        print $fh "read_lef -lef $lef_file -tech only\n";
                        &read_lef(-lef,$lef_file,-tech,only);
                        $found_lefs++;
                    }
                }

                if (exists $file_group->{'std-cell-lefs'}) {
                    my $stdcell_lef_group = $file_group->{'std-cell-lefs'};

                    # Check if std-cell-lefs has VT type hierarchy (hash) or is a simple array
                    if (ref($stdcell_lef_group) eq 'HASH') {
                        # Handle VT type hierarchy (ulvt, slvt, lvt, rvt, mixed, etc.)
                        foreach my $vt_type (keys %$stdcell_lef_group) {
                            my $stdcell_lef_files = ref($stdcell_lef_group->{$vt_type}) eq 'ARRAY' ?
                                                   $stdcell_lef_group->{$vt_type} : [$stdcell_lef_group->{$vt_type}];

                            foreach my $lef_file (@$stdcell_lef_files) {
                                print $fh "read_lef -lef $lef_file -tech dont\n";
                                &read_lef(-lef,$lef_file,-tech,dont);
                                $found_lefs++;
                            }
                        }
                    } else {
                        # Handle legacy simple array format
                        my $stdcell_lef_files = ref($stdcell_lef_group) eq 'ARRAY' ?
                                               $stdcell_lef_group : [$stdcell_lef_group];

                        foreach my $lef_file (@$stdcell_lef_files) {
                            print $fh "read_lef -lef $lef_file -tech dont\n";
                            &read_lef(-lef,$lef_file,-tech,dont);
                            $found_lefs++;
                        }
                    }
                }

                # Process macro LEFs if the switch is enabled
                if ($read_macro_lefs && exists $file_group->{'macro-lefs'}) {
                    my $macro_lef_files = ref($file_group->{'macro-lefs'}) eq 'ARRAY' ?
                                         $file_group->{'macro-lefs'} : [$file_group->{'macro-lefs'}];

                    foreach my $lef_file (@$macro_lef_files) {
                        print $fh "read_lef -lef $lef_file -tech dont\n";
                        &read_lef(-lef,$lef_file,-tech,dont);
                        $found_lefs++;
                    }
                }

#<!-- Liberty paths, remembered but NOT read.
#
#     "std-cell-libs" lists every corner of every VT flavour -- 3336 files for
#     slvt on this samsung config, 2937 for elvt on the tsmc one, and the
#     uncompressed ones run to 2GB each.  Reading them here would be absurd and
#     nothing in this tool wants all of them at once.  What the list is for is
#     picking one: synthesis takes a single liberty for dfflibmap and abc.
#
#     So the paths go into %STDCELL_LIB_ALREADY keyed by VT flavour, and
#     get_std_cell_libs searches them by corner.  Nothing is opened until
#     something asks for a specific file. -->
                if (exists $file_group->{'std-cell-libs'}) {
                    $found_libs += &dbfConfigAddStdCellLibs($file_group->{'std-cell-libs'});
                }

                # Cell function map: says which cells are combinational,
                # sequential or memory when no liberty is read
                if (exists $file_group->{'cell-func-map'}) {
                    my $map_files = ref($file_group->{'cell-func-map'}) eq 'ARRAY' ?
                                    $file_group->{'cell-func-map'} : [$file_group->{'cell-func-map'}];
                    push(@func_maps, @$map_files);
                }

                # Process IO cell LEFs if the switch is enabled
                if ($read_io_lefs && exists $file_group->{'io-cell-lefs'}) {
                    my $io_lef_group = $file_group->{'io-cell-lefs'};

                    # Handle different voltage threshold variants
                    foreach my $vt_type (keys %$io_lef_group) {
                        my $io_lef_files = ref($io_lef_group->{$vt_type}) eq 'ARRAY' ?
                                          $io_lef_group->{$vt_type} : [$io_lef_group->{$vt_type}];

                        foreach my $lef_file (@$io_lef_files) {
                            print $fh "read_lef -lef $lef_file -tech dont\n";
                            &read_lef(-lef,$lef_file,-tech,dont);
                            $found_lefs++;
                        }
                    }
                }
            }
        }
    }

    foreach my $map_file (@func_maps) {
        next unless (defined $map_file && $map_file ne "");
        print $fh "read_cell_func_map -file $map_file\n";
        &read_cell_func_map("-file", $map_file);
    }

    close($fh);

    if ($found_lefs == 0) {
        unlink $output_file;
        my $error_msg = "Warning: No LEF files found for tech node '$tech_node' from foundry '$foundry' and layer '$layer'";
        if ($read_macro_lefs || $read_io_lefs) {
            my @extra_types;
            push @extra_types, "macro LEFs" if $read_macro_lefs;
            push @extra_types, "IO cell LEFs" if $read_io_lefs;
            $error_msg .= " (including " . join(" and ", @extra_types) . ")";
        }
        print "$error_msg\n";
        return;
    }

    my $lef_types = "tech and std-cell LEFs";
    if ($read_macro_lefs || $read_io_lefs) {
        my @extra_types;
        push @extra_types, "macro LEFs" if $read_macro_lefs;
        push @extra_types, "IO cell LEFs" if $read_io_lefs;
        $lef_types .= " and " . join(" and ", @extra_types);
    }
    print "Generated $output_file with $found_lefs read_lef commands ($lef_types)\n";
    if (@func_maps) {
        print "Read " . scalar(@func_maps) . " cell function map(s) from the config\n";
    }
    if ($found_libs > 0) {
        my @vts = sort keys %STDCELL_LIB_ALREADY;
        my @summary = map { "$_ " . scalar(@{$STDCELL_LIB_ALREADY{$_}}) } @vts;
        print "INFO-PAR-CONFIG : 003 : $found_libs liberty path(s) noted, not read: ",
              join(", ", @summary), "\n";
        print "INFO-PAR-CONFIG : 004 : pick one with get_std_cell_libs -vt <flavour> -corner <pattern>\n";
    }

    #<!-- The library is loaded now, so choose the assign buffer.  Without one,
    #     read_verilog drops every assign statement and only says so at
    #     $DEBUG == 101.  A cell named explicitly by an earlier
    #     set_buffer_for_assign is left alone. -->
    if ( $GLOBAL->dbfGlobalGetBufForAssign eq "" ) {
        &set_buffer_for_assign();
    }
    else {
        print "INFO-PAR-CONFIG : 001 : assign buffer already set to " .
              $GLOBAL->dbfGlobalGetBufForAssign . ", leaving it\n";
    }

    #<!-- and the tie cells, which the constant side of an assign needs -->
    if ( $GLOBAL->dbfGlobalGetTieHighCell eq "" || $GLOBAL->dbfGlobalGetTieLowCell eq "" ) {
        &set_tie_cells();
    }
    # &source($output_file);
    return;

}

my $t1 = new Benchmark;
my $td = timediff($t1, $t0);
print "Command read_config took:",timestr($td),"\n";

}# sub read_config

#------------------------------------------------------------------------------------------#
#<!-- Files a "std-cell-libs" entry into %STDCELL_LIB_ALREADY and says how many
#     it filed.  The entry is either a hash keyed by VT flavour or a bare list,
#     and both shapes appear in the configs in use.  Nothing is opened here. -->
sub dbfConfigAddStdCellLibs {
    my ($lib_group) = @_;
    return 0 unless ( defined $lib_group );

    my $count = 0;
    if (ref($lib_group) eq 'HASH') {
        foreach my $vt_type (keys %$lib_group) {
            my $lib_files = ref($lib_group->{$vt_type}) eq 'ARRAY' ?
                            $lib_group->{$vt_type} : [$lib_group->{$vt_type}];
            push(@{$STDCELL_LIB_ALREADY{$vt_type}}, @$lib_files);
            $count += scalar(@$lib_files);
        }
    } else {
        my $lib_files = ref($lib_group) eq 'ARRAY' ? $lib_group : [$lib_group];
        push(@{$STDCELL_LIB_ALREADY{'default'}}, @$lib_files);
        $count += scalar(@$lib_files);
    }
    return $count;
}
#------------------------------------------------------------------------------------------#
#<!-- read_library_config: the liberty half of read_config_file, on its own.
#
#     read_config_file reads every tech and std-cell LEF it finds, which takes
#     minutes and is beside the point when all you want is a liberty to hand to
#     yosys.  This walks the same library.config and fills only
#     %STDCELL_LIB_ALREADY, so synthesize has something to choose from before a
#     single LEF has been read.  get_std_cell_libs does the choosing. -->
sub read_library_config {

my $config_file;
my $tech_node;
my $foundry;
my $layer;
my $append = 0;

my $noOfArguments = @_;
if ( $noOfArguments == 0 || $_[0] eq '-h' ) {
  print "Usage : read_library_config -config <library.config> -foundary <fab> -technode <node> [-layer <n>] [--append]\n";
  print "        Records the std-cell liberty paths only; reads no LEF and opens no liberty.\n";
  print "        Use get_std_cell_libs to pick one out of what this records.\n";
  return;
}

for(my $i = 0; $i < $noOfArguments; $i++){
  if($_[$i] eq "-config"){$config_file = $_[$i+1];}
  if($_[$i] eq "-technode"){$tech_node = $_[$i+1];}
  if($_[$i] eq "-foundary"){$foundry = $_[$i+1];}
  if($_[$i] eq "-foundry"){$foundry = $_[$i+1];}
  if($_[$i] eq "-layer"){$layer = $_[$i+1];}
  if($_[$i] eq "--append"){$append = 1;}
}#for

unless ( defined $config_file && $config_file ne "" ) {
  print "ERROR-PAR-LIBCFG : 001 : no -config given\n";
  return;
}
unless ( -f $config_file ) {
  print "ERROR-PAR-LIBCFG : 002 : config file $config_file does not exist\n";
  return;
}
unless ( defined $foundry && $foundry ne "" ) {
  print "ERROR-PAR-LIBCFG : 003 : no -foundary given\n";
  return;
}

my $config = parse_config($config_file);

unless ( exists $config->{$foundry} && exists $config->{$foundry}{node} ) {
  print "ERROR-PAR-LIBCFG : 004 : foundry $foundry has no nodes in $config_file\n";
  print "ERROR-PAR-LIBCFG : 005 : the file has: " . join(", ", sort keys %$config) . "\n";
  return;
}

%STDCELL_LIB_ALREADY = () unless ( $append == 1 );

my $found_libs = 0;
foreach my $node (@{$config->{$foundry}{node}}) {
  next if ( defined $tech_node && $tech_node ne "" && $node->{type} !~ /$tech_node/i );

  foreach my $file_group (@{$node->{files}}) {
    next if ( defined $layer && $layer ne "" && $layer ne $file_group->{layer} );
    next unless ( exists $file_group->{'std-cell-libs'} );
    $found_libs += &dbfConfigAddStdCellLibs($file_group->{'std-cell-libs'});
  }
}

if ( $found_libs == 0 ) {
  print "WARN-PAR-LIBCFG : 006 : no std-cell-libs found for foundry $foundry" .
        ( defined $tech_node ? ", node $tech_node" : "" ) .
        ( defined $layer     ? ", layer $layer"    : "" ) . "\n";
  return;
}

my @vts = sort keys %STDCELL_LIB_ALREADY;
print "INFO-PAR-LIBCFG : 007 : recorded $found_libs liberty path(s) in " . scalar(@vts) . " flavour(s)\n";
foreach my $vt ( @vts ) {
  print "INFO-PAR-LIBCFG : 008 :   $vt : " . scalar(@{$STDCELL_LIB_ALREADY{$vt}}) . "\n";
}
return;

}# sub read_library_config
#------------------------------------------------------------------------------------------#
#<!-- get_std_cell_libs: pick liberty paths out of what the config recorded.
#
#     There are thousands per flavour -- every corner of every voltage and
#     temperature -- so this is a filter, not a dump.  -vt narrows to a flavour,
#     -corner is a substring or regex matched against the file name, and the
#     surviving paths are printed and returned.  --set also parks them in
#     @SYNTH_LIBERTY_LIST, which is where synthesize looks when it is given no
#     -liberty of its own. -->
sub get_std_cell_libs {

my $vt;
my $corner;
my $maxPrint = 20;
my $doSet = 0;
my $wantFirst = 0;

my $noOfArguments = @_;
if ( $noOfArguments > 0 && $_[0] eq '-h' ) {
  print "Usage : get_std_cell_libs [-vt <flavour>] [-corner <pattern>] [-max <n>] [--first] [--set]\n";
  print "        --first keeps only the first match, --set parks the result for synthesize\n";
  return;
}

for(my $i = 0; $i < $noOfArguments; $i++){
  if($_[$i] eq "-vt"){$vt = $_[$i+1];}
  if($_[$i] eq "-corner"){$corner = $_[$i+1];}
  if($_[$i] eq "-max"){$maxPrint = $_[$i+1];}
  if($_[$i] eq "--first"){$wantFirst = 1;}
  if($_[$i] eq "--set"){$doSet = 1;}
}#for

unless ( keys %STDCELL_LIB_ALREADY ) {
  print "ERROR-PAR-LIBSEL : 001 : no liberty paths are recorded\n";
  print "ERROR-PAR-LIBSEL : 002 : run read_library_config -config <library.config> -foundary <fab> -technode <node> first\n";
  return ();
}

my @flavours = sort keys %STDCELL_LIB_ALREADY;
if ( defined $vt && $vt ne "" ) {
  my @hit = grep { /^$vt$/i } @flavours;
  unless ( @hit ) {
    print "ERROR-PAR-LIBSEL : 003 : no flavour named $vt; the config has " . join(", ", @flavours) . "\n";
    return ();
  }
  @flavours = @hit;
}

my @picked = ();
foreach my $flavour ( @flavours ) {
  foreach my $lib ( @{$STDCELL_LIB_ALREADY{$flavour}} ) {
    next if ( defined $corner && $corner ne "" && $lib !~ /$corner/ );
    push(@picked, $lib);
  }
}

unless ( @picked ) {
  print "WARN-PAR-LIBSEL : 004 : nothing matched" .
        ( defined $vt     ? " -vt $vt"         : "" ) .
        ( defined $corner ? " -corner $corner" : "" ) . "\n";
  return ();
}

@picked = ( $picked[0] ) if ( $wantFirst == 1 );

print "INFO-PAR-LIBSEL : 005 : " . scalar(@picked) . " liberty file(s) matched\n";
my $shown = 0;
foreach my $lib ( @picked ) {
  last if ( $shown >= $maxPrint );
  print "INFO-PAR-LIBSEL : 006 :   $lib\n";
  $shown++;
}
if ( scalar(@picked) > $shown ) {
  print "INFO-PAR-LIBSEL : 007 :   ... and " . ( scalar(@picked) - $shown ) .
        " more; narrow it with -corner or raise -max\n";
}

if ( $doSet == 1 ) {
  @SYNTH_LIBERTY_LIST = @picked;
  print "INFO-PAR-LIBSEL : 008 : synthesize will use these unless it is given -liberty\n";
}

return @picked;

}# sub get_std_cell_libs
#------------------------------------------------------------------------------------------#
#<!-- $VAR and ${VAR} in a config path, expanded from the environment.
#
#     A config that ships with the repository cannot name an absolute path:
#     the one checked in pointed at /home/ubuntu/proton, which was somebody
#     else's machine years ago.  Expanding the environment lets it say
#     $ELECTRON_HOME/TESTS/library/... and be right in any checkout.
#
#     ELECTRON_HOME falls back to the tool's own idea of where it lives, so it
#     works whether or not the variable is exported.  A name that resolves to
#     nothing is left alone rather than silently becoming an empty string,
#     because "no such file: $FOO/x.lef" says what went wrong and
#     "no such file: /x.lef" does not. -->
sub dbfConfigExpandVars {
    my ($value) = @_;
    return $value unless ( defined $value && $value =~ /\$/ );

    my $home = $ENV{ELECTRON_HOME};
    unless ( defined $home && $home ne "" ) {
        $home = $GLOBAL->dbfGlobalGetElectronHome;
    }

    $value =~ s{\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)}{
        my $name = defined $1 ? $1 : $2;
        my $sub;
        if ( $name eq "ELECTRON_HOME" && defined $home && $home ne "" ) { $sub = $home; }
        elsif ( defined $ENV{$name} && $ENV{$name} ne "" )              { $sub = $ENV{$name}; }
        defined $sub ? $sub : ( defined $1 ? "\${$name}" : "\$$name" );
    }ge;

    return $value;
}

#<!-- Walk the decoded config and expand every string in it, so no reader has
#     to remember to do it per key. -->
sub dbfConfigExpandTree {
    my ($node) = @_;
    if ( ref($node) eq 'HASH' ) {
        foreach my $k ( keys %$node ) { $node->{$k} = &dbfConfigExpandTree($node->{$k}); }
        return $node;
    }
    if ( ref($node) eq 'ARRAY' ) {
        for ( my $i = 0; $i <= $#{$node}; $i++ ) { $node->[$i] = &dbfConfigExpandTree($node->[$i]); }
        return $node;
    }
    return &dbfConfigExpandVars($node);
}

sub parse_config {
    my ($config_file) = @_;

    open(my $fh, '<', $config_file) or die "Cannot open $config_file: $!\n";
    my $json_text = do { local $/; <$fh> };
    close($fh);

    my $json = JSON->new;
    my $config = eval { $json->decode($json_text) };
    die "Error parsing JSON in $config_file: $@\n" if $@;

    return &dbfConfigExpandTree($config);
}




1;
