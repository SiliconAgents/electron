sub build_clock_tree {
  # build clock tree command is the wraper command that generates the list of flops and its locations in a text file
  # the text file is then given to a rest service to create the clock tree for the design. 
  # this will be a flat implementation of the design  in a Htree
  use Benchmark;
  my $t0 = new Benchmark;

  my $noOfArguments = @_;

  if($noOfArguments < 2 || $_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq '-HELP'){
     print "Usage : build_clock_tree -net <net Name>\n";
  }else{
     my $topModule = $GLOBAL->dbfGlobalGetTOP;
     my $netName;
     for(my $x = 0; $x < $noOfArguments ; $x++){
         if($_[$x] eq "-net"){$netName = $_[$x+1];}
     }#for all the arguments

     open(WRITE,">$topModule-cts-input.txt");
     if(exists $NETS_ALREADY{$netName}){
        foreach $instance (keys %{$NETS_ALREADY{$netName}}){
           if(exists $PORTS_ALREADY{$topModule}{$instance}){ 
              print WRITE "$netName PIN $NETS_ALREADY{$netName}{$instance}\n";
           }else{
              print WRITE "$netName $instance $NETS_ALREADY{$netName}{$instance}\n";
           }
         }# for each instance attached
      }else{
         print "WARN-BLD-CLKTR : 001 : net $netName does not exists\n";
      }
      close(WRITE);
      
      ########################## executing python script ############################
      system("python /apps/clktree_v3.py '$topModule-cts-input.txt'");
      &add_clock_tree("-f", "clk_tree.txt", "-net", $netName, "-buffer", "BUF_X1");
  }
  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command build_clock_tree  took:",timestr($td),"\n";
}#sub build_clock_tree

