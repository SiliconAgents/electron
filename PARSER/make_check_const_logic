#<!-- Three-valued logic, 0 1 and 2 for X, as lookup tables indexed 3*a+b. -->
@CCL_AND = (0,0,0, 0,1,2, 0,2,2);
@CCL_OR  = (0,1,2, 1,1,1, 2,1,2);
@CCL_XOR = (0,1,2, 1,0,2, 2,2,2);
@CCL_NOT = (1,0,2);

#<!-- A cell's function entry, found by name or, failing that, by the name
#     with its VT suffix dropped. -->
sub check_const_logic_func_of {
my ($cell) = @_;
return $CONST_LOGIC_FUNC{$cell} if ( exists $CONST_LOGIC_FUNC{$cell} );
( my $key = $cell ) =~ s/(ULVTLL|LVTLL|ULVT|ELVT|LVT|SVT)$//;
return $CONST_LOGIC_FUNC_BY_KEY{$key};
}# sub check_const_logic_func_of

#<!-- grep out of one liberty what a function needs, and compile it.  Each
#     entry: INS the input pins, OUT pin -> compiled function, and for a flop
#     or latch SEQ with its next state, clock or enable, clear and preset. -->
sub check_const_logic_read_liberty {
my ($lib) = @_;
unless ( -r $lib ) {
  print "ERROR-UTS-CHK_CONST : 018 : cannot read $lib\n";
  return -1;
}
my $pat = '^\s*(cell ?\(|pin ?\(|ff ?\(|latch ?\(|ff_bank|statetable|test_cell|bus ?\(|bundle ?\(|' .
          'function|next_state|clocked_on|clear|preset|data_in|enable|direction)';
my $grep = ( $lib =~ /\.gz$/ ) ? "zgrep" : "grep";
my $fh;
unless ( open($fh, "-|", $grep, "-E", $pat, $lib) ) {
  print "ERROR-UTS-CHK_CONST : 019 : cannot run $grep on $lib : $!\n";
  return -1;
}
my ($n, $cell, $cellIndent, $grp, $grpName, $grpIndent) = (0, undef, 0, "", "", 0);
my %raw = ();
my $flush = sub {
  return unless ( defined $cell );
  my $e = &check_const_logic_compile_cell($cell, $raw{$cell});
  if ( defined $e ) {
    $CONST_LOGIC_FUNC{$cell} = $e;
    ( my $key = $cell ) =~ s/(ULVTLL|LVTLL|ULVT|ELVT|LVT|SVT)$//;
    $CONST_LOGIC_FUNC_BY_KEY{$key} = $e unless ( exists $CONST_LOGIC_FUNC_BY_KEY{$key} );
    $n++;
  }
  delete $raw{$cell};
};
while ( my $line = <$fh> ) {
  $line =~ /^(\s*)/;
  my $ind = length($1);
  if ( $line =~ /^\s*cell\s*\(\s*"?([^"\)\s]+)"?\s*\)/ ) {
    $flush->();
    ($cell, $cellIndent, $grp) = ($1, -1, "");
    $raw{$cell} = { PIN => {}, DIR => {}, SEQ => undef, UNKNOWN => 0 };
    next;
  }
  next unless ( defined $cell );
  my $r = $raw{$cell};
  if ( $line =~ /^\s*(pin|ff|latch|ff_bank|statetable|test_cell|bus|bundle)\s*\(\s*([^\)]*)\)/ ) {
    my ($g, $name) = ($1, $2);
    $name =~ s/"//g; $name =~ s/^\s+|\s+$//g;
    #<!-- the cell's own groups all sit at one indent, the first one seen;
    #     anything deeper is inside test_cell -->
    $cellIndent = $ind if ( $cellIndent < 0 );
    if ( $ind > $cellIndent ) { $grp = "skip"; $grpIndent = $ind; next; }
    if ( $g eq "test_cell" ) { $grp = "skip"; $grpIndent = $ind; next; }
    if ( $g eq "ff_bank" || $g eq "statetable" || $g eq "bus" || $g eq "bundle" ) { $r->{UNKNOWN} = 1; $grp = "skip"; next; }
    ($grp, $grpName, $grpIndent) = ($g, $name, $ind);
    if ( $g eq "ff" || $g eq "latch" ) {
      my ($iq, $iqn) = split(/\s*,\s*/, $name);
      $r->{SEQ} = { TYPE => $g, IQ => $iq, IQN => $iqn };
    }
    next;
  }
  next if ( $grp eq "skip" || $grp eq "" );
  next unless ( $ind > $grpIndent );
  next unless ( $line =~ /^\s*(\w+)\s*:\s*"?([^";]*)"?\s*;/ );
  my ($attr, $value) = ($1, $2);
  if ( $grp eq "pin" ) {
    $r->{DIR}{$grpName} = $value if ( $attr eq "direction" );
    $r->{PIN}{$grpName} = $value if ( $attr eq "function" );
  } elsif ( $grp eq "ff" || $grp eq "latch" ) {
    $r->{SEQ}{$attr} = $value;
  }
}
$flush->();
close($fh);
return $n;
}# sub check_const_logic_read_liberty

sub check_const_logic_compile_cell {
my ($cell, $r) = @_;
my @ins = sort grep { $r->{DIR}{$_} eq "input" || $r->{DIR}{$_} eq "inout" } keys %{$r->{DIR}};
my @outs = sort grep { $r->{DIR}{$_} eq "output" || $r->{DIR}{$_} eq "inout" } keys %{$r->{DIR}};
return undef unless ( @outs );
my $e = { INS => \@ins, OUT => {} };
foreach my $pin ( @outs ) {
  next unless ( exists $r->{PIN}{$pin} );
  my $c = &check_const_logic_compile_expr($r->{PIN}{$pin});
  $e->{OUT}{$pin} = $c if ( defined $c );
}
my $s = $r->{SEQ};
if ( defined $s && !$r->{UNKNOWN} ) {
  my ($nsAttr, $clkAttr) = ( $s->{TYPE} eq "ff" ) ? ("next_state", "clocked_on") : ("data_in", "enable");
  my $seq = { TYPE => $s->{TYPE}, IQ => $s->{IQ}, IQN => $s->{IQN} };
  foreach my $k ( [NS => $nsAttr], [CLK => $clkAttr], [CLR => "clear"], [PRE => "preset"] ) {
    my ($slot, $attr) = @$k;
    next unless ( exists $s->{$attr} );
    $seq->{$slot} = &check_const_logic_compile_expr($s->{$attr});
    return undef unless ( defined $seq->{$slot} );
  }
  return undef unless ( defined $seq->{NS} && defined $seq->{CLK} );
  $e->{SEQ} = $seq;
} elsif ( defined $s || $r->{UNKNOWN} ) {
  #<!-- a state table or a bank of flops: the outputs are left X -->
  foreach my $pin ( keys %{$e->{OUT}} ) {
    delete $e->{OUT}{$pin} if ( grep { !exists $r->{DIR}{$_} || $r->{DIR}{$_} eq "internal" } @{$e->{OUT}{$pin}{VARS}} );
  }
}
#<!-- an output whose function names something that is not an input -- an
#     internal node of a state table -- cannot be evaluated -->
foreach my $pin ( keys %{$e->{OUT}} ) {
  my $ok = 1;
  foreach my $v ( @{$e->{OUT}{$pin}{VARS}} ) {
    next if ( defined $e->{SEQ} && ( $v eq $e->{SEQ}{IQ} || ( defined $e->{SEQ}{IQN} && $v eq $e->{SEQ}{IQN} ) ) );
    $ok = 0 unless ( exists $r->{DIR}{$v} && $r->{DIR}{$v} ne "internal" );
  }
  delete $e->{OUT}{$pin} unless ( $ok );
}
return undef unless ( keys %{$e->{OUT}} );
return $e;
}# sub check_const_logic_compile_cell

#<!-- A liberty boolean expression to a perl sub over a hash of pin values.
#     Precedence, tightest first: ! and postfix ', then ^, then & * and plain
#     juxtaposition, then | +.  Returns { SUB, VARS } or undef if it does not
#     parse. -->
sub check_const_logic_compile_expr {
my ($text) = @_;
my @tok = ( $text =~ /([A-Za-z_][\w\[\]\.]*|[01]|[!'^&*|+()])/g );
my $pos = 0;
my %vars = ();
my ($pOr, $pAnd, $pXor, $pUnary);
$pUnary = sub {
  my $t = $tok[$pos];
  return undef unless ( defined $t );
  my $code;
  if ( $t eq "!" ) { $pos++; my $c = $pUnary->(); return undef unless ( defined $c ); $code = "\$CCL_NOT[$c]"; }
  elsif ( $t eq "(" ) { $pos++; $code = $pOr->(); return undef unless ( defined $code && defined $tok[$pos] && $tok[$pos] eq ")" ); $pos++; }
  elsif ( $t eq "0" || $t eq "1" ) { $pos++; $code = $t; }
  elsif ( $t =~ /^[A-Za-z_]/ ) { $pos++; $vars{$t} = 1; $code = "(\$v->{'$t'} // 2)"; }
  else { return undef; }
  while ( defined $tok[$pos] && $tok[$pos] eq "'" ) { $pos++; $code = "\$CCL_NOT[$code]"; }
  return $code;
};
$pXor = sub {
  my $a = $pUnary->(); return undef unless ( defined $a );
  while ( defined $tok[$pos] && $tok[$pos] eq "^" ) { $pos++; my $b = $pUnary->(); return undef unless ( defined $b ); $a = "\$CCL_XOR[3*($a)+($b)]"; }
  return $a;
};
$pAnd = sub {
  my $a = $pXor->(); return undef unless ( defined $a );
  while ( defined $tok[$pos] && $tok[$pos] =~ /^([&*!(01]|[A-Za-z_].*)$/ ) {
    $pos++ if ( $tok[$pos] eq "&" || $tok[$pos] eq "*" );
    my $b = $pXor->(); return undef unless ( defined $b );
    $a = "\$CCL_AND[3*($a)+($b)]";
  }
  return $a;
};
$pOr = sub {
  my $a = $pAnd->(); return undef unless ( defined $a );
  while ( defined $tok[$pos] && ( $tok[$pos] eq "|" || $tok[$pos] eq "+" ) ) { $pos++; my $b = $pAnd->(); return undef unless ( defined $b ); $a = "\$CCL_OR[3*($a)+($b)]"; }
  return $a;
};
my $code = $pOr->();
return undef unless ( defined $code && $pos == @tok );
my $sub = eval "sub { my \$v = shift; return $code; }";
return undef unless ( defined $sub );
return { SUB => $sub, VARS => [ sort keys %vars ], TEXT => $text };
}# sub check_const_logic_compile_expr

#<!-- One function under a pin assignment, exactly when it is cheap: Kleene
#     first, and if that says X while some input is known and at most four of
#     its inputs are not, every completion of the unknown ones. -->
sub check_const_logic_eval {
my ($c, $v) = @_;
my $r = $c->{SUB}->($v);
return $r unless ( $r == 2 );
my @x = grep { ( $v->{$_} // 2 ) == 2 } @{$c->{VARS}};
return 2 if ( @x == 0 || @x > 4 || @x == @{$c->{VARS}} );
my %w = %$v;
my $first;
for ( my $m = 0 ; $m < ( 1 << @x ) ; $m++ ) {
  for ( my $k = 0 ; $k < @x ; $k++ ) { $w{$x[$k]} = ( $m >> $k ) & 1; }
  my $o = $c->{SUB}->(\%w);
  $first = $o unless ( defined $first );
  return 2 if ( $o != $first );
}
return $first;
}# sub check_const_logic_eval

#<!-- Every output of one instance, given its input values.  For a flop the
#     reason it is constant goes back through $$reason; $force sets the value
#     a flop is assumed to hold instead. -->
sub check_const_logic_eval_cell {
my ($f, $v, $reason, $force) = @_;
my %out = ();
my $s = $f->{SEQ};
if ( defined $s && defined $force ) {
  my %w = %$v; $w{$s->{IQ}} = $force; $w{$s->{IQN}} = 1 - $force if ( defined $s->{IQN} );
  foreach my $pin ( keys %{$f->{OUT}} ) { $out{$pin} = &check_const_logic_eval($f->{OUT}{$pin}, \%w); }
  return %out;
}
if ( defined $s ) {
  my ($iq, $iqn) = ($s->{IQ}, $s->{IQN});
  my $at = sub { my ($q) = @_; my %w = %$v; $w{$iq} = $q; $w{$iqn} = ( $q == 2 ) ? 2 : 1 - $q if ( defined $iqn ); return \%w; };
  my $clr = defined $s->{CLR} ? &check_const_logic_eval($s->{CLR}, $at->(2)) : 0;
  my $pre = defined $s->{PRE} ? &check_const_logic_eval($s->{PRE}, $at->(2)) : 0;
  my $clk = &check_const_logic_eval($s->{CLK}, $at->(2));
  #<!-- a flop's clock that never moves, or a latch's enable tied shut, never
  #     loads; a latch enable tied open still does -->
  my $frozen = ( $s->{TYPE} eq "ff" ) ? ( $clk != 2 ) : ( $clk == 0 );
  my $q = 2;
  my $ns = $frozen ? 2 : &check_const_logic_eval($s->{NS}, $at->(2));
  if ( $ns != 2 && ( $ns == 0 ? $pre == 0 : $clr == 0 ) ) {
    $q = $ns; $$reason = "$q D=$q";
  } else {
    #<!-- hold: once it has c it keeps c.  It gets c from a reset that can
    #     fire, or, when no reset can, from power-up: a flop with no reset
    #     starts as x and synthesis may pick its value, which is what removes
    #     a register whose D is tied but whose enable is not. -->
    my $noReset = ( $clr == 0 && $pre == 0 );
    my @holds = ();
    foreach my $c ( 0, 1 ) {
      my $fights = ( $c == 0 ) ? $pre : $clr;
      next unless ( $fights == 0 );
      push(@holds, $c) if ( $frozen || &check_const_logic_eval($s->{NS}, $at->($c)) == $c );
    }
    foreach my $c ( @holds ) {
      my $sets = ( $c == 0 ) ? $clr : $pre;
      if ( $sets != 0 ) { $q = $c; $$reason = "$q holds-reset"; last; }
    }
    if ( $q == 2 && $noReset && @holds && $CONST_LOGIC_POWERUP ) {
      $q = $holds[0];
      $$reason = ( @holds == 2 ) ? "$q never-loaded" : "$q holds-powerup";
    }
  }
  my $w = $at->($q);
  foreach my $pin ( keys %{$f->{OUT}} ) { $out{$pin} = &check_const_logic_eval($f->{OUT}{$pin}, $w); }
  return %out;
}
foreach my $pin ( keys %{$f->{OUT}} ) { $out{$pin} = &check_const_logic_eval($f->{OUT}{$pin}, $v); }
return %out;
}# sub check_const_logic_eval_cell
