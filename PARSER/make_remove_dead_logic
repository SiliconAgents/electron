#<!-- remove_dead_logic: take out of the flat database what check_dead_logic
#     and check_const_logic found.
#
#     It runs both checks itself, with the same dont_touch set, so what it
#     removes is exactly what they report -- a stale %DEAD_LOGIC from an
#     earlier run, or one taken with a different keep list, would otherwise
#     remove the wrong things.  Flat database only: %CADB, %COMP_ALREADY,
#     %NETS_ALREADY and %NADB, the stores elaborate fills and that the flat
#     flow (set_floorplan, place_flat_design, legalize_flat, write_def,
#     write_verilog --flat) reads.  %MODULE_ALREADY, the hierarchical view,
#     is not touched.
#
#     What goes:
#       every dead instance (no path to a top output, a macro, or a
#       dont_touch cell)
#       with -const, every cell whose outputs are all constant, and every
#       cell whose only use was one of those.  Reset-backed constants only;
#       -powerup adds the flops whose constancy rests on choosing a no-reset
#       flop's power-up value (holds-powerup, never-loaded).
#
#     A constant net that still has loads once its driver is gone is driven
#     by a tie cell, $GLOBAL's tie high / tie low (set_tie_cells, or the
#     config's cell-func-map), named bt_const_tie_<n> in the removed
#     driver's hierarchy; ties are shared, -tie_fanout loads each.  With no tie cell configured the
#     command refuses rather than leave inputs floating; --no_tie ties the
#     load pins to 1'b0 / 1'b1 instead, as electron already does for a
#     scalar tie-off when the library has none.
#
#     Nets left with no pin at all are deleted, from %NETS_ALREADY and %NADB
#     together (write_def reads one under a guard on the other), and from
#     %NETS_ROUTING_ALREADY.  A net still on a top port stays.
#
#     Run it after elaborate (or hier2flat) and before placement. -->
#------------------------------------------------------------------------------------------#
sub remove_dead_logic {

my ($doConst, $powerup, $dry, $noTie, $hier) = (0, 0, 0, 0, 0);
my $tieFanout = 20;
my $report = "";
my @libs = ();
my @keepArgs = ();

my $noOfArguments = @_;
if ( $noOfArguments > 0 && $_[0] eq '-h' ) {
  print "Usage : remove_dead_logic [-const] [-powerup] [-liberty <lib>[,<lib>...]] [-report <file>]\n";
  print "                          [-keep_pattern <regex>] [-dont_touch <file>] [--no_keep]\n";
  print "                          [-dry_run] [-tie_fanout <n>] [--no_tie] [-hier]\n";
  print "        Removes from the flat database every cell and flop check_dead_logic\n";
  print "        calls dead and, with -const, every cell check_const_logic folds and\n";
  print "        whatever dies with them.  Both checks are run here, with the same\n";
  print "        dont_touch set.  Before placement, after elaborate or hier2flat.\n";
  print "        -const    also remove constant logic (reset-backed constants only)\n";
  print "        -powerup  with -const, also the flops that are constant only for a\n";
  print "                  chosen power-up value (no-reset flops)\n";
  print "        -liberty  cell functions for -const (default: the config's synthesis libs)\n";
  print "        -report   write every removed instance and every tie cell added\n";
  print "        -dry_run  report what would be removed, change nothing\n";
  print "        -tie_fanout  load pins per tie cell, shared within one hierarchy (default 20;\n";
  print "                  0 = one tie per constant net)\n";
  print "        -hier     edit the hierarchical netlist too, per module definition: a\n";
  print "                  cell goes only where it is removable in every instance of its\n";
  print "                  module, so write_verilog --hier writes a netlist hier_place reads\n";
  print "        --no_tie  tie the loads of a constant net to 1'b0/1'b1 instead of adding\n";
  print "                  tie cells (they are left off any net in the DEF)\n";
  &check_dead_logic_keep_usage;
  return;
}
for(my $i = 0; $i < $noOfArguments; $i++){
  if($_[$i] eq "-const"){$doConst = 1;}
  if($_[$i] eq "-powerup"){$powerup = 1;}
  if($_[$i] eq "-liberty"){push(@libs, $_[$i+1]);}
  if($_[$i] eq "-report"){$report = $_[$i+1];}
  if($_[$i] eq "-dry_run"){$dry = 1;}
  if($_[$i] eq "--no_tie"){$noTie = 1;}
  if($_[$i] eq "-hier"){$hier = 1;}
  if($_[$i] eq "-tie_fanout"){$tieFanout = $_[$i+1];}
  if($_[$i] eq "-keep_pattern" || $_[$i] eq "-dont_touch"){push(@keepArgs, $_[$i], $_[$i+1]);}
  if($_[$i] eq "--no_keep"){push(@keepArgs, $_[$i]);}
}#for

unless ( keys %COMP_ALREADY ) {
  print "ERROR-UTS-RM_DEAD : 001 : no instances in the flat database; read a netlist and elaborate first\n";
  return;
}
if ( $powerup && !$doConst ) {
  print "WARN-UTS-RM_DEAD : 002 : -powerup only matters with -const; ignoring it\n";
}

#<!-- tie cells, checked before anything is changed -->
my ($tieHi, $tieLo) = ($GLOBAL->dbfGlobalGetTieHighCell, $GLOBAL->dbfGlobalGetTieLowCell);
$tieHi = "" unless ( defined $tieHi );
$tieLo = "" unless ( defined $tieLo );
my ($tieHiOut, $tieLoOut) = ("", "");
$tieHiOut = &dbfVerilogGetCellSingleOutputPin($tieHi) if ( $tieHi ne "" );
$tieLoOut = &dbfVerilogGetCellSingleOutputPin($tieLo) if ( $tieLo ne "" );
if ( $doConst && !$noTie && !$dry && ( $tieHiOut eq "" || $tieLoOut eq "" ) ) {
  print "ERROR-UTS-RM_DEAD : 003 : -const needs a tie high and a tie low cell (have \"$tieHi\" / \"$tieLo\");\n";
  print "ERROR-UTS-RM_DEAD : 003 :   give them a tie_high / tie_low function in the cell-func-map, or set_tie_cells,\n";
  print "ERROR-UTS-RM_DEAD : 003 :   or pass --no_tie to tie the load pins to constants instead\n";
  return;
}

use Benchmark;
my $t0 = new Benchmark;

#<!-- the checks, with the same dont_touch set -->
&check_dead_logic(@keepArgs);
my %dead = %{ $DEAD_LOGIC{INST} || {} };
my (%fold, %newDead, %val, %flopWhy) = ();
if ( $doConst ) {
  my @cArgs = @keepArgs;
  push(@cArgs, "-liberty", join(",", @libs)) if ( @libs );
  push(@cArgs, "-reset_only") unless ( $powerup );
  &check_const_logic(@cArgs);
  unless ( exists $CONST_LOGIC{SUMMARY} ) {
    print "ERROR-UTS-RM_DEAD : 004 : check_const_logic did not run; nothing removed\n";
    return;
  }
  %fold = %{ $CONST_LOGIC{FOLD} || {} };
  %newDead = %{ $CONST_LOGIC{NEW_DEAD} || {} };
  %val = %{ $CONST_LOGIC{NET} || {} };
  %flopWhy = %{ $CONST_LOGIC{FLOP} || {} };
}

my %why = ();
$why{$_} = "dead" foreach ( keys %dead );
foreach my $inst ( keys %fold ) {
  next if ( exists $why{$inst} );
  $why{$inst} = exists $flopWhy{$inst} ? "const-flop:$flopWhy{$inst}" : "const";
}
foreach my $inst ( keys %newDead ) { $why{$inst} = "dead-after-fold" unless ( exists $why{$inst} ); }
my $nFlop = 0;
foreach my $inst ( keys %why ) {
  my $cell = exists $CADB{$inst} ? $CADB{$inst}->dbCadbGetCellref : "";
  $nFlop++ if ( exists $PLDB{$cell} && $PLDB{$cell}->dbMdbGetType == 1 );
}

if ( $hier ) {
  if ( $noTie ) {
    print "ERROR-UTS-RM_DEAD : 012 : -hier needs tie cells; --no_tie is not supported with it\n";
    return;
  }
  &remove_dead_logic_hier(\%why, \%val, $tieFanout, $dry, $report, [$tieHi, $tieHiOut, $tieLo, $tieLoOut]);
  %DEAD_LOGIC = ();
  %CONST_LOGIC = ();
  my $t1 = new Benchmark;
  print "Command remove_dead_logic took:", timestr(timediff($t1, $t0)), "\n";
  return;
}

#<!-- the constant nets that will need a driver: a folded cell's outputs,
#     wherever a pin that stays still reads them -->
my @ties = ();          # [net, value, hierarchy of the removed driver]
foreach my $inst ( sort keys %fold ) {
  next unless ( exists $COMP_ALREADY{$inst} );
  my $cell = $CADB{$inst}->dbCadbGetCellref;
  foreach my $pin ( sort keys %{$COMP_ALREADY{$inst}} ) {
    my $net = $COMP_ALREADY{$inst}{$pin};
    next unless ( defined $net && exists $val{$net} );
    next unless ( exists $PLDB{$cell} && $PLDB{$cell}->dbMdbGetPinDir($pin) == 1 );
    my $stays = 0;
    foreach my $m ( keys %{$NETS_ALREADY{$net} || {}} ) {
      next if ( $m eq $inst || exists $why{$m} );
      $stays = 1; last;
    }
    next unless ( $stays );
    ( my $hier = $inst ) =~ s{/?[^/]*$}{};
    push(@ties, [$net, $val{$net}, $hier]);
  }
}

my %byWhy = ();
foreach my $inst ( keys %why ) { ( my $w = $why{$inst} ) =~ s/:.*//; $byWhy{$w}++; }
my $nAll = scalar(keys %why);
print "INFO-UTS-RM_DEAD : 005 : " . ( $dry ? "would remove" : "removing" ) . " $nAll instance(s), $nFlop of them flops: " .
      join(", ", map { "$byWhy{$_} $_" } sort keys %byWhy) . "\n";
print "INFO-UTS-RM_DEAD : 006 : " . scalar(@ties) . " constant net(s) still read by what stays: " .
      ( $noTie ? "loads tied to 1'b0/1'b1" : ( $tieFanout > 0 ? "tie cells shared per hierarchy, up to $tieFanout loads each" : "one tie cell each" ) ) . "\n";

my $fh;
if ( $report ne "" ) {
  unless ( open($fh, ">", $report) ) {
    print "ERROR-UTS-RM_DEAD : 007 : cannot write $report : $!\n";
    return;
  }
  print $fh "# remove_dead_logic on $TOP_MODULE" . ( $dry ? " (dry run)" : "" ) . "\n";
  print $fh "# removed <instance> <cell> <reason>\n# tie <instance> <cell> <net> <value>\n";
  foreach my $inst ( sort keys %why ) {
    print $fh "removed $inst " . $CADB{$inst}->dbCadbGetCellref . " $why{$inst}\n" if ( exists $CADB{$inst} );
  }
}
if ( $dry ) {
  close($fh) if ( defined $fh );
  print "INFO-UTS-RM_DEAD : 008 : dry run, the database is unchanged\n";
  return;
}

#<!-- take the instances out -->
my %touched = ();
foreach my $inst ( keys %why ) {
  next unless ( exists $COMP_ALREADY{$inst} );
  foreach my $pin ( keys %{$COMP_ALREADY{$inst}} ) {
    my $net = $COMP_ALREADY{$inst}{$pin};
    next unless ( defined $net && exists $NETS_ALREADY{$net} );
    delete $NETS_ALREADY{$net}{$inst};
    $touched{$net} = 1;
  }
  delete $COMP_ALREADY{$inst};
  delete $CADB{$inst};
}

#<!-- drive the constant nets that still have loads.  One tie cell per net
#     would be one per folded driver -- 107,598 on a 2M-instance design --
#     so the load pins of every constant net of one value in one hierarchy
#     are packed onto shared tie nets, at most -tie_fanout pins on each
#     (default 20; 0 keeps one tie per original net).  Loads are taken in
#     instance-name order, which keeps a tie's pins in one corner of the
#     hierarchy.  A net that reaches a top port keeps its own name, since the
#     port refers to it by name, and gets a tie of its own. -->
my ($nTie, $nTiedPins, $nMerged) = (0, 0, 0);
my $seq = 0;
my $newTie = sub {
  my ($hier, $v, $net) = @_;
  my ($cell, $out) = $v ? ($tieHi, $tieHiOut) : ($tieLo, $tieLoOut);
  my $name;
  do { $name = ( $hier ne "" ? "$hier/" : "" ) . "bt_const_tie_" . $seq++; } while ( exists $COMP_ALREADY{$name} );
  $net = $name . "_net" unless ( defined $net );
  $CADB{$name} = CompAttDB::new();
  $CADB{$name}->dbCadbSetCellref($cell);
  $COMP_ALREADY{$name}{$out} = $net;
  unless ( exists $NETS_ALREADY{$net} ) {
    $NADB{$net} = NetsAttrDB::new();
    $NADB{$net}->dbNadbSetNetType(0);
  }
  $NETS_ALREADY{$net}{$name} = $out;
  $nTie++;
  print $fh "tie $name $cell $net $v\n" if ( defined $fh );
  return $net;
};
my %group = ();         # "hier\tvalue" -> [ [inst, pin], ... ]
foreach my $t ( @ties ) {
  my ($net, $v, $hier) = @$t;
  next unless ( exists $NETS_ALREADY{$net} && keys %{$NETS_ALREADY{$net}} );
  my @loads = sort grep { exists $COMP_ALREADY{$_} } keys %{$NETS_ALREADY{$net}};
  my $onPort = scalar(grep { !exists $COMP_ALREADY{$_} } keys %{$NETS_ALREADY{$net}});
  if ( $noTie ) {
    my $c = $v ? "1'b1" : "1'b0";
    foreach my $m ( @loads ) {
      foreach my $pin ( keys %{$COMP_ALREADY{$m}} ) {
        next unless ( $COMP_ALREADY{$m}{$pin} eq $net );
        $COMP_ALREADY{$m}{$pin} = $c; $nTiedPins++;
      }
      delete $NETS_ALREADY{$net}{$m};
    }
    next;
  }
  if ( $onPort || $tieFanout <= 0 ) {
    $newTie->($hier, $v, $net);
    next;
  }
  #<!-- every pin, not only the one %NETS_ALREADY keeps per instance -->
  foreach my $m ( @loads ) {
    foreach my $pin ( sort keys %{$COMP_ALREADY{$m}} ) {
      push(@{$group{"$hier\t$v"}}, [$m, $pin]) if ( $COMP_ALREADY{$m}{$pin} eq $net );
    }
    delete $NETS_ALREADY{$net}{$m};
  }
  $nMerged++;
}
foreach my $key ( sort keys %group ) {
  my ($hier, $v) = split(/\t/, $key);
  my @pins = sort { $a->[0] cmp $b->[0] || $a->[1] cmp $b->[1] } @{$group{$key}};
  for ( my $k = 0 ; $k < @pins ; $k += $tieFanout ) {
    my $net = $newTie->($hier, $v, undef);
    foreach my $lp ( @pins[$k .. ( $k + $tieFanout - 1 < $#pins ? $k + $tieFanout - 1 : $#pins )] ) {
      my ($m, $pin) = @$lp;
      $COMP_ALREADY{$m}{$pin} = $net;
      $NETS_ALREADY{$net}{$m} = $pin;
    }
  }
}

#<!-- nets with nothing left on them -->
my $nNetGone = 0;
foreach my $net ( keys %touched ) {
  next unless ( exists $NETS_ALREADY{$net} );
  next if ( keys %{$NETS_ALREADY{$net}} );
  delete $NETS_ALREADY{$net};
  delete $NADB{$net};
  delete $NETS_ROUTING_ALREADY{$net} if ( exists $NETS_ROUTING_ALREADY{$net} );
  $nNetGone++;
}
close($fh) if ( defined $fh );

#<!-- what the checks found is gone; their results describe a netlist that
#     no longer exists -->
%DEAD_LOGIC = ();
%CONST_LOGIC = ();

print "INFO-UTS-RM_DEAD : 009 : removed $nAll instance(s); added $nTie tie cell(s)" .
      ( $nMerged ? " for $nMerged constant net(s)" : "" ) .
      ( $nTiedPins ? ", tied $nTiedPins pin(s) to constants" : "" ) . "; deleted $nNetGone net(s) left empty\n";
print "INFO-UTS-RM_DEAD : 010 : " . scalar(keys %COMP_ALREADY) . " instance(s) and " . scalar(keys %NETS_ALREADY) . " net(s) remain\n";
print "INFO-UTS-RM_DEAD : 011 : report written to $report\n" if ( $report ne "" );

my $t1 = new Benchmark;
print "Command remove_dead_logic took:", timestr(timediff($t1, $t0)), "\n";
return;

}# sub remove_dead_logic
#------------------------------------------------------------------------------------------#

#<!-- remove_dead_logic -hier: the same removal, applied to the hierarchical
#     netlist (%MODULE_ALREADY) as well as to the flat database, so that
#     write_verilog --hier writes something hier_place can read.
#
#     A module definition is shared by its instances, so a cell can only be
#     taken out of it where it is removable in EVERY instance.  On a 2M-instance
#     design that is 96.0% of the cells the flat removal takes;
#     the rest stays.  Taking a subset of a removal is not automatically safe:
#     a cell that stays may still read one that goes.  So the set is closed:
#     whenever a cell that stays reads the output of one that goes, the net
#     has to be constant, with the same value, in every instance of the
#     reader's module -- then the reader's pin is moved onto a tie net in its
#     own module -- or the driver stays too.  Repeat until nothing changes.
#     A top output port read off a removed driver gets its own tie the same
#     way.  Nothing that stays is left undriven.
#
#     The same plan is then applied to both views: per module, the removed
#     cells' connection lines and leaf entries go, readers are rewired, tie
#     cells are added (shared, -tie_fanout pins each, named bt_const_tie_<n>
#     on bt_const_tie_<n>_net) and the module area follows; per instance of
#     that module, the flat database gets exactly the same edits under the
#     instance's path.  The two cannot drift. -->
sub remove_dead_logic_hier {
my ($why, $val, $tieFanout, $dry, $report, $tie) = @_;
my ($tieHi, $tieHiOut, $tieLo, $tieLoOut) = @$tie;

#<!-- where each module is instantiated, by the path elaborate gives the flat
#     instances under it -->
my (%pathMod, %modPaths) = ();
my $walk;
$walk = sub {
  my ($m, $p) = @_;
  $pathMod{$p} = $m;
  push(@{$modPaths{$m}}, $p);
  foreach my $h ( sort $MODULE_ALREADY{$m}->dbVNOMGetHierInst ) {
    my $c = $MODULE_ALREADY{$m}->dbVNOMGetHierInstCell($h);
    next unless ( exists $MODULE_ALREADY{$c} );
    next if ( $MODULE_ALREADY{$c}->dbVNOMGetClass == 11 );     # a blackbox is a leaf
    $walk->($c, ( $p eq "" ? $h : "$p/$h" ));
  }
};
$walk->($TOP_MODULE, "");
my $split = sub {
  my ($inst) = @_;
  my ($p, $l) = ( $inst =~ m{^(.*)/([^/]+)$} ) ? ($1, $2) : ("", $inst);
  return () unless ( exists $pathMod{$p} && $MODULE_ALREADY{$pathMod{$p}}->dbVNOMHasLeafInst($l) );
  return ($pathMod{$p}, $p, $l);
};

#<!-- candidates: removable in every instance of the module -->
my %count = ();
foreach my $inst ( keys %$why ) {
  my ($m, $p, $l) = $split->($inst);
  next unless ( defined $m );
  $count{$m}{$l}++;
}
my %U = ();
my $nCand = 0;
foreach my $m ( keys %count ) {
  foreach my $l ( keys %{$count{$m}} ) {
    if ( $count{$m}{$l} == scalar(@{$modPaths{$m}}) ) { $U{$m}{$l} = 1; $nCand++; }
  }
}

#<!-- the flat connectivity the closure walks -->
my (%readers, %outNets) = ();
foreach my $inst ( keys %COMP_ALREADY ) {
  my $cell = exists $CADB{$inst} ? $CADB{$inst}->dbCadbGetCellref : "";
  my $mdb = $PLDB{$cell};
  foreach my $pin ( keys %{$COMP_ALREADY{$inst}} ) {
    my $net = $COMP_ALREADY{$inst}{$pin};
    next if ( !defined $net || $net eq "" || $net =~ /^1'b[01]$/ );
    my $dir = defined $mdb ? $mdb->dbMdbGetPinDir($pin) : 2;
    next if ( $dir eq "" );
    push(@{$readers{$net}}, [$inst, $pin]) if ( $dir == 0 || $dir == 2 );
    push(@{$outNets{$inst}}, $net) if ( $dir == 1 || $dir == 2 );
  }
}
my %outPort = ();
foreach my $port ( keys %{$PORTS_ALREADY{$TOP_MODULE}} ) {
  my $dir = $PORTS_ALREADY{$TOP_MODULE}{$port}->dbPortGetDir;
  next unless ( $dir eq "output" || $dir eq "inout" );
  my @conn = $PORTS_ALREADY{$TOP_MODULE}{$port}->dbPortGetConn;
  $outPort{$conn[0]} = 1 if ( @conn && defined $conn[0] && $conn[0] ne "" );
}
my $gone = sub {
  my ($inst) = @_;
  my ($m, $p, $l) = $split->($inst);
  return ( defined $m && exists $U{$m}{$l} ) ? 1 : 0;
};

#<!-- The closure.  The first pass looks at every removed driver; after that
#     only the cells just kept can have created a conflict -- by reading a
#     removed driver -- so each round looks only at the removed drivers of
#     the nets those cells read.  A full pass at the end recomputes the ties
#     from scratch and confirms nothing was missed (if it finds a conflict
#     after all, the rounds go on).  From scratch every round cost a full pass
#     per round, 27 of them on a 2M-instance design. -->
my %inNetsOf = ();
foreach my $n ( keys %readers ) {
  foreach my $rp ( @{$readers{$n}} ) { push(@{$inNetsOf{$rp->[0]}}, $n); }
}
my %driverOf = ();
foreach my $d ( keys %outNets ) { $driverOf{$_} = $d foreach ( @{$outNets{$d}} ); }
my $scan = sub {
  my ($drivers) = @_;
  my (%drop, %rq, %reqDrv, %pt) = ();
  foreach my $d ( @$drivers ) {
    next unless ( $gone->($d) );
    my ($dm, $dp, $dl) = $split->($d);
    foreach my $n ( @{$outNets{$d} || []} ) {
      foreach my $rp ( @{$readers{$n} || []} ) {
        my ($r, $pin) = @$rp;
        next if ( $gone->($r) );
        my ($rm, $rpath, $rl) = $split->($r);
        if ( exists $val->{$n} && defined $rm && $pin !~ /\[/ ) {
          my $k = "$rm\t$rl\t$pin";
          $rq{$k} = 1;
          push(@{$reqDrv{$k}}, "$dm\t$dl");
        } else {
          $drop{"$dm\t$dl"} = 1;
        }
      }
      if ( $outPort{$n} ) {
        if ( exists $val->{$n} ) { $pt{$n} = $val->{$n}; } else { $drop{"$dm\t$dl"} = 1; }
      }
    }
  }
  #<!-- a rewired pin has to see one constant in every instance of its module -->
  foreach my $k ( keys %rq ) {
    my ($rm, $rl, $pin) = split(/\t/, $k);
    my %vals = ();
    foreach my $p ( @{$modPaths{$rm}} ) {
      my $fi = ( $p eq "" ) ? $rl : "$p/$rl";
      my $n = exists $COMP_ALREADY{$fi} ? $COMP_ALREADY{$fi}{$pin} : undef;
      my $v = ( defined $n && exists $val->{$n} ) ? $val->{$n} : ( defined $n && $n =~ /^1'b([01])$/ ? $1 : "X" );
      $vals{$v} = 1;
    }
    if ( keys %vals == 1 && !exists $vals{X} ) { $rq{$k} = ( keys %vals )[0]; }
    else { $drop{$_} = 1 foreach ( @{$reqDrv{$k}} ); }
  }
  return (\%drop, \%rq, \%pt);
};
my ($round, %req, %portTie) = (0);
my @next = keys %outNets;
my $full = 1;
while ( 1 ) {
  $round++;
  my ($drop, $rq, $pt) = $scan->(\@next);
  if ( !%$drop ) {
    if ( $full ) { %req = %$rq; %portTie = %$pt; last; }
    @next = keys %outNets; $full = 1;           # converged: one full pass to confirm
    next;
  }
  my @kept = ();
  foreach my $ml ( keys %$drop ) {
    my ($m, $l) = split(/\t/, $ml);
    delete $U{$m}{$l};
    foreach my $p ( @{$modPaths{$m}} ) { push(@kept, ( $p eq "" ) ? $l : "$p/$l"); }
  }
  my %nx = ();
  foreach my $k ( @kept ) {
    foreach my $n ( @{$inNetsOf{$k} || []} ) {
      my $d = $driverOf{$n};
      $nx{$d} = 1 if ( defined $d && $gone->($d) );
    }
  }
  @next = keys %nx; $full = 0;
  print "INFO-UTS-RM_DEAD : 013 : closure round $round: " . scalar(keys %$drop) . " cell(s) kept so that nothing that stays loses its driver\n";
}

#<!-- the plan, per module: what goes, and the ties for what stays -->
my ($nModLeaf, $nTieMod, $nModEdited) = (0, 0, 0);
my %plan = ();          # M -> { GONE => {L}, TIES => [[name, net, value, [[L,pin],...]], ...] }
my %reqByMod = ();
foreach my $k ( keys %req ) {
  my ($rm, $rl, $pin) = split(/\t/, $k);
  push(@{$reqByMod{$rm}{$req{$k}}}, [$rl, $pin]);
}
foreach my $m ( keys %U ) { $plan{$m}{GONE} = $U{$m}; $nModLeaf += scalar(keys %{$U{$m}}); }
foreach my $m ( keys %reqByMod ) {
  my $seq = 0;
  foreach my $v ( sort keys %{$reqByMod{$m}} ) {
    my @pins = sort { $a->[0] cmp $b->[0] || $a->[1] cmp $b->[1] } @{$reqByMod{$m}{$v}};
    my $fan = ( $tieFanout > 0 ) ? $tieFanout : scalar(@pins);
    for ( my $i = 0 ; $i < @pins ; $i += $fan ) {
      my $name;
      do { $name = "bt_const_tie_" . $seq++; } while ( $MODULE_ALREADY{$m}->dbVNOMHasLeafInst($name) || $MODULE_ALREADY{$m}->dbVNOMHasHierInst($name) );
      push(@{$plan{$m}{TIES}}, [$name, "${name}_net", $v, [ @pins[$i .. ( $i + $fan - 1 < $#pins ? $i + $fan - 1 : $#pins )] ]]);
      $nTieMod++;
    }
  }
}
foreach my $n ( sort keys %portTie ) {
  my $seq = 0; my $name;
  do { $name = "bt_const_tie_port_" . $seq++; } while ( $MODULE_ALREADY{$TOP_MODULE}->dbVNOMHasLeafInst($name) || grep { $_->[0] eq $name } @{$plan{$TOP_MODULE}{TIES} || []} );
  push(@{$plan{$TOP_MODULE}{TIES}}, [$name, $n, $portTie{$n}, []]);
  $nTieMod++;
}

#<!-- what that is in the flat database -->
my ($nFlatGone, $nFlatTie, $nFlatFlop) = (0, 0, 0);
foreach my $m ( keys %plan ) {
  my $np = scalar(@{$modPaths{$m}});
  $nFlatGone += $np * scalar(keys %{$plan{$m}{GONE} || {}});
  $nFlatTie  += $np * scalar(@{$plan{$m}{TIES} || []});
  foreach my $l ( keys %{$plan{$m}{GONE} || {}} ) {
    my $c = $MODULE_ALREADY{$m}->dbVNOMGetLeafInstCell($l);
    $nFlatFlop += $np if ( exists $PLDB{$c} && $PLDB{$c}->dbMdbGetType == 1 );
  }
}
my $nFlatRemovable = scalar(keys %$why);
printf "INFO-UTS-RM_DEAD : 014 : per module: %d cell(s) in %d module(s) go, %d of the %d the flat removal takes (%.1f%%); %d of them flops\n",
       $nFlatGone, scalar(grep { %{$plan{$_}{GONE} || {}} } keys %plan), $nFlatGone, $nFlatRemovable,
       $nFlatRemovable ? 100 * $nFlatGone / $nFlatRemovable : 0, $nFlatFlop;
print "INFO-UTS-RM_DEAD : 015 : $nTieMod tie cell(s) in the module definitions, $nFlatTie in the flat database; " . scalar(keys %portTie) . " on top output ports\n";

my $fh;
if ( $report ne "" ) {
  if ( open($fh, ">", $report) ) {
    print $fh "# remove_dead_logic -hier on $TOP_MODULE" . ( $dry ? " (dry run)" : "" ) . "\n";
    print $fh "# module <module> removed <leaf> <cell>\n# module <module> tie <name> <cell> <net> <value> <loads>\n";
    foreach my $m ( sort keys %plan ) {
      foreach my $l ( sort keys %{$plan{$m}{GONE} || {}} ) {
        print $fh "module $m removed $l " . $MODULE_ALREADY{$m}->dbVNOMGetLeafInstCell($l) . "\n";
      }
      foreach my $t ( @{$plan{$m}{TIES} || []} ) {
        print $fh "module $m tie $t->[0] " . ( $t->[2] ? $tieHi : $tieLo ) . " $t->[1] $t->[2] " . scalar(@{$t->[3]}) . "\n";
      }
    }
  } else {
    print "ERROR-UTS-RM_DEAD : 007 : cannot write $report : $!\n";
    return;
  }
}
if ( $dry ) {
  close($fh) if ( defined $fh );
  print "INFO-UTS-RM_DEAD : 008 : dry run, the database is unchanged\n";
  return;
}

#<!-- apply: module definitions -->
my $nBefore = scalar(keys %COMP_ALREADY);
foreach my $m ( sort keys %plan ) {
  my $mod = $MODULE_ALREADY{$m};
  my $gone = $plan{$m}{GONE} || {};
  my %rewire = ();      # leaf -> pin -> net
  foreach my $t ( @{$plan{$m}{TIES} || []} ) {
    foreach my $lp ( @{$t->[3]} ) { $rewire{$lp->[0]}{$lp->[1]} = $t->[1]; }
  }
  my @keep = ();
  my $area = $mod->dbVNOMGetArea;
  foreach my $line ( $mod->dbVNOMGetConn ) {
    my ($cell, $inst) = ( split(/\s+/, $line) )[0, 1];
    if ( defined $inst && exists $gone->{$inst} ) {
      my @size = exists $PLDB{$cell} ? $PLDB{$cell}->dbMdbGetSize : (0, 0);
      $area -= $size[0] * $size[1];
      next;
    }
    if ( defined $inst && exists $rewire{$inst} ) {
      foreach my $pin ( keys %{$rewire{$inst}} ) {
        my $new = $rewire{$inst}{$pin};
        $line =~ s/\.\Q$pin\E\s*\(\s*[^()]*?\s*\)/.$pin($new)/;
      }
    }
    push(@keep, $line);
  }
  foreach my $t ( @{$plan{$m}{TIES} || []} ) {
    my ($name, $net, $v) = @$t;
    my ($cell, $out) = $v ? ($tieHi, $tieHiOut) : ($tieLo, $tieLoOut);
    push(@keep, "$cell $name (.$out($net)) ;");
    $mod->dbVNOMAddLeafInst($name);
    $mod->dbVNOMSetLeafInstCell($name, $cell);
    my @size = exists $PLDB{$cell} ? $PLDB{$cell}->dbMdbGetSize : (0, 0);
    $area += $size[0] * $size[1];
  }
  $mod->{conn} = \@keep;
  delete ${$mod->{Lchild}}{$_} foreach ( keys %$gone );
  $mod->dbVNOMSetArea($area);
  $nModEdited++;
}
#<!-- cached hierarchical areas are stale now; report_verilog_area recomputes -->
foreach my $m ( keys %MODULE_ALREADY ) {
  $MODULE_ALREADY{$m}->dbVNOMSetLeafArea(0);
  $MODULE_ALREADY{$m}->dbVNOMSetHierArea(0);
}

#<!-- apply: the flat database, the same edits under every instance path -->
my %touched = ();
my $nFlatAdded = 0;
foreach my $m ( sort keys %plan ) {
  foreach my $p ( @{$modPaths{$m}} ) {
    my $pre = ( $p eq "" ) ? "" : "$p/";
    foreach my $l ( keys %{$plan{$m}{GONE} || {}} ) {
      my $inst = "$pre$l";
      next unless ( exists $COMP_ALREADY{$inst} );
      foreach my $pin ( keys %{$COMP_ALREADY{$inst}} ) {
        my $net = $COMP_ALREADY{$inst}{$pin};
        next unless ( defined $net && exists $NETS_ALREADY{$net} );
        delete $NETS_ALREADY{$net}{$inst};
        $touched{$net} = 1;
      }
      delete $COMP_ALREADY{$inst};
      delete $CADB{$inst};
    }
    foreach my $t ( @{$plan{$m}{TIES} || []} ) {
      my ($name, $net, $v, $loads) = @$t;
      my ($cell, $out) = $v ? ($tieHi, $tieHiOut) : ($tieLo, $tieLoOut);
      my $fnet = ( @$loads ) ? "$pre$net" : $net;          # a port tie keeps the port's net
      my $fi = "$pre$name";
      $CADB{$fi} = CompAttDB::new();
      $CADB{$fi}->dbCadbSetCellref($cell);
      $COMP_ALREADY{$fi}{$out} = $fnet;
      unless ( exists $NETS_ALREADY{$fnet} ) {
        $NADB{$fnet} = NetsAttrDB::new();
        $NADB{$fnet}->dbNadbSetNetType(0);
      }
      $NETS_ALREADY{$fnet}{$fi} = $out;
      $nFlatAdded++;
      foreach my $lp ( @$loads ) {
        my ($l, $pin) = @$lp;
        my $li = "$pre$l";
        next unless ( exists $COMP_ALREADY{$li} );
        my $old = $COMP_ALREADY{$li}{$pin};
        $COMP_ALREADY{$li}{$pin} = $fnet;
        if ( defined $old && exists $NETS_ALREADY{$old} && exists $NETS_ALREADY{$old}{$li} ) {
          my $still = grep { defined $COMP_ALREADY{$li}{$_} && $COMP_ALREADY{$li}{$_} eq $old } keys %{$COMP_ALREADY{$li}};
          if ( $still ) {
            my ($other) = grep { $COMP_ALREADY{$li}{$_} eq $old } keys %{$COMP_ALREADY{$li}};
            $NETS_ALREADY{$old}{$li} = $other;
          } else {
            delete $NETS_ALREADY{$old}{$li};
          }
          $touched{$old} = 1;
        }
        $NETS_ALREADY{$fnet}{$li} = $pin;
      }
    }
  }
}
my $nNetGone = 0;
foreach my $net ( keys %touched ) {
  next unless ( exists $NETS_ALREADY{$net} );
  next if ( keys %{$NETS_ALREADY{$net}} );
  delete $NETS_ALREADY{$net};
  delete $NADB{$net};
  delete $NETS_ROUTING_ALREADY{$net} if ( exists $NETS_ROUTING_ALREADY{$net} );
  $nNetGone++;
}
close($fh) if ( defined $fh );

my $nAfter = scalar(keys %COMP_ALREADY);
print "INFO-UTS-RM_DEAD : 009 : edited $nModEdited module definition(s); flat database $nBefore -> $nAfter instance(s) " .
      "($nFlatGone removed, $nFlatAdded tie cell(s) added); deleted $nNetGone net(s) left empty\n";
if ( $nAfter != $nBefore - $nFlatGone + $nFlatAdded ) {
  print "WARN-UTS-RM_DEAD : 016 : flat instance count is $nAfter, the plan says " . ( $nBefore - $nFlatGone + $nFlatAdded ) . "\n";
}
}# sub remove_dead_logic_hier
#------------------------------------------------------------------------------------------#

1;
