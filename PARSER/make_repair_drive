#<!-- repair_drive: bring every driver within its liberty max_capacitance.
#
#     Per-module synthesis maps one module at a time and cannot see the loads
#     below a module boundary, so a net that crosses one can be left on a
#     minimum-size driver: on five 1.2M-3.9M-cell designs OpenSTA lists 19 to
#     3,259 max_capacitance violators each, the worst 23x over its limit.  STA
#     engines disagree beyond the characterised table (one extrapolates, one
#     clamps), so until these are fixed no timing number can be trusted.
#
#     Drive and Vt are one choice.  A lower-Vt cell carries more load at the
#     same area -- the smallest NAND3 carries 0.0084 pF in the highest Vt and
#     0.0220 pF in the lowest, more than the next drive up -- and leaks 5x to
#     80x more.  So for a driver over its limit every cell of its class (same
#     function, same pins: 3RDBIN/liberty_sizing), in any allowed Vt and any
#     drive, is a candidate; the feasible one with the least
#         area + leak_weight * leakage
#     is chosen.  Where no cell of the class can carry the load, a buffer is
#     put at the driver, chosen the same way.
#
#     Hierarchy, as remove_dead_logic -hier does it: edits go into the module
#     DEFINITIONS (what write_verilog --hier writes) and are replayed in the
#     flat database under every instance path (what write_sgraph and
#     placement read).  A definition is shared by every instance of its
#     module, so a cell there is sized for the worst load over all of them.
#     Loads are summed on the flat nets, which elaborate has already joined
#     across module boundaries -- exactly what the per-module synthesis could
#     not see.
#
#     Not touched: instances whose leaf name matches -keep_pattern (default
#     d0nt -- the RTL's hand-placed don't-touch cells), clock cells (stem
#     CK*), cells with no row in the sizing table (macros), and drivers of a
#     net whose local expression is not a plain name or bit select (those
#     are counted).  Run after remove_dead_logic -const -hier and before
#     write_verilog --hier and write_sgraph. -->
#------------------------------------------------------------------------------------------#
sub repair_drive {

my @vts = ("svt", "lvt");
my $leakW = 0.04;               # area units (um2) per leakage unit (nW)
my $margin = 1.0;               # aim for load <= margin * max_capacitance
my $marginSet = 0;
my $iters = 2;
my $table = "";
my $report = "";
my $dry = 0;
my $keep = "d0nt";

my $t0 = time();
my $noOfArguments = @_;
if ( $noOfArguments > 0 && ( $_[0] eq '-h' || $_[0] eq '-help' ) ) {
  print "Usage : repair_drive [-vts <vt>[,<vt>...]] [-leak_weight <area per leakage>]\n";
  print "                     [-margin <f>] [-iterations <n>] [-table <sizing.tsv>]\n";
  print "                     [-keep_pattern <regex>] [-report <file>] [-dry_run]\n";
  print "        Resizes, swaps Vt or buffers every driver whose net load exceeds its\n";
  print "        liberty max_capacitance, summing the load across module boundaries.\n";
  print "        Edits the hierarchical module definitions and the flat database.\n";
  print "        -vts         the Vt flavours a repair may use (default svt,lvt)\n";
  print "        -leak_weight the cost of one unit of leakage in units of area: the\n";
  print "                     candidate with the least area + leak_weight * leakage\n";
  print "                     wins (default 0.04 um2/nW; 0 = area only)\n";
  print "        -margin      size for load <= margin * max_capacitance (default 1.0)\n";
  print "        -iterations  re-sum and repeat; an upsize loads its own inputs more\n";
  print "                     (default 2)\n";
  print "        -table       a 3RDBIN/liberty_sizing table (default: the config's\n";
  print "                     cell-sizing)\n";
  print "        -keep_pattern instances whose leaf name matches are never changed\n";
  print "                     (default d0nt)\n";
  print "        -report      write every change made\n";
  print "        -dry_run     report what would change, change nothing\n";
  return;
}
for(my $i = 0; $i < $noOfArguments; $i++){
  if($_[$i] eq "-vts"){@vts = split(/,/, lc($_[$i+1]));}
  if($_[$i] eq "-leak_weight"){$leakW = $_[$i+1];}
  if($_[$i] eq "-margin"){$margin = $_[$i+1]; $marginSet = 1;}
  if($_[$i] eq "-iterations"){$iters = $_[$i+1];}
  if($_[$i] eq "-table"){$table = $_[$i+1];}
  if($_[$i] eq "-keep_pattern"){$keep = $_[$i+1];}
  if($_[$i] eq "-report"){$report = $_[$i+1];}
  if($_[$i] eq "-dry_run"){$dry = 1;}
}
#<!-- synthesis_mode standalone: a netlist judged on its own gets drivers
#     repaired to a tighter load, so its no-wire timing is not dominated by
#     overloaded nets; an explicit -margin wins -->
if ( !$marginSet && defined $SYNTH_MODE && $SYNTH_MODE eq "standalone" ) {
  $margin = 0.15;
  print "INFO-PAR-RP_DRV : 013 : synthesis_mode standalone: drivers sized for load <= $margin x max_capacitance\n";
}
$table = $LIBCFG_CELL_SIZING if ( $table eq "" && defined $LIBCFG_CELL_SIZING );
if ( !defined $table || $table eq "" || ! -f $table ) {
  print "ERROR-PAR-RP_DRV : 001 : no sizing table; give -table, or a config with cell-sizing\n";
  print "ERROR-PAR-RP_DRV : 001 :   (build one with 3RDBIN/liberty_sizing)\n";
  return;
}
unless ( exists $MODULE_ALREADY{$TOP_MODULE} && scalar(keys %COMP_ALREADY) > 0 ) {
  print "ERROR-PAR-RP_DRV : 002 : no hierarchical netlist and flat database; read_verilog and elaborate first\n";
  return;
}
#<!-- -vts any: a library with no Vt flavours in its file names (one corner
#     of one flavour) -- liberty_sizing leaves its vt column empty -->
my %vtOK = map { $_ => 1 } @vts;
my $anyVt = ( grep { $_ eq "any" } @vts ) ? 1 : 0;

#<!-- the sizing table: cell -> {vt, area, leak, class, dont, pins{pin}=[dir,cap,maxcap]} -->
my (%SZ, %CLS) = ();
open(my $tf, "<", $table) or do { print "ERROR-PAR-RP_DRV : 003 : cannot read $table : $!\n"; return; };
my @col = ();
while ( my $l = <$tf> ) {
  next if ( $l =~ /^#/ );
  chomp($l);
  my @f = split(/\t/, $l, -1);
  if ( !@col ) { @col = @f; next; }
  my %r; @r{@col} = @f;
  my %pins = ();
  foreach my $p ( split(/;/, $r{pins}) ) {
    my ($n, $d, $c, $mc) = split(/:/, $p);
    next unless ( defined $n && $n ne "" );
    $pins{$n} = [$d, ($c eq "" ? 0 : $c), (defined $mc && $mc ne "" ? $mc : undef)];
  }
  $SZ{$r{cell}} = { vt => $r{vt}, area => $r{area}, leak => $r{leakage}, class => $r{class},
                    dont => $r{dont_use}, pins => \%pins };
  push(@{$CLS{$r{class}}}, $r{cell}) unless ( $r{dont_use} );
}
close($tf);
print "INFO-PAR-RP_DRV : 004 : " . scalar(keys %SZ) . " cell(s) in $table; repairs may use " .
      join(",", @vts) . ", leak_weight $leakW, margin $margin\n";

#<!-- the buffer class: a BUFF or BUF stem, one input, one output, out = in
#     (truth table 2) -- not a clock or delay buffer, which share the function -->
my ($bufClass) = sort { scalar(@{$CLS{$b}}) <=> scalar(@{$CLS{$a}}) }
                 grep { /^BUFF?\|[^|,]+\|[^|,]+\|2$/ } keys %CLS;
#<!-- its pins, from the class: stem|in|out|truth table -->
my ($bufIn, $bufOut) = defined $bufClass ? ( split(/\|/, $bufClass) )[1, 2] : ("", "");
#<!-- the allowed buffer that carries the most -->
my $largestBuf = sub {
  my ($big, $bc) = (undef, -1);
  foreach my $c ( @{$CLS{$bufClass} || []} ) {
    next unless ( ( $anyVt || $vtOK{$SZ{$c}{vt}} ) && exists $PLDB{$c} );
    my $mc = $SZ{$c}{pins}{$bufOut}[2];
    ($big, $bc) = ($c, $mc) if ( defined $mc && $mc > $bc );
  }
  return $big;
};

#<!-- where each module is instantiated, as remove_dead_logic -hier walks it -->
my (%pathMod, %modPaths) = ();
my $walk;
$walk = sub {
  my ($m, $p) = @_;
  $pathMod{$p} = $m;
  push(@{$modPaths{$m}}, $p);
  foreach my $h ( sort $MODULE_ALREADY{$m}->dbVNOMGetHierInst ) {
    my $c = $MODULE_ALREADY{$m}->dbVNOMGetHierInstCell($h);
    next unless ( exists $MODULE_ALREADY{$c} );
    next if ( $MODULE_ALREADY{$c}->dbVNOMGetClass == 11 );
    $walk->($c, ( $p eq "" ? $h : "$p/$h" ));
  }
};
$walk->($TOP_MODULE, "");
my $split = sub {
  my ($inst) = @_;
  my ($p, $l) = ( $inst =~ m{^(.*)/([^/]+)$} ) ? ($1, $2) : ("", $inst);
  return () unless ( exists $pathMod{$p} && $MODULE_ALREADY{$pathMod{$p}}->dbVNOMHasLeafInst($l) );
  return ($pathMod{$p}, $p, $l);
};
my $cost = sub { my ($c) = @_; return $SZ{$c}{area} + $leakW * $SZ{$c}{leak}; };
#<!-- an assign: read_verilog holds "assign out = in" as a buffer instance,
#     bt_assign_buf_N, and write_verilog writes it back as the assign.  So it
#     is a wire, not a cell: whatever its output net carries is load on its
#     input net, and it is never sized.  Taken as a cell, a NAND driving one
#     was sized for one buffer input while STA saw the 0.05 pF behind it, 739%
#     over its limit; on another design a flop drove 386 assigns of one bit.
#     With set_write_assign_as_buffer they are written as cells, and stay so. -->
my $asWire = ( $GLOBAL->dbfGlobalGetWriteAssignAsBuffer == 0 ) ? 1 : 0;
my ($aIn, $aOut) = ( $GLOBAL->dbfGlobalGetBufForAssignIn, $GLOBAL->dbfGlobalGetBufForAssignOut );
my $isAssign = sub { my ($l) = @_; return $asWire && $GLOBAL->dbfGlobalCheckAssignInstance($l) ? 1 : 0; };

#<!-- Vt by speed, slowest first; a low-leakage variant just below its base -->
my %vtRank = ( "" => 0, svt => 0, lvtll => 1, lvt => 2, ulvtll => 3, ulvt => 4, elvt => 5 );
#<!-- the cheapest allowed cell of $class whose every output carries $need{pin}.
#     With $cur, the cell being replaced: its own Vt is always allowed and no
#     slower Vt is -- a repair must not trade a cell's speed for its load.
#     Without that, -vts svt,lvt moved 232 ulvt cells to svt on one design and
#     reported the leakage it saved as a gain. -->
my $choose = sub {
  my ($class, $need, $cur) = @_;
  my ($best, $bc) = (undef, 0);
  my ($curVt, $curRank) = defined $cur ? ($SZ{$cur}{vt}, $vtRank{$SZ{$cur}{vt}} || 0) : ("", -1);
  foreach my $c ( @{$CLS{$class} || []} ) {
    my $vt = $SZ{$c}{vt};
    next unless ( ( $anyVt || $vtOK{$vt} || ( defined $cur && $vt eq $curVt ) ) && exists $PLDB{$c} );
    next if ( defined $cur && ( $vtRank{$vt} || 0 ) < $curRank );
    my $ok = 1;
    foreach my $po ( keys %$need ) {
      my $mc = $SZ{$c}{pins}{$po}[2];
      if ( !defined $mc || $need->{$po} > $margin * $mc ) { $ok = 0; last; }
    }
    next unless ( $ok );
    my $k = $cost->($c);
    ($best, $bc) = ($c, $k) if ( !defined $best || $k < $bc );
  }
  return $best;
};

my $fh;
if ( $report ne "" ) {
  open($fh, ">", $report) or do { print "ERROR-PAR-RP_DRV : 005 : cannot write $report : $!\n"; return; };
}
my ($nResize, $nSwap, $nBuf, $nStuck, $nSkip, $dArea, $dLeak) = (0, 0, 0, 0, 0, 0, 0);
my %stuck = ();
my $bufSeq = 0;

#<!-- PHASE 1: buffer trees, port-local, one module definition at a time.
#     A net whose load is more than the largest allowed buffer carries -- the
#     read selects of a latch array, 10,000 pins on one net -- gets a tree,
#     and it is built in the definition where those loads are: loads inside a
#     child, reached through its input port, get their tree inside the child,
#     so every copy of the child has it and the parent then sees only the
#     tree's inputs on that port.  Definitions bottom up, children first.
#     Loads are grouped in name order (the best stand-in for locality before
#     placement), each group within one tree buffer's limit, and levels added
#     until the top fits one buffer's limit too; whatever drives the net is then
#     sized by the per-driver pass below.  Every edit is replayed in the flat
#     database under every instance path. -->
my ($nTreeNets, $nTreeBufs, $nClkSkip) = (0, 0, 0);
my $treePhase = sub {
if ( defined $bufClass && !$dry ) {
  my @bufs = grep { ( $anyVt || $vtOK{$SZ{$_}{vt}} ) && exists $PLDB{$_} && defined $SZ{$_}{pins}{$bufOut}[2] }
             @{$CLS{$bufClass}};
  my ($bigCap) = sort { $b <=> $a } map { $SZ{$_}{pins}{$bufOut}[2] } @bufs;
  my $treeAt = $margin * ( $bigCap || 0 );
  #<!-- the tree's buffer: the cheapest that carries half of what a net may
  #     load before it needs a tree.  $choose applies -margin itself, so the
  #     request is in the same terms as $treeAt; asking for half of $bigCap
  #     found no buffer at all under any margin below 1. -->
  my $tb = $choose->($bufClass, { $bufOut => 0.5 * $treeAt });
  my $grp = defined $tb ? $margin * $SZ{$tb}{pins}{$bufOut}[2] : 0;
  my $pack = 0.85 * $grp;       # headroom for what the second driver pass upsizes
  my $tbIn = defined $tb ? $SZ{$tb}{pins}{$bufIn}[1] : 0;

  #<!-- one definition's local nets: loads (leaf input pins, child input ports)
  #     and what drives them -->
  my %local = ();
  my $parse = sub {
    my ($m) = @_;
    my (%loads, %driven, %clk) = ();
    foreach my $line ( $MODULE_ALREADY{$m}->dbVNOMGetConn ) {
      my ($cell, $inst) = ( split(/\s+/, $line) )[0, 1];
      next unless ( defined $inst );
      my $leaf = $MODULE_ALREADY{$m}->dbVNOMHasLeafInst($inst);
      my $hier = !$leaf && exists $MODULE_ALREADY{$cell};
      next unless ( $leaf || $hier );
      #<!-- an assign: a load of everything behind its output, ["A", ..., out] -->
      if ( $leaf && $isAssign->($inst) ) {
        my ($in, $out) = ( &dbfConnPinExpr($line, $aIn), &dbfConnPinExpr($line, $aOut) );
        push(@{$loads{$in}}, ["A", $inst, $aIn, $cell, $out])
          if ( defined $in && defined $out && &dbfConnExprIsNet($in) && &dbfConnExprIsNet($out) );
        next;
      }
      foreach my $pe ( &dbfConnPins($line) ) {
        my ($pin, $x) = @$pe;
        next unless ( &dbfConnExprIsNet($x) );
        if ( $leaf ) {
          next unless ( exists $SZ{$cell} && exists $SZ{$cell}{pins}{$pin} );
          if ( $SZ{$cell}{pins}{$pin}[0] ne "o" ) {
            push(@{$loads{$x}}, ["L", $inst, $pin, $cell]);
            $clk{$x} = 1 if ( $SZ{$cell}{pins}{$pin}[0] eq "k" );
          }
          else { $driven{$x} = $cell; }
        } elsif ( exists $MODULE_ALREADY{$cell}->{ins}{$pin} ) {
          push(@{$loads{$x}}, ["H", $inst, $pin, $cell]);
        } else {
          $driven{$x} = "";
        }
      }
    }
    return { loads => \%loads, driven => \%driven, clk => \%clk };
  };
  #<!-- a clock net: one that reaches a clock pin, here or through a child's
  #     port.  A clock entering a module by a port has no driver inside it, so
  #     the driver's class could not say; on one design that missed four clock
  #     ports with 826 to 11,762 loads each, and data buffers went into them.
  #     Clock nets are CTS's: clock buffers, balanced skew. -->
  my (%clkMemo, $isClk) = ();
  $isClk = sub {
    my ($m, $x) = @_;
    return $clkMemo{"$m\t$x"} if ( exists $clkMemo{"$m\t$x"} );
    $clkMemo{"$m\t$x"} = 0;
    $local{$m} = $parse->($m) unless ( exists $local{$m} );
    my $v = $local{$m}{clk}{$x} ? 1 : 0;
    unless ( $v ) {
      foreach my $ld ( @{$local{$m}{loads}{$x} || []} ) {
        next if ( $ld->[0] eq "L" );
        if ( $ld->[0] eq "A" ? $isClk->($m, $ld->[4]) : $isClk->($ld->[3], $ld->[2]) ) { $v = 1; last; }
      }
    }
    return $clkMemo{"$m\t$x"} = $v;
  };
  my (%plMemo, %nlBusy, $portLoad, $netLoad, $ldCap) = ();
  $ldCap = sub {
    my ($m, $ld) = @_;
    return $SZ{$ld->[3]}{pins}{$ld->[2]}[1] if ( $ld->[0] eq "L" );
    return $netLoad->($m, $ld->[4]) if ( $ld->[0] eq "A" );
    return $portLoad->($ld->[3], $ld->[2]);
  };
  $netLoad = sub {
    my ($m, $x) = @_;
    return 0 if ( $nlBusy{"$m\t$x"} );      # a loop of assigns
    $nlBusy{"$m\t$x"} = 1;
    my $l = 0;
    $l += $ldCap->($m, $_) foreach ( @{$local{$m}{loads}{$x} || []} );
    delete $nlBusy{"$m\t$x"};
    return $l;
  };
  $portLoad = sub {
    my ($c, $p) = @_;
    return $plMemo{"$c\t$p"} if ( exists $plMemo{"$c\t$p"} );
    $local{$c} = $parse->($c) unless ( exists $local{$c} );
    return $plMemo{"$c\t$p"} = $netLoad->($c, $p);
  };
  #<!-- a leaf input pin on $x somewhere under $m: [relative path, pin] -- how
  #     the flat net of $x is found under each instance path -->
  my $rep;
  $rep = sub {
    my ($m, $x) = @_;
    $local{$m} = $parse->($m) unless ( exists $local{$m} );
    foreach my $ld ( @{$local{$m}{loads}{$x} || []} ) { return ($ld->[1], $ld->[2]) if ( $ld->[0] ne "H" ); }
    foreach my $ld ( @{$local{$m}{loads}{$x} || []} ) {
      my ($r, $pp) = $rep->($ld->[3], $ld->[2]);
      return ("$ld->[1]/$r", $pp) if ( defined $r );
    }
    return ();
  };
  my $move = sub {
    my ($fi, $pin, $from, $to) = @_;
    $COMP_ALREADY{$fi}{$pin} = $to;
    my ($other) = grep { defined $COMP_ALREADY{$fi}{$_} && $COMP_ALREADY{$fi}{$_} eq $from } keys %{$COMP_ALREADY{$fi}};
    if ( defined $other ) { $NETS_ALREADY{$from}{$fi} = $other; } else { delete $NETS_ALREADY{$from}{$fi}; }
    $NETS_ALREADY{$to}{$fi} = $pin;
    unless ( exists $NADB{$to} ) { $NADB{$to} = NetsAttrDB::new(); $NADB{$to}->dbNadbSetNetType(0); }
  };
  my (%height, $hgt) = ();
  $hgt = sub {
    my ($m) = @_;
    return $height{$m} if ( exists $height{$m} );
    my $h = 0;
    foreach my $hi ( $MODULE_ALREADY{$m}->dbVNOMGetHierInst ) {
      my $c = $MODULE_ALREADY{$m}->dbVNOMGetHierInstCell($hi);
      next unless ( exists $modPaths{$c} );
      my $ch = $hgt->($c) + 1;
      $h = $ch if ( $ch > $h );
    }
    return $height{$m} = $h;
  };
  $hgt->($_) foreach ( keys %modPaths );

  foreach my $m ( ( defined $tb && $grp > 0 ) ? sort { $height{$a} <=> $height{$b} || $a cmp $b } keys %modPaths : () ) {
    $local{$m} = $parse->($m);
    my $mod = $MODULE_ALREADY{$m};
    my $n = scalar(@{$modPaths{$m}});
    my (%rw, @add) = ();
    my $addArea = 0;
    my @plans = ();
    foreach my $x ( sort keys %{$local{$m}{loads}} ) {
      next unless ( $netLoad->($m, $x) > $treeAt );
      my $d = $local{$m}{driven}{$x};
      next if ( defined $d && $d ne "" && exists $SZ{$d} && $SZ{$d}{class} =~ /^CK/ );   # clocks: CTS
      if ( $isClk->($m, $x) ) { $nClkSkip++; next; }
      my @cur = map { { kind => $_->[0], inst => $_->[1], pin => $_->[2], cell => $_->[3],
                        cap => $ldCap->($m, $_) } }
                sort { $a->[1] cmp $b->[1] || $a->[2] cmp $b->[2] } @{$local{$m}{loads}{$x}};
      my @loads = @cur;
      my @tbufs = ();
      my $levels = 0;
      while ( 1 ) {
        my ($tot, $g, $gc) = (0, [], 0);
        my @groups = ();
        $tot += $_->{cap} foreach ( @cur );
        last if ( $levels > 0 && $tot <= $grp );
        foreach my $it ( @cur ) {
          if ( @$g && $gc + $it->{cap} > $pack ) { push(@groups, $g); ($g, $gc) = ([], 0); }
          push(@$g, $it); $gc += $it->{cap};
        }
        push(@groups, $g) if ( @$g );
        last if ( $levels > 0 && @groups == scalar(@cur) );   # no progress: stop
        my @next = ();
        foreach my $gl ( @groups ) {
          #<!-- each group's own buffer: the cheapest that carries it.  One
          #     load can be more than the packing size -- a child port with
          #     0.026 pF behind it, below the tree threshold so the child built
          #     none, above one mid-size buffer's limit -- and a buffer sized
          #     for the packing was overloaded by it -->
          my $gl_cap = 0; $gl_cap += $_->{cap} foreach ( @$gl );
          my $gb = $choose->($bufClass, { $bufOut => $gl_cap }) || $largestBuf->();
          $bufSeq++;
          my $bi = { kind => "B", inst => "repdrv_tb_$bufSeq", pin => $bufIn, cell => $gb,
                     cap => $SZ{$gb}{pins}{$bufIn}[1], out => "repdrv_tn_$bufSeq" };
          $_->{net} = $bi->{out} foreach ( @$gl );
          push(@tbufs, $bi); push(@next, $bi);
        }
        @cur = @next;
        $levels++;
      }
      $_->{net} = $x foreach ( @cur );
      my ($r, $rp) = $rep->($m, $x);
      push(@plans, [$x, \@loads, \@tbufs, $levels, $r, $rp]);
      foreach my $it ( @loads ) { $rw{$it->{inst}}{$it->{pin}} = $it->{net}; }
      my %used = ();
      foreach my $bi ( @tbufs ) {
        push(@add, "$bi->{cell} $bi->{inst} (.$bufIn($bi->{net}), .$bufOut($bi->{out})) ;");
        $mod->dbVNOMAddLeafInst($bi->{inst});
        $mod->dbVNOMSetLeafInstCell($bi->{inst}, $bi->{cell});
        my @s = exists $PLDB{$bi->{cell}} ? $PLDB{$bi->{cell}}->dbMdbGetSize : (0, 0);
        $addArea += $s[0] * $s[1];
        $dArea += $n * $SZ{$bi->{cell}}{area};
        $dLeak += $n * $SZ{$bi->{cell}}{leak};
        $used{$bi->{cell}}++;
      }
      $nTreeNets++;
      $nTreeBufs += scalar(@tbufs);
      print $fh "tree\t$m\t$x\t" . scalar(@loads) . " load(s)\t" .
                join(",", map { "$used{$_} $_" } sort keys %used) . "\t$levels level(s)\tx$n\n" if ( $fh );
    }
    next unless ( @plans );
    #<!-- the definition -->
    my @lines = ();
    foreach my $line ( $mod->dbVNOMGetConn ) {
      my ($cell, $inst) = ( split(/\s+/, $line) )[0, 1];
      if ( defined $inst && exists $rw{$inst} ) {
        $line = &dbfConnSetPinExpr($line, $_, $rw{$inst}{$_}) foreach ( sort keys %{$rw{$inst}} );
      }
      push(@lines, $line);
    }
    $mod->{conn} = [@lines, @add];
    $mod->dbVNOMSetArea($mod->dbVNOMGetArea + $addArea);
    #<!-- the flat database, under every path -->
    foreach my $pp ( @{$modPaths{$m}} ) {
      my $pre = ( $pp eq "" ) ? "" : "$pp/";
      foreach my $pl ( @plans ) {
        my ($x, $loads, $tbufs, $levels, $r, $rp) = @$pl;
        next unless ( defined $r && exists $COMP_ALREADY{"$pre$r"} );
        my $F = $COMP_ALREADY{"$pre$r"}{$rp};
        next unless ( defined $F && exists $NETS_ALREADY{$F} );
        foreach my $it ( @$loads ) {
          my $to = "$pre$it->{net}";
          if ( $it->{kind} ne "H" ) {
            $move->("$pre$it->{inst}", $it->{pin}, $F, $to) if ( exists $COMP_ALREADY{"$pre$it->{inst}"} );
          } else {
            my $under = "$pre$it->{inst}/";
            foreach my $fi ( grep { index($_, $under) == 0 } keys %{$NETS_ALREADY{$F}} ) {
              foreach my $pin ( grep { defined $COMP_ALREADY{$fi}{$_} && $COMP_ALREADY{$fi}{$_} eq $F } keys %{$COMP_ALREADY{$fi}} ) {
                $move->($fi, $pin, $F, $to);
              }
            }
          }
        }
        foreach my $bi ( @$tbufs ) {
          my $fb = "$pre$bi->{inst}";
          my $in = ( $bi->{net} eq $x ) ? $F : "$pre$bi->{net}";
          my $out = "$pre$bi->{out}";
          $CADB{$fb} = CompAttDB::new();
          $CADB{$fb}->dbCadbSetCellref($bi->{cell});
          $COMP_ALREADY{$fb}{$bufIn} = $in;
          $COMP_ALREADY{$fb}{$bufOut} = $out;
          $NETS_ALREADY{$in}{$fb} = $bufIn;
          $NETS_ALREADY{$out}{$fb} = $bufOut;
          foreach my $nn ( $in, $out ) {
            unless ( exists $NADB{$nn} ) { $NADB{$nn} = NetsAttrDB::new(); $NADB{$nn}->dbNadbSetNetType(0); }
          }
        }
      }
    }
    #<!-- what a parent sees on this definition's ports has changed -->
    $local{$m} = $parse->($m);
    delete $plMemo{$_} foreach ( grep { /^\Q$m\E\t/ } keys %plMemo );
  }
  print "INFO-PAR-RP_DRV : 011 : $nTreeNets net(s) over " . sprintf("%.4g", $treeAt) . " given buffer trees: " .
        "$nTreeBufs buffer(s) in module definitions\n" if ( $nTreeNets );
  print "INFO-PAR-RP_DRV : 012 : $nClkSkip clock net(s) over that load left for CTS\n" if ( $nClkSkip );
}
};

#<!-- the per-driver pass.  Run twice around the trees: first with no
#     buffering, so every overloaded driver is upsized before the trees are
#     built and they see the loads' final input capacitance -- a tree sized on
#     the old capacitances was overloaded again the moment its loads were
#     upsized, and the second pass buffered its buffers; then with buffering,
#     for what no cell of its class can carry. -->
my $driverPass = sub {
my ($allowBuf, $pass) = @_;
for ( my $it = 1; $it <= $iters; $it++ ) {
  #<!-- loads on the flat nets, and the driving pins -->
  my (%load, %drv, %alias) = ();
  foreach my $inst ( keys %COMP_ALREADY ) {
    if ( $isAssign->( ( $inst =~ m{([^/]+)$} )[0] ) ) {
      my ($in, $out) = ( $COMP_ALREADY{$inst}{$aIn}, $COMP_ALREADY{$inst}{$aOut} );
      push(@{$alias{$in}}, $out) if ( defined $in && defined $out && $in ne "" && $out ne "" );
      next;
    }
    my $cell = exists $CADB{$inst} ? $CADB{$inst}->dbCadbGetCellref : "";
    my $sz = $SZ{$cell};
    foreach my $pin ( keys %{$COMP_ALREADY{$inst}} ) {
      my $net = $COMP_ALREADY{$inst}{$pin};
      next if ( !defined $net || $net eq "" || $net =~ /^1'b[01]$/ );
      next unless ( defined $sz && exists $sz->{pins}{$pin} );
      if ( $sz->{pins}{$pin}[0] ne "o" ) { $load{$net} += $sz->{pins}{$pin}[1]; }
      else { $drv{$inst}{$pin} = $net; }
    }
  }
  #<!-- a net's load and that of every net assigned from it -->
  my (%eff, $effLoad) = ();
  $effLoad = sub {
    my ($n) = @_;
    return $eff{$n} if ( exists $eff{$n} );
    $eff{$n} = $load{$n} || 0;            # a loop of assigns stops here
    my $l = $eff{$n};
    $l += $effLoad->($_) foreach ( @{$alias{$n} || []} );
    return $eff{$n} = $l;
  };
  #<!-- violators, gathered per module definition: the worst load over every
  #     instance of the module is what its one cell must carry -->
  my %need = ();          # m -> l -> pin -> load
  my $nViol = 0;
  foreach my $inst ( keys %drv ) {
    my $cell = $CADB{$inst}->dbCadbGetCellref;
    my $over = 0;
    foreach my $po ( keys %{$drv{$inst}} ) {
      my $mc = $SZ{$cell}{pins}{$po}[2];
      $over = 1 if ( defined $mc && $effLoad->($drv{$inst}{$po}) > $margin * $mc );
    }
    next unless ( $over );
    $nViol++;
    my ($m, $p, $l) = $split->($inst);
    if ( !defined $m || $l =~ /$keep/ || $SZ{$cell}{class} =~ /^CK/ ) { $nSkip++ if ( $it == 1 ); next; }
    next if ( exists $need{$m}{$l} );
    foreach my $pp ( @{$modPaths{$m}} ) {
      my $fi = ( $pp eq "" ) ? $l : "$pp/$l";
      foreach my $po ( keys %{$drv{$fi} || {}} ) {
        my $ld = $effLoad->($drv{$fi}{$po});
        $need{$m}{$l}{$po} = $ld if ( !exists $need{$m}{$l}{$po} || $ld > $need{$m}{$l}{$po} );
      }
    }
  }
  print "INFO-PAR-RP_DRV : 006 : ${pass}iteration $it: $nViol driver(s) over max_capacitance in " .
        scalar(keys %need) . " module definition(s)\n";
  last unless ( keys %need );

  #<!-- decide, per definition and leaf -->
  my (%newCell, %bufAt) = ();
  foreach my $m ( keys %need ) {
    foreach my $l ( keys %{$need{$m}} ) {
      my $cell = $MODULE_ALREADY{$m}->dbVNOMGetLeafInstCell($l);
      next unless ( defined $cell && exists $SZ{$cell} );
      my $c = $choose->($SZ{$cell}{class}, $need{$m}{$l}, $cell);
      if ( defined $c ) {
        $newCell{$m}{$l} = $c if ( $c ne $cell );
        next;
      }
      next unless ( $allowBuf );
      #<!-- nothing in the class carries it: a buffer on each output that is
      #     over the limit -- a flop's Q, say, while its QN is fine -->
      my @over = grep { my $mc = $SZ{$cell}{pins}{$_}[2];
                        defined $mc && $need{$m}{$l}{$_} > $margin * $mc } keys %{$need{$m}{$l}};
      if ( !@over || !defined $bufClass ) { $stuck{"$m\t$l"} = 1; next; }
      foreach my $po ( sort @over ) {
        #<!-- not $b: a lexical $b hides sort's own, and the "largest buffer"
        #     below came back as an arbitrary one -- the smallest, on one
        #     design, put in front of a reset tree at 3.2 ns -->
        my $bcell = $choose->($bufClass, { $bufOut => $need{$m}{$l}{$po} });
        unless ( defined $bcell ) {
          #<!-- more than the largest buffer: the largest, and say so -->
          $bcell = $largestBuf->();
          $stuck{"$m\t$l"} = 1;
        }
        push(@{$bufAt{$m}{$l}}, [$po, $bcell]) if ( defined $bcell );
      }
    }
  }
  if ( $dry ) {
    foreach my $m ( sort keys %newCell ) {
      foreach my $l ( sort keys %{$newCell{$m}} ) {
        print $fh "resize\t$m\t$l\t" . $MODULE_ALREADY{$m}->dbVNOMGetLeafInstCell($l) . "\t$newCell{$m}{$l}\n" if ( $fh );
      }
    }
    foreach my $m ( sort keys %bufAt ) {
      foreach my $l ( sort keys %{$bufAt{$m}} ) {
        print $fh "buffer\t$m\t$l\t$_->[0]\t$_->[1]\n" foreach ( $fh ? @{$bufAt{$m}{$l}} : () );
      }
    }
    last;
  }

  #<!-- apply: module definitions, then the flat database under every path -->
  my %mods = map { $_ => 1 } ( keys %newCell, keys %bufAt );
  foreach my $m ( keys %mods ) {
    my $mod = $MODULE_ALREADY{$m};
    my $n = scalar(@{$modPaths{$m}});
    my $area = $mod->dbVNOMGetArea;
    my @lines = ();
    my @add = ();
    foreach my $line ( $mod->dbVNOMGetConn ) {
      my ($cell, $inst) = ( split(/\s+/, $line) )[0, 1];
      if ( defined $inst && exists $newCell{$m}{$inst} ) {
        my $new = $newCell{$m}{$inst};
        $line =~ s/^\s*\Q$cell\E\b/$new/;
        $mod->dbVNOMSetLeafInstCell($inst, $new);
        my @o = exists $PLDB{$cell} ? $PLDB{$cell}->dbMdbGetSize : (0, 0);
        my @s = exists $PLDB{$new} ? $PLDB{$new}->dbMdbGetSize : (0, 0);
        $area += $s[0] * $s[1] - $o[0] * $o[1];
        $dArea += $n * ( $SZ{$new}{area} - $SZ{$cell}{area} );
        $dLeak += $n * ( $SZ{$new}{leak} - $SZ{$cell}{leak} );
        if ( $SZ{$new}{vt} ne $SZ{$cell}{vt} ) { $nSwap++; } else { $nResize++; }
        print $fh "resize\t$m\t$inst\t$cell\t$new\tx$n\n" if ( $fh );
        foreach my $pp ( @{$modPaths{$m}} ) {
          my $fi = ( $pp eq "" ) ? $inst : "$pp/$inst";
          $CADB{$fi}->dbCadbSetCellref($new) if ( exists $CADB{$fi} );
        }
      }
      foreach my $bp ( ( defined $inst && exists $bufAt{$m}{$inst} ) ? @{$bufAt{$m}{$inst}} : () ) {
        my ($po, $bcell) = @$bp;
        #<!-- one net: a plain name, a bit select or an escaped name (which
        #     keeps its terminating space); UTILS/gen_net_func reads it -->
        my $expr = &dbfConnPinExpr($line, $po);
        if ( !&dbfConnExprIsNet($expr) ) {
          $nSkip++;
        } else {
          $bufSeq++;
          my ($bn, $nn) = ("repdrv_buf_$bufSeq", "repdrv_net_$bufSeq");
          $line = &dbfConnSetPinExpr($line, $po, $nn);
          push(@add, "$bcell $bn (.$bufIn($nn), .$bufOut($expr)) ;");
          $mod->dbVNOMAddLeafInst($bn);
          $mod->dbVNOMSetLeafInstCell($bn, $bcell);
          my @s = exists $PLDB{$bcell} ? $PLDB{$bcell}->dbMdbGetSize : (0, 0);
          $area += $s[0] * $s[1];
          $dArea += $n * $SZ{$bcell}{area};
          $dLeak += $n * $SZ{$bcell}{leak};
          $nBuf++;
          print $fh "buffer\t$m\t$inst\t$po\t$bcell\t$bn\tx$n\n" if ( $fh );
          @$bp = ($po, $bcell, $bn, $nn);
        }
      }
      push(@lines, $line);
    }
    $mod->{conn} = [@lines, @add];
    $mod->dbVNOMSetArea($area);
    #<!-- the flat side of the buffers -->
    foreach my $inst ( keys %{$bufAt{$m} || {}} ) {
     foreach my $bp ( @{$bufAt{$m}{$inst}} ) {
      my ($po, $bcell, $bn, $nn) = @$bp;
      next unless ( defined $bn );
      foreach my $pp ( @{$modPaths{$m}} ) {
        my $pre = ( $pp eq "" ) ? "" : "$pp/";
        my ($fi, $fb, $fn) = ("$pre$inst", "$pre$bn", "$pre$nn");
        next unless ( exists $COMP_ALREADY{$fi} && defined $COMP_ALREADY{$fi}{$po} );
        my $old = $COMP_ALREADY{$fi}{$po};
        $COMP_ALREADY{$fi}{$po} = $fn;
        my ($other) = grep { $_ ne $po && defined $COMP_ALREADY{$fi}{$_} && $COMP_ALREADY{$fi}{$_} eq $old }
                      keys %{$COMP_ALREADY{$fi}};
        if ( defined $other ) { $NETS_ALREADY{$old}{$fi} = $other; } else { delete $NETS_ALREADY{$old}{$fi}; }
        $NETS_ALREADY{$old}{$fb} = $bufOut;
        $CADB{$fb} = CompAttDB::new();
        $CADB{$fb}->dbCadbSetCellref($bcell);
        $COMP_ALREADY{$fb}{$bufIn} = $fn;
        $COMP_ALREADY{$fb}{$bufOut} = $old;
        $NADB{$fn} = NetsAttrDB::new();
        $NADB{$fn}->dbNadbSetNetType(0);
        $NETS_ALREADY{$fn}{$fi} = $po;
        $NETS_ALREADY{$fn}{$fb} = $bufIn;
      }
     }
    }
  }
  foreach my $m ( keys %MODULE_ALREADY ) {
    $MODULE_ALREADY{$m}->dbVNOMSetLeafArea(0);
    $MODULE_ALREADY{$m}->dbVNOMSetHierArea(0);
  }
}
};

if ( $dry ) {
  $driverPass->(1, "");
} else {
  $driverPass->(0, "upsize pass, ");
  $treePhase->();
  $driverPass->(1, "");
}
$nStuck = scalar(keys %stuck);
close($fh) if ( defined $fh );
if ( $dry ) {
  print "INFO-PAR-RP_DRV : 007 : dry run, the database is unchanged\n";
  return;
}
printf("INFO-PAR-RP_DRV : 008 : %d upsize(s), %d Vt swap(s), %d buffer(s) added in module definitions; " .
       "flat area %+.2f, leakage %+.1f; %d s\n", $nResize, $nSwap, $nBuf, $dArea, $dLeak, time() - $t0);
print "WARN-PAR-RP_DRV : 009 : $nStuck driver(s) need more than any one cell of their class or one buffer can carry\n" if ( $nStuck );
print "INFO-PAR-RP_DRV : 010 : $nSkip driver(s) left alone: kept by -keep_pattern, clock cells, " .
      "outside the hierarchy walk, or a net that is not a plain name\n" if ( $nSkip );
}# sub repair_drive
#------------------------------------------------------------------------------------------#

1;
