#<!-- hier_synthesis: RTL hierarchy to a HIERARCHICAL gate netlist, one
#     distinct module at a time.
#
#     synthesize is the flat path: one yosys run, one netlist, hierarchy gone.
#     That is what a placer cannot use.  This is the other one, for a design
#     elaborated with yosys-slang's --keep-hierarchy, which emits one module
#     per INSTANCE -- 119,351 of them on one design, and 111 distinct
#     structures.  A single yosys run over that does not finish, because every
#     pass walks all 119,351 and optimises the same one-cell wrapper thirty-five
#     thousand times.
#
#     So: group the copies into distinct modules, rank them by depth, and
#     synthesise each ONCE, deepest first, reading the levels below as
#     blackboxes.  What comes out is still hierarchical, which is what
#     hier_place needs.  The work is done by 3RDBIN/rtlil_bottom_up and
#     3RDBIN/yosys_bottom_up; this command is the electron face of them and the
#     place the defaults live.
#
#     THE LATCH.  dfflibmap maps flip-flops only and yosys has no latch
#     equivalent, so a latch is lowered to $_DLATCH_ and then ignored by every
#     pass after it -- ending up in the netlist as a yosys internal cell that
#     place and route has no model for, with nothing reporting a problem.  This
#     builds the techmap from the liberty's own latch() groups by default.
#     --no_latchmap turns that off; there is no good reason to. -->

#------------------------------------------------------------------------------------------#
sub hier_synthesis {

my $noOfArguments = @_;
if ( $noOfArguments == 0 || $_[0] eq '-h' ) {
  print "Usage : hier_synthesis -rtl <filelist> -top <module> | -rtlil <design.il>\n";
  print "                       [-liberty <lib>] [-blackbox <cells.v>]\n";
  print "                       [-out <dir>] [-netlist <file>] [--read]\n";
  print "                       [-jobs <n>] [-flatten_below <cells>]\n";
  print "                       [-slang_args <args>] [-slang_plugin <slang.so>]\n";
  print "                       [-patch <rules.py>] [-latchmap <file>]\n";
  print "                       [-abc_delay <ps> [-abc_driver <cell>] [-abc_load <fF>]]\n";
  print "                       [-leaf_wrappers <glob>[,<glob>]]\n";
  print "                       [--no_latchmap] [--no_verify] [--no_run]\n";
  print "\n";
  print "        -rtl            an RTL filelist, as the front end reads it: +incdir+ and\n";
  print "                        +define+ lines are passed through.  Elaborated with\n";
  print "                        read_slang --keep-hierarchy, which is what makes the\n";
  print "                        hierarchy survive to the placer.\n";
  print "        -top            top module.  Required with -rtl.\n";
  print "        -rtlil          skip elaboration and start from a dump written earlier.\n";
  print "        -slang_args     extra options for read_slang, appended to the defaults.\n";
  print "        -slang_plugin   the yosys-slang plugin to elaborate with.  Omitted:\n";
  print "                        \$ELECTRON_SLANG_PLUGIN, else INSTALL/slang/slang.so when\n";
  print "                        make slang-plugin has built it, else the image's own.\n";
  print "        -patch          rewrite constructs the front end will not elaborate,\n";
  print "                        in copies, before elaborating: a python file of\n";
  print "                        PATCHES, see 3RDBIN/rtl_patch.  A rule that no longer\n";
  print "                        matches is an error.  Needs -rtl.\n";
  print "        -liberty        liberty for dfflibmap and abc.  Omitted, the list left\n";
  print "                        by get_std_cell_libs --set is used.\n";
  print "        -blackbox       standard cell stubs.  Omitted, they are built from the\n";
  print "                        LEFs in the config read_library_config was pointed at.\n";
  print "        -out            work directory, default hier_synthesis\n";
  print "        -netlist        also write the whole hierarchy as ONE file here,\n";
  print "                        gzipped when the name ends in .gz.  The per-module\n";
  print "                        netlists stay in <out>/netlists either way.\n";
  print "        --read          read that netlist back with read_verilog and elaborate\n";
  print "        -jobs           modules synthesised at once, default 8\n";
  print "        -abc_delay      buffer high-fanout nets and size gates toward this\n";
  print "                        delay, in PICOSECONDS whatever the liberty's unit\n";
  print "                        (abc -constr -D).  Off by default: abc then maps\n";
  print "                        with minimum-size gates and buffers nothing.\n";
  print "        -abc_driver     with -abc_delay, the cell driving module inputs\n";
  print "                        (default: a buffer from the liberty)\n";
  print "        -abc_load       with -abc_delay, the load on module outputs in fF\n";
  print "                        (default: four median input pins)\n";
  print "        -leaf_wrappers  modules that wrap library cells, e.g. 'cellwrap_*':\n";
  print "                        elaborated once per parameter set instead of once\n";
  print "                        per instance.  Only wrappers whose bodies hold\n";
  print "                        nothing but library cells; see 3RDBIN/rtlil_leaf_wrappers.\n";
  print "        -flatten_below  keep a module as a hierarchy boundary only when its\n";
  print "                        subtree is at least this many cells, default 2000.\n";
  print "                        0 keeps every module, which costs area: a boundary is a\n";
  print "                        wall abc cannot optimise across.\n";
  print "        --no_latchmap   do not map latches to library cells.  They will reach\n";
  print "                        the netlist as \$_DLATCH_ and nothing will say so.\n";
  print "        --no_verify     skip reloading the netlists to check they compose\n";
  print "        --no_run        write the setup and stop\n";
  return;
}

my $rtlil;
my $rtlList;
my $topModule;
my $slangArgs = "";
my $slangPlugin = "";
my $patchRules = "";
my $netlistOut;
my $readBack = 0;
my $outDir = "hier_synthesis";
my $blackbox;
my $latchmap;
my $jobs = 8;
my $flattenBelow = 2000;
my $abcDelay = "";
my $leafWrappers = "";
my $abcDriver = "";
my $abcLoad = "";
my $noLatchmap = 0;
my $noVerify = 0;
my $noRun = 0;
my @libFiles = ();

for(my $i = 0; $i < $noOfArguments; $i++){
  if($_[$i] eq "-rtlil"){$rtlil = $_[$i+1];}
  if($_[$i] eq "-rtl"){$rtlList = $_[$i+1];}
  if($_[$i] eq "-top"){$topModule = $_[$i+1];}
  if($_[$i] eq "-top_module"){$topModule = $_[$i+1];}
  if($_[$i] eq "-slang_args"){$slangArgs = $_[$i+1];}
  if($_[$i] eq "-slang_plugin"){$slangPlugin = $_[$i+1];}
  if($_[$i] eq "-patch"){$patchRules = $_[$i+1];}
  if($_[$i] eq "-netlist"){$netlistOut = $_[$i+1];}
  if($_[$i] eq "--read"){$readBack = 1;}
  if($_[$i] eq "-out"){$outDir = $_[$i+1];}
  if($_[$i] eq "-blackbox"){$blackbox = $_[$i+1];}
  if($_[$i] eq "-latchmap"){$latchmap = $_[$i+1];}
  if($_[$i] eq "-jobs"){$jobs = $_[$i+1];}
  if($_[$i] eq "-flatten_below"){$flattenBelow = $_[$i+1];}
  if($_[$i] eq "-abc_delay"){$abcDelay = $_[$i+1];}
  if($_[$i] eq "-leaf_wrappers"){$leafWrappers = $_[$i+1];}
  if($_[$i] eq "-abc_driver"){$abcDriver = $_[$i+1];}
  if($_[$i] eq "-abc_load"){$abcLoad = $_[$i+1];}
  if($_[$i] eq "-liberty"){ push(@libFiles, split(/\s*\,\s*/, $_[$i+1])); }
  if($_[$i] eq "--no_latchmap"){$noLatchmap = 1;}
  if($_[$i] eq "--no_verify"){$noVerify = 1;}
  if($_[$i] eq "--no_run"){$noRun = 1;}
}#for

#<!-- Either an RTL filelist to elaborate, or a dump already elaborated. -->
if ( defined $rtlList && $rtlList ne "" ) {
  unless ( -f $rtlList ) {
    print "ERROR-PAR-HR_SYN : 034 : filelist $rtlList does not exist\n";
    return;
  }
  $topModule = $TOP_MODULE unless ( defined $topModule && $topModule ne "" );
  unless ( defined $topModule && $topModule ne "" ) {
    print "ERROR-PAR-HR_SYN : 035 : -rtl needs -top, and TOP_MODULE is not set\n";
    return;
  }
}
elsif ( defined $rtlil && $rtlil ne "" ) {
  unless ( -f $rtlil ) {
    print "ERROR-PAR-HR_SYN : 003 : $rtlil does not exist\n";
    return;
  }
}
else {
  print "ERROR-PAR-HR_SYN : 001 : give -rtl <filelist> -top <module>, or -rtlil <dump>\n";
  print "ERROR-PAR-HR_SYN : 002 : -rtlil wants what yosys writes after read_slang --keep-hierarchy\n";
  return;
}
if ( $patchRules ne "" ) {
  unless ( defined $rtlList && $rtlList ne "" ) {
    print "ERROR-PAR-HR_SYN : 060 : -patch rewrites RTL, so it needs -rtl, not -rtlil\n";
    return;
  }
  unless ( -f $patchRules ) {
    print "ERROR-PAR-HR_SYN : 061 : patch rules $patchRules do not exist\n";
    return;
  }
}
if ( $slangPlugin ne "" && $slangPlugin ne "slang" && ! -f $slangPlugin ) {
  print "ERROR-PAR-HR_SYN : 062 : slang plugin $slangPlugin does not exist\n";
  return;
}

#<!-- the liberty, exactly as synthesize picks it -->
unless ( @libFiles ) {
  @libFiles = @SYNTH_LIBERTY_LIST if ( @SYNTH_LIBERTY_LIST );
}
unless ( @libFiles ) {
  print "ERROR-PAR-HR_SYN : 004 : no liberty given and none set by get_std_cell_libs --set\n";
  print "ERROR-PAR-HR_SYN : 005 : either pass -liberty <file>, or\n";
  print "ERROR-PAR-HR_SYN : 006 :   read_library_config -config <library.config> -foundary <fab> -technode <node>\n";
  print "ERROR-PAR-HR_SYN : 007 :   get_std_cell_libs -vt <flavour> -corner <pattern> --first --set\n";
  return;
}
#<!-- yosys_bottom_up takes one liberty.  Several would mean one dfflibmap and
#     one abc per file, which is not what its script does. -->
if ( scalar(@libFiles) > 1 ) {
  print "WARN-PAR-HR_SYN : 008 : " . scalar(@libFiles) . " liberty files given; using the first\n";
}
my $liberty = $libFiles[0];
unless ( -f $liberty ) {
  print "ERROR-PAR-HR_SYN : 009 : liberty $liberty does not exist\n";
  return;
}

#<!-- Checked here and not at the point of use: extraction is a scan of a
#     gigabyte-scale dump, and discovering a missing argument after it has run
#     wastes a minute to say something that was knowable at the start. -->
my $bbArg = "";
if ( defined $blackbox && $blackbox ne "" ) {
  unless ( -f $blackbox ) {
    print "ERROR-PAR-HR_SYN : 018 : blackbox file $blackbox does not exist\n";
    return;
  }
  $bbArg = "--blackbox $blackbox";
}
elsif ( defined $LIBCFG_CELL_STUBS && $LIBCFG_CELL_STUBS ne "" ) {
  #<!-- The config carries a prebuilt file for this node.  Preferred over
  #     building our own: one file for every design on the node, and the
  #     several hundred LEFs are read once rather than once per design. -->
  $blackbox = $LIBCFG_CELL_STUBS;
  $bbArg    = "--blackbox $blackbox";
  print "INFO-PAR-HR_SYN : 053 : cell stubs from the config: $blackbox\n";
}
elsif ( defined $LIBCFG_FILE && $LIBCFG_FILE ne "" ) {
  #<!-- Built from the same config, foundry, node and layer read_library_config
  #     was given.  A netlist that instantiates library cells directly needs
  #     these or hierarchy -check stops on every one of them. -->
  $blackbox = "$outDir/cells.v";
}
else {
  print "ERROR-PAR-HR_SYN : 019 : no -blackbox given and no library config has been read\n";
  print "ERROR-PAR-HR_SYN : 020 :   read_library_config -config <library.config> -foundary <fab> -technode <node> -layer <n>\n";
  return;
}

unless ( -d $outDir ) {
  system("mkdir -p $outDir");
  unless ( -d $outDir ) {
    print "ERROR-PAR-HR_SYN : 010 : cannot create $outDir\n";
    return;
  }
}

my $beehome = $BEEHOME;
my $levelDir = "$outDir/lvl";
my $netDir   = "$outDir/netlists";

#<!-- Step 0a: the standard cell stubs, when the caller did not supply them.
#     Built once and reused: lef_blackbox reads every LEF the config lists for
#     this foundry/node/layer, which is hundreds of files. -->
unless ( -f $blackbox || $noRun == 1 ) {
  my $bbLog = "$outDir/lef_blackbox.log";
  my $inner = "python3 $beehome/3RDBIN/lef_blackbox -o $blackbox" .
              " --config $LIBCFG_FILE --foundry $LIBCFG_FOUNDRY";
  $inner .= " --node $LIBCFG_NODE"   if ( defined $LIBCFG_NODE  && $LIBCFG_NODE  ne "" );
  $inner .= " --layer $LIBCFG_LAYER" if ( defined $LIBCFG_LAYER && $LIBCFG_LAYER ne "" );
  my $cmd = &dbfElectronToolCommand("python3", $inner, $bbLog);
  unless ( defined $cmd ) {
    print "ERROR-PAR-HR_SYN : 036 : no python3 on PATH and no container image to run it in\n";
    return;
  }
  print "INFO-PAR-HR_SYN : 037 : building standard cell stubs from the LEFs\n";
  system($cmd);
  unless ( -f $blackbox ) {
    print "ERROR-PAR-HR_SYN : 038 : no stubs written; see $bbLog\n";
    return;
  }
}
$bbArg = "--blackbox $blackbox" if ( $bbArg eq "" );

#<!-- Step 0b: a liberty yosys can actually read.  The CCS/LVF liberties a
#     modern PDK ships are gigabytes and gzipped, and yosys parses neither --
#     it stops on a group whose name contains a colon.  liberty_slim drops the
#     signoff-only groups, which is all yosys needed gone. -->
if ( $liberty =~ /\.gz$/ ) {
  my $slim = "$outDir/" . "liberty_slim.lib";
  #<!-- Computed even under --no_run, so the command printed there is the one
  #     that would actually run.  Printing the .gz would be a lie: yosys cannot
  #     read it, which is the entire reason this step exists. -->
  unless ( -f $slim || $noRun == 1 ) {
    my $slLog = "$outDir/liberty_slim.log";
    my $inner = "python3 $beehome/3RDBIN/liberty_slim -o $slim $liberty";
    my $cmd = &dbfElectronToolCommand("python3", $inner, $slLog);
    unless ( defined $cmd ) {
      print "ERROR-PAR-HR_SYN : 039 : no python3 on PATH and no container image to run it in\n";
      return;
    }
    print "INFO-PAR-HR_SYN : 040 : slimming $liberty for yosys\n";
    system($cmd);
  }
  if ( ! -f $slim && $noRun != 1 ) {
    print "ERROR-PAR-HR_SYN : 041 : could not slim $liberty; see $outDir/liberty_slim.log\n";
    return;
  }
  $liberty = $slim;
}

#<!-- Step 0c: elaborate, keeping one module per instance.  --keep-hierarchy is
#     the whole point: without it yosys flattens and the placer gets back the
#     one enormous module it cannot help with.
#
#     The relaxations are not optional on real RTL. Every one of them was added
#     because a vendor IP in a real filelist stopped the front end dead: an
#     identifier used before its declaration, an SVA, a duplicate definition, a
#     loop that outruns the unroll limit. -slang_args appends more. -->
#
#     Which plugin.  The suite's own build cannot do $clog2 of a procedural
#     variable or an escaped instance name under --keep-hierarchy, and each of
#     those had been costing a patched copy of somebody's RTL; make
#     slang-plugin builds one that can (INSTALL/slang/build_plugin.sh).  An
#     image rebuilt since carries it as plain "slang".
#
#     --ignore-unknown-modules is gone from upstream: an instantiated module
#     with no definition is now an error, which is the right answer -- the
#     flag had been turning a missing file into an empty box.  So it is
#     passed only to a plugin that still takes it, found out by asking. -->
if ( defined $rtlList && $rtlList ne "" && $noRun != 1 ) {
  $rtlil = "$outDir/design.il" unless ( defined $rtlil && $rtlil ne "" );
  unless ( -f $rtlil ) {
    if ( $slangPlugin eq "" ) {
      if ( defined $ENV{ELECTRON_SLANG_PLUGIN} && $ENV{ELECTRON_SLANG_PLUGIN} ne "" ) {
        $slangPlugin = $ENV{ELECTRON_SLANG_PLUGIN};
      }
      elsif ( -f "$beehome/INSTALL/slang/slang.so" ) {
        $slangPlugin = "$beehome/INSTALL/slang/slang.so";
      }
      else { $slangPlugin = "slang"; }
    }
    print "INFO-PAR-HR_SYN : 063 : yosys-slang plugin: $slangPlugin\n";

    #<!-- -patch: the copies and the list that points at them go in the work
    #     directory; the RTL itself is never touched. -->
    my $elabList = $rtlList;
    if ( $patchRules ne "" ) {
      my $patchDir = "$outDir/rtl";
      my $base = $rtlList; $base =~ s/.*\///;
      unlink("$patchDir/$base");
      my $inner = "python3 $beehome/3RDBIN/rtl_patch --filelist $rtlList" .
                  " --rules $patchRules --out $patchDir";
      my $cmd = &dbfElectronToolCommand("python3", $inner, "$outDir/patch.log");
      unless ( defined $cmd ) {
        print "ERROR-PAR-HR_SYN : 064 : no python3 on PATH and no container image to run it in\n";
        return;
      }
      print "INFO-PAR-HR_SYN : 065 : patching $rtlList by $patchRules\n";
      system($cmd);
      unless ( -f "$patchDir/$base" ) {
        print "ERROR-PAR-HR_SYN : 066 : patching failed; see $outDir/patch.log\n";
        return;
      }
      $elabList = "$patchDir/$base";
    }

    my $probe = "$outDir/slang_probe.sv";
    open(my $pf, ">", $probe);
    print $pf "module slang_probe; endmodule\n";
    close($pf);
    my $probeCmd = &dbfElectronToolCommand("yosys",
        "yosys -m $slangPlugin -p \"read_slang --ignore-unknown-modules $probe\"",
        "$outDir/slang_probe.log");
    #<!-- Not -q: that hides the diagnostic naming the flag and leaves only
    #     "elaboration failed", which says nothing about why. -->
    my $unknownFlag = " --ignore-unknown-modules";
    if ( defined $probeCmd ) {
      system("$probeCmd > /dev/null");
      if ( open(my $pl, "<", "$outDir/slang_probe.log") ) {
        while ( <$pl> ) {
          if ( /ignore-unknown-modules.*no longer supported/ ) { $unknownFlag = ""; last; }
        }
        close($pl);
      }
    }
    if ( $unknownFlag eq "" ) {
      print "INFO-PAR-HR_SYN : 067 : this plugin requires a definition for every module;" .
            " a missing one is an error, not an empty box\n";
    }

    my $elabLog = "$outDir/elaborate.log";
    my $common = " --single-unit$unknownFlag" .
                 " --ignore-assertions --allow-use-before-declare" .
                 " --allow-hierarchical-const --relax-enum-conversions --compat vcs" .
                 " --unroll-limit 200000 --error-limit 50" .
                 " -Wno-range-width-oob -Wno-duplicate-definition" .
                 " -Wno-unconnected-inout-port";
    #<!-- -Wno-unconnected-inout-port: the cell stubs carry the power pins and
    #     RTL never connects them, so slang warns once per cell instance --
    #     3.26 million lines, 1.9 GB, on one design, copied into every log
    #     downstream of this one.  Nothing else ever triggered it. -->
    my $flags = "--keep-hierarchy$common";

    #<!-- -leaf_wrappers: --keep-hierarchy makes a module per INSTANCE, and a
    #     library that wraps each hand-placed cell in a module of its own turns
    #     every such cell into a module -- 97% of one design's 907,000, and
    #     over half an hour of elaboration.  Blackboxed, they cost nothing
    #     here; rtlil_leaf_wrappers then puts each parameter set's contents
    #     back, elaborated once. -->
    my $wrapList = "";
    my $dumpTo = $rtlil;
    if ( $leafWrappers ne "" ) {
      $wrapList = "$outDir/leaf_wrappers.txt";
      unlink($wrapList);
      my $find = "python3 $beehome/3RDBIN/rtlil_leaf_wrappers find --filelist $elabList" .
                 " --stubs $blackbox --pattern '$leafWrappers' --out $wrapList";
      my $fcmd = &dbfElectronToolCommand("python3", $find, "$outDir/leaf_wrappers.log");
      system($fcmd) if ( defined $fcmd );
      unless ( -f $wrapList ) {
        print "ERROR-PAR-HR_SYN : 069 : finding the leaf wrappers failed; see $outDir/leaf_wrappers.log\n";
        return;
      }
      my $n = 0;
      if ( open(my $wl, "<", $wrapList) ) {
        while ( my $w = <$wl> ) { chomp($w); next if ( $w eq "" ); $flags .= " --blackboxed-module $w"; $n++; }
        close($wl);
      }
      print "INFO-PAR-HR_SYN : 070 : $n leaf wrapper(s) matching $leafWrappers elaborated once each\n";
      $dumpTo = "$rtlil.raw" if ( $n > 0 );
      $wrapList = "" if ( $n == 0 );
    }
    my $inner = "yosys -m $slangPlugin -p \"read_slang -F $elabList $blackbox --top $topModule" .
                " $flags $slangArgs ; hierarchy -check -top $topModule ;" .
                " stat -top $topModule ; write_rtlil $rtlil.part\"" .
                " && mv $rtlil.part $dumpTo";
    my $cmd = &dbfElectronToolCommand("yosys", $inner, $elabLog);
    unless ( defined $cmd ) {
      print "ERROR-PAR-HR_SYN : 042 : no yosys on PATH and no container image to run it in\n";
      return;
    }
    print "INFO-PAR-HR_SYN : 043 : elaborating $elabList, top $topModule\n";
    system($cmd);
    if ( $wrapList ne "" && -f "$rtlil.raw" ) {
      my $fill = "python3 $beehome/3RDBIN/rtlil_leaf_wrappers fill --il $rtlil.raw --out $rtlil" .
                 " --filelist $elabList --stubs $blackbox --wrappers $wrapList --top $topModule" .
                 " --yosys 'yosys -m $slangPlugin' --read-slang '$common $slangArgs'";
      my $wcmd = &dbfElectronToolCommand("python3", $fill, "$outDir/leaf_wrappers_fill.log");
      print "INFO-PAR-HR_SYN : 071 : elaborating each leaf wrapper's parameter sets once\n";
      system($wcmd) if ( defined $wcmd );
      if ( -f $rtlil ) { unlink("$rtlil.raw"); }
      else {
        print "ERROR-PAR-HR_SYN : 072 : filling the leaf wrappers failed; see $outDir/leaf_wrappers_fill.log\n";
        return;
      }
    }
  }
  unless ( -f $rtlil ) {
    print "ERROR-PAR-HR_SYN : 044 : elaboration wrote no RTLIL; see $outDir/elaborate.log\n";
    return;
  }
}

#<!-- Step 1: the distinct modules, ranked by depth.  --level all extracts
#     every level in ONE scan of the dump; one scan per level would read a
#     gigabyte file ten times over. -->
unless ( $noRun == 1 ) {
  my $extractLog = "$outDir/extract.log";
  my $inner = "python3 $beehome/3RDBIN/rtlil_bottom_up $rtlil --level all --extract $levelDir";
  my $cmd = &dbfElectronToolCommand("python3", $inner, $extractLog);
  unless ( defined $cmd ) {
    print "ERROR-PAR-HR_SYN : 011 : no python3 on PATH and no container image to run it in\n";
    return;
  }
  print "INFO-PAR-HR_SYN : 012 : grouping $rtlil into distinct modules\n";
  system($cmd);
  unless ( -f "$levelDir/DESIGN.tsv" ) {
    print "ERROR-PAR-HR_SYN : 013 : extraction wrote no DESIGN.tsv; see $extractLog\n";
    return;
  }
}

#<!-- Step 2: the latch techmap.  Built from the liberty every time rather than
#     cached, because it has to match the liberty actually being mapped to. -->
my $latchArg = "";
if ( $noLatchmap == 1 ) {
  print "WARN-PAR-HR_SYN : 014 : --no_latchmap: a latch will reach the netlist as \$_DLATCH_\n";
}
elsif ( defined $latchmap && $latchmap ne "" ) {
  unless ( -f $latchmap ) {
    print "ERROR-PAR-HR_SYN : 015 : latchmap $latchmap does not exist\n";
    return;
  }
  $latchArg = "--latchmap $latchmap";
}
else {
  $latchmap = "$outDir/latchmap.v";
  unless ( $noRun == 1 ) {
    my $lmLog = "$outDir/latchmap.log";
    my $inner = "python3 $beehome/3RDBIN/liberty_latchmap -o $latchmap $liberty";
    my $cmd = &dbfElectronToolCommand("python3", $inner, $lmLog);
    if ( defined $cmd ) {
      system($cmd);
    }
  }
  if ( -f $latchmap ) {
    $latchArg = "--latchmap $latchmap";
    print "INFO-PAR-HR_SYN : 016 : latches map through $latchmap\n";
  }
  elsif ( $noRun == 1 ) {
    #<!-- Nothing was generated because nothing was run.  Saying "no latch cell
    #     found" here would blame the liberty for the dry run. -->
    $latchArg = "--latchmap $latchmap";
    print "INFO-PAR-HR_SYN : 033 : --no_run, so $latchmap was not built yet\n";
  }
  else {
    print "WARN-PAR-HR_SYN : 017 : no latch cell found in $liberty; latches will stay unmapped\n";
  }
}

#<!-- Step 3: synthesise, deepest level first. -->
my $verifyArg = ( $noVerify == 1 ) ? "" : "--verify";
my $synthLog = "$outDir/synthesis.log";
my $inner = "python3 -u $beehome/3RDBIN/yosys_bottom_up" .
            " --levels $levelDir --liberty $liberty $bbArg" .
            " --out $netDir --jobs $jobs --flatten-below $flattenBelow" .
            " $latchArg $verifyArg";
#<!-- -abc_delay: abc's buffer / upsize / dnsize run only with a constraints
#     file, so without it every gate is the smallest that does the job and
#     nothing splits a high fanout.  yosys_bottom_up has the details. -->
if ( $abcDelay ne "" ) {
  $inner .= " --abc-delay $abcDelay";
  $inner .= " --abc-driver $abcDriver" if ( $abcDriver ne "" );
  $inner .= " --abc-load $abcLoad"     if ( $abcLoad ne "" );
  print "INFO-PAR-HR_SYN : 068 : buffering and sizing toward $abcDelay ps\n";
}

if ( $noRun == 1 ) {
  print "INFO-PAR-HR_SYN : 021 : --no_run, so nothing was started\n";
  print "INFO-PAR-HR_SYN : 022 : $inner\n";
  return;
}

my $cmd = &dbfElectronToolCommand("python3", $inner, $synthLog);
unless ( defined $cmd ) {
  print "ERROR-PAR-HR_SYN : 023 : no python3 on PATH and no container image to run it in\n";
  return;
}
print "INFO-PAR-HR_SYN : 024 : synthesising, log in $synthLog\n";
system($cmd);

unless ( -d $netDir ) {
  print "ERROR-PAR-HR_SYN : 025 : no netlists written; see $synthLog\n";
  return;
}

&dbfHierSynthReport($synthLog, $netDir, $levelDir);

#<!-- One file, because nothing in electron reads a DIRECTORY of netlists.
#     Without this the command ends with N files and the flow stops: read_verilog
#     wants a file, and hier_place wants what read_verilog loaded. -->
my $joined = "$outDir/" . "netlist.v";
unless ( &dbfHierSynthJoin($levelDir, $netDir, $joined) ) {
  return;
}

if ( defined $netlistOut && $netlistOut ne "" ) {
  my $part = "$netlistOut.part";
  my $rc = ( $netlistOut =~ /\.gz$/ ) ? system("gzip -c '$joined' > '$part'")
                                      : system("cp '$joined' '$part'");
  if ( $rc != 0 || ! -s $part || ! rename($part, $netlistOut) ) {
    print "ERROR-PAR-HR_SYN : 048 : could not write $netlistOut\n";
    unlink($part);
    return;
  }
  print "INFO-PAR-HR_SYN : 049 : netlist written to $netlistOut\n";
}

if ( $readBack == 1 ) {
  #<!-- The top is whatever the deepest level held.  With -rtlil the caller
  #     never said, so it is taken from what the synthesis reported rather
  #     than guessed from the file names. -->
  my $top = $topModule;
  $top = &dbfHierSynthTop($synthLog) unless ( defined $top && $top ne "" );
  unless ( defined $top && $top ne "" ) {
    print "ERROR-PAR-HR_SYN : 050 : cannot tell which module is the top, so --read is skipped\n";
    return;
  }
  print "INFO-PAR-HR_SYN : 051 : reading $joined back in, top $top\n";
  &read_verilog("-v", $joined);
  $TOP_MODULE = $top;
  &elaborate();
}

return;

}# sub hier_synthesis
#------------------------------------------------------------------------------------------#
#<!-- What came out.  The numbers are read back from the log rather than
#     recomputed: yosys_bottom_up --verify reloads every netlist and lets yosys
#     walk the hierarchy, which is the only count that proves the netlists
#     COMPOSE -- that every child is defined with the ports its parent expects.
#     No per-module run can check that, each having seen its children as
#     blackboxes. -->
sub dbfHierSynthReport {
my ($logFile, $netDir, $levelDir) = @_;

#<!-- Counted from the level manifests, not by globbing *.v.  yosys_bottom_up
#     also drops a pruned standard-cell stub file in there, and a glob counts
#     it as a module netlist -- six where five were written. -->
my $n = 0;
foreach my $man ( glob("$levelDir/lvl*/MODULES.tsv") ) {
  next unless ( open(HSYN_C, "<$man") );
  while ( my $line = <HSYN_C> ) {
    next if ( $line =~ /^#/ );
    chomp($line);
    my ($name) = split(/\t/, $line);
    $n++ if ( defined $name && $name ne "" && -f "$netDir/$name.v" );
  }
  close(HSYN_C);
}
print "INFO-PAR-HR_SYN : 026 : $n netlist(s) in $netDir\n";

unless ( -f $logFile && open(HSYN_LOG, "<$logFile") ) {
  print "WARN-PAR-HR_SYN : 027 : no log at $logFile to report on\n";
  return;
}

my $failed = 0;
my $verified = "";
my $sequential = "";
my $unmapped = "";
while ( my $line = <HSYN_LOG> ) {
  chomp($line);
  if ( $line =~ /(\d+) failed/ ) { $failed += $1; }
  if ( $line =~ /verified in .* -- (.*)$/ ) { $verified = $1; }
  if ( $line =~ /yosys_bottom_up: ([\d,]+ sequential.*)$/ ) { $sequential = $1; }
  if ( $line =~ /WARNING -- (.*)$/ ) { $unmapped = $1; }
}
close(HSYN_LOG);

if ( $failed > 0 ) {
  print "ERROR-PAR-HR_SYN : 028 : $failed module(s) failed to synthesise; see $logFile\n";
}
if ( $verified ne "" ) {
  print "INFO-PAR-HR_SYN : 029 : $verified\n";
}
if ( $sequential ne "" ) {
  print "INFO-PAR-HR_SYN : 030 : $sequential\n";
}
if ( $unmapped ne "" ) {
  print "WARN-PAR-HR_SYN : 031 : $unmapped\n";
  print "WARN-PAR-HR_SYN : 032 : a \$_DLATCH_ here means the latch techmap did not run\n";
}

return;

}# sub dbfHierSynthReport
#------------------------------------------------------------------------------------------#
#<!-- Every module netlist in one file, deepest level first.
#
#     Verilog does not care about definition order, but a reader does, and a
#     netlist whose leaves come first reads the way the design was built.  The
#     order comes from the level directories rather than from sorting file
#     names, which would interleave the hierarchy arbitrarily.
#
#     Standard cell stubs are NOT included: write_verilog leaves blackboxes
#     out, and the cells come from the LEF on the electron side. -->
sub dbfHierSynthJoin {
my ($levelDir, $netDir, $joined) = @_;

my @levels = sort { $a <=> $b }
             map { /lvl(\d+)$/ ? $1 : () } glob("$levelDir/lvl*");
unless ( @levels ) {
  print "ERROR-PAR-HR_SYN : 045 : no level directories under $levelDir\n";
  return 0;
}

unless ( open(HSYN_OUT, ">$joined") ) {
  print "ERROR-PAR-HR_SYN : 046 : cannot write $joined : $!\n";
  return 0;
}
print HSYN_OUT "// Hierarchical netlist, written by hier_synthesis.\n";
print HSYN_OUT "// One module per distinct structure, deepest level first.\n";
print HSYN_OUT "// Standard cells are not defined here; they come from the LEF.\n\n";

my $count = 0;
foreach my $lvl ( @levels ) {
  my $man = "$levelDir/lvl$lvl/MODULES.tsv";
  next unless ( -f $man );
  next unless ( open(HSYN_MAN, "<$man") );
  while ( my $line = <HSYN_MAN> ) {
    next if ( $line =~ /^#/ );
    chomp($line);
    my ($name) = split(/\t/, $line);
    next unless ( defined $name && $name ne "" );
    my $v = "$netDir/$name.v";
    next unless ( -f $v );
    next unless ( open(HSYN_V, "<$v") );
    while ( my $l = <HSYN_V> ) { print HSYN_OUT $l; }
    close(HSYN_V);
    print HSYN_OUT "\n";
    $count++;
  }
  close(HSYN_MAN);
}
close(HSYN_OUT);

if ( $count == 0 ) {
  print "ERROR-PAR-HR_SYN : 047 : no module netlists found under $netDir\n";
  return 0;
}
print "INFO-PAR-HR_SYN : 052 : joined $count module(s) into $joined\n";
return 1;

}# sub dbfHierSynthJoin
#------------------------------------------------------------------------------------------#
#<!-- The top module, from what the synthesis reported.  Needed by --read when
#     the caller started from -rtlil and never named one. -->
sub dbfHierSynthTop {
my ($logFile) = @_;
return undef unless ( -f $logFile && open(HSYN_T, "<$logFile") );
my $top;
while ( my $line = <HSYN_T> ) {
  if ( $line =~ /yosys_bottom_up: top is (\S+?);/ ) { $top = $1; }
}
close(HSYN_T);
return $top;

}# sub dbfHierSynthTop
#------------------------------------------------------------------------------------------#

1;
