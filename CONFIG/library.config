{
  "_comment": [
    "Library configuration for read_config_file and read_library_config.",
    "",
    "  read_config_file    -config CONFIG/library.config -foundary nangate -technode 45nm -layer 6",
    "  get_std_cell_libs   --first --set",
    "",
    "Paths may use $ELECTRON_HOME or any environment variable; ELECTRON_HOME",
    "falls back to the tool's own location, so this file is right in any",
    "checkout and must not name an absolute path outside the repository.",
    "",
    "Keys read_config_file understands, and nothing else:",
    "  tech            technology LEF, read with -tech only",
    "  std-cell-lefs   cell LEFs; a list, or a map of VT flavour to list",
    "  std-cell-libs   liberty paths, recorded but never opened; pick one",
    "                  with get_std_cell_libs",
    "  macro-lefs      read only with -read_macro_lefs",
    "  io-cell-lefs    read only with -read_io_lefs",
    "  cell-func-map   combinational/sequential/memory, for a flow with no liberty",
    "",
    "nangate is the only foundry configured here because it is the only one",
    "whose files are in the repository. The entries that used to sit alongside",
    "it named /home/ubuntu and /ef paths inherited from the fork and had not",
    "resolved in years; the remaining foundries are empty placeholders."
  ],

  "nangate": {
    "node": [
      {
        "type": "45nm",
        "files": [
          {
            "layer": "6",
            "tech": "$ELECTRON_HOME/TESTS/library/NangateOpenCellLibrary_PDKv1_2_v2008_10.lef",
            "std-cell-lefs": [
              "$ELECTRON_HOME/TESTS/library/NangateOpenCellLibrary_PDKv1_2_v2008_10.lef"
            ],
            "std-cell-libs": [
              "$ELECTRON_HOME/TESTS/library/NangateOpenCellLibrary_PDKv1_2_v2008_10_slow_conditional_ecsm.lib"
            ]
          }
        ]
      }
    ]
  },

  "tsmc": {},
  "global foundry": {},
  "umc": {},
  "smic": {},
  "on semi": {}
}
