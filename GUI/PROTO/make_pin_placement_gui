####################################### bus recognition for the pin planner ###############################################
#<!-- Two spellings of a bus bit are recognised:
#
#       data[3]    the bracket form, as written in Verilog and in the pseudo DB
#       data_3_    the flattened form, which is what a DEF carries once the
#                  brackets have been escaped away
#
#     A bare trailing "_3" is deliberately NOT treated as a bus bit.  It cannot
#     be told apart from a scalar that simply ends in a digit, stage_2 and
#     sync_1 being the usual casualties, and wrongly gluing those into a bus is
#     worse than leaving a real bus split.
#
#     Returns (base, bit, style) or the empty list when the name is not a bus
#     bit.  style is what regenerates the original spelling later. -->
sub pinBusBaseBit {

my $pin = $_[0];
unless ( defined $pin && $pin ne "" ) {
  return ();
}
if ( $pin =~ m/^(.+)\[(\d+)\]$/ ) {
  return ($1, $2, "bracket");
}
if ( $pin =~ m/^(.+)_(\d+)_$/ ) {
  return ($1, $2, "underscore");
}
return ();

}#sub pinBusBaseBit


#<!-- Rebuild one bit's name in the spelling its bus was written in. -->
sub pinBusBitName {

my ($base, $bit, $style) = @_;
if ( defined $style && $style eq "underscore" ) {
  return $base . "_" . $bit . "_";
}
return $base . "[" . $bit . "]";

}#sub pinBusBitName


#<!-- Collapse bus bits into one entry per bus, labelled base[msb:lsb] whatever
#     spelling the bits used, and remember the members so a selection can be
#     turned back into real pin names.  Anything that is not a bus bit, and any
#     bus that turned out to have a single bit, passes through untouched. -->
sub groupPinsIntoBuses {

my @pins = @_;
my %bits = ();
my %style = ();
my @single = ();

foreach my $pin ( @pins ) {
  my ($base, $bit, $sty) = &pinBusBaseBit($pin);
  if ( defined $base ) {
    push(@{$bits{$base}}, $bit);
    #<!-- first spelling seen wins, so a bus written both ways stays readable -->
    $style{$base} = $sty unless ( exists $style{$base} );
  }
  else {
    push(@single, $pin);
  }
}

my @out = ();
foreach my $base ( sort keys %bits ) {
  my @b = sort { $a <=> $b } @{$bits{$base}};
  if ( @b == 1 ) {
    #<!-- a lone bit is not a bus, put its real name back -->
    push(@out, &pinBusBitName($base, $b[0], $style{$base}));
    next;
  }
  my $label = $base . "[" . $b[-1] . ":" . $b[0] . "]";
  $PIN_BUS_MEMBERS{$label} =
      [ map { &pinBusBitName($base, $_, $style{$base}) } @b ];
  push(@out, $label);
}

push(@out, sort @single);
return (@out);

}#sub groupPinsIntoBuses


#<!-- A guide records real pin names, since guidePin passes them straight
#     through to the database.  Turn any grouped label back into its bits. -->
sub expandBusSelection {

my @sel = @_;
my @out = ();
foreach my $item ( @sel ) {
  if ( exists $PIN_BUS_MEMBERS{$item} ) {
    push(@out, @{$PIN_BUS_MEMBERS{$item}});
  }
  else {
    push(@out, $item);
  }
}
return (@out);

}#sub expandBusSelection


#<!-- What is currently assigned, as "<pin or bus> (<guide>)" lines for the
#     assigned list.  Bits are collapsed for display so a 32 bit bus reads as one
#     row, but this deliberately does NOT record into PIN_BUS_MEMBERS: only part
#     of a bus may be assigned, and a partial label there would make
#     expandBusSelection hand the wrong bits to guidePin. -->
sub assignedPinDisplayList {

my @out = ();
foreach my $guide ( sort keys %TEMP_PIN_HASH ) {
  my $pinRef = $TEMP_PIN_HASH{$guide};
  unless ( defined $pinRef && @$pinRef > 0 ) {
    next;
  }
  my %bits = ();
  my %style = ();
  my @single = ();
  foreach my $pin ( @$pinRef ) {
    my ($base, $bit, $sty) = &pinBusBaseBit($pin);
    if ( defined $base ) {
      push(@{$bits{$base}}, $bit);
      $style{$base} = $sty unless ( exists $style{$base} );
    }
    else {
      push(@single, $pin);
    }
  }
  #<!-- $busBase, not $b: a "sort { $a <=> $b }" inside a loop over "my $b"
  #     would compare against the loop variable instead of the sort operand -->
  foreach my $busBase ( sort keys %bits ) {
    my @n = sort { $a <=> $b } @{$bits{$busBase}};
    #<!-- one label per contiguous run, so assigning bits 3 and 1 reads as
    #     data[3] data[1] and not as the whole of data[3:1] -->
    my @run = ();
    for ( my $i = 0; $i <= $#n; $i++ ) {
      push(@run, $n[$i]);
      next if ( $i < $#n && ($n[$i+1] - $n[$i]) == 1 );
      if ( @run == 1 ) {
        push(@out, &pinBusBitName($busBase, $run[0], $style{$busBase}) . "  ($guide)");
      }
      else {
        push(@out, $busBase . "[" . $run[-1] . ":" . $run[0] . "]  ($guide)");
      }
      @run = ();
    }
  }
  foreach my $pin ( sort @single ) {
    push(@out, "$pin  ($guide)");
  }
}
return (@out);

}#sub assignedPinDisplayList


####################################### menu entry point for the pin planner ##############################################
#<!-- create_pinPlace_popup is otherwise only reachable by holding p and right
#     clicking a module on the canvas, which resolves the module from what was
#     clicked.  A menu entry has nothing clicked, so it plans the module being
#     edited, which is the case create_pinList already special cases: for
#     TOP_MODULE it lists the real ports out of PORTS_ALREADY.
#
#     The popup only records pin guides, through createPinGuide and guidePin.
#     Turning them into pin locations is hier_place_pins --honorPinGuide, which
#     ignores the guides without that switch, so say so on the way in. -->
sub hier_pin_planner {

unless ( defined $TOP_MODULE && $TOP_MODULE ne "" ) {
  print "WARN-GUI-PIN_PLAN : 001 : no module is being edited, run edit_module first\n";
  return;
}
unless ( exists $PSEUDO_MODULE_ALREADY{$TOP_MODULE} ) {
  print "WARN-GUI-PIN_PLAN : 002 : module $TOP_MODULE is not loaded for editing, run edit_module -module $TOP_MODULE\n";
  return;
}

print "INFO-GUI-PIN_PLAN : 003 : planning pins of $TOP_MODULE\n";
print "INFO-GUI-PIN_PLAN : 004 : guides are applied by hier_place_pins --honorPinGuide\n";
&create_pinPlace_popup($TOP_MODULE);

}#sub hier_pin_planner

###################################### Subroutine to calculate no. of Pins for current Module #############################
#<!-- The real per bit names behind one list entry.  A grouped bus knows its
#     members exactly when groupPinsIntoBuses made it, which is the only way an
#     underscore spelled bus can be expanded; a base[hi:lo] label from the cell
#     or pseudo database is bracket spelled and splits arithmetically. -->
sub pinEntryMembers {

my $entry = $_[0];
if ( exists $PIN_BUS_MEMBERS{$entry} ) {
  return (@{$PIN_BUS_MEMBERS{$entry}});
}
if ( $entry =~ m/\[\d+:\d+\]/ ) {
  return (&utilSplitBusBits($entry));
}
return ($entry);

}#sub pinEntryMembers


#<!-- Collapse the bits of a partly assigned bus back into contiguous labels,
#     keeping the bit order and the spelling the original label used, and record
#     the members so expandBusSelection can turn a selection back into real pin
#     names.  A run of one bit is emitted as that bit, not as a one wide bus. -->
sub regroupBusBits {

my ($label, @members) = @_;
my $descending = 0;
if ( $label =~ m/\[(\d+):(\d+)\]/ ) {
  $descending = ( $1 > $2 );
}

my @out = ();
my %bit = ();
my $base = "";
my $style = "";
foreach my $m ( @members ) {
  my ($b, $n, $sty) = &pinBusBaseBit($m);
  unless ( defined $b ) {
    #<!-- not a bus bit after all, pass it through -->
    push(@out, $m);
    next;
  }
  $base = $b;
  $style = $sty if ( $style eq "" );
  $bit{$n} = 1;
}
return (@out) if ( $base eq "" );

my @nums = sort { $a <=> $b } keys %bit;
my @run = ();
my @runs = ();
for ( my $i = 0; $i <= $#nums; $i++ ) {
  push(@run, $nums[$i]);
  if ( $i == $#nums || ($nums[$i+1] - $nums[$i]) != 1 ) {
    push(@runs, [@run]);
    @run = ();
  }
}

foreach my $r ( @runs ) {
  my @n = @$r;
  if ( $#n == 0 ) {
    push(@out, &pinBusBitName($base, $n[0], $style));
    next;
  }
  my $range = $descending ? "$n[-1]:$n[0]" : "$n[0]:$n[-1]";
  my $newLabel = $base . "[" . $range . "]";
  my @order = $descending ? reverse @n : @n;
  $PIN_BUS_MEMBERS{$newLabel} =
      [ map { &pinBusBitName($base, $_, $style) } @order ];
  push(@out, $newLabel);
}
return (@out);

}#sub regroupBusBits


sub create_pinList {
my $module = $_[0];
my $mode = $_[1];
my $showAll = $_[2];
my $pattern = $_[3];

my @pins = ();
my @temp = ();
if($mode eq "SplitMode"){$mode = "BusMode";}
elsif($mode eq "BusMode"){$mode = "SplitMode";}

if($module eq $TOP_MODULE){
   if(exists $PORTS_ALREADY{$module}){
      #<!-- PORTS_ALREADY holds one entry per bit, so this list was flat in both
      #     modes and the bus toggle did nothing for the module being edited.
      #     Collapse the bits in BusMode, recognising both data[3] and data_3_. -->
      @pins = keys %{$PORTS_ALREADY{$module}};
      if($mode eq "BusMode"){
         @pins = &groupPinsIntoBuses(@pins);
      }else{
         @pins = sort @pins;
      }
   }elsif(exists $PSEUDO_MODULE_ALREADY{$module}){
       if($mode eq "SplitMode"){  
          my @inputPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInput;
          my @outputPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetOutput; 
          my @bidiPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidi; 
          push (@pins,@inputPins,@outputPins,@bidiPins); 
       }elsif($mode eq "BusMode"){
          my @inPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInput;
          foreach my $pin(@inPins){
            my $type = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInputType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInputBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}#if type 1(bus)
          }#foreach inpin
          my @outPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetOutput;
          foreach my $pin(@outPins){
            my $type = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetOutputType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetOutputBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}#if type 1(bus)
          }#foreach outpin
          my @bidiPins = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidi;
          foreach my $pin(@bidiPins){
            my $type = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidiType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidiBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}#if type 1(bus)
          }#foreach bidipin
       }
   }
}elsif(exists $PSEUDO_VINST_ALREADY{$TOP_MODULE}{$module}){  
   my $cellref = $PSEUDO_VINST_ALREADY{$TOP_MODULE}{$module}->dbPimDBGetInstCellref;
   if(exists $PLDB{$cellref}){
      if($mode eq "SplitMode"){
         @pins = $PLDB{$cellref}->dbMdbGetPins; 
      }elsif($mode eq "BusMode"){
         my @pinArray = $PLDB{$cellref}->dbMdbGetPins; 
         foreach(sort@pinArray){
           my $width = $PLDB{$cellref}->dbMdbGetPinBusWidth($_);
           if($width == 1){
              my $baseName = $PLDB{$cellref}->dbMdbGetPinBusBaseName($_);
              if($#temp >= -1){ 
                 if($temp[-1] ne $baseName){
                    my $bits = $PLDB{$cellref}->dbMdbGetPinBusBits($baseName);
                    push(@pins, $baseName.$bits);
                    push(@temp, $baseName);
                 }
              }else{
                 my $bits = $PLDB{$cellref}->dbMdbGetPinBusBits($baseName);
                 push(@pins, $baseName.$bits);
                 push(@temp, $baseName);
              }
           }else{push(@pins,$_);}
         }#foreach pin 
      }#if bus mode
   }elsif(exists $PSEUDO_MODULE_ALREADY{$cellref}){
       if($mode eq "SplitMode"){  
          my @inputPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetInput;
          my @outputPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetOutput; 
          my @bidiPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetBidi; 
          push (@pins,@inputPins,@outputPins,@bidiPins); 
       }elsif($mode eq "BusMode"){
          my @inPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetInput;
          foreach my $pin(@inPins){
            my $type = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetInputType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetInputBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}#if type 1(bus)
          }#foreach inpin
          my @outPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetOutput;
          foreach my $pin(@outPins){
            my $type = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetOutputType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetOutputBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}#if type 1(bus)
          }#foreach output
          my @bidiPins = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetBidi;
          foreach my $pin(@bidiPins){
            my $type = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetBidiType($pin);
            if($type == 1){
               my $bits = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetBidiBits($pin);
               push(@pins, $pin.$bits);
            }else{push(@pins, $pin);}
          }#foreach bidipin
       }#if bus mode
   }#if exists in pesudo
}#if module

#<!-- Subtract what is already assigned, so a pin given to a guide leaves this
#     list.  The entries here are either plain pin names or grouped bus labels,
#     while TEMP_PIN_HASH always holds real per bit names, so each entry is
#     expanded to its members, the assigned members are dropped, and whatever is
#     left is grouped back up.  A bus with some bits assigned therefore stays,
#     showing only its free bits.
#
#     The previous version compared the label strings directly.  That could not
#     work: the available side spells a bus msb:lsb and the assigned side built
#     its label lsb:msb, so the two were never equal and a fully assigned bus
#     never left the list. -->
if($showAll == 0){
   my %assignedPin = ();
   foreach my $guide (keys %TEMP_PIN_HASH){
      my $guidePins = $TEMP_PIN_HASH{$guide};
      next unless(defined $guidePins);
      foreach my $pin (@$guidePins){ $assignedPin{$pin} = 1; }
   }

   my @leftPins = ();
   foreach my $entry (@pins){
      next if(! defined $entry || $entry eq "");
      my @members = &pinEntryMembers($entry);
      my @free = ();
      foreach my $m (@members){ push(@free,$m) unless(exists $assignedPin{$m}); }

      if($#free == -1){ next; }                                  #<!-- all of it is assigned -->
      if($#free == $#members){ push(@leftPins,$entry); next; }    #<!-- none of it is -->
      push(@leftPins, &regroupBusBits($entry,@free));             #<!-- part of it is -->
   }

   @pins= ();
   #<!-- quoted: a bus name typed into the search box carries [ and ], which as
   #     a live regex is either an unterminated class or a class that matches
   #     the wrong thing -->
   my $quoted = quotemeta($pattern);
   foreach(@leftPins){
         if(($_ =~ m/$quoted/i) && ($_ ne "" )){push(@pins,$_);}
   }
}#if showAll 
@pins = sort @pins;
return(@pins);
}#sub create_pinList

