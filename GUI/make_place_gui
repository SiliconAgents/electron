##########################################################################################################
############################ Creating popup Gui to run the flat graph placer #############################
##########################################################################################################
#<!-- Drives place_flat_design: write_flat_graph, then 3RDBIN/flat_graph_placer,
#     then read_flat_graph_placement.  Replaces Graywolf Placer on the Place
#     menu, which needed a graywolf binary on PATH. -->
sub flat_place {
  my $subWin = MainWindow->new();
  $subWin->title ("Flat Place");
  $subWin->geometry("380x170+0+0");

  my $fanoutLimit = "";
  my ($keepFiles, $writeOnly, $legalize) = ("", "", "");

  my $fanoutFrame = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $optFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $noteFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $buttonFrame = $subWin->Frame()->pack(-side => 'bottom');

  $fanoutFrame->Label(-text => "Fanout limit ")->pack(-side=>'left');
  $fanoutFrame->Entry(-textvariable => \$fanoutLimit, -width=>8)->pack(-side=>'left');

  $optFrame->Checkbutton(-text => "keep graph files", -variable => \$keepFiles,
                         -onvalue => "--keep", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");
  $optFrame->Checkbutton(-text => "write only", -variable => \$writeOnly,
                         -onvalue => "--write_only", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");
  #<!-- off by default: the grid snap discards the embedding's own positions and
  #     is not row legalisation, that is legalizePlace -->
  $optFrame->Checkbutton(-text => "grid snap", -variable => \$legalize,
                         -onvalue => "--legalize", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");

  $noteFrame->Label(-text => "leaves a layout plot in <top>.png",
                    -font=>"Times 8")->pack(-side=>'left');

  $buttonFrame->Button(-text=>'Run', -command => sub {
                         my @args = ();
                         if ( $fanoutLimit =~ m/^\d+$/ && $fanoutLimit > 0 ) {
                           push(@args, "-fanout_limit", $fanoutLimit);
                         }
                         if ( $legalize  ne "" ) { push(@args, $legalize); }
                         if ( $keepFiles ne "" ) { push(@args, $keepFiles); }
                         if ( $writeOnly ne "" ) { push(@args, $writeOnly); }
                         &place_flat_design(@args);
                         $subWin->destroy;
                       })->pack(-side=>"left");
  $buttonFrame->Button(-text=>'Cancel', -command => sub {$subWin->destroy;})->pack(-side=>"left");

}#sub flat_place


