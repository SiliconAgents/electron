  $degFrame->Entry(-textvariable => \$maxDegree, -width=>8)->pack(-side=>'left');
  $fixFrame->Label(-text => "Hold ")->pack(-side=>'left');
  $fixFrame->Optionmenu(-variable => \$fix,
                        -options => ["block+port", "block", "port", "status", "none"],
                        )->pack(-side=>'left');
  #<!-- ports with no location yet: require errors out, free hands them to the
  #     solver, perimeter invents evenly spaced edge locations -->
  $portFrame->Label(-text => "Unplaced ports ")->pack(-side=>'left');
  $portFrame->Optionmenu(-variable => \$ports,
                         -options => [qw/require free perimeter/])->pack(-side=>'left');
