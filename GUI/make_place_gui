##########################################################################################################
################################ Creating popup Gui to run the ePlacer ###################################
##########################################################################################################
#<!-- Drives eplacer: write_flat_graph, then 3RDBIN/eplacer, then
#     read_flat_graph_placement.  Needs the graph as well as the nodefile,
#     because eplace trades wirelength against density and the wirelength comes
#     from the edge list.  Nodes the database marks FIXED stay put, and placed
#     nodes keep their locations so the placer spreads density out from the
#     current placement instead of starting over. -->
sub eplacer_popup {
  my $subWin = MainWindow->new();
  $subWin->title ("ePlacer");
  $subWin->geometry("330x230+0+0");

  my ($iters, $density, $maxDisp, $fanout) = ("", "", "", "");
  my $fix = "status";
  my ($keepFiles, $writeOnly) = ("", "");

  my $iterFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $densFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $dispFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fanFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fixFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $optFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $noteFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $buttonFrame = $subWin->Frame()->pack(-side => 'bottom');

  $iterFrame->Label(-text => "Iterations       ")->pack(-side=>'left');
  $iterFrame->Entry(-textvariable => \$iters, -width=>8)->pack(-side=>'left');
  $densFrame->Label(-text => "Target density   ")->pack(-side=>'left');
  $densFrame->Entry(-textvariable => \$density, -width=>8)->pack(-side=>'left');
  $dispFrame->Label(-text => "Max disp    (um) ")->pack(-side=>'left');
  $dispFrame->Entry(-textvariable => \$maxDisp, -width=>8)->pack(-side=>'left');
  $fanFrame->Label(-text  => "Fanout limit     ")->pack(-side=>'left');
  $fanFrame->Entry(-textvariable => \$fanout, -width=>8)->pack(-side=>'left');

  $fixFrame->Label(-text => "Hold ")->pack(-side=>'left');
#<!-- placed holds every node that already has a location, ports and std cells
#     alike, and places only the UNPLACED ones.  status, the default, holds a
#     FIXED node only, so a design that is placed bar a few gaps gets
#     rearranged wholesale. -->
  $fixFrame->Optionmenu(-variable => \$fix,
                        -options => [qw/status placed none ports macros ports+macros/],
                        )->pack(-side=>'left');

  $optFrame->Checkbutton(-text => "keep files", -variable => \$keepFiles,
                         -onvalue => "--keep", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");
  $optFrame->Checkbutton(-text => "write only", -variable => \$writeOnly,
                         -onvalue => "--write_only", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");

  $noteFrame->Label(-text => "Hold=placed keeps the placement and fills only the gaps",
                    -font=>"Times 8")->pack(-side=>'left');

  $buttonFrame->Button(-text=>'Run', -command => sub {
                         my @args = ();
                         if ( $iters   =~ m/^\d+$/ )            { push(@args, "-iters", $iters); }
                         if ( $density =~ m/^\d+(\.\d+)?$/ )    { push(@args, "-target_density", $density); }
                         if ( $maxDisp =~ m/^\d+(\.\d+)?$/ )    { push(@args, "-max_displacement", $maxDisp); }
                         if ( $fanout  =~ m/^\d+$/ && $fanout > 0 ) { push(@args, "-fanout_limit", $fanout); }
                         if ( defined $fix && $fix ne "" )      { push(@args, "-fix", $fix); }
                         if ( $keepFiles ne "" ) { push(@args, $keepFiles); }
                         if ( $writeOnly ne "" ) { push(@args, $writeOnly); }
                         &eplacer(@args);
                         $subWin->destroy;
                       })->pack(-side=>"left");
  $buttonFrame->Button(-text=>'Cancel', -command => sub {$subWin->destroy;})->pack(-side=>"left");

}#sub eplacer_popup


#<!-- Min-cut bisection.  Same files and same seeding as the ePlacer popup, so
#     the two can be run one after the other; what differs is the knobs, since
#     mincut has no iteration count or displacement cap.  Leaf and passes are
#     the two that matter: leaf 1 is the most uniform spread, and passes 0 skips
#     Fiduccia-Mattheyses refinement and cuts on coordinates alone, which is
#     much faster but ignores the netlist. -->
sub mincut_placer_popup {
  my $subWin = MainWindow->new();
  $subWin->title ("Min-cut Placer");
  $subWin->geometry("330x260+0+0");

  my ($leaf, $passes, $tolerance, $density, $macroArea, $fanout) = ("", "", "", "", "", "");
  my $fix = "status";
  my ($keepFiles, $writeOnly) = ("", "");

  my $leafFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $passFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $tolFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $densFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $macroFrame  = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fanFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fixFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $optFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $noteFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $buttonFrame = $subWin->Frame()->pack(-side => 'bottom');

  $leafFrame->Label(-text  => "Leaf cells       ")->pack(-side=>'left');
  $leafFrame->Entry(-textvariable => \$leaf, -width=>8)->pack(-side=>'left');
  $passFrame->Label(-text  => "FM passes        ")->pack(-side=>'left');
  $passFrame->Entry(-textvariable => \$passes, -width=>8)->pack(-side=>'left');
  $tolFrame->Label(-text   => "Area tolerance   ")->pack(-side=>'left');
  $tolFrame->Entry(-textvariable => \$tolerance, -width=>8)->pack(-side=>'left');
  $densFrame->Label(-text  => "Target density   ")->pack(-side=>'left');
  $densFrame->Entry(-textvariable => \$density, -width=>8)->pack(-side=>'left');
  $macroFrame->Label(-text => "Macro area (um2) ")->pack(-side=>'left');
  $macroFrame->Entry(-textvariable => \$macroArea, -width=>8)->pack(-side=>'left');
  $fanFrame->Label(-text   => "Fanout limit     ")->pack(-side=>'left');
  $fanFrame->Entry(-textvariable => \$fanout, -width=>8)->pack(-side=>'left');

  $fixFrame->Label(-text => "Hold ")->pack(-side=>'left');
#<!-- placed holds every node that already has a location, ports and std cells
#     alike, and places only the UNPLACED ones.  status, the default, holds a
#     FIXED node only, so a design that is placed bar a few gaps gets
#     rearranged wholesale. -->
  $fixFrame->Optionmenu(-variable => \$fix,
                        -options => [qw/status placed none ports macros ports+macros/],
                        )->pack(-side=>'left');

  $optFrame->Checkbutton(-text => "keep files", -variable => \$keepFiles,
                         -onvalue => "--keep", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");
  $optFrame->Checkbutton(-text => "write only", -variable => \$writeOnly,
                         -onvalue => "--write_only", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");

  $noteFrame->Label(-text => "uniform density.  Hold=placed fills only the gaps",
                    -font=>"Times 8")->pack(-side=>'left');

  $buttonFrame->Button(-text=>'Run', -command => sub {
                         my @args = ();
                         if ( $leaf      =~ m/^\d+$/ && $leaf > 0 )   { push(@args, "-leaf", $leaf); }
                         #<!-- 0 is a real value for passes, so test the string -->
                         if ( $passes    =~ m/^\d+$/ )                { push(@args, "-passes", $passes); }
                         if ( $tolerance =~ m/^\d*\.?\d+$/ )          { push(@args, "-tolerance", $tolerance); }
                         if ( $density   =~ m/^\d*\.?\d+$/ )          { push(@args, "-target_density", $density); }
                         if ( $macroArea =~ m/^\d*\.?\d+$/ )          { push(@args, "-macro_area", $macroArea); }
                         if ( $fanout    =~ m/^\d+$/ && $fanout > 0 ) { push(@args, "-fanout_limit", $fanout); }
                         if ( defined $fix && $fix ne "" )            { push(@args, "-fix", $fix); }
                         if ( $keepFiles ne "" ) { push(@args, $keepFiles); }
                         if ( $writeOnly ne "" ) { push(@args, $writeOnly); }
                         &mincut_placer(@args);
                         $subWin->destroy;
                       })->pack(-side=>"left");
  $buttonFrame->Button(-text=>'Cancel', -command => sub {$subWin->destroy;})->pack(-side=>"left");

}#sub mincut_placer_popup


#<!-- Seed placement through an anchor hypergraph.  Two stages behind one
#     button, so the popup is split the same way: the top group shapes the
#     hypergraph, the bottom group places it.
#
#     Trust types is left on "auto" on purpose.  It decides whether the anchor
#     stage believes electron's TYPE= column about what is a flop, and forcing it
#     on with an undescribed library hides every flop while forcing it off
#     throws away a good liberty.  seedPlace works it out from the database and
#     prints which way it went. -->
sub seed_place_popup {
  my $subWin = MainWindow->new();
  $subWin->title ("Seed Placer");
  $subWin->geometry("380x560+0+0");

  my ($minEdge, $maxEdge, $maxCone, $blockArea, $seqRegex) = ("", "", "", "", "");
  my ($iters, $density, $margin, $maxDegree, $fanout) = ("", "", "", "", "");
  my ($mcPasses, $mcLeaf, $mcTolerance, $mcJobs) = ("", "", "", "");
  my $mcPartitioner = "auto";
  my $noMincut = "";
  my $ports = "require";
  my $split = "equal";
  my $breakLoops = "greedy";
  my $trust = "auto";
  my $fix = "block+port";
  my ($noPortAnchors, $noFillers, $keepFiles, $writeOnly) = ("", "", "", "");

  $subWin->Label(-text => "anchor hypergraph", -font=>"Times 10 bold",
                 -foreground=>"navy")->pack(-side=>'top', -anchor=>'w');
  my $splitFrame  = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $edgeFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $coneFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $areaFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $seqFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $loopFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $trustFrame  = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $anchOptFrame= $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');

  #<!-- stage two: bisect the anchors so stage three does not start with the
  #     whole design collapsed on the die centre -->
  $subWin->Label(-text => "bisection seed", -font=>"Times 10 bold",
                 -foreground=>"navy")->pack(-side=>'top', -anchor=>'w');
  my $mcSkipFrame = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $mcPassFrame = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $mcLeafFrame = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $mcPartFrame = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');

  $mcSkipFrame->Checkbutton(-text => "skip the bisection", -variable => \$noMincut,
                         -onvalue => "--no_mincut", -offvalue => "",
                         -font=>"Times 10 bold")->pack(-side=>"left");
  $mcPassFrame->Label(-text  => "FM passes      ")->pack(-side=>'left');
  $mcPassFrame->Entry(-textvariable => \$mcPasses, -width=>8)->pack(-side=>'left');
  $mcLeafFrame->Label(-text  => "Leaf anchors   ")->pack(-side=>'left');
  $mcLeafFrame->Entry(-textvariable => \$mcLeaf, -width=>8)->pack(-side=>'left');
  $mcPartFrame->Label(-text  => "Partitioner    ")->pack(-side=>'left');
  $mcPartFrame->Optionmenu(-variable => \$mcPartitioner,
                           -options => [qw/auto metis fm none/])->pack(-side=>'left');
  $mcPartFrame->Label(-text  => " jobs ")->pack(-side=>'left');
  $mcPartFrame->Entry(-textvariable => \$mcJobs, -width=>4)->pack(-side=>'left');

  $subWin->Label(-text => "placement", -font=>"Times 10 bold",
                 -foreground=>"navy")->pack(-side=>'top', -anchor=>'w');
  my $iterFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $densFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $margFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $degFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fixFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $portFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $fanFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $optFrame    = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $noteFrame   = $subWin->Frame()->pack(-side => 'top', -anchor=>'n', -fill=>'x');
  my $buttonFrame = $subWin->Frame()->pack(-side => 'bottom');

  $splitFrame->Label(-text => "Area split     ")->pack(-side=>'left');
  $splitFrame->Optionmenu(-variable => \$split,
