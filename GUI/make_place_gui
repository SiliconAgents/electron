  $seqFrame->Entry(-textvariable => \$seqRegex, -width=>16)->pack(-side=>'left');
  $loopFrame->Label(-text  => "Break loops    ")->pack(-side=>'left');
  $loopFrame->Optionmenu(-variable => \$breakLoops,
                         -options => [qw/greedy dfs none/])->pack(-side=>'left');
