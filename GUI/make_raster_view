#<!-- raster_view: look at a large design without making a canvas item per cell.
#
#     THE PROBLEM IT AVOIDS
#
#     The flat view in make_worldCan_def_gui walks "keys %CADB" and calls
#     createRectangle once per instance.  Measured on this machine that is
#     3.0us an item, so 3.4 million instances -- TESTS/large mxu_1024 -- is ten
#     seconds before anything appears, a canvas item struct each for as long as
#     the window is open, and every pan and zoom walking all of them again.
#
#     Rasterising is O(pixels) instead of O(cells).  3RDBIN/def_raster turns
#     3.4 million cells into a 1200x1200 PNG in 0.53s, and Tk puts that on a
#     canvas as ONE item in 0.023s.
#
#     SVG was the other idea and it is worse, not better: one <rect> per cell
#     is the same retained-mode problem moved into an XML parser, and the file
#     for that design is 196MB.  Measured before writing any of this.
#
#     WHY IT IS A SEPARATE WINDOW AND NOT THE FLAT VIEW
#
#     Because the flat view works and this must not be able to break it.  Open
#     both; they share nothing.  Nothing in this file touches
#     $design_worldcanvas, design_display, or any of their state.
#
#     WHAT THE PICTURE MEANS
#
#     By default each pixel is coloured by the fraction of it covered by cell
#     area -- a utilisation map, dark blue empty through to red full.  That is
#     the right thing to show at chip level: a 3mm die drawn 1200 pixels wide
#     puts a pixel at 2.5um, and a standard cell is 0.19 to 2um wide, so the
#     cells are sub-pixel and drawing them individually would show nothing.
#     Where they are DENSE is visible, and is what you want to see.
#
#     Drag a rectangle to zoom; it re-rasterises that region, so zooming in
#     costs another half second and never gets slower. -->

#<!-- ======================================================================
#     The Raster tab.
#
#     This is where the raster lives, and the flat view is left completely
#     alone -- byte for byte the code it has always been.  That is a better
#     split than the one I tried first, which wired the raster into
#     design_display and spent two rounds breaking its zoom: the flat view owns
#     item-per-instance drawing, selection and highlight, and is what you want
#     on a design small enough to click around in.  The Raster tab owns the
#     "show me a million cells" case and owns its own zoom, so the two cannot
#     interfere.
#
#     It takes no input.  The design is already in memory -- every location and
#     every cell size -- so the tab dumps four numbers per cell and rasterises
#     that.  No DEF to write, no LEF to name, no file to browse for.
#
#     $img_canvas is a Scrolled('Canvas'), a plain one, which is exactly right
#     here: there is no WorldCanvas zoom to fight, so the viewport is ours and
#     a zoom is just a smaller rectangle handed to the rasteriser. -->

#<!-- Draw the current viewport into the Raster tab. -->
sub dbfRasterTabDraw {

return unless ( defined $img_canvas );
return unless ( @RASTER_TAB_VIEW == 4 );
return if ( $RASTER_TAB_BUSY );
$RASTER_TAB_BUSY = 1;

#<!-- canvas operations go to the real Canvas, not the Scrolled Frame around
#     it: a Frame has its own lower, which wants a window path and dies on a
#     tag.  createImage and delete have no Frame equivalent and would delegate,
#     but taking the subwidget once is simpler than remembering which is which. -->
my $cv = $img_canvas;
my $sub = eval { $img_canvas->Subwidget('scrolled') };
$cv = $sub if ( defined $sub );

my $W = $cv->width;
my $H = $cv->height;
$W = 540 if ( ! defined $W || $W < 10 );
$H = 540 if ( ! defined $H || $H < 10 );

my $ok = eval {
  my $home = $GLOBAL->dbfGlobalGetElectronHome;
  my $bin  = "$home/3RDBIN/def_raster";
  my $cmd  = ( -x $bin ) ? "$bin $RASTER_TAB_FILE $RASTER_TAB_PNG"
                         : "python3 $bin $RASTER_TAB_FILE $RASTER_TAB_PNG";
  $cmd .= " --cells --quiet --width $W --height $H";
  $cmd .= sprintf(" --bbox %.6f %.6f %.6f %.6f", @RASTER_TAB_VIEW);
  my $rc = system($cmd);
  die "the rasteriser exited with $rc\n" if ( $rc != 0 );
  die "no image was produced\n" unless ( -e $RASTER_TAB_PNG );
  $cv->delete('all');
  my $new = $cv->Photo(-file => $RASTER_TAB_PNG);
  $cv->createImage(0, 0, -anchor => 'nw', -image => $new, -tags => ['RASTER']);
  $cv->configure(-scrollregion => [0, 0, $new->width, $new->height]);
  $RASTER_TAB_PHOTO->delete if ( defined $RASTER_TAB_PHOTO );
  $RASTER_TAB_PHOTO = $new;
  1;
};
my $err = $@;
$RASTER_TAB_BUSY = 0;
unless ( $ok ) {
  $RASTER_TAB_STATUS = "could not draw: $err";
  $RASTER_TAB_STATUS =~ s/\s+$//;
  return;
}
$RASTER_TAB_STATUS = sprintf("%.1f x %.1f um  |  %.4f um per pixel  |  %d cells",
    $RASTER_TAB_VIEW[2]-$RASTER_TAB_VIEW[0],
    $RASTER_TAB_VIEW[3]-$RASTER_TAB_VIEW[1],
    ($RASTER_TAB_VIEW[2]-$RASTER_TAB_VIEW[0]) / ($W > 0 ? $W : 1),
    $RASTER_TAB_COUNT);

}# sub dbfRasterTabDraw


#<!-- Coalesce a burst of zooms into one raster.
#
#     Every wheel notch and every key repeat changes the viewport, and
#     rastering each one runs python synchronously with the Tk event loop
#     blocked -- the window would stop responding for as long as the queue took
#     and the zoom would feel broken even though each frame is right.
#
#     So the viewport moves immediately and the picture follows once the view
#     has been still for a moment.  Each new event cancels the pending draw. -->
sub dbfRasterTabSchedule {

return unless ( defined $img_canvas );
if ( defined $RASTER_TAB_AFTER ) {
  eval { $RASTER_TAB_AFTER->cancel };
  undef $RASTER_TAB_AFTER;
}
$RASTER_TAB_AFTER = $img_canvas->after(140, sub {
    undef $RASTER_TAB_AFTER;
    &dbfRasterTabDraw;
  });

}# sub dbfRasterTabSchedule


#<!-- Zoom by $fac about a point, or about the middle of the view if no point
#     is given.  Keeping the point under the cursor fixed is what makes a wheel
#     zoom feel right: you zoom into what you are pointing at, not into the
#     centre of the window, which is the one thing WorldCanvas does not do. -->
sub dbfRasterTabZoom {

my ($fac, $px, $py) = @_;
return unless ( @RASTER_TAB_VIEW == 4 && defined $fac && $fac > 0 );

my ($w, $h) = ( $RASTER_TAB_VIEW[2] - $RASTER_TAB_VIEW[0],
                $RASTER_TAB_VIEW[3] - $RASTER_TAB_VIEW[1] );
return unless ( $w > 0 && $h > 0 );
my ($nw, $nh) = ( $w / $fac, $h / $fac );

#<!-- Stop at something sensible at both ends: a few nanometres across is
#     past any cell, and a thousand times the die is a dot in a black field. -->
my ($hw, $hh) = ( $RASTER_TAB_HOME[2]-$RASTER_TAB_HOME[0],
                  $RASTER_TAB_HOME[3]-$RASTER_TAB_HOME[1] );
if ( $hw > 0 && ($nw < $hw/100000 || $nw > $hw*1000) ) { return; }

my ($fx, $fy) = (0.5, 0.5);
if ( defined $px && defined $py ) {
  my $cv = $img_canvas;
  my $sub = eval { $img_canvas->Subwidget('scrolled') };
  $cv = $sub if ( defined $sub );
  my $cw = $cv->width;  my $ch = $cv->height;
  if ( $cw > 0 && $ch > 0 ) {
    $fx = $px / $cw;
    $fy = $py / $ch;
    $fx = 0 if ( $fx < 0 ); $fx = 1 if ( $fx > 1 );
    $fy = 0 if ( $fy < 0 ); $fy = 1 if ( $fy > 1 );
  }
}
#<!-- the world point under the cursor, which must not move.  Canvas y runs
#     down and the die's y runs up, hence 1-$fy on that axis. -->
my $ux = $RASTER_TAB_VIEW[0] + $fx * $w;
my $uy = $RASTER_TAB_VIEW[1] + (1 - $fy) * $h;

@RASTER_TAB_VIEW = ( $ux - $fx * $nw,
                     $uy - (1 - $fy) * $nh,
                     $ux + (1 - $fx) * $nw,
                     $uy + $fy * $nh );
&dbfRasterTabSchedule;

}# sub dbfRasterTabZoom


#<!-- Pan by a fraction of the view. -->
sub dbfRasterTabPan {

my ($dxf, $dyf) = @_;
return unless ( @RASTER_TAB_VIEW == 4 );
my $dx = ($RASTER_TAB_VIEW[2] - $RASTER_TAB_VIEW[0]) * $dxf;
my $dy = ($RASTER_TAB_VIEW[3] - $RASTER_TAB_VIEW[1]) * $dyf;
@RASTER_TAB_VIEW = ( $RASTER_TAB_VIEW[0]+$dx, $RASTER_TAB_VIEW[1]+$dy,
                     $RASTER_TAB_VIEW[2]+$dx, $RASTER_TAB_VIEW[3]+$dy );
&dbfRasterTabSchedule;

}# sub dbfRasterTabPan


#<!-- Raising the tab.  Dumps the design if it has not been dumped, or if the
#     instance count has changed since it was, then draws it.  No arguments, no
#     files, nothing to pick. -->
sub activate_RasterTab {

return unless ( defined $img_canvas );

my $n = keys %CADB;
unless ( $n > 0 ) {
  $RASTER_TAB_STATUS = "no design loaded";
  return;
}

#<!-- the controls, built once and packed above the canvas -->
unless ( $RASTER_TAB_READY ) {
  my $bar = $tab13->Frame()->pack(-side => 'top', -fill => 'x', -before => $img_canvas);
  $bar->Button(-text => 'Fit', -command => sub {
        @RASTER_TAB_VIEW = @RASTER_TAB_HOME; &dbfRasterTabDraw;
      })->pack(-side => 'left');
  $bar->Button(-text => 'Zoom out', -command => sub {
        my ($cx, $cy) = ( ($RASTER_TAB_VIEW[0]+$RASTER_TAB_VIEW[2])/2,
                          ($RASTER_TAB_VIEW[1]+$RASTER_TAB_VIEW[3])/2 );
        my ($w, $h) = ( $RASTER_TAB_VIEW[2]-$RASTER_TAB_VIEW[0],
                        $RASTER_TAB_VIEW[3]-$RASTER_TAB_VIEW[1] );
        @RASTER_TAB_VIEW = ($cx-$w, $cy-$h, $cx+$w, $cy+$h);
        &dbfRasterTabDraw;
      })->pack(-side => 'left');
  $bar->Button(-text => 'Redraw', -command => sub {
        undef $RASTER_TAB_N; &activate_RasterTab;
      })->pack(-side => 'left');
  $bar->Label(-text => '  wheel / i o : zoom   drag: zoom to box   2 f : fit   arrows: pan',
              -font => "Times 8")->pack(-side => 'left');
  $bar->Label(-textvariable => \$RASTER_TAB_STATUS, -anchor => 'e')
      ->pack(-side => 'right', -fill => 'x', -expand => 1);

  #<!-- drag a rectangle to zoom into it -->
  my $cv = $img_canvas;
  my $sub = eval { $img_canvas->Subwidget('scrolled') };
  $cv = $sub if ( defined $sub );
  $cv->Tk::bind('<ButtonPress-1>', [ sub {
        my ($c, $x, $y) = @_;
        ($RASTER_TAB_DX, $RASTER_TAB_DY) = ($c->canvasx($x), $c->canvasy($y));
        $c->delete('band');
        $c->createRectangle($RASTER_TAB_DX, $RASTER_TAB_DY,
                            $RASTER_TAB_DX, $RASTER_TAB_DY,
                            -outline => 'white', -tags => 'band');
      }, Ev('x'), Ev('y') ]);
  $cv->Tk::bind('<B1-Motion>', [ sub {
        my ($c, $x, $y) = @_;
        return unless ( defined $RASTER_TAB_DX );
        $c->coords('band', $RASTER_TAB_DX, $RASTER_TAB_DY,
                   $c->canvasx($x), $c->canvasy($y));
      }, Ev('x'), Ev('y') ]);
  $cv->Tk::bind('<ButtonRelease-1>', [ sub {
        my ($c, $x, $y) = @_;
        return unless ( defined $RASTER_TAB_DX );
        my ($x1, $y1) = ($c->canvasx($x), $c->canvasy($y));
        $c->delete('band');
        my ($px0, $px1) = ( $RASTER_TAB_DX < $x1 ? ($RASTER_TAB_DX, $x1) : ($x1, $RASTER_TAB_DX) );
        my ($py0, $py1) = ( $RASTER_TAB_DY < $y1 ? ($RASTER_TAB_DY, $y1) : ($y1, $RASTER_TAB_DY) );
        undef $RASTER_TAB_DX;
        #<!-- a click is not a zoom -->
        return if ( $px1 - $px0 < 5 || $py1 - $py0 < 5 );
        my $w = $c->width;  my $h = $c->height;
        return unless ( $w > 0 && $h > 0 );
        my $sx = ($RASTER_TAB_VIEW[2] - $RASTER_TAB_VIEW[0]) / $w;
        my $sy = ($RASTER_TAB_VIEW[3] - $RASTER_TAB_VIEW[1]) / $h;
        #<!-- canvas y runs down, the die's y runs up -->
        @RASTER_TAB_VIEW = ( $RASTER_TAB_VIEW[0] + $px0 * $sx,
                             $RASTER_TAB_VIEW[3] - $py1 * $sy,
                             $RASTER_TAB_VIEW[0] + $px1 * $sx,
                             $RASTER_TAB_VIEW[3] - $py0 * $sy );
        &dbfRasterTabDraw;
      }, Ev('x'), Ev('y') ]);

  #<!-- The same gestures Tk::WorldCanvas is bound to in the flat view, so the
  #     muscle memory carries over -- design_ZoomIn_ZoomOut_new binds <2> to
  #     fit, <i> and <o> to zoom, <f> to fit and the arrows to pan.
  #
  #     Plus the wheel, which WorldCanvas does not have.  Button-4 and Button-5
  #     are how X11 delivers wheel up and down, and the zoom is about the
  #     CURSOR rather than the middle of the window, so you zoom into what you
  #     are pointing at. -->
  $cv->Tk::bind('<Button-4>', [ sub { my ($c,$x,$y)=@_;
        &dbfRasterTabZoom(1.25, $c->canvasx($x), $c->canvasy($y)); },
        Ev('x'), Ev('y') ]);
  $cv->Tk::bind('<Button-5>', [ sub { my ($c,$x,$y)=@_;
        &dbfRasterTabZoom(0.80, $c->canvasx($x), $c->canvasy($y)); },
        Ev('x'), Ev('y') ]);
  #<!-- and the way a wheel arrives on toolkits that send MouseWheel instead -->
  $cv->Tk::bind('<MouseWheel>', [ sub { my ($c,$d,$x,$y)=@_;
        &dbfRasterTabZoom(($d > 0 ? 1.25 : 0.80), $c->canvasx($x), $c->canvasy($y)); },
        Ev('D'), Ev('x'), Ev('y') ]);

  $cv->Tk::bind('<2>', sub { @RASTER_TAB_VIEW = @RASTER_TAB_HOME;
                             &dbfRasterTabSchedule; });
  $cv->Tk::bind('<i>', [ sub { my ($c,$x,$y)=@_;
        &dbfRasterTabZoom(1.25, $c->canvasx($x), $c->canvasy($y)); },
        Ev('x'), Ev('y') ]);
  $cv->Tk::bind('<o>', [ sub { my ($c,$x,$y)=@_;
        &dbfRasterTabZoom(0.80, $c->canvasx($x), $c->canvasy($y)); },
        Ev('x'), Ev('y') ]);
  $cv->Tk::bind('<f>', sub { @RASTER_TAB_VIEW = @RASTER_TAB_HOME;
                             &dbfRasterTabSchedule; });
  $cv->Tk::bind('<KeyPress-Up>',    sub { &dbfRasterTabPan(0,  0.2); });
  $cv->Tk::bind('<KeyPress-Down>',  sub { &dbfRasterTabPan(0, -0.2); });
  $cv->Tk::bind('<KeyPress-Left>',  sub { &dbfRasterTabPan(-0.2, 0); });
  $cv->Tk::bind('<KeyPress-Right>', sub { &dbfRasterTabPan( 0.2, 0); });

  #<!-- A canvas needs the keyboard focus before any of those keys reach it.
  #     CanvasFocus is what activate_flatViewTab uses on the flat view, so the
  #     two tabs behave the same way; taking it on entry is friendlier than
  #     making people click first.
  #
  #     The MOUSE does not depend on any of this: wheel, drag and middle click
  #     are pointer events and go to the widget under the pointer whatever has
  #     the keyboard.  So zooming works even if the keys do not. -->
  $cv->configure(-takefocus => 1);
  $cv->Tk::bind('<Enter>', sub {
      eval { $cv->CanvasFocus } or eval { $cv->Tk::focus };
    });

  $RASTER_TAB_READY = 1;
}

#<!-- dump, unless the same design is already dumped -->
unless ( defined $RASTER_TAB_N && $RASTER_TAB_N == $n && -e $RASTER_TAB_FILE ) {
  my $scale = $GLOBAL->dbfGlobalGetDBU;
  $scale = 1 unless ( defined $scale && $scale > 0 );
  my @die = ( 0, 0, 0, 0 );
  if ( exists $DIE_ALREADY{dieArea} && @{$DIE_ALREADY{dieArea}} >= 4 ) {
    @die = @{$DIE_ALREADY{dieArea}};
  }
  unless ( $die[2] > $die[0] && $die[3] > $die[1] ) {
    $RASTER_TAB_STATUS = "the design has no die area";
    return;
  }
  $RASTER_TAB_FILE = "$TOP_MODULE.rastertab.cells";
  $RASTER_TAB_PNG  = "$TOP_MODULE.rastertab.png";
  $RASTER_TAB_STATUS = "dumping $n instances ...";
  $img_canvas->update if ( defined $img_canvas );
  undef $FLAT_RASTER_DUMP_N;
  my $cnt = &dbfRasterDumpCells($RASTER_TAB_FILE, $scale, \@die);
  unless ( $cnt > 0 ) {
    $RASTER_TAB_STATUS = "no placed instance has a size to draw";
    return;
  }
  $RASTER_TAB_COUNT = $cnt;
  $RASTER_TAB_N = $n;
  @RASTER_TAB_HOME = ( $die[0]/$scale, $die[1]/$scale, $die[2]/$scale, $die[3]/$scale );
  @RASTER_TAB_VIEW = @RASTER_TAB_HOME;
}

&dbfRasterTabDraw;

}# sub activate_RasterTab


#<!-- ======================================================================
#     Shared: the cell dump.
#
#     WHAT design_display SPENDS ITS TIME ON
#
#     Not Tk.  Its instance loop already refuses to draw anything under three
#     pixels -- "$display_limit" in make_worldCan_def_gui -- so at chip level
#     most cells never reach createRectangle at all.  What costs is the loop
#     itself: a hash lookup and several method calls per instance, 3.4 million
#     times, to decide "no" 3.4 million times.
#
#     So the fix is to not walk the database per instance.  Walk it ONCE into a
#     flat file, and let every later pan and zoom re-rasterise that file
#     instead of walking the database again.  The first draw costs about what
#     it costs today; every one after it is a fifth of a second.
#
#     WHY A DUMP AND NOT A DEF
#
#     Because write_def is 38s on the big design and then the rasteriser has to
#     parse it back and parse a LEF to find the sizes -- all of which electron
#     already has in memory.  Four numbers per cell is the whole of it.
#
#     The dump is in $DBSCALEFACTOR units, deliberately, NOT the true DBU: the
#     canvas transform in design_display is built on $DBSCALEFACTOR, and the
#     image has to line up with that transform rather than with the truth.
#     CLAUDE.md records that the two diverge. -->

#<!-- Walk %CADB once into a flat file.  Re-walked only when the instance count
#     changes, which is the cheap test that catches a new design being read
#     without costing anything on a pan. -->
sub dbfRasterDumpCells {

my ($file, $scale, $die) = @_;

my $n = keys %CADB;
if ( defined $FLAT_RASTER_DUMP_N && $FLAT_RASTER_DUMP_N == $n
     && defined $FLAT_RASTER_DUMP_F && $FLAT_RASTER_DUMP_F eq $file && -e $file ) {
  return $n;
}

unless ( open(FRD, ">$file") ) {
  print "WARN-GUI-RASTER : 017 : cannot write $file : $!\n";
  return 0;
}
printf FRD "UNITS %d\n", $scale;
printf FRD "DIE %d %d %d %d\n", @$die;
my %wOf = ();
my %hOf = ();
my $cnt = 0;
foreach my $inst ( keys %CADB ) {
  my $obj = $CADB{$inst};
  my $status = $obj->dbCadbGetStatus;
  next unless ( $status eq "PLACED" || $status eq "FIXED" );
  my $cellref = $obj->dbCadbGetCellref;
  next unless ( exists $PLDB{$cellref} );
  #<!-- size per cellref, not per instance: a design with a million instances
  #     has a hundred distinct cells -->
  unless ( exists $wOf{$cellref} ) {
    my @s = $PLDB{$cellref}->dbMdbGetSize;
    $wOf{$cellref} = ( @s >= 2 && $s[0] > 0 ) ? $s[0] * $scale : 0;
    $hOf{$cellref} = ( @s >= 2 && $s[1] > 0 ) ? $s[1] * $scale : 0;
  }
  my ($w, $h) = ($wOf{$cellref}, $hOf{$cellref});
  next unless ( $w > 0 && $h > 0 );
  my $orient = $obj->dbCadbGetOrient;
  if ( defined $orient && $orient =~ m/^(E|W|FE|FW)$/ ) { ($w, $h) = ($h, $w); }
  my @loc = $obj->dbCadbGetLoc;
  next unless ( @loc >= 2 && defined $loc[1] );
  printf FRD "CELL %d %d %d %d\n", $loc[0], $loc[1], $w, $h;
  $cnt++;
}
close(FRD);
$FLAT_RASTER_DUMP_N = $n;
$FLAT_RASTER_DUMP_F = $file;
print "INFO-GUI-RASTER : 018 : dumped $cnt placed instance(s) for the raster view\n";
return $cnt;

}# sub dbfRasterDumpCells


sub raster_view {

use Benchmark;
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my ($defFile, $pngFile, $rasterBin, $mode, $extra);
my @lefs = ();
my $width = 1200;
my ($noWindow, $keepFiles) = (0, 0);

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : raster_view -def <file>      a DEF on disk to draw.  With no -def it\n";
  print "                                     draws what is in memory and needs nothing\n";
  print "                                     else -- no LEF, no DEF, no file to pick.\n";
  print "                    -lef <file>      cell sizes, and ONLY needed with -def,\n";
  print "                                     because a DEF does not carry them\n";
  print "                    -out <file.png>  default <top>.raster.png\n";
  print "                    -width <pixels>  default 1200\n";
  print "                    -mode <util|count|outline>\n";
  print "                          util  : fraction of each pixel covered by cells,\n";
  print "                                  which is the useful thing at chip level\n";
  print "                          count : cells per pixel\n";
  print "                    -raster <path>   default ELECTRON_HOME/3RDBIN/def_raster\n";
  print "                    -args <extra>    passed straight to it\n";
  print "                    --no_window      write the PNG and do not open anything\n";
  print "                    --keep           keep the DEF this wrote\n";
  print "\n";
  print "        Draws the design as an image instead of one canvas item per\n";
  print "        instance, which is what makes a million cell design openable.\n";
  print "        Opens its own window; drag a rectangle in it to zoom.\n";
  print "\n";
  print "        The Raster TAB in the main window does the same thing without a\n";
  print "        command -- raise it and it draws.  This is for when you want a\n";
  print "        second view, or a DEF that is not the loaded design.\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-lef")        { push(@lefs, $_[$i+1]); }
  elsif ($_[$i] eq "-def")        { $defFile = $_[$i+1]; }
  elsif ($_[$i] eq "-out")        { $pngFile = $_[$i+1]; }
  elsif ($_[$i] eq "-width")      { $width = $_[$i+1]; }
  elsif ($_[$i] eq "-mode")       { $mode = $_[$i+1]; }
  elsif ($_[$i] eq "-raster")     { $rasterBin = $_[$i+1]; }
  elsif ($_[$i] eq "-args")       { $extra = $_[$i+1]; }
  elsif ($_[$i] eq "--no_window") { $noWindow = 1; }
  elsif ($_[$i] eq "--keep")      { $keepFiles = 1; }
  elsif ($_[$i] =~ m/^-+\w/)      { print "WARN-GUI-RASTER : 001 : invalid option $_[$i]\n"; }
}

#<!-- Two ways in, and the default is the one that needs nothing.
#
#     -def draws a DEF from disk, which then needs -lef for the cell sizes,
#     because a DEF does not carry them.  That is for looking at a DEF the
#     session has not read.
#
#     With no -def it dumps what is in memory: electron already knows every
#     instance's location and size, so writing four numbers per cell beats
#     writing a DEF and parsing a LEF back to recover what we started with.
#     It is also what makes the command usable without naming a LEF, which is
#     the first thing anyone trips over -- read_lef records no path, so -lef
#     means typing out again what the config already said. -->
my $fromMemory = ( defined $defFile && $defFile ne "" ) ? 0 : 1;
if ( $fromMemory ) {
  my $n = keys %CADB;
  unless ( $n > 0 ) {
    print "ERR-GUI-RASTER : 002 : no instances in memory; read a design, or pass -def and -lef\n";
    return;
  }
}
else {
  unless ( @lefs ) {
    print "ERR-GUI-RASTER : 003 : -def needs -lef too; a DEF carries no cell sizes\n";
    return;
  }
  foreach my $l ( @lefs ) {
    unless ( -e $l ) {
      print "ERR-GUI-RASTER : 020 : no LEF at $l\n";
      return;
    }
  }
}

unless ( defined $rasterBin && $rasterBin ne "" ) {
  my $home = $GLOBAL->dbfGlobalGetElectronHome;
  $rasterBin = "$home/3RDBIN/def_raster";
}
unless ( -e $rasterBin ) {
  print "ERR-GUI-RASTER : 004 : no rasteriser at $rasterBin\n";
  return;
}

my $wroteDef = 0;
my $cellsMode = 0;
if ( $fromMemory ) {
  #<!-- dump once; a later re-raster for a zoom reuses it -->
  $defFile = "$TOP_MODULE.raster.cells";
  $cellsMode = 1;
  my $scale = $GLOBAL->dbfGlobalGetDBU;
  $scale = 1 unless ( defined $scale && $scale > 0 );
  my @dieDbu = ( 0, 0, 0, 0 );
  if ( exists $DIE_ALREADY{dieArea} && @{$DIE_ALREADY{dieArea}} >= 4 ) {
    @dieDbu = @{$DIE_ALREADY{dieArea}};
  }
  unless ( $dieDbu[2] > $dieDbu[0] && $dieDbu[3] > $dieDbu[1] ) {
    print "ERR-GUI-RASTER : 005 : the design has no die area to draw in\n";
    return;
  }
  #<!-- forget any earlier dump: this one may be of a different design -->
  undef $FLAT_RASTER_DUMP_N;
  my $cnt = &dbfRasterDumpCells($defFile, $scale, \@dieDbu);
  unless ( $cnt > 0 ) {
    print "ERR-GUI-RASTER : 006 : no placed instance has a size; nothing to draw\n";
    return;
  }
  $wroteDef = 1;
}
unless ( -e $defFile ) {
  print "ERR-GUI-RASTER : 021 : no input at $defFile\n";
  return;
}
unless ( defined $pngFile && $pngFile ne "" ) {
  $pngFile = "$TOP_MODULE.raster.png";
}

#<!-- The die, so that "fit" has something to fit to.  Microns, because that is
#     what the rasteriser takes.
#
#     Read out of the DEF being drawn, not out of the floorplan, because the
#     DEF carries its own UNITS and is self consistent where the floorplan is
#     not: dbFlplanGetDBUnit answered 2000 where dbfGlobalGetDBU says 4000 on
#     the first design this was pointed at, which is exactly the
#     $DEF_DATABASE_UNIT divergence CLAUDE.md warns about.  The viewport came
#     out twice the size of the die and the design sat in a quarter of the
#     window.
#
#     It is two lines of the file, and it is the file the picture is of. -->
my @vp = ();
if ( $cellsMode ) {
  #<!-- the dump's own DIE line, in the same units its CELL lines use -->
  if ( open(RV_DEF, "<$defFile") ) {
    my $ddbu = 1;
    while ( my $line = <RV_DEF> ) {
      if    ( $line =~ m/^UNITS\s+(\d+)/ ) { $ddbu = $1; }
      elsif ( $line =~ m/^DIE\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)/ ) {
        @vp = ( $1/$ddbu, $2/$ddbu, $3/$ddbu, $4/$ddbu );
        last;
      }
      last if ( $line =~ m/^CELL/ );
    }
    close(RV_DEF);
  }
}
elsif ( open(RV_DEF, "<$defFile") ) {
  my $ddbu = 0;
  while ( my $line = <RV_DEF> ) {
    if ( $line =~ m/^\s*UNITS\s+DISTANCE\s+MICRONS\s+(\d+)/ ) {
      $ddbu = $1;
    }
    elsif ( $line =~ m/^\s*DIEAREA\s*\(\s*(-?\d+)\s+(-?\d+)\s*\).*\(\s*(-?\d+)\s+(-?\d+)\s*\)/ ) {
      if ( $ddbu > 0 ) { @vp = ( $1/$ddbu, $2/$ddbu, $3/$ddbu, $4/$ddbu ); }
      last;
    }
    last if ( $line =~ m/^\s*COMPONENTS/ );
  }
  close(RV_DEF);
}
unless ( @vp == 4 && $vp[2] > $vp[0] && $vp[3] > $vp[1] ) {
  print "WARN-GUI-RASTER : 013 : no DIEAREA found in $defFile, the rasteriser picks the view\n";
  @vp = ();
}

my $rc = &dbfRasterRun($rasterBin, $defFile, $pngFile, \@lefs, $width, $mode, undef, $extra, $cellsMode);
if ( $rc != 0 ) {
  print "ERR-GUI-RASTER : 007 : the rasteriser exited with status $rc\n";
  unlink($defFile) if ( $wroteDef && ! $keepFiles );
  return;
}
print "INFO-GUI-RASTER : 008 : wrote $pngFile\n";

#<!-- Open the window whenever there is a display to open it on.
#
#     NOT gated on dbGlobalGetGuiStatus: that is set inside start_gui, which
#     runs in the process &win forks, so it is 0 at the ordinary prompt and
#     gating on it would mean the window never appeared except when the command
#     was typed into the GUI's own entry box.  A raster view is worth having
#     without the rest of the GUI.
#
#     Inside the GUI process there is already an event loop, so return and let
#     it run the window.  At the prompt there is not, so run one here and block
#     until the window is closed -- the same bargain hier_place makes, and the
#     reason it says so out loud. -->
if ( $noWindow ) {
  print "INFO-GUI-RASTER : 009 : --no_window given; the PNG is $pngFile\n";
}
elsif ( ! defined $ENV{DISPLAY} || $ENV{DISPLAY} eq "" ) {
  print "INFO-GUI-RASTER : 011 : no DISPLAY, so no window; the PNG is $pngFile\n";
}
else {
  &dbfRasterWindow($pngFile, $defFile, \@lefs, $rasterBin, $width, $mode, $extra, \@vp, $cellsMode);
  if ( $GLOBAL->dbGlobalGetGuiStatus != 1 ) {
    print "INFO-GUI-RASTER : 012 : electron is waiting; close the raster view to carry on\n";
    MainLoop();
  }
}

unless ( $keepFiles ) {
  unlink($defFile) if ( $wroteDef );
}

my $t1 = new Benchmark;
print "Command raster_view took:",timestr(timediff($t1,$t0)),"\n";

}# sub raster_view


#<!-- Run the rasteriser.  Executable with a python3 shebang, like every other
#     3RDBIN tool, or through the interpreter if it is neither. -->
sub dbfRasterRun {

my ($bin, $def, $png, $lefs, $width, $mode, $bbox, $extra, $cells) = @_;

my $cmd = ( -x $bin ) ? "$bin $def $png" : "python3 $bin $def $png";
if ( $cells ) { $cmd .= " --cells"; }
else { foreach my $l ( @$lefs ) { $cmd .= " --lef $l"; } }
$cmd .= " --width $width" if ( defined $width && $width > 0 );
$cmd .= " --mode $mode"   if ( defined $mode && $mode ne "" );
if ( defined $bbox && @$bbox == 4 ) {
  $cmd .= sprintf(" --bbox %.4f %.4f %.4f %.4f", @$bbox);
}
$cmd .= " $extra" if ( defined $extra && $extra ne "" );
return system($cmd);

}# sub dbfRasterRun


#<!-- The window.  Its own Toplevel, its own canvas, one image item on it, and
#     no reference to anything the flat view owns.
#
#     Zoom is a rubber band: drag a rectangle, and the region under it is
#     re-rasterised at the same pixel budget.  That is why zooming does not get
#     slower as you go in -- the cell count falls and the pixel count does not
#     change -- and it is the whole reason to draw this way. -->
sub dbfRasterWindow {

my ($png, $def, $lefs, $bin, $width, $mode, $extra, $die, $cells) = @_;

my $top = MainWindow->new;
$top->title("Electron raster view - $TOP_MODULE");

my $bar = $top->Frame()->pack(-side => 'top', -fill => 'x');
my $status = "";
my @view = @$die;          #<!-- current viewport, microns -->
my @home = @$die;

my $canvas = $top->Canvas(-width => $width, -height => $width,
                          -bg => 'black', -highlightthickness => 0)
                 ->pack(-side => 'top', -expand => 1, -fill => 'both');

my $photo;
my $imgItem;
my ($imgW, $imgH) = ($width, $width);

my $show = sub {
  #<!-- A fresh Photo each time: reusing one and re-reading into it keeps the
  #     old pixels where the new image is smaller. -->
  my $new = $top->Photo(-file => $png);
  $imgW = $new->width;
  $imgH = $new->height;
  $canvas->delete('all');
  $imgItem = $canvas->createImage(0, 0, -anchor => 'nw', -image => $new);
  $canvas->configure(-width => $imgW, -height => $imgH,
                     -scrollregion => [0, 0, $imgW, $imgH]);
  $photo->delete if ( defined $photo );
  $photo = $new;
  $status = sprintf("%.1f x %.1f um at %.4f um/px",
                    $view[2]-$view[0], $view[3]-$view[1],
                    ($view[2]-$view[0]) / ($imgW > 0 ? $imgW : 1));
};

my $redraw = sub {
  my @bbox = @view;
  my $rc = &dbfRasterRun($bin, $def, $png, $lefs, $width, $mode, \@bbox, $extra, $cells);
  if ( $rc != 0 ) {
    $status = "the rasteriser failed, the view is unchanged";
    return;
  }
  $show->();
};

$bar->Button(-text => 'Fit', -command => sub { @view = @home; $redraw->(); })
    ->pack(-side => 'left');
$bar->Button(-text => 'Zoom out', -command => sub {
      my ($cx, $cy) = (($view[0]+$view[2])/2, ($view[1]+$view[3])/2);
      my ($w, $h) = (($view[2]-$view[0]), ($view[3]-$view[1]));
      @view = ($cx-$w, $cy-$h, $cx+$w, $cy+$h);
      $redraw->();
    })->pack(-side => 'left');
$bar->Button(-text => 'Close', -command => sub { $top->destroy; })
    ->pack(-side => 'right');
$bar->Label(-textvariable => \$status, -anchor => 'w')
    ->pack(-side => 'left', -fill => 'x', -expand => 1);

#<!-- rubber band.  Canvas y runs down and the die's y runs up, so the y
#     mapping is flipped -- the same flip the rasteriser applies to the image
#     before writing it. -->
my ($dragX, $dragY, $band);
$canvas->Tk::bind('<ButtonPress-1>', [ sub {
    my ($c, $x, $y) = @_;
    ($dragX, $dragY) = ($c->canvasx($x), $c->canvasy($y));
    $c->delete('band') if ( defined $band );
    $band = $c->createRectangle($dragX, $dragY, $dragX, $dragY,
                                -outline => 'white', -tags => 'band');
  }, Ev('x'), Ev('y') ]);
$canvas->Tk::bind('<B1-Motion>', [ sub {
    my ($c, $x, $y) = @_;
    return unless ( defined $band );
    $c->coords($band, $dragX, $dragY, $c->canvasx($x), $c->canvasy($y));
  }, Ev('x'), Ev('y') ]);
$canvas->Tk::bind('<ButtonRelease-1>', [ sub {
    my ($c, $x, $y) = @_;
    return unless ( defined $band );
    my ($x1, $y1) = ($c->canvasx($x), $c->canvasy($y));
    $c->delete('band');
    undef $band;
    my ($px0, $px1) = ( $dragX < $x1 ? ($dragX, $x1) : ($x1, $dragX) );
    my ($py0, $py1) = ( $dragY < $y1 ? ($dragY, $y1) : ($y1, $dragY) );
    #<!-- a click, not a drag: ignore it rather than zooming to a point -->
    if ( $px1 - $px0 < 4 || $py1 - $py0 < 4 ) { return; }
    my $sx = ($view[2] - $view[0]) / ($imgW > 0 ? $imgW : 1);
    my $sy = ($view[3] - $view[1]) / ($imgH > 0 ? $imgH : 1);
    my @nv = ( $view[0] + $px0 * $sx,
               $view[3] - $py1 * $sy,
               $view[0] + $px1 * $sx,
               $view[3] - $py0 * $sy );
    @view = @nv;
    $redraw->();
  }, Ev('x'), Ev('y') ]);

$show->();
print "INFO-GUI-RASTER : 010 : raster view open; drag a rectangle to zoom, Fit to go back\n";

}# sub dbfRasterWindow

1;
