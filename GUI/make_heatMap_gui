     $count++;
  }

  $design_worldcanvas->CanvasBind("<1>"=> [sub {&display_point($design_worldcanvas,$canvasWidth,$canvasHeight,$llx,$lly,$timeS[0],$timeS[-1],$actS[0],$actS[-1]); }]);
  $design_worldcanvas->CanvasBind("<B1-ButtonRelease>"=> [sub{$design_worldcanvas->delete(POINT_TEMP);}]);

  #----------------------------------------------#
