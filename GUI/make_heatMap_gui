      my $ury1 = $lly1;
      my $yText = $actS[0] + $yStep*$i;
      
      $design_worldcanvas->createLine($llx1,$lly1,$urx1,$ury1, -fill,"yellow");
      $design_worldcanvas->createText($llx1-15,$lly1, -text=>$yText,-fill,"yellow");
  }#for y axis

  #-------------------- Marks with Text on X-axis --------------------#   
  my $xStep = ($timeS[-1] - $timeS[0])/$dNum;
