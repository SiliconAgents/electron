  }
  
  my $count = 0;
  foreach my $t (keys %TIME_VS_ACTIVITY){
     #if($count > 5){last;} 
     my $activity = $TIME_VS_ACTIVITY{$t};
     my $xx = $llx + ($t - $timeS[0])*($canvasWidth/($xStep*$dNum));
