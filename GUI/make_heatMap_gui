sub display_point {
  my ($canvas, $canW, $canH, $refX, $refY, $minT, $maxT, $minA, $maxA) = @_;
  
  my @xy = $canvas->eventLocation();
  my $x = $xy[0];
  my $y = $xy[1];
  #print "x,y=>$x,$y\n";
  
  my $time = int($minT + (($x - $refX)*($maxT - $minT))/$canW);
  my $activity = int($minA + (($y - $refY)*($maxA - $minA))/$canH);
  #print "$time $activity\n";

  $canvas->createText($x,$y, -text=>"($time, $activity)" ,-anchor=>"sw",-tags=>"POINT_TEMP",-fill=>"white",-font=>"Times 14");
}#sub display_point
