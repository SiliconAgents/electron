sub plot_time_vs_activity {
  my $fileName = $_[0]; #time vs activity csv file
  my $t0 = new Benchmark;

  ## the canvas area reamain the same : always  500 by 500
  my $box = [0,0,540,540];
  my $guiCanvasWidth = 540;
  my $guiCanvasHeight = 540;
  my $canvasWidth = 500;
  my $canvasHeight = 500;

  # a margin of 20 units is given on each side ..
  $design_worldcanvas->createRectangle(@$box, -outline,"black");

  my $baseName = basename($fileName); 
  $baseName =~ s/activityPer|\.csv//g;
  my ($number, $unit) = (split(/(\d+)/, $baseName))[1,2];

  my $mfact = 1;
  if($unit eq "ps"){
     $mfact = $number; 
  }elsif($unit eq "ns"){
     $mfact = $number*1000; 
  }
  #print "mfact:$mfact\n";

  my %TIME_VS_ACTIVITY = (); 
  open(READ, "$fileName");
  while(<READ>){
     chomp($_);
     $_ =~ s/^\s+//g;
     if($_ =~ /^\s*#/){next;}
     if($_ =~ /^$/){next;}
     $_ =~ s/\(|\)//g;
     my ($time, $activity) = split(/\,/, $_);
     $time *= $mfact;
     $TIME_VS_ACTIVITY{$time} = $activity;     
  }
  close(READ);
  #my @timeS = sort {$a<=>$b} keys %TIME_VS_ACTIVITY;
  print "time_range: $timeS[0] - $timeS[-1]\n";
