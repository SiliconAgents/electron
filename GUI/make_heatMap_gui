sub create_leakage_power_heat_map_gcells {
  my $t0 = new Benchmark;

  ############################# creating gcell database ##################################
  my $noOfArg = @_;
  my ($gcellSizeX,$gcellSizeY,$ngcellX,$ngcellY) = (100,100,0,0);
  my ($_ngcellX, $_ngcellY)       = (10,10);
  my $inFile;
  if($noOfArg < 2 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP"){
     print"Usage: create_leakage_power_heat_map_gcells -gx <gcell size across x>\n";
     print"                                            -gy <gcell size across y>\n";
     print"                                            -nx <number of gcells across x>\n";
     print"                                            -ny <number of gcells across y>\n";
     print"                                            -inst_file <instance leakage power file>\n";
     return;
  }
  for(my $i=0; $i<$noOfArg; $i++){
      if($_[$i] eq "-gx"){$gcellSizeX = $_[$i+1];}
      if($_[$i] eq "-gy"){$gcellSizeY = $_[$i+1];}
      if($_[$i] eq "-nx"){$ngcellX = $_[$i+1];}
      if($_[$i] eq "-ny"){$ngcellY = $_[$i+1];}
      if($_[$i] eq "-inst_file"){$inFile = $_[$i+1];}
  }
  
  my ($llx, $lly, $urx, $ury) = (0, 0, 4566, 4566);
  
  if ($gcellSizeX == 0) {
    if ($ngcellX == 0) {
      $ngcellX = $_ngcellX;
      $ngcellY = $_ngcellY;
    } 
    $gcellSizeX = ($urx - $llx + 1 )/$ngcellX;
    $gcellSizeY = ($ury - $lly + 1)/$ngcellY;
  } elsif ($ngcellX == 0) {
    $ngcellX = ceil( ($urx - $llx )/$gcellSizeX);
    $ngcellY = ceil( ($ury - $lly )/$gcellSizeY);
  }

  print "gcellSize: $gcellSizeX,$gcellSizeY\n";
  print "numGcell:  $ngcellX  $ngcellY\n"; 

  my ($x, $y) = ($llx, $lly);
  my ($numX, $numY) = (0,0);
  my ($x1, $y1);
  my ($pid);
  while ($y < $ury) {
      $y1 = $y + $gcellSizeY;
      if ($y1 > $ury) {$y1 = $ury;}
      while ($x < $urx) {
        $x1 = $x + $gcellSizeX;
        if ($x1 > $urx) {$x1 = $urx;}
        $GCellArray[$numX][$numY] = new GCell;
        $GCellArray[$numX][$numY]->dbgGcellSetBBox($x,$y, $x1,$y1);
        $pid = min($numX+1, $numY+1, $ngcellX - $numX, $ngcellY - $numY);
        $GCellArray[$numX][$numY]->dbgGcellSetPid($pid);
        $x = $x1; $numX++;
      } #while
      $y = $y1; $numY++;
      $x = $llx; $numX = 0;
  }

  open(READ, "$inFile");
  while(<READ>){
     chomp($_);
     $_ =~ s/^\s+//g;
     if($_ =~ /^\s*#/){next;}
     if($_ =~ /^$/){next;}
     my ($instName, $locX, $locY, $leakage_power) = (split(/\,/, $_))[0,1,2,7];
     $leakage_power *= 10**9;
     #print "inst:$instName, $locX, $locY, $leakage_power\n";
     my $gcellX = int ($locX/$gcellSizeX);
     my $gcellY = int ($locY/$gcellSizeY);
     #$GCellArray[$gcellX][$gcellY]->dbgGcellAddInst("$instName=$leakage_power") if($gcellX < $ngcellX && $gcellY < $ngcellY);
     if($leakage_power > 0){
        $GCellArray[$gcellX][$gcellY]->dbgGcellAddLeakagePower($leakage_power) if($gcellX < $ngcellX && $gcellY < $ngcellY);
        #print "instance:$instName leakage_power:$leakage_power\n";
        #print "  gcell:$gcellX,$gcellY\n";
     }
          
  }
  close(READ);

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command create_leakage_power_heat_map_gcells took:",timestr($td),"\n";
}# sub create_leakage_power_heat_map_gcells

