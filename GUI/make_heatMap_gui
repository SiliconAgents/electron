sub plot_activity_heat_map {
  #my @heat_map_colors = ("#000000", "#303030", "#302E9B", "#000082", "#0001FC", "#2B67FD", "#99CDFC", "#2DD1CA", "#008001", "#9AD000", "#FED000", "#756264", "#9B5B59", "#FE6700", "#FD0002", "#DAB711", "#E3E103");
  my @heat_map_colors = ("#000000", "#303030","#302E9B", "#000082", "#0001FC", "#2B67FD", "#99CDFC", "#2DD1CA", "#008001", "#9AD000", "#FED000", "#756264", "#9B5B59", "#FE6700", "#FD0002");

  my $t0 = new Benchmark;
  ## the canvas area reamain the same : always  500 by 500
  #my $box = [0,0,540,540];
  my $box = [0,0,700,700];
  my $guiCanvasWidth = 540;
  my $guiCanvasHeight = 540;
  # a margin of 20 units is given on each side ..
     
  my ($chip_llx, $chip_lly, $chip_urx, $chip_ury) = (0, 0, 4566, 4566);
  
  my $guiWidth = abs($chip_urx - $chip_llx) ;
  my $guiHeight = abs($chip_ury - $chip_lly) ;
  my $hMultFact  = 500/$guiHeight;
  my $wMultFact  = 500/$guiWidth;
  
  if($hMultFact < $wMultFact){
     $MulFactor = $hMultFact;
  }else{
     $MulFactor =  $wMultFact; 
  }
  
  my $moduleName = $GLOBAL->dbfGlobalGetTOP;
  $top->title (" Proton (mcu_top)");
  my $bllx = $chip_llx*$MulFactor + 20;
  my $blly = $chip_lly*$MulFactor + 20;
  my $burx = $chip_urx*$MulFactor + 20;
  my $bury = $chip_ury*$MulFactor + 20;
  $design_worldcanvas->createRectangle(0,0,540,540, -outline,"black");
  #$design_worldcanvas->createRectangle($bllx,$blly-2,$burx+2,$bury, -outline,"green", -width=>2);
  $design_worldcanvas->createRectangle($bllx,$blly-1,$burx+1,$bury, -outline,"green", -width=>2);

  my $max_activity = 0;
  for(my $i=0; $i<=$#GCellArray ; $i++) {
     for (my $j=0; $j<=$#{@GCellArray[0]} ; $j++) {
          my $activity = $GCellArray[$i][$j]->dbgGcellGetPinActivity; 
          #print "activity is :$activity\n";
          if($activity > $max_activity){$max_activity = $activity;}   
     }
  }
  my $activity_range = int($max_activity/@heat_map_colors) + 1;
  print "max_act:$max_activity act_range:$activity_range\n";

  ########  dispay the activity  #######
  for(my $i=0; $i<=$#GCellArray ; $i++) {
     for (my $j=0; $j<=$#{@GCellArray[0]} ; $j++) {
          my @gcell_bbox = $GCellArray[$i][$j]->dbgGcellGetBBox;
          my $activity = $GCellArray[$i][$j]->dbgGcellGetPinActivity; 
          #my @instList = $GCellArray[$i][$j]->dbgGcellGetInst; 
          my $llx = $gcell_bbox[0]*$MulFactor + 20;
          my $lly = $gcell_bbox[1]*$MulFactor + 20;
          my $urx = $gcell_bbox[2]*$MulFactor + 20;
          my $ury = $gcell_bbox[3]*$MulFactor + 20;

          my $fill_color = $heat_map_colors[int($activity/$activity_range)];
          #print "$i,$j=>$llx,$lly,$urx,$ury $activity=>$fill_color\n";

          $design_worldcanvas->createRectangle($llx,$lly,$urx,$ury, -fill =>$fill_color, -tags=>$activity);
     }
  }

  my $refX = 560;
  my $refY = 20;
  foreach my $color (@heat_map_colors){
     $design_worldcanvas->createRectangle($refX,$refY,$refX+10,$refY+15, -fill=>$color, -outline=>"white");
     $refY +=15; 
  }
  #----------------------------------------------#
  $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "heat map display took:",timestr($td),"\n";
  #$design_worldcanvas->viewArea(@$box, -border => 0);
  $design_worldcanvas->viewAll;
  @box_org = $design_worldcanvas->getView();
  &design_ZoomIn_ZoomOut_new($design_worldcanvas,\@box_org);
  &activate_flatViewTab;
}#sub plot_activity_heat_map

sub create_activity_heat_map_gcells {
  my $t0 = new Benchmark;

  ############################# creating gcell database ##################################
  my $noOfArg = @_;
  my ($gcellSizeX,$gcellSizeY,$ngcellX,$ngcellY) = (100,100,0,0);
  my ($_ngcellX, $_ngcellY)       = (10,10);
  my ($pinsLocFile, $tcfFile);
  if($noOfArg < 4 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP"){
     print"Usage: create_activity_heat_map_gcells -gx <gcell size across x>\n";
     print"                                       -gy <gcell size across y>\n";
     print"                                       -nx <number of gcells across x>\n";
     print"                                       -ny <number of gcells across y>\n";
     print"                                       -pins_file < pins location file>\n";
     print"                                       -tcf_file < TCF file>\n";
     return;
  }
  for(my $i=0; $i<$noOfArg; $i++){
      if($_[$i] eq "-gx"){$gcellSizeX = $_[$i+1];}
      if($_[$i] eq "-gy"){$gcellSizeY = $_[$i+1];}
      if($_[$i] eq "-nx"){$ngcellX = $_[$i+1];}
      if($_[$i] eq "-ny"){$ngcellY = $_[$i+1];}
      if($_[$i] eq "-pins_file"){$pinsLocFile = $_[$i+1];}
      if($_[$i] eq "-tcf_file") {$tcfFile = $_[$i+1];}
  }

  my ($llx, $lly, $urx, $ury) = (0, 0, 4566, 4566);
  
  if ($gcellSizeX == 0) {
    if ($ngcellX == 0) {
      $ngcellX = $_ngcellX;
      $ngcellY = $_ngcellY;
    } 
    $gcellSizeX = ($urx - $llx + 1 )/$ngcellX;
    $gcellSizeY = ($ury - $lly + 1)/$ngcellY;
  } elsif ($ngcellX == 0) {
    $ngcellX = ceil( ($urx - $llx )/$gcellSizeX);
    $ngcellY = ceil( ($ury - $lly )/$gcellSizeY);
  }

  print "gcellSize: $gcellSizeX,$gcellSizeY\n";
  print "numGcell:  $ngcellX  $ngcellY\n"; 

  my ($x, $y) = ($llx, $lly);
  my ($numX, $numY) = (0,0);
  my ($x1, $y1);
  my ($pid);
  while ($y < $ury) {
      $y1 = $y + $gcellSizeY;
      if ($y1 > $ury) {$y1 = $ury;}
      while ($x < $urx) {
        $x1 = $x + $gcellSizeX;
        if ($x1 > $urx) {$x1 = $urx;}
        $GCellArray[$numX][$numY] = new GCell;
        $GCellArray[$numX][$numY]->dbgGcellSetBBox($x,$y, $x1,$y1);
        $pid = min($numX+1, $numY+1, $ngcellX - $numX, $ngcellY - $numY);
        $GCellArray[$numX][$numY]->dbgGcellSetPid($pid);
        $x = $x1; $numX++;
      } #while
      $y = $y1; $numY++;
      $x = $llx; $numX = 0;
  }

  %PIN2ACTIVITY = ();
  &read_tcf("-tcf", $tcfFile);
  open(READ, "$pinsLocFile");
  while(<READ>){
     chomp($_);
     $_ =~ s/^\s+//g;
     if($_ =~ /^\s*#/){next;}
     if($_ =~ /^$/){next;}
     my ($pinName, $locX, $locY) = (split(/\,/, $_))[0,2,3];
     my $activity = $PIN2ACTIVITY{$pinName};
     #print "pin:$pinName, $locX, $locY, $activity\n";
     my $gcellX = int ($locX/$gcellSizeX);
     my $gcellY = int ($locY/$gcellSizeY);
     #$GCellArray[$gcellX][$gcellY]->dbgGcellAddInst("$pinName=$activity") if($gcellX < $ngcellX && $gcellY < $ngcellY);
     if($activity > 0){
        $GCellArray[$gcellX][$gcellY]->dbgGcellAddPinActivity($activity) if($gcellX < $ngcellX && $gcellY < $ngcellY);
        #print "  pin:$pinName activity:$activity\n";
        #print "  gcell:$gcellX,$gcellY\n";
     }
          
  }
  close(READ);

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command create_activity_heat_map_gcells took:",timestr($td),"\n";
}# sub create_activity_heat_map_gcells



sub read_tcf {
  %PIN2ACTIVITY = ();
  my $noOfArg = @_;
  if($noOfArg < 2 || $_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq '-HELP') {
     print "\nUsage : read_tcf -tcf < TCF file >\n";
  }else {
     my $tcfFile = "";
     for(my $i=0 ; $i<$noOfArg; $i++){
         if($_[$i] eq "-tcf"){$tcfFile = $_[$i+1];} 
     }#for correct no.of Arguments
  
     if(-e $tcfFile){
        my $t0 = new Benchmark;
        print "INFO-PAR-PIN : 001 : File $tcfFile exists .....\n";
        open(READ, "$tcfFile");
        print "INFO-PAR-PIN : 002 : Begin reading pin activity from file $tcfFile .....\n";
        my $START_PIN_SECTION = 0;
        while(<READ>){
           chomp($_);
           $_ =~ s/^\s+//g;
           if($_ =~ /^\s*#/){next;}
           if($_ =~ /^$/){next;}
           if($_ =~ /^\s*pin\s*\(\)\s+\{/){
              $START_PIN_SECTION = 1; 
              next;   
           }elsif($_ =~ /^\s*\}/){  
              $START_PIN_SECTION = 0;
           }
           if($START_PIN_SECTION == 1){
              $_ =~ s/\"|\;//g;
              #my ($pinName, $actStr) = split(/\:/, $_);
              my ($pinName, $actStr) = split(/\s+\:\s+/, $_);
              $pinName =~ s/\s+//g;
              $pinName =~ s/\\//g;
              $pinName =~ s/\:/\//g;
              $actStr =~ s/^\s+//;
              $pinName =~ s/tb\/u_mcu_top_gasket\/u_mcu_top\///g;
              
              my $activity = (split(/\s+/, $actStr))[1];
              if($activity == 0){next;}
              $PIN2ACTIVITY{$pinName} = $activity;
           }  
        }
        print "INFO-PAR-PIN : 003 : End reading pin activity .....\n";
        close(READ);
  
        my $tfinal = new Benchmark;
        my $tdfinal = timediff($tfinal, $t0);
        print "command parse_tcf.pl took:",timestr($tdfinal),"\n";
     }else{
       print "WARN: File $tcfFile does not exists ! \n";
     }
  }
}#sub read_tcf

