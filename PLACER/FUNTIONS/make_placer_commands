##########################################################################################################
########################### command to run graywolf placer for flat design  ##############################
##########################################################################################################
sub place_graywolf {
  use Benchmark;
  my $t0 = new Benchmark; 
  my $noOfArguments = @_;
  if($noOfArguments < 0 || $_[0] eq "-h"){
     print "Usage: place_graywolf -porosity <-1/0/1/2 (default -1)>\n";
  }else{
     my $porosity = -1;
     for(my $i=0; $i < $noOfArguments;$i++){
         if($_[$i] eq "-porosity"){$porosity = $_[$i+1];}
     }#for

     #write the design.cel file 
     &write_graywolf_cel_file($porosity);
     &write_placement_par_file ;
     system ("graywolf -n placement");
     &read_graywolf_placement_result ;
     
     #------ refine the port placement and assign them metal layer ----#
     &prePlaceData( "--noTrace", "--noLevel");
     &snapPlace( "--iosOnly");
     &remove_pins_overlap;
     # the place_output_fine_tune snaps the std cells to rows and fixes the X pitch as well as matches the row orientation
     &place_output_fine_tune ;
     if($DEBUG ==0) {system("rm -rf placement.*")};
     #---------  pins are refined -------------------------------------#
  }

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "command place_graywolf took:",timestr($td),"\n";
}#sub place_graywolf

