##########################################################################################################
############################# check if hier inst size is greater than 20000 ##############################
##########################################################################################################
sub hasGraywolfLargeHierInst{
  my $moduleName = $_[0];

  my $dbu = $GLOBAL->dbfGlobalGetDBU;
  my @hierInsts = $MODULE_ALREADY{$moduleName}->dbVNOMGetHierInst;
  #print "module:$moduleName hierInsts:@hierInsts\n";
  foreach my $inst (@hierInsts){
     my $cellref = $PSEUDO_VINST_ALREADY{$moduleName}{$inst}->dbPimDBGetInstCellref;
     #my @size = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetSize;
     #print "inst:$inst cell:$cellref size:@size\n"; 
     my $status = $PSEUDO_VINST_ALREADY{$moduleName}{$inst}->dbPimDBGetInstStatus;
     my @loc = $PSEUDO_VINST_ALREADY{$moduleName}{$inst}->dbPimDBGetInstRelBbox;  
     if($status eq 'UNPLACED'){
        @loc = &return_pseudo_vinst_size($moduleName,$inst);
     }
     #print " status:$status loc:@loc\n";
     my $instW = ($loc[2] - $loc[0])*$dbu;
     my $instH = ($loc[3] - $loc[1])*$dbu;
     if($instW > 20000 || $instH > 20000){
        return (1);
     }
  }
  return (0);
}#sub hasGraywolfLargeHierInst

##########################################################################################################
##################################### placing hier inst at 0,0 ###########################################
##########################################################################################################
sub place_hier_inst_at_zero{
  my $moduleName = $_[0];
  foreach my $instance (keys %{$PSEUDO_VINST_ALREADY{$moduleName}}){
     if($PSEUDO_VINST_ALREADY{$moduleName}{$instance}->dbPimDBGetInstStatus() eq "FIXED"){next;};
     my @org_bbox = &return_pseudo_vinst_size($moduleName,$instance);
     my $width = $org_bbox[2] - $org_bbox[0];
     my $height = $org_bbox[3] - $org_bbox[1];
     my @bbox = (0, 0, $width, $height);
     $PSEUDO_VINST_ALREADY{$moduleName}{$instance}->dbPimDBSetInstRelBbox(@bbox);
     #$PSEUDO_VINST_ALREADY{$moduleName}{$instance}->dbPimDBSetInstRelLoc(0, 0);
     $PSEUDO_VINST_ALREADY{$moduleName}{$instance}->dbPimDBSetInstStatus(PLACED);
     $PSEUDO_VINST_ALREADY{$moduleName}{$instance}->dbPimDBSetInstOrient(N);
  }
}#sub place_hier_inst_at_zero

