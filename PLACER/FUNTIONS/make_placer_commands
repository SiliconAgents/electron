##########################################################################################################
########## command to run mpl placer on full hierarchy and convert design from  hier to flat #############
##########################################################################################################
sub place_hier_mpl{
  use Benchmark;
  my $t0 = new Benchmark;

  my $incr = $_[0];
  my $global_top = $GLOBAL->dbfGlobalGetTOP;
  &editModule('-module', $global_top);
  foreach my $moduleName (keys %MODULE_ALREADY){
     &editModule('-module', $moduleName);
     &set_place_mode('--keepTempFile');
     &place_graph_mpl_pseudo($incr);
     &commitModuleLocOnly('-module', $moduleName);  
  }
  &editModule('-module', $global_top);
  &hier2flat;

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "Command place_hier_mpl took:",timestr($td),"\n";
}#sub place_hier_mpl

