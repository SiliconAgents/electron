##########################################################################################################
######## command to run graywolf placer on full hierarchy and convert design from  hier to flat ##########
##########################################################################################################
sub place_hier_graywolf {
  use Benchmark;
  my $t0 = new Benchmark;

  my $global_top = $GLOBAL->dbfGlobalGetTOP;
  &editModule('-module', $global_top);
  foreach my $moduleName (keys %MODULE_ALREADY){
     &editModule('-module', $moduleName);
     &place_graph_graywolf_pseudo;
     &commitModuleLocOnly('-module', $moduleName);  
  }
  &editModule('-module', $global_top);
  &hier2flat;

  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "Command place_hier_graywolf took:",timestr($td),"\n";
}#sub place_hier_graywolf

