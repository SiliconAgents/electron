#****f* /legalize_flat
#  legalize_flat
# FUNCTION
#  Legalize the flat placement: remove cell overlaps and put every movable
#  standard cell on a row and a site, moving each as little as possible.
#
#  What it is not is the old "legalize", which is place_output_fine_tune: that
#  snaps each instance to the nearest row and site INDEPENDENTLY of every other
#  instance.  It never looks at overlap, so it cannot remove one, and snapping
#  two neighbours to the same row is a way to create one.  This replaces the
#  snapping with a placement.
#
#  Two passes, in the order the density has to be fixed before the rows can be:
#
#  Pass 1, spreading -- OFF BY DEFAULT, and the reason is worth reading.
#  The core is cut into bins, each bin's movable cell area is compared with the
#  free area it has, and a bin holding more than it can fit hands cells to
#  whichever neighbour has room.  It is meant to stop pass 2 having to shove a
#  cell half way across the die because its region was never going to hold it.
#
#  On nangate_flat it does far more harm than good.  Three runs each way,
#  everything else identical:
#
#                       unrouted of 4489     avg move     worst move
#      --spread              523 544 537     12.9-13.2um    83-88um
#      default (off)          78  98  77     13.0-13.1um    50-52um
#
#  Seven times the routing failures for no gain anywhere else, and it only
#  moves about 300 of the 4233 cells to do it.  The reason is the kind of move
#  it makes: it retargets a cell to the CENTRE of a neighbouring bin, a full
#  bin away, chosen purely on area with no idea what the cell is connected to.
#  Pass 2 resolves ordinary local density perfectly well by sliding cells along
#  rows, and does it without tearing anything out of its neighbourhood.
#
#  Turn it on with --spread when pass 2 reports cells that found no row at all
#  (WARN 013) -- that is the case it was written for and the case where it
#  earns its cost.  On the hierarchical tests, which have no obstacles and no
#  real hotspots, it is worth about 3% of average displacement and nothing
#  else.
#
#  There is no connectivity term anywhere in here: with no net to pull on, a
#  cell has no reason to be anywhere except where it already is, so the only
#  objective is displacement.  That is exactly why pass 1 misbehaves -- total
#  displacement is blind to how many pins a cell has.
#
#  THE LOCAL DENSITY CAP, which is the thing to read before using this.
#
#  Pass 2 gives a cell the nearest row whose SEGMENT has room, and on a die
#  with no macros a segment is the whole row.  So the capacity question was
#  "is this 1496um row more than 100% full", the answer at 50% utilisation is
#  almost always no, and the nearest row won every time however crowded it was
#  AT THAT X.  Abacus then fixed a 300% full patch the only way it can, by
#  sliding cells along the row.  The bill, on mxu_256 after hier_place_all:
#
#                       avg |dx|   p99 |dx|   worst    total horizontal
#      --no_dbin          42.9um     351um    879um         36,716 mm
#      the cap on         10.5um      50um    183um          9,005 mm
#
#  and the vertical movement that bought it went from 310mm to 473mm.  27.7
#  METRES of horizontal movement removed for 163mm of vertical, a trade of
#  170 to 1, and it is available because 100% of the over-full width on that
#  design has free space within FOUR ROWS, 5.6um.  Zero overlaps either way.
#
#  TWO THINGS MAKE IT WORK AND BOTH ARE EASY TO GET WRONG.
#
#  It relieves OVERFLOW, it does not equalise density.  Equalising is a
#  transportation problem whose answer drains the dense middle of a die into
#  empty rows hundreds of rows away: simulated on mxu_256 it wants a mean |dy|
#  of 686um against 2.3um for relieving only the overflow.  That is 300 times
#  the movement for no extra legality, and aiming a cell at the CENTRE of
#  another bin is precisely what pass 1 does, which is the best explanation
#  anyone has for why pass 1 multiplies unrouted nets by seven.
#
#  And it is BOUNDED, by -dbin_rows, default 2.  Let the cap reach the whole
#  -rows window and it becomes equalisation by the back door.  Measured on one
#  fixed placement of nangate_flat, unrouted nets of 4489:
#
#      cap off  108      +/-2 rows  119      21um bins, +/-6 rows  138
#      +/-1     173      +/-3       101      5um bins,   +/-6      480
#
#  NOTE WHAT THAT SECOND TABLE DOES NOT SAY.  It does not show a routing
#  improvement.  Fine bins with no bound are clearly, reproducibly harmful --
#  480 against 108 is far outside the noise -- but everything in the sane
#  region lands in the same band as no cap at all, and the order is not even
#  monotone, so on nangate_flat this is worth nothing to the router and
#  nothing is the honest number.  Two reasons to expect that: qrouter itself
#  is not deterministic here (108, 115 and 116 unrouted on three runs of ONE
#  legalized DEF), and nangate_flat is 60 rows on an 85um die where only 62%
#  of the over-full width can be absorbed vertically at all, against 100% on
#  mxu_256.  It is the only design in the tree with a router in its flow, and
#  it is the wrong shape for this.
#
#  So: the displacement win is large, measured, and reproducible; the routing
#  effect is unmeasured on any design where the mechanism applies.  Which is
#  why this is ON by default and pass 1 is not -- it does not move a cell that
#  is not in an over-full bin, it never changes a cell's x, and it never sends
#  one more than two rows -- but if unrouted nets go up on a real design,
#  --no_dbin is the first thing to try and the numbers above are the control.
#
#  Pass 2, rows.  Every movable cell is assigned to a row near its own y and
#  legalized along x by Abacus: cells are taken in x order, and a cell that
#  would overlap its left neighbour is merged into a cluster whose position is
#  the weighted mean of its members' targets, collapsing into the cluster before
#  it when those overlap in turn.  That is the minimum total squared
#  displacement for a given row assignment, which is the closest thing to "moved
#  as little as possible" that is cheap to compute.  Rows are tried nearest
#  first within a window, and the assignment with the lowest cost wins.
#
#  FIXED instances never move.  Nor does anything that is not a CORE cell: a
#  macro is not a row object and legalizing one by sliding it along a row would
#  be worse than leaving it, so blocks and pads are obstacles here, and the rows
#  they sit on are cut into free intervals around them.
#
# SYNOPSIS
#  legalize_flat
#
# INPUTS
#
#       options :
#               -grid <um> : bin size for pass 1, default 10
#               -rows <n> : rows either side to try in pass 2, default 6
#               -max_disp <um> : report cells moved further than this
#               -iters <n> : pass 1 iteration cap, default 20
#
#       switches :
#               --spread : run pass 1; it is off by default, see above
#               --no_spread : the default, kept so old scripts still run
#               --no_snap_x : leave x off the site grid
#               --report_only : say what it would do and change nothing
#
# OUTPUTS
#               instance locations in CADB, and the instance boxes
#
#****

#=========================== orientation for a row ===========================#
#<!-- What orientation a cell must take to sit in a row of a given orientation.
#
#     Standard cell rows alternate -- N, FS, N, FS -- so that a row and the one
#     above it share a power rail.  A cell in an FS row has to be flipped in y
#     to match, or its VDD meets the neighbour's VSS.
#
#     This was simply never done.  legalize_flat read dbCadbGetOrient only to
#     transpose w and h for a 90 degree rotation, and never wrote an orientation
#     back, so every cell came out of the placer N and stayed N.  Measured on
#     mxu_256: 423,506 of 855,424 cells, 49.5%, sat in an FS row as N.
#
#     It matters more the moment a legalizer starts moving cells between rows on
#     purpose, which is what the local density cap below does -- but it was
#     already wrong for every cell the row window moved, and |dy| already
#     reached two row pitches.
#
#     The rule is: keep whatever mirroring in x the cell already had, take the
#     row's flip in y.  The four row-legal orientations are exactly the two
#     bits (mirror x, flip y):
#
#         N = (0,0)   FN = (1,0)   FS = (0,1)   S = (1,1)
#
#     A 90 degree rotated cell -- E, W, FE, FW -- is not a row object at all;
#     composing a rotation with a row flip is ambiguous and a rotated standard
#     cell does not occur in this flow, so those are returned untouched rather
#     than guessed at. -->
sub dbfLegalOrientForRow {
my ($cell, $row) = @_;
$cell = "N" unless ( defined $cell && $cell ne "" );
$row  = "N" unless ( defined $row  && $row  ne "" );
return $cell if ( $cell =~ m/^F?[EW]$/ );
my %xmir = ( "N" => 0, "FN" => 1, "FS" => 0, "S" => 1 );
my %yflp = ( "N" => 0, "FN" => 0, "FS" => 1, "S" => 1 );
#<!-- an orientation this does not know about is left alone -->
return $cell unless ( exists $xmir{$cell} );
my $ry = ( exists $yflp{$row} ) ? $yflp{$row} : 0;
my @tab = ( [ "N", "FS" ], [ "FN", "S" ] );      #<!-- [mirror x][flip y] -->
return $tab[ $xmir{$cell} ][ $ry ];
}#sub dbfLegalOrientForRow

sub legalize_flat {

use Benchmark;
use POSIX qw(ceil floor);
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $gridUm = 10;
my $rowWin = 6;
my $maxDispUm;
my $iterCap = 20;
my ($noSnapX, $reportOnly, $debug) = (0, 0, 0);
#<!-- Pass 1 is OFF by default.  See the measurement above the pass itself. -->
my $doSpread = 0;
my ($extPlacer, $extArgs, $keepExt);
my $spreadOrder = "large";
#<!-- Local density cap on the row assignment.  0 means "work it out from the
#     row span"; -1 turns it off and restores the behaviour this replaces. -->
my $dbinUm = 0;
#<!-- How many rows the cap may push a cell off its nearest.  The relief it is
#     there for is one or two rows away; letting it reach the whole -rows window
#     turns it back into density equalisation, which is exactly what it must not
#     be -- measured, unbounded it takes nangate_flat from 116 unrouted nets to
#     480, bounded at two it improves them. -->
my $dbinRows = 2;

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : legalize_flat -grid <bin size in um, default 10>\n";
  print "                      -rows <rows either side to try, default 6>\n";
  print "                      -max_disp <um, report cells moved further>\n";
  print "                      -iters <spreading iteration cap, default 20>\n";
  print "                      --spread       run the density pass (default OFF,\n";
  print "                                     see below)\n";
  print "                      --no_spread    the default; kept so old scripts run\n";
  print "                      --no_snap_x    leave x off the site grid\n";
  print "                      --report_only  change nothing\n";
  print "                      -dbin <um>     column width for the local density\n";
  print "                                     cap on the row assignment.  0, the\n";
  print "                                     default, is 100 mean cell widths\n";
  print "                      -dbin_rows <n> how many rows the local cap may push\n";
  print "                                     a cell off its nearest, default 2.\n";
  print "                                     Unbounded it becomes equalisation\n";
  print "                      --no_dbin      no local cap: every cell takes its\n";
  print "                                     nearest row however full that row\n";
  print "                                     already is locally.  The behaviour\n";
  print "                                     before the cap existed, kept for A/B\n";
  print "                      -spread_order <small|large>\n";
  print "                            which cell an over-full bin gives away.\n";
  print "                            large moves fewer cells and lowers total\n";
  print "                            displacement; small leaves the big drivers\n";
  print "                            alone and routes better, and is the default.\n";
  print "                      -debug\n";
  print "\n";
  print "        -placer <path>   hand the rows, cells and obstacles to an\n";
  print "                         external legalizer instead of legalizing here.\n";
  print "                         ELECTRON_HOME/3RDBIN/legalize_flat is the one\n";
  print "                         that ships: NumPy, and it reserves the rows\n";
  print "                         above a cell taller than one row, which the\n";
  print "                         internal path does not.\n";
  print "        -args <extra>    passed straight to it\n";
  print "        --keep_files     keep <top>.legal.in and <top>.legal.out\n";
  print "\n";
  print "        The code in here is the reference: short, readable, and the\n";
  print "        thing to check an external legalizer against on a small design\n";
  print "        whose cells are all one row tall.\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-grid")        { $gridUm = $_[$i+1]; }
  elsif ($_[$i] eq "-rows")        { $rowWin = $_[$i+1]; }
  elsif ($_[$i] eq "-max_disp")    { $maxDispUm = $_[$i+1]; }
  elsif ($_[$i] eq "-iters")       { $iterCap = $_[$i+1]; }
  elsif ($_[$i] eq "--no_spread")  { $doSpread = 0; }
  elsif ($_[$i] eq "--spread")     { $doSpread = 1; }
  elsif ($_[$i] eq "--no_snap_x")  { $noSnapX = 1; }
  elsif ($_[$i] eq "--report_only"){ $reportOnly = 1; }
  elsif ($_[$i] eq "-spread_order"){ $spreadOrder = $_[$i+1]; }
  elsif ($_[$i] eq "-dbin")        { $dbinUm = $_[$i+1]; }
  elsif ($_[$i] eq "--no_dbin")    { $dbinUm = -1; }
  elsif ($_[$i] eq "-dbin_rows")   { $dbinRows = $_[$i+1]; }
  elsif ($_[$i] eq "-placer")      { $extPlacer = $_[$i+1]; }
  elsif ($_[$i] eq "-args")        { $extArgs = $_[$i+1]; }
  elsif ($_[$i] eq "--keep_files") { $keepExt = 1; }
  elsif ($_[$i] eq "-debug")       { $debug = 1; }
  elsif ($_[$i] =~ m/^-+\w/)       { print "WARN-ALG-LEGAL : 001 : invalid option $_[$i]\n"; }
}

my $dbu = $GLOBAL->dbfGlobalGetDBU;
unless ( defined $dbu && $dbu > 0 ) {
  print "ERR-ALG-LEGAL : 002 : database units are not set\n";
  return;
}

my $flplanID = $FLOORPLAN_LOOKUP{"$TOP_MODULE/_self_"};
unless ( defined $flplanID && exists $FLOORPLAN_ALREADY{$flplanID} ) {
  print "ERR-ALG-LEGAL : 003 : module $TOP_MODULE has no floorplan\n";
  return;
}
my @die = $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetSize;
unless ( @die >= 4 && $die[2] > $die[0] && $die[3] > $die[1] ) {
  print "ERR-ALG-LEGAL : 004 : module $TOP_MODULE has no die area\n";
  return;
}

#---------------------------- the rows -----------------------------------#
#<!-- Stored as "name site x0 y0 orient numX numY stepX stepY", the same by
#     read_def and by dbgGenerateRows, all of it in dbu.  Field 3 is the row's
#     y and field 7 its site pitch, which is what dbPlaceGetNearestRow and
#     dbPlaceGetNearestXStep already rely on. -->
my $rowH = $GLOBAL->dbGlobalGetRowHeight;
unless ( defined $rowH && $rowH > 0 ) {
  print "ERR-ALG-LEGAL : 005 : row height is not set, read a LEF with a site\n";
  return;
}
$rowH = $rowH * $dbu;

my @rowY = ();
my %rowX0 = ();
my %rowX1 = ();
my %rowOrient = ();
my $siteX = 0;
foreach my $tag ( $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetRows ) {
  my @f = split(/\s+/, $tag);
  next unless ( @f >= 8 );
  my ($x0, $y, $numX, $stepX) = ($f[2], $f[3], $f[5], $f[7]);
  next unless ( defined $y && defined $x0 && defined $numX && defined $stepX );
  my $x1 = $x0 + $numX * $stepX;
  #<!-- one entry per y, widened if the same y is given in several records -->
  if ( exists $rowX0{$y} ) {
    $rowX0{$y} = $x0 if ( $x0 < $rowX0{$y} );
    $rowX1{$y} = $x1 if ( $x1 > $rowX1{$y} );
  }
  else {
    push(@rowY, $y);
    $rowX0{$y} = $x0;
    $rowX1{$y} = $x1;
    #<!-- field 4 is the row's orientation, and it is the whole reason a cell
    #     cannot simply be dropped into a different row: rows alternate N and
    #     FS so that neighbours share a power rail, and a cell left N in an FS
    #     row has its rails upside down. -->
    $rowOrient{$y} = ( defined $f[4] && $f[4] ne "" ) ? $f[4] : "N";
  }
  $siteX = $stepX if ( $stepX > $siteX );
}
@rowY = sort { $a <=> $b } @rowY;
my $nRows = @rowY;
unless ( $nRows > 0 ) {
  print "ERR-ALG-LEGAL : 006 : $TOP_MODULE has no ROWs, run floorplan first\n";
  return;
}
if ( $siteX <= 0 ) { $siteX = 1; $noSnapX = 1; }

#------------------------- movable and obstacles --------------------------#
#<!-- Movable is a CORE cell the database calls PLACED.  FIXED never moves, and
#     anything that is not CORE -- a macro, a pad -- is an obstacle: it is not a
#     row object, and sliding one along a row to legalize it would do more harm
#     than leaving it where it is. -->
my @mov = ();          #<!-- [inst, w, h, tx, ty] in dbu, tx/ty the target -->
my $totMovW = 0;       #<!-- their total width, for the default bin size -->
my @obs = ();          #<!-- [llx, lly, urx, ury] -->
my ($skipNoCell, $skipNoSize, $unplacedCnt) = (0, 0, 0);

foreach my $inst ( sort keys %CADB ) {
  my $cellref = $CADB{$inst}->dbCadbGetCellref;
  unless ( defined $cellref && exists $PLDB{$cellref} ) {
    $skipNoCell++;
    next;
  }
  my @size = $PLDB{$cellref}->dbMdbGetSize;
  unless ( @size >= 2 && $size[0] > 0 && $size[1] > 0 ) {
    $skipNoSize++;
    next;
  }
  my $orient = $CADB{$inst}->dbCadbGetOrient;
  $orient = "N" unless ( defined $orient && $orient ne "" );
  my ($w, $h) = ($size[0] * $dbu, $size[1] * $dbu);
  #<!-- a rotated cell occupies the transposed footprint -->
  if ( $orient eq "E" || $orient eq "FE" || $orient eq "W" || $orient eq "FW" ) {
    ($w, $h) = ($h, $w);
  }

  my $status = $CADB{$inst}->dbCadbGetStatus;
  $status = "" unless ( defined $status );
  my @loc = $CADB{$inst}->dbCadbGetLoc;
  my ($x, $y) = ( (defined $loc[0]) ? $loc[0] : 0, (defined $loc[1]) ? $loc[1] : 0 );

  if ( $status ne "PLACED" && $status ne "FIXED" ) {
    #<!-- nothing to preserve and nothing to legalize: a cell with no location
    #     is the placer's problem, not the legalizer's -->
    $unplacedCnt++;
    next;
  }

  my $class = $PLDB{$cellref}->dbMdbGetClass;
  $class = "" unless ( defined $class );
  my $isCore = ( $class =~ m/^CORE/ ) ? 1 : 0;

  if ( $status eq "FIXED" || ! $isCore ) {
    push(@obs, [$x, $y, $x + $w, $y + $h]);
    next;
  }
  push(@mov, [$inst, $w, $h, $x, $y]);
  $totMovW += $w;
}

my $nMov = @mov;
my $nObs = @obs;
print "INFO-ALG-LEGAL : 007 : $nMov movable CORE cell(s), $nObs obstacle(s) held\n";
if ( $unplacedCnt > 0 ) {
  print "INFO-ALG-LEGAL : 008 : $unplacedCnt instance(s) have no location and were left for the placer\n";
}
if ( $skipNoCell > 0 ) {
  print "WARN-ALG-LEGAL : 009 : $skipNoCell instance(s) have no cell in the library and were skipped\n";
}
if ( $skipNoSize > 0 ) {
  print "WARN-ALG-LEGAL : 010 : $skipNoSize instance(s) have a cell with no size and were skipped\n";
}
unless ( $nMov > 0 ) {
  print "INFO-ALG-LEGAL : 011 : nothing movable, stopping\n";
  return;
}

#<!-- remember where everything started, to measure the displacement against -->
my %origX = ();
my %origY = ();
foreach my $m ( @mov ) {
  $origX{$m->[0]} = $m->[3];
  $origY{$m->[0]} = $m->[4];
}

#================== hand the whole thing to an external tool ================#
#<!-- -placer forks off here, after the rows, the movable cells and the
#     obstacles have been worked out and before either pass runs, because those
#     three things are what the external tool needs and everything after this
#     point is the algorithm it replaces.
#
#     3RDBIN/legalize_flat is the one that ships: same two passes, NumPy, and
#     it reserves the rows above a multi-row cell, which the code below does
#     not.  Anything that reads the format and writes back "PLACE idx x y" will
#     do.
#
#     The format is deliberately its own rather than the flat placer nodefile:
#     a legalizer needs rows, sites and obstacles, and needs no nets at all, so
#     sharing the placer's format would mean writing a netlist nobody reads.
#     Everything in it is integer DBU. -->
if ( defined $extPlacer && $extPlacer ne "" ) {
  unless ( -e $extPlacer ) {
    print "ERR-ALG-LEGAL : 022 : no legalizer at $extPlacer\n";
    return;
  }
  my $inFile  = "$TOP_MODULE.legal.in";
  my $outFile = "$TOP_MODULE.legal.out";
  unlink($outFile) if ( -e $outFile );

  unless ( open(LGL_IN, ">$inFile") ) {
    print "ERR-ALG-LEGAL : 023 : cannot write $inFile : $!\n";
    return;
  }
  print LGL_IN "# electron legalizer input, all integers in dbu\n";
  print LGL_IN "UNITS $dbu\n";
  print LGL_IN "DIE $die[0] $die[1] $die[2] $die[3]\n";
  print LGL_IN "ROWH $rowH\n";
  print LGL_IN "SITEX $siteX\n";
  foreach my $y ( @rowY ) {
    print LGL_IN "ROW $y $rowX0{$y} $rowX1{$y}\n";
  }
  foreach my $o ( @obs ) {
    print LGL_IN "OBS $o->[0] $o->[1] $o->[2] $o->[3]\n";
  }
  #<!-- the index is what comes back, so the mapping has to be kept -->
  my @byIdx = ();
  for ( my $i = 0 ; $i < @mov ; $i++ ) {
    my $m = $mov[$i];
    push(@byIdx, $m->[0]);
    print LGL_IN "CELL $i $m->[1] $m->[2] $m->[3] $m->[4] $m->[0]\n";
  }
  close(LGL_IN);
  print "INFO-ALG-LEGAL : 024 : wrote $inFile, " . scalar(@mov) . " cell(s)\n";

  #<!-- run it the way the other 3RDBIN tools are run: executable with a
  #     python3 shebang, or through the interpreter if it is neither -->
  my $cmd = ( -x $extPlacer ) ? "$extPlacer $inFile $outFile"
                              : "python3 $extPlacer $inFile $outFile";
  $cmd .= " --grid $gridUm --rows $rowWin --iters $iterCap";
  $cmd .= " --spread-order $spreadOrder";
  $cmd .= " --spread" if ( $doSpread );
  $cmd .= " --no-snap-x" if ( $noSnapX );
  $cmd .= " $extArgs" if ( defined $extArgs && $extArgs ne "" );
  print "INFO-ALG-LEGAL : 025 : $cmd\n";
  my $rc = system($cmd);
  if ( $rc != 0 ) {
    print "ERR-ALG-LEGAL : 026 : the legalizer exited with status $rc, nothing applied\n";
    return;
  }
  unless ( -e $outFile ) {
    print "ERR-ALG-LEGAL : 027 : $outFile was not written, nothing applied\n";
    return;
  }

  unless ( open(LGL_OUT, "<$outFile") ) {
    print "ERR-ALG-LEGAL : 028 : cannot read $outFile : $!\n";
    return;
  }
  my ($extN, $extSum, $extMax, $extMaxInst, $extBad) = (0, 0, 0, "", 0);
  my @extLoc = ();
  while ( my $line = <LGL_OUT> ) {
    next if ( $line =~ /^\s*(#|$)/ );
    my @f = split(/\s+/, $line);
    next unless ( @f >= 4 && $f[0] eq "PLACE" );
    my ($i, $x, $y) = ($f[1], $f[2], $f[3]);
    unless ( $i =~ /^\d+$/ && $i < @byIdx ) { $extBad++; next; }
    my $inst = $byIdx[$i];
    push(@extLoc, [$inst, $x, $y]);
    my $disp = abs($x - $origX{$inst}) + abs($y - $origY{$inst});
    $extSum += $disp;
    if ( $disp > $extMax ) { $extMax = $disp; $extMaxInst = $inst; }
    $extN++;
  }
  close(LGL_OUT);
  if ( $extBad > 0 ) {
    print "WARN-ALG-LEGAL : 029 : $extBad line(s) of $outFile named no cell and were ignored\n";
  }
  unless ( $extN > 0 ) {
    print "ERR-ALG-LEGAL : 030 : $outFile placed nothing, leaving the placement alone\n";
    return;
  }
  #<!-- a cell the tool did not place keeps its own location, exactly as the
  #     internal path leaves a cell that found no row -->
  if ( $extN < @mov ) {
    my $miss = @mov - $extN;
    print "WARN-ALG-LEGAL : 031 : $miss cell(s) came back unplaced and keep their location\n";
  }
  printf("INFO-ALG-LEGAL : 032 : legalized %d cell(s), average move %.3f um, worst %.3f um%s\n",
         $extN, ($extSum / $extN) / $dbu, $extMax / $dbu,
         ( $extMaxInst ne "" ) ? " on $extMaxInst" : "");

  if ( $reportOnly ) {
    print "INFO-ALG-LEGAL : 033 : --report_only given, nothing was changed\n";
    my $t1 = new Benchmark;
    print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
    return;
  }
  my $extReOriented = 0;
  foreach my $n ( @extLoc ) {
    my ($inst, $x, $y) = @$n;
    $CADB{$inst}->dbCadbSetLoc($x, $y);
    $CADB{$inst}->dbCadbSetStatus(PLACED);
    #<!-- same rule as the internal path.  A y the external tool returns that is
    #     not exactly a row's y is left alone rather than guessed at. -->
    if ( exists $rowOrient{$y} ) {
      my $was = $CADB{$inst}->dbCadbGetOrient;
      my $now = &dbfLegalOrientForRow($was, $rowOrient{$y});
      if ( ! defined $was || $was ne $now ) {
        $CADB{$inst}->dbCadbSetOrient($now);
        $extReOriented++;
      }
    }
    if ( exists $PLACE{$TOP_MODULE} && $PLACE{$TOP_MODULE}->dbPlaceGetIsInstFlop($inst) ) {
      $PLACE{$TOP_MODULE}->dbPlaceSetFlopLoc($inst, $x, $y);
    }
  }
  if ( $extReOriented > 0 ) {
    print "INFO-ALG-LEGAL : 038 : $extReOriented cell(s) re-oriented to match their row\n";
  }
  print "INFO-ALG-LEGAL : 034 : updating instance boxes\n";
  &set_inst_box;
  unless ( $keepExt ) { unlink($inFile); unlink($outFile); }
  my $t1 = new Benchmark;
  print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
  return;
}

#====================== pass 1: spread the density =========================#
if ( $doSpread ) {
  my $bin = $gridUm * $dbu;
  $bin = $rowH if ( $bin < $rowH );        #<!-- a bin shorter than a row is no use -->
  my $nbx = int( ($die[2] - $die[0]) / $bin ) + 1;
  my $nby = int( ($die[3] - $die[1]) / $bin ) + 1;

  #<!-- free area per bin: its own area less whatever an obstacle covers of it -->
  my %cap = ();
  for ( my $bx = 0 ; $bx < $nbx ; $bx++ ) {
    for ( my $by = 0 ; $by < $nby ; $by++ ) {
      my $x0 = $die[0] + $bx * $bin;  my $x1 = $x0 + $bin;
      my $y0 = $die[1] + $by * $bin;  my $y1 = $y0 + $bin;
      $x1 = $die[2] if ( $x1 > $die[2] );
      $y1 = $die[3] if ( $y1 > $die[3] );
      my $a = ($x1 - $x0) * ($y1 - $y0);
      $a = 0 if ( $a < 0 );
      $cap{"$bx,$by"} = $a;
    }
  }
  foreach my $o ( @obs ) {
    my $bx0 = int( ($o->[0] - $die[0]) / $bin );  my $bx1 = int( ($o->[2] - $die[0]) / $bin );
    my $by0 = int( ($o->[1] - $die[1]) / $bin );  my $by1 = int( ($o->[3] - $die[1]) / $bin );
    for ( my $bx = $bx0 ; $bx <= $bx1 ; $bx++ ) {
      next if ( $bx < 0 || $bx >= $nbx );
      for ( my $by = $by0 ; $by <= $by1 ; $by++ ) {
        next if ( $by < 0 || $by >= $nby );
        my $x0 = $die[0] + $bx * $bin;  my $x1 = $x0 + $bin;
        my $y0 = $die[1] + $by * $bin;  my $y1 = $y0 + $bin;
        my $ox = ( ($o->[2] < $x1 ? $o->[2] : $x1) - ($o->[0] > $x0 ? $o->[0] : $x0) );
        my $oy = ( ($o->[3] < $y1 ? $o->[3] : $y1) - ($o->[1] > $y0 ? $o->[1] : $y0) );
        next if ( $ox <= 0 || $oy <= 0 );
        $cap{"$bx,$by"} -= $ox * $oy;
        $cap{"$bx,$by"} = 0 if ( $cap{"$bx,$by"} < 0 );
      }
    }
  }

  my $binOf = sub {
    my ($m) = @_;
    my $bx = int( ($m->[3] + $m->[1]/2 - $die[0]) / $bin );
    my $by = int( ($m->[4] + $m->[2]/2 - $die[1]) / $bin );
    $bx = 0 if ( $bx < 0 ); $bx = $nbx-1 if ( $bx >= $nbx );
    $by = 0 if ( $by < 0 ); $by = $nby-1 if ( $by >= $nby );
    return ($bx, $by);
  };

  my $movedOut = 0;
  my $iter = 0;
  while ( $iter < $iterCap ) {
    $iter++;
    my %load = ();
    my %members = ();
    foreach my $m ( @mov ) {
      my ($bx, $by) = $binOf->($m);
      $load{"$bx,$by"} += $m->[1] * $m->[2];
      push(@{$members{"$bx,$by"}}, $m);
    }
    #<!-- Worst bin first, so the relief goes where it is needed most, and the
    #     bin key as the tie break so that the order is the same every run.
    #
    #     Without the tie break this sorts over "keys %load", and Perl
    #     randomises hash order per process: bins with equal overflow were
    #     relieved in a different order each time, different cells were handed
    #     to neighbours, and the whole legalisation came out different.
    #     Measured on matmul_4x4 before the fix -- two identical runs agreed on
    #     88.8% of 204,816 cells and moved the rest by 11um on average, which
    #     is enough to hide a real regression inside the noise.  This was the
    #     only hash-ordered iteration in the algorithm; the cell loop above
    #     already sorts. -->
    #<!-- The tie break compares the bin indices NUMERICALLY, not the "bx,by"
    #     key as a string: "10,5" sorts before "9,3" as text and after it as a
    #     pair of numbers.  3RDBIN/legalize_flat does the same comparison the
    #     numeric way, and the two have to agree or the reference stops being
    #     one -- it showed up as 48,219 cells rebinned here against 48,216
    #     there on the same design.
    #
    #     Decorated, because a split inside a comparator runs O(n log n) times
    #     and cost nine seconds of the thirty-five on the 855k cell MXU.  This
    #     way the key is built once per bin. -->
    my @over = map  { $_->[0] }
               sort { $b->[1] <=> $a->[1] || $a->[2] <=> $b->[2] }
               map  { my ($qx, $qy) = split(/,/, $_);
                      [ $_, $load{$_} - $cap{$_}, $qx * $nby + $qy ] }
               grep { $load{$_} > $cap{$_} } keys %load;
    last unless ( @over );

    my $movedThisPass = 0;
    #<!-- $bkey, NOT $b.
    #
    #     This loop variable used to be called $b, and the two sorts below
    #     compare $b against $a.  A lexical "my $b" in scope SHADOWS sort's $b,
    #     and sort cannot assign to a lexical, so inside both comparators $b
    #     was the bin key string -- "3,7" -- and $b->[3] was a symbolic deref
    #     of an array that does not exist, i.e. undef.  Each comparator
    #     degenerated to "0 <=> $a->something", which sorts ASCENDING by that
    #     something: exactly the reverse of what both were written to do.
    #
    #     So the spreading pass handed the SMALLEST cell to the neighbour with
    #     the LEAST room, where the comments promise the opposite.  It still
    #     terminated and still produced a legal placement, which is why it
    #     went unnoticed -- it just relieved very little per iteration, ran
    #     into the -iters cap, and left pass 2 to shove cells a long way.  perl
    #     -w reports it as "uninitialized value in multiplication" and nothing
    #     in this tree runs with -w.
    #
    #     Renaming the variable is the whole fix; the comparators were right. -->
    foreach my $bkey ( @over ) {
      my ($bx, $by) = split(/,/, $bkey);
      my $excess = $load{$bkey} - $cap{$bkey};
      next unless ( $excess > 0 );
      #<!-- the cheapest cell to give away is the one nearest a bin with room -->
      my @cand = ();
      foreach my $dx ( -1, 0, 1 ) {
        foreach my $dy ( -1, 0, 1 ) {
          next if ( $dx == 0 && $dy == 0 );
          my ($nx, $ny) = ($bx + $dx, $by + $dy);
          next if ( $nx < 0 || $nx >= $nbx || $ny < 0 || $ny >= $nby );
          my $k = "$nx,$ny";
          my $room = $cap{$k} - ( defined $load{$k} ? $load{$k} : 0 );
          push(@cand, [$k, $nx, $ny, $room]) if ( $room > 0 );
        }
      }
      next unless ( @cand );
      #<!-- most room first, bin indices numerically as the tie break -->
      @cand = sort { $b->[3] <=> $a->[3]
                     || $a->[1] <=> $b->[1] || $a->[2] <=> $b->[2] } @cand;

      #<!-- Which cell to give away, and why the default is the SMALL one.
      #
      #     Largest first relieves the most excess per move, so it moves fewer
      #     cells and comes out with a lower total displacement -- 41.9um
      #     against 43.8um on matmul_4x4.  It also routes measurably worse.
      #     Three runs of nangate_flat each way, same build, same everything:
      #
      #         smallest first   360, 371, 395 nets of 4489 unrouted
      #         largest first    501, 522, 544
      #
      #     Non overlapping, so it is not the placer's run to run spread.  The
      #     reason is that a move here is not a nudge: it retargets the cell to
      #     the CENTRE of a neighbouring bin, a full bin away.  The big cells
      #     are the drivers, they carry the most pins, and tearing one out of
      #     its neighbourhood costs more wire than nudging several small ones
      #     -- which total displacement, summed over cells and blind to pin
      #     count, does not see.
      #
      #     So displacement is the wrong thing to optimise here and this picks
      #     the other way on purpose.  -spread_order large restores it.
      #     Area ties break on the instance name so two runs pick the same
      #     cell. -->
      my @members = ( $spreadOrder eq "large" )
        ? sort { $b->[1]*$b->[2] <=> $a->[1]*$a->[2] || $a->[0] cmp $b->[0] } @{$members{$bkey}}
        : sort { $a->[1]*$a->[2] <=> $b->[1]*$b->[2] || $a->[0] cmp $b->[0] } @{$members{$bkey}};
      foreach my $m ( @members ) {
        last if ( $excess <= 0 );
        my $area = $m->[1] * $m->[2];
        foreach my $c ( @cand ) {
          next if ( $c->[3] < $area );
          #<!-- shift the target just inside the neighbour, keeping the other
          #     axis where it was: the move has to be the smallest one that
          #     changes which bin the cell belongs to -->
          my $tx = $die[0] + $c->[1] * $bin + $bin/2 - $m->[1]/2;
          my $ty = $die[1] + $c->[2] * $bin + $bin/2 - $m->[2]/2;
          $m->[3] = $tx;
          $m->[4] = $ty;
          $c->[3] -= $area;
          $load{$c->[0]} += $area;
          $excess -= $area;
          $movedThisPass++;
          $movedOut++;
          last;
        }
      }
    }
    last unless ( $movedThisPass > 0 );
  }
  print "INFO-ALG-LEGAL : 012 : spreading: $movedOut cell(s) rebinned in $iter pass(es)",
        " over ${gridUm}um bins\n";
}

#====================== pass 2: rows and Abacus ============================#
#<!-- Free intervals per row.  An obstacle covering part of a row's y band cuts
#     it in two, and each piece is legalized on its own: a cell cannot slide
#     through a macro. -->
my %seg = ();          #<!-- y => [ [x0,x1], ... ] -->
foreach my $y ( @rowY ) {
  my @cut = ();
  foreach my $o ( @obs ) {
    next if ( $o->[3] <= $y || $o->[1] >= $y + $rowH );      #<!-- no y overlap -->
    my $a = ( $o->[0] > $rowX0{$y} ) ? $o->[0] : $rowX0{$y};
    my $b = ( $o->[2] < $rowX1{$y} ) ? $o->[2] : $rowX1{$y};
    push(@cut, [$a, $b]) if ( $b > $a );
  }
  @cut = sort { $a->[0] <=> $b->[0] } @cut;
  my @free = ();
  my $x = $rowX0{$y};
  foreach my $c ( @cut ) {
    push(@free, [$x, $c->[0]]) if ( $c->[0] > $x );
    $x = $c->[1] if ( $c->[1] > $x );
  }
  push(@free, [$x, $rowX1{$y}]) if ( $rowX1{$y} > $x );
  $seg{$y} = \@free;
}

#--------------------- local density cap on the assignment -------------------#
#<!-- WHY THIS EXISTS.
#
#     Below, a cell is given the row nearest its own y whose SEGMENT has room.
#     A segment is a whole free run of a row, and on a die with no macros that
#     is the entire row: 1496um on mxu_256.  So the capacity test was asking
#     "is this 1496um row more than 100% full", and the answer is almost always
#     no -- the design is at 50% utilisation and only 42 of 1068 rows overflow
#     as whole rows.  The cost is abs(wx - tx) + abs(y - ty) with wx clamped
#     only to the segment, so wx == tx, the cost collapses to pure |dy|, and
#     the nearest row wins every time whatever the LOCAL density.
#
#     Measured on mxu_256 after hier_place_all: at 47um columns 22.8% of
#     occupied bins are over capacity and 22.1% of all cell width has to leave
#     its bin.  Abacus then does that the only way it can, by sliding cells
#     along the row, and the bill is mean |dx| 42.9um against mean |dy| 0.36um
#     -- 36.7 metres of horizontal movement against 0.31 of vertical, on a
#     design where 100% of the excess has free space within FOUR ROWS, 5.6um.
#
#     So the fix is to make the capacity test local: bins across each row, and
#     a cell may not take a row whose bin at that x is already full.  The
#     search below already walks rows nearest-first, so pruning candidates this
#     way makes it exactly "the nearest row with room here" -- which is the
#     cheapest possible relief and needs no extra pass.
#
#     AND NOT DENSITY EQUALISATION, which is the trap.  Making every bin's
#     density equal is a transportation problem whose answer drains the dense
#     middle of the die into empty rows hundreds of rows away: simulated on
#     mxu_256 it costs a mean |dy| of 686um, against 2.3um for relieving only
#     the overflow.  That is 300 times the movement for no extra legality, and
#     it is what pass 1 above does -- it aims a cell at the CENTRE of another
#     bin -- which is the best explanation anyone has for why pass 1 multiplies
#     unrouted nets by seven.  Nothing here moves a cell that is not in an
#     over-full bin, and nothing here changes a cell's x.
#
#     Capacity is the FREE width in the bin, not the bin width, so a bin half
#     covered by a macro counts as half a bin and cells are not driven into
#     obstacles. -->
my $dbin = 0;
my %binCap = ();       #<!-- "rowIdx,binIdx" => free width in dbu -->
my %binLoad = ();
my $binX0 = 0;
my $nBins = 0;
if ( $dbinUm >= 0 ) {
  my ($spanLo, $spanHi);
  foreach my $y ( @rowY ) {
    $spanLo = $rowX0{$y} if ( ! defined $spanLo || $rowX0{$y} < $spanLo );
    $spanHi = $rowX1{$y} if ( ! defined $spanHi || $rowX1{$y} > $spanHi );
  }
  $binX0 = ( defined $spanLo ) ? $spanLo : 0;
  my $span = ( defined $spanHi ) ? $spanHi - $binX0 : 0;
  if ( $span > 0 ) {
    if ( $dbinUm > 0 ) { $dbin = $dbinUm * $dbu; }
    else {
      #<!-- A HUNDRED CELLS WIDE, not a fraction of the row.
      #
      #     A fraction of the span was the first try and it is wrong, because
      #     it reads the die size rather than the cell size.  span/16 is 94um
      #     on mxu_256 -- about a hundred cells, which is the size that
      #     measured well -- and 5.32um on the 85um die of nangate_flat, about
      #     five cells.  At five cells this is not relieving overflow any more,
      #     it is demanding uniform density at cell granularity.
      #
      #     A hundred times the mean cell width is scale free and lands on both
      #     sizes that measured well: ~93um on mxu_256, ~21um on nangate_flat
      #     once the span/4 clamp bites.
      #
      #     Clamped below so a bin is always several sites wide, and above so a
      #     small die still gets four columns rather than one. -->
      my $meanW = ( $nMov > 0 ) ? ( $totMovW / $nMov ) : 0;
      $dbin = int( 100 * $meanW );
      my $lo = 8 * $siteX;
      my $hi = int( $span / 4 );
      $dbin = $lo if ( $dbin < $lo );
      $dbin = $hi if ( $hi > 0 && $dbin > $hi );
    }
    $dbin = $siteX if ( $dbin < $siteX );
    $nBins = int( $span / $dbin ) + 1;
    #<!-- free width per bin, from the segments so obstacles are counted -->
    for ( my $r = 0 ; $r < $nRows ; $r++ ) {
      my $y = $rowY[$r];
      foreach my $s ( @{$seg{$y}} ) {
        my ($a, $b) = @$s;
        my $b0 = int( ($a - $binX0) / $dbin );
        my $b1 = int( ($b - $binX0) / $dbin );
        $b0 = 0 if ( $b0 < 0 );
        $b1 = $nBins - 1 if ( $b1 > $nBins - 1 );
        for ( my $bi = $b0 ; $bi <= $b1 ; $bi++ ) {
          my $lo = $binX0 + $bi * $dbin;
          my $hi = $lo + $dbin;
          $lo = $a if ( $a > $lo );
          $hi = $b if ( $b < $hi );
          $binCap{"$r,$bi"} += ($hi - $lo) if ( $hi > $lo );
        }
      }
    }
    printf("INFO-ALG-LEGAL : 039 : local density cap on, %d column(s) of %.2f um, up to %d row(s) away\n",
           $nBins, $dbin / $dbu, $dbinRows);
  }
}
else {
  print "INFO-ALG-LEGAL : 040 : --no_dbin, the row assignment ignores local density\n";
}

#<!-- Abacus on one segment.  Cells arrive in x order; a cell that will not fit
#     after the last cluster starts a new one, otherwise it joins and the
#     cluster slides to the weighted mean of its members' targets, merging into
#     its left neighbour when that now overlaps.  The result is the minimum sum
#     of squared displacement for this set of cells in this segment. -->
my $abacus = sub {
  my ($cells, $xlo, $xhi) = @_;     #<!-- cells: [ [inst,w,tx], ... ] in x order -->
  my @cl = ();                      #<!-- cluster: [x, w, q, width, firstIdx, count] -->
  my @order = ();
  foreach my $c ( @$cells ) {
    push(@order, $c);
    my $i = $#order;
    if ( @cl && $cl[-1]->[0] + $cl[-1]->[3] > $c->[2] ) {
      my $k = $cl[-1];
      $k->[2] += 1 * ( $c->[2] - $k->[3] );     #<!-- q += w_i*(tx - cluster width so far) -->
      $k->[1] += 1;
      $k->[3] += $c->[1];
      $k->[5]++;
    }
    else {
      push(@cl, [ $c->[2], 1, 1 * $c->[2], $c->[1], $i, 1 ]);
    }
    #<!-- collapse from the top down -->
    while ( 1 ) {
      my $k = $cl[-1];
      $k->[0] = $k->[2] / $k->[1];
      $k->[0] = $xlo if ( $k->[0] < $xlo );
      $k->[0] = $xhi - $k->[3] if ( $k->[0] > $xhi - $k->[3] );
      last if ( @cl < 2 );
      my $p = $cl[-2];
      last if ( $p->[0] + $p->[3] <= $k->[0] );
      #<!-- merge k into p -->
      $p->[2] += $k->[2] - $k->[1] * $p->[3];
      $p->[1] += $k->[1];
      $p->[3] += $k->[3];
      $p->[5] += $k->[5];
      pop(@cl);
    }
  }
  #<!-- walk the clusters out into positions -->
  my @out = ();
  my $idx = 0;
  foreach my $k ( @cl ) {
    my $x = $k->[0];
    for ( my $n = 0 ; $n < $k->[5] ; $n++ ) {
      my $c = $order[$idx++];
      push(@out, [$c->[0], $x, $c->[1]]);
      $x += $c->[1];
    }
  }
  return (@out);
};

#<!-- Cost of putting this cell in this segment: the displacement it would
#     suffer, plus what it would cost the cells already there.  Trying every row
#     for every cell is the textbook Abacus and is too slow here, so the search
#     is a window of -rows either side of the cell's own row. -->
my %inSeg = ();        #<!-- "y,segIdx" => [ [inst,w,tx], ... ] -->
my %segFree = ();      #<!-- "y,segIdx" => remaining width -->
foreach my $y ( @rowY ) {
  for ( my $s = 0 ; $s < @{$seg{$y}} ; $s++ ) {
    $segFree{"$y,$s"} = $seg{$y}[$s][1] - $seg{$y}[$s][0];
    $inSeg{"$y,$s"} = [];
  }
}

#<!-- tallest first: a double height cell has fewer rows that will take it, so
#     let it choose before the single height ones fill them -->
my @byY = sort { $b->[2] <=> $a->[2] || $a->[3] <=> $b->[3] } @mov;
my ($noRoom, $tooTall) = (0, 0);
my ($movedRow, $movedRowSum, $movedRowMax) = (0, 0, 0);
foreach my $m ( @byY ) {
  my ($inst, $w, $h, $tx, $ty) = @$m;
  #<!-- Nearest row index to the cell's y, by binary search.
  #
  #     This used to scan every row for every cell, which is O(cells x rows)
  #     -- and rows grow as the square root of cells on a squarish die, so the
  #     whole legalizer came out O(n^1.5).  Measured on the two MXUs: 1069 rows
  #     x 855k cells against 2138 x 3.42M is 8.01 times the work for four times
  #     the cells, and legalize_flat took 7.53 times as long.  That was the
  #     entire superlinearity; everything else here is linear.
  #
  #     @rowY is sorted, so the answer is a bisection.  Arithmetic would do it
  #     in O(1) for uniformly pitched rows, which is what set_floorplan and
  #     every LEF site in practice produce -- but a DEF may carry several ROW
  #     records with gaps between them, and a bisection does not care. -->
  my $best;
  {
    my ($lo, $hi) = (0, $nRows - 1);
    while ( $lo < $hi ) {
      my $mid = int( ($lo + $hi) / 2 );
      if ( $rowY[$mid] < $ty ) { $lo = $mid + 1; }
      else                     { $hi = $mid; }
    }
    #<!-- $lo is the first row at or above $ty; the one below may be nearer -->
    $best = $lo;
    if ( $lo > 0 && abs($rowY[$lo-1] - $ty) <= abs($rowY[$lo] - $ty) ) {
      $best = $lo - 1;
    }
  }
  my $rowsNeeded = int( ($h + $rowH - 1) / $rowH );
  if ( $rowsNeeded > 1 ) { $tooTall++; }

  #<!-- Two attempts: the first honours the local density cap, the second does
  #     not.  A cell whose bin is full in every row of the window has to go
  #     somewhere, and leaving it where it started -- overlapping -- is worse
  #     than putting it in a locally crowded row and letting Abacus slide it.
  #     So the cap is a preference with a guaranteed fallback, never a reason
  #     to fail.  $useCap == 0 is exactly the old behaviour, which is what
  #     --no_dbin selects for the whole run. -->
  my ($pickKey, $pickCost, $pickBin, $pickR);
  foreach my $useCap ( ($dbin > 0) ? (1, 0) : (0) ) {
  ($pickKey, $pickCost, $pickBin, $pickR) = (undef, undef, undef, undef);
  #<!-- the capped attempt looks only $dbinRows rows out; the fallback below
  #     uses the full -rows window, so the bound can never leave a cell
  #     unplaced -- it only limits how far the CAP is allowed to reach. -->
  my $win = ( $useCap ) ? ( ($dbinRows < $rowWin) ? $dbinRows : $rowWin ) : $rowWin;
  for ( my $d = 0 ; $d <= $win ; $d++ ) {
    foreach my $r ( ($best - $d), ($best + $d) ) {
      next if ( $d > 0 && $r == $best );
      next if ( $r < 0 || $r >= $nRows );
      my $y = $rowY[$r];
      for ( my $s = 0 ; $s < @{$seg{$y}} ; $s++ ) {
        my $k = "$y,$s";
        next if ( $segFree{$k} < $w );
        my ($sx0, $sx1) = @{$seg{$y}[$s]};
        next if ( $sx1 - $sx0 < $w );
        #<!-- where in this segment it wants to be, and what that costs -->
        my $wx = $tx;
        $wx = $sx0 if ( $wx < $sx0 );
        $wx = $sx1 - $w if ( $wx > $sx1 - $w );
        #<!-- and whether the row is already full AT THAT X.  Charged to the
        #     bin holding the cell's left edge: a cell is narrow next to a
        #     column and splitting it across two bins buys nothing. -->
        my $bi;
        if ( $dbin > 0 ) {
          $bi = int( ($wx - $binX0) / $dbin );
          $bi = 0 if ( $bi < 0 );
          $bi = $nBins - 1 if ( $bi > $nBins - 1 );
          if ( $useCap ) {
            my $cap = $binCap{"$r,$bi"};
            next unless ( defined $cap );
            next if ( $binLoad{"$r,$bi"} + $w > $cap );
          }
        }
        my $cost = abs($wx - $tx) + abs($y - $ty);
        if ( ! defined $pickCost || $cost < $pickCost ) {
          $pickCost = $cost;
          $pickKey = $k;
          $pickBin = ( defined $bi ) ? "$r,$bi" : undef;
          $pickR = $r;
        }
      }
    }
    #<!-- Stop widening once no row further out could possibly win.
    #
    #     The cost is |wx - tx| + |y - ty|, so a row d steps away costs at
    #     least d * rowH in the y term alone.  Once the best cost found is no
    #     more than that, nothing further out can beat it and the search is
    #     provably done -- which is the same early exit, made correct.
    #
    #     It used to be "last if ( defined $pickKey && $d >= 1 )": stop as soon
    #     as ANYTHING was found at d >= 1.  That capped the search at three
    #     rows whatever -rows said, so the option was very nearly a no-op --
    #     the default of 6 promised thirteen rows and searched three. -->
    #<!-- The cost is |wx - tx| + |y - ty|, so a row d steps away costs at
    #     least d * rowH in the y term alone; once the best found is no more
    #     than that, nothing further out can beat it.  Still a valid bound with
    #     the cap on, because the cap only removes candidates -- it does not
    #     change what any surviving candidate costs. -->
    last if ( defined $pickCost && $pickCost <= ($d + 1) * $rowH );
  }
  last if ( defined $pickKey );
  }#foreach useCap

  unless ( defined $pickKey ) {
    $noRoom++;
    next;
  }
  push(@{$inSeg{$pickKey}}, [$inst, $w, $tx]);
  $segFree{$pickKey} -= $w;
  $binLoad{$pickBin} += $w if ( defined $pickBin );
  #<!-- how many cells the cap pushed off their nearest row, and how far -->
  if ( defined $pickR && $pickR != $best ) {
    $movedRow++;
    my $off = abs($pickR - $best);
    $movedRowMax = $off if ( $off > $movedRowMax );
    $movedRowSum += $off;
  }
}

if ( $noRoom > 0 ) {
  print "WARN-ALG-LEGAL : 013 : $noRoom cell(s) found no row with room within $rowWin row(s)\n";
  print "WARN-ALG-LEGAL : 014 : they keep their current location.  Raise -rows, try --spread,\n";
  print "WARN-ALG-LEGAL : 035 : or the design does not fit\n";
}
if ( $tooTall > 0 ) {
  print "INFO-ALG-LEGAL : 015 : $tooTall cell(s) are taller than one row; they are placed on\n";
  print "INFO-ALG-LEGAL : 016 : their own row and the rows above are not reserved\n";
}

#--------------------------- solve and write back --------------------------#
my ($placed, $sumDisp, $maxDisp, $maxDispInst) = (0, 0, 0, "");
my $overLimit = 0;
my $limit = ( defined $maxDispUm ) ? $maxDispUm * $dbu : undef;
my @newLoc = ();

foreach my $y ( @rowY ) {
  for ( my $s = 0 ; $s < @{$seg{$y}} ; $s++ ) {
    my $k = "$y,$s";
    my $cells = $inSeg{$k};
    next unless ( @$cells );
    my ($sx0, $sx1) = @{$seg{$y}[$s]};
    my @sorted = sort { $a->[2] <=> $b->[2] } @$cells;
    my @out = $abacus->(\@sorted, $sx0, $sx1);

    #<!-- Put x on the site grid without giving the overlap back.  Snapping each
    #     cell independently can push it left into its neighbour, so the walk is
    #     left to right with a cursor: a cell goes to its own snapped position or
    #     to the first free site after the one before it, whichever is further
    #     right. -->
    my $cursor = $sx0;
    foreach my $o ( @out ) {
      my ($inst, $x, $w) = @$o;
      unless ( $noSnapX ) {
        my $n = int( ($x - $sx0) / $siteX + 0.5 );
        $x = $sx0 + $n * $siteX;
      }
      if ( $x < $cursor ) {
        my $n = int( ($cursor - $sx0) / $siteX );
        $n++ while ( $sx0 + $n * $siteX < $cursor );
        $x = $noSnapX ? $cursor : $sx0 + $n * $siteX;
      }
      if ( $x + $w > $sx1 ) { $x = $sx1 - $w; }
      $cursor = $x + $w;

      my $dx = abs($x - $origX{$inst});
      my $dy = abs($y - $origY{$inst});
      my $disp = $dx + $dy;
      $sumDisp += $disp;
      if ( $disp > $maxDisp ) { $maxDisp = $disp; $maxDispInst = $inst; }
      $overLimit++ if ( defined $limit && $disp > $limit );
      print "DBG-ALG-LEGAL : 017 : $inst -> $x $y (moved $disp dbu)\n" if ($debug);
      push(@newLoc, [$inst, $x, $y]);
      $placed++;
    }
  }
}

my $avg = ( $placed > 0 ) ? $sumDisp / $placed : 0;
printf("INFO-ALG-LEGAL : 018 : legalized %d cell(s), average move %.3f um, worst %.3f um%s\n",
       $placed, $avg / $dbu, $maxDisp / $dbu,
       ( $maxDispInst ne "" ) ? " on $maxDispInst" : "");
if ( defined $limit && $overLimit > 0 ) {
  printf("WARN-ALG-LEGAL : 019 : %d cell(s) moved further than %g um\n", $overLimit, $maxDispUm);
}
if ( $movedRow > 0 ) {
  printf("INFO-ALG-LEGAL : 041 : %d cell(s) took a row other than their nearest, %.2f rows on average, %d at most\n",
         $movedRow, $movedRowSum / $movedRow, $movedRowMax);
}

if ( $reportOnly ) {
  print "INFO-ALG-LEGAL : 020 : --report_only given, nothing was changed\n";
  my $t1 = new Benchmark;
  print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
  return;
}

my $reOriented = 0;
foreach my $n ( @newLoc ) {
  my ($inst, $x, $y) = @$n;
  $CADB{$inst}->dbCadbSetLoc($x, $y);
  $CADB{$inst}->dbCadbSetStatus(PLACED);
  #<!-- and the orientation the row it landed in requires -->
  if ( exists $rowOrient{$y} ) {
    my $was = $CADB{$inst}->dbCadbGetOrient;
    my $now = &dbfLegalOrientForRow($was, $rowOrient{$y});
    if ( ! defined $was || $was ne $now ) {
      $CADB{$inst}->dbCadbSetOrient($now);
      $reOriented++;
    }
  }
  #<!-- the placer keeps a parallel location for flops and reads it back, so it
  #     has to agree with CADB or a later placer step undoes this -->
  if ( exists $PLACE{$TOP_MODULE} && $PLACE{$TOP_MODULE}->dbPlaceGetIsInstFlop($inst) ) {
    $PLACE{$TOP_MODULE}->dbPlaceSetFlopLoc($inst, $x, $y);
  }
}
if ( $reOriented > 0 ) {
  print "INFO-ALG-LEGAL : 037 : $reOriented cell(s) re-oriented to match their row\n";
}
print "INFO-ALG-LEGAL : 021 : updating instance boxes\n";
&set_inst_box;

my $t1 = new Benchmark;
print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";

}# sub legalize_flat

1;
