#****f* /legalize_flat
#  legalize_flat
# FUNCTION
#  Legalize the flat placement: remove cell overlaps and put every movable
#  standard cell on a row and a site, moving each as little as possible.
#
#  What it is not is the old "legalize", which is place_output_fine_tune: that
#  snaps each instance to the nearest row and site INDEPENDENTLY of every other
#  instance.  It never looks at overlap, so it cannot remove one, and snapping
#  two neighbours to the same row is a way to create one.  This replaces the
#  snapping with a placement.
#
#  Two passes, in the order the density has to be fixed before the rows can be:
#
#  Pass 1, spreading -- OFF BY DEFAULT, and the reason is worth reading.
#  The core is cut into bins, each bin's movable cell area is compared with the
#  free area it has, and a bin holding more than it can fit hands cells to
#  whichever neighbour has room.  It is meant to stop pass 2 having to shove a
#  cell half way across the die because its region was never going to hold it.
#
#  On nangate_flat it does far more harm than good.  Three runs each way,
#  everything else identical:
#
#                       unrouted of 4489     avg move     worst move
#      --spread              523 544 537     12.9-13.2um    83-88um
#      default (off)          78  98  77     13.0-13.1um    50-52um
#
#  Seven times the routing failures for no gain anywhere else, and it only
#  moves about 300 of the 4233 cells to do it.  The reason is the kind of move
#  it makes: it retargets a cell to the CENTRE of a neighbouring bin, a full
#  bin away, chosen purely on area with no idea what the cell is connected to.
#  Pass 2 resolves ordinary local density perfectly well by sliding cells along
#  rows, and does it without tearing anything out of its neighbourhood.
#
#  Turn it on with --spread when pass 2 reports cells that found no row at all
#  (WARN 013) -- that is the case it was written for and the case where it
#  earns its cost.  On the hierarchical tests, which have no obstacles and no
#  real hotspots, it is worth about 3% of average displacement and nothing
#  else.
#
#  There is no connectivity term anywhere in here: with no net to pull on, a
#  cell has no reason to be anywhere except where it already is, so the only
#  objective is displacement.  That is exactly why pass 1 misbehaves -- total
#  displacement is blind to how many pins a cell has.
#
#  THE LOCAL DENSITY CAP, which is the thing to read before using this.
#
#  Pass 2 gives a cell the nearest row whose SEGMENT has room, and on a die
#  with no macros a segment is the whole row.  So the capacity question was
#  "is this 1496um row more than 100% full", the answer at 50% utilisation is
#  almost always no, and the nearest row won every time however crowded it was
#  AT THAT X.  Abacus then fixed a 300% full patch the only way it can, by
#  sliding cells along the row.
#
#  Every test in the tree that legalizes, average and worst move in um, each
#  pair from ONE placement legalized both ways:
#
#      test              cells    --no_dbin        cap on        avg    worst
#      ---------------  -------  -------------  -------------  -----  -------
#      nangate_flat       4,233   12.9 /  49.4   12.4 /  44.7  1.04x   1.11x
#      nangate_recurse    4,233   11.0 /  72.0    4.2 /  25.3  2.63x   2.85x
#      matmul_4x4       204,816   46.9 / 453.7   15.1 / 274.8  3.10x   1.65x
#      mxu_tile64       213,568   28.5 / 477.1   10.9 /  80.3  2.62x   5.94x
#      mxu_256          855,424   43.3 / 879.0   11.1 / 183.5  3.91x   4.79x
#
#  Two and a half to four times less average movement on every design placed
#  hierarchically, and up to six times less on the worst cell.  nangate_flat is
#  the exception and the reason is in its numbers, not in the cap: see below.
#
#  On mxu_256, measured on the written DEFs rather than from the summary above,
#  the horizontal total falls from 36,716mm to 9,005mm while the vertical rises
#  from 310mm to 473mm.  27.7 METRES of horizontal movement removed for 163mm
#  of vertical, a trade of 170 to 1, and it is there to be had because 100% of
#  the over-full width on that design has free space within FOUR ROWS, 5.6um.
#
#  Legality is unaffected, and that is checked independently rather than taken
#  from the tool: an integer-DBU overlap sweep over the written DEF says zero
#  overlaps on every design above, with or without the cap, and zero cells
#  whose orientation disagrees with their row.
#
#  TWO THINGS MAKE IT WORK AND BOTH ARE EASY TO GET WRONG.
#
#  It relieves OVERFLOW, it does not equalise density.  Equalising is a
#  transportation problem whose answer drains the dense middle of a die into
#  empty rows hundreds of rows away: simulated on mxu_256 it wants a mean |dy|
#  of 686um against 2.3um for relieving only the overflow.  That is 300 times
#  the movement for no extra legality, and aiming a cell at the CENTRE of
#  another bin is precisely what pass 1 does, which is the best explanation
#  anyone has for why pass 1 multiplies unrouted nets by seven.
#
#  And it is BOUNDED, by -dbin_rows, default 2.  Let the cap reach the whole
#  -rows window and it becomes equalisation by the back door.  Measured on one
#  fixed placement of nangate_flat, unrouted nets of 4489:
#
#      cap off  108      +/-2 rows  119      21um bins, +/-6 rows  138
#      +/-1     173      +/-3       101      5um bins,   +/-6      480
#
#  NOTE WHAT THAT SECOND TABLE DOES NOT SAY.  It does not show a routing
#  improvement.  Fine bins with no bound are clearly, reproducibly harmful --
#  480 against 108 is far outside the noise -- but everything in the sane
#  region lands in the same band as no cap at all, and the order is not even
#  monotone, so on nangate_flat this is worth nothing to the router and
#  nothing is the honest number.  Two reasons to expect that: qrouter itself
#  is not deterministic here (108, 115 and 116 unrouted on three runs of ONE
#  legalized DEF), and nangate_flat is 60 rows on an 85um die where only 62%
#  of the over-full width can be absorbed vertically at all, against 100% on
#  mxu_256.  It is the only design in the tree with a router in its flow, and
#  it is the wrong shape for this -- which is also why it is the one row of
#  the table above that shows nothing.  Its 1.04x is not a small win, it is
#  noise: place_flat_design is not deterministic either, so that row is the
#  only one whose two halves do not come from the same placement.
#
#  So: the displacement win is large, measured, and reproducible; the routing
#  effect is unmeasured on any design where the mechanism applies.  Which is
#  why this is ON by default and pass 1 is not -- it does not move a cell that
#  is not in an over-full bin, it never changes a cell's x, and it never sends
#  one more than two rows -- but if unrouted nets go up on a real design,
#  --no_dbin is the first thing to try and the numbers above are the control.
#
#  PASS 1B, PIN DENSITY RELIEF BY PADDING -- also OFF by default, also new.
#
#  Everything above is about CELL AREA: a bin holds more cell area than it has
#  room for.  What a router runs out of first is not area, it is PINS -- a 5um
#  square holding forty pins needs forty escapes out of it whatever the cells
#  in it are worth in area, and a tile packed with small many-pinned cells is
#  denser in pins than a tile holding one wide buffer of the same area.
#
#  So this counts SIGNAL PINS per tile, not area, and relieves the tiles over a
#  target by PADDING: a cell in an over-full tile is handed to pass 2 with a
#  wider footprint than it really has.  Abacus then opens the gap itself, and
#  that is the whole trick -- padding changes nothing but the width the row
#  assignment and the Abacus clustering see, so the cell still lands at the
#  minimum total squared displacement for its row, and the slack shows up as
#  real whitespace in exactly the tiles that asked for it.
#
#  WHY PADDING AND NOT A MOVE.  The two mechanisms above both relieve density
#  by retargeting a cell somewhere else -- pass 1 to the centre of another bin,
#  which costs seven times the unrouted nets, and the local cap to a nearby
#  row, which is bounded and does not.  Padding retargets nothing.  The cell
#  keeps its x target and its y target; only its width changes, and Abacus
#  spends that width the cheapest way it can.  A cell that is alone in its tile
#  does not move at all even if the tile is over target, because there is
#  nothing for its padding to push against.
#
#  THE TARGET is a percentile of the occupied tiles, not a constant, because
#  there is no absolute number of pins per 5um that is right for every library
#  and every utilisation.  -pin_pctl 95, the default, means "relieve the
#  densest twentieth of the tiles and leave the rest alone" -- which is the
#  same rule the local cap follows and for the same reason: relieve the
#  overflow, do not equalise.  -pin_target names an absolute count instead.
#
#  THE PADDING IS BOUNDED, by -pin_max, the most a cell may be inflated,
#  default 2.0 -- a cell never takes more than twice its own width.  A tile at
#  four times the target would otherwise ask for a four times wider cell, which
#  is density equalisation wearing a different hat.  It did not bind anywhere
#  on nangate_flat: -pin_max 3.0 gives a byte identical placement, because the
#  amount asked for is under one site long before it reaches the cap, and a
#  site is the quantum.
#
#  The amount is w * (pins_in_tile / target - 1), which is the inflation that
#  would take the tile to the target if the tile's cells were all padded and
#  pins rode on cells uniformly.  Neither is exactly true, so this converges
#  towards the target rather than onto it.
#
#  WHAT IT MEASURES, on nangate_flat.  One placement, legalized every way, pin
#  density counted independently from the written DEF over 5um tiles using the
#  real LEF pin shapes -- not from the numbers this command prints:
#
#      -pin_pctl    worst tile     p99     tiles>80    HPWL      avg move
#      ----------  ------------  -------  ----------  --------  ----------
#      off (base)       111        106        56       30013um    12.46um
#      99               111        106        56       30013um    12.46um
#      98               103         96        53       30291um    13.32um
#      95                94         92        48       30952um    13.99um
#      90                94         93        39       31702um    15.13um
#      85                94         89        30       32366um    15.93um
#      80                94         88        20       32920um    16.78um
#
#  So the worst tile comes down 15% for 3.1% of wirelength at the default, and
#  the tail keeps thinning as the percentile drops while the worst tile stops
#  improving -- 94 is where one site of padding runs out.  99 is a no-op by
#  construction: the target lands on the maximum, so no tile is over it.
#
#  It holds at scale.  matmul_4x4, 204,816 instances, one placement legalized
#  both ways, same independent check, defaults:
#
#                       worst   p99   >70   >80      HPWL       avg move
#      off (base)        114     77   573    58    6,464,149um   15.15um
#      --pin_spread      107     72   223    19    6,778,049um   17.22um
#
#  The tail is where it pays: two thirds of the tiles over 80 pins are gone,
#  and 61% of those over 70, for 4.9% of wirelength.  Zero overlaps both ways.
#
#  NOTE WHAT GOES UP.  Tiles over 40 pins rise, 7,878 to 8,054, and occupied
#  tiles rise with them.  That is not a regression, it is the mechanism: the
#  pins pushed out of the worst tiles land in their neighbours, and the point
#  is to flatten the peak, not the distribution.  A pass that lowered the
#  middle of the histogram too would be equalising density, which is the trap
#  described above pass 1.
#
#  It costs one extra run of pass 2 and nothing else: 19.9s to 23.3s on
#  matmul_4x4 end to end, +17%, most of which is the DEF either side.
#
#  AND THE ROUTING NUMBER SAYS NOTHING, which has to be stated because this is
#  the one design in the tree with a router in its flow and the temptation to
#  read it is strong.  Unrouted nets of 4489, same placement throughout:
#
#      base 121    -dbin_rows 1  111    -dbin_rows 3  104
#                  -dbin_rows 4  261    --no_dbin     168
#
#  Those four knobs do not change the pin density map AT ALL -- worst tile 111,
#  p99 106, p90 90, identical for every one of them -- and they move unrouted
#  nets from 104 to 261.  Every --pin_spread result above falls inside that
#  band.  qrouter on this design is chaotic with respect to small placement
#  changes, so it can neither confirm nor refute this pass, and averaging would
#  need an ensemble of placements rather than more runs of one.
#
#  It is not qrouter being random, though, and that matters for anyone
#  measuring here: write_def walks "keys %CADB" and Perl randomises hash order
#  per process, so the DEF's record order changes every run and qrouter routes
#  in file order.  Five runs of ONE byte-identical legalized DEF gave 222, 200,
#  239, 197 and 130.  With PERL_HASH_SEED=0 and PERL_PERTURB_KEYS=0 the same
#  DEF gives 121 four times out of four.  Pin that seed before comparing
#  anything through the router.
#
#  LEGALITY IS NEVER TRADED FOR DENSITY.  Padding is width the rows have to
#  find, and at an aggressive percentile they cannot: at -pin_pctl 70, 39 cells
#  found no row, kept the overlapping location the placer gave them, and an
#  integer sweep over the DEF reported 449 overlaps.  So the padded run is
#  compared against the unpadded one and thrown away if it placed fewer cells;
#  see the check after the second pass.  Every row in the table above is zero
#  overlaps, checked that way.
#
#  Pass 2, rows.  Every movable cell is assigned to a row near its own y and
#  legalized along x by Abacus: cells are taken in x order, and a cell that
#  would overlap its left neighbour is merged into a cluster whose position is
#  the weighted mean of its members' targets, collapsing into the cluster before
#  it when those overlap in turn.  That is the minimum total squared
#  displacement for a given row assignment, which is the closest thing to "moved
#  as little as possible" that is cheap to compute.  Rows are tried nearest
#  first within a window, and the assignment with the lowest cost wins.
#
#  CELLS TALLER THAN ONE ROW are placed before pass 2 and then treated as
#  obstacles, so the rows they occupy are cut around them exactly as they are
#  cut around a macro.  Abacus cannot slide a cell through a macro and it
#  cannot slide one through a tall cell either, which is the whole point: the
#  overlap becomes impossible rather than unlikely.
#
#  This used to be a known hole -- the command counted them and said out loud
#  that the rows above were not reserved.  Nangate is 135 macros all 1.4um
#  tall, so nothing in TESTS caught it.  Checked now on a synthetic design of
#  300 single height and 30 double height cells: zero overlaps by an
#  independent integer sweep over the written DEF.
#
#  Reserving the rows' free WIDTH instead, which is what 3RDBIN/legalize_flat
#  does, does not work -- it reserves width, not place, and the rows above pack
#  from the left as if the tall cell were not there.  The same synthetic design
#  through -placer: 20 overlaps, while it prints "the rows above them were
#  reserved".
#
#  FIXED instances never move.  Nor does anything that is not a CORE cell: a
#  macro is not a row object and legalizing one by sliding it along a row would
#  be worse than leaving it, so blocks and pads are obstacles here, and the rows
#  they sit on are cut into free intervals around them.
#
# SYNOPSIS
#  legalize_flat
#
# INPUTS
#
#       options :
#               -grid <um> : bin size for pass 1, default 10
#               -rows <n> : rows either side to try in pass 2, default 6
#               -max_disp <um> : report cells moved further than this
#               -iters <n> : pass 1 iteration cap, default 20
#
#               -pin_grid <um> : tile for the pin density map, default 5
#               -pin_pctl <n> : percentile of occupied tiles to relieve
#                               above, default 95
#               -pin_target <n> : an absolute pins-per-tile target instead
#               -pin_max <r> : most a cell may be inflated, default 2.0
#
#       switches :
#               --spread : run pass 1; it is off by default, see above
#               --no_spread : the default, kept so old scripts still run
#               --pin_spread : run pass 1b, the pin density padding; off by
#                              default, see above
#               --no_snap_x : leave x off the site grid
#               --report_only : say what it would do and change nothing
#               --incremental : keep the legal cells, repair only the rest
#
# OUTPUTS
#               instance locations in CADB, and the instance boxes
#
#****

#=========================== orientation for a row ===========================#
#<!-- What orientation a cell must take to sit in a row of a given orientation.
#
#     Standard cell rows alternate -- N, FS, N, FS -- so that a row and the one
#     above it share a power rail.  A cell in an FS row has to be flipped in y
#     to match, or its VDD meets the neighbour's VSS.
#
#     This was simply never done.  legalize_flat read dbCadbGetOrient only to
#     transpose w and h for a 90 degree rotation, and never wrote an orientation
#     back, so every cell came out of the placer N and stayed N.  Measured on
#     mxu_256: 423,506 of 855,424 cells, 49.5%, sat in an FS row as N.
#
#     It matters more the moment a legalizer starts moving cells between rows on
#     purpose, which is what the local density cap below does -- but it was
#     already wrong for every cell the row window moved, and |dy| already
#     reached two row pitches.
#
#     The rule is: keep whatever mirroring in x the cell already had, take the
#     row's flip in y.  The four row-legal orientations are exactly the two
#     bits (mirror x, flip y):
#
#         N = (0,0)   FN = (1,0)   FS = (0,1)   S = (1,1)
#
#     A 90 degree rotated cell -- E, W, FE, FW -- is not a row object at all;
#     composing a rotation with a row flip is ambiguous and a rotated standard
#     cell does not occur in this flow, so those are returned untouched rather
#     than guessed at. -->
sub dbfLegalOrientForRow {
my ($cell, $row) = @_;
$cell = "N" unless ( defined $cell && $cell ne "" );
$row  = "N" unless ( defined $row  && $row  ne "" );
return $cell if ( $cell =~ m/^F?[EW]$/ );
my %xmir = ( "N" => 0, "FN" => 1, "FS" => 0, "S" => 1 );
my %yflp = ( "N" => 0, "FN" => 0, "FS" => 1, "S" => 1 );
#<!-- an orientation this does not know about is left alone -->
return $cell unless ( exists $xmir{$cell} );
my $ry = ( exists $yflp{$row} ) ? $yflp{$row} : 0;
my @tab = ( [ "N", "FS" ], [ "FN", "S" ] );      #<!-- [mirror x][flip y] -->
return $tab[ $xmir{$cell} ][ $ry ];
}#sub dbfLegalOrientForRow

sub legalize_flat {

use Benchmark;
use POSIX qw(ceil floor);
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $gridUm = 10;
my $rowWin = 6;
my $maxDispUm;
my $iterCap = 20;
my ($noSnapX, $reportOnly, $debug) = (0, 0, 0);
my $incremental = 0;
#<!-- Pass 1 is OFF by default.  See the measurement above the pass itself. -->
my $doSpread = 0;
my ($extPlacer, $extArgs, $keepExt);
my $spreadOrder = "large";
#<!-- Local density cap on the row assignment.  0 means "work it out from the
#     row span"; -1 turns it off and restores the behaviour this replaces. -->
my $dbinUm = 0;
#<!-- How many rows the cap may push a cell off its nearest.  The relief it is
#     there for is one or two rows away; letting it reach the whole -rows window
#     turns it back into density equalisation, which is exactly what it must not
#     be -- measured, unbounded it takes nangate_flat from 116 unrouted nets to
#     480, bounded at two it improves them. -->
my $dbinRows = 2;
#<!-- Pass 1b, pin density relief by padding.  OFF by default for the same
#     reason pass 1 is: it is new, and nothing about it is measured yet. -->
my $doPinPad = 0;
my $pinGridUm = 5;
#<!-- 95, not 90: see the table at the head of the file.  90 buys a better
#     spread of the distribution and costs nearly twice the wirelength. -->
my $pinPctl = 95;
my $pinMaxRatio = 2.0;
my $pinTarget = 0;      #<!-- 0 means "derive it from -pin_pctl" -->

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : legalize_flat -grid <bin size in um, default 10>\n";
  print "                      -rows <rows either side to try, default 6>\n";
  print "                      -max_disp <um, report cells moved further>\n";
  print "                      -iters <spreading iteration cap, default 20>\n";
  print "                      --spread       run the density pass (default OFF,\n";
  print "                                     see below)\n";
  print "                      --no_spread    the default; kept so old scripts run\n";
  print "                      --no_snap_x    leave x off the site grid\n";
  print "                      --report_only  change nothing\n";
  print "                      --incremental  keep every cell that is already legal where it\n";
  print "                                     is and move only the rest into the nearest gap\n";
  print "                                     (after hier_place_all --legalize, say)\n";
  print "                      -dbin <um>     column width for the local density\n";
  print "                                     cap on the row assignment.  0, the\n";
  print "                                     default, is 100 mean cell widths\n";
  print "                      -dbin_rows <n> how many rows the local cap may push\n";
  print "                                     a cell off its nearest, default 2.\n";
  print "                                     Unbounded it becomes equalisation\n";
  print "                      --no_dbin      no local cap: every cell takes its\n";
  print "                                     nearest row however full that row\n";
  print "                                     already is locally.  The behaviour\n";
  print "                                     before the cap existed, kept for A/B\n";
  print "                      --pin_spread   relieve PIN density by padding the\n";
  print "                                     cells in the densest tiles, so that\n";
  print "                                     Abacus opens real gaps there.  Off by\n";
  print "                                     default.  Worst 5um tile -15% for 3.1%\n";
  print "                                     of wirelength on nangate_flat; see the\n";
  print "                                     table at the head of the file, and note\n";
  print "                                     what it says about the router\n";
  print "                      -pin_grid <um> tile for the pin density map, default 5\n";
  print "                      -pin_pctl <n>  relieve tiles above this percentile of\n";
  print "                                     the occupied ones, default 95.  Lower\n";
  print "                                     thins the tail further and costs more\n";
  print "                                     wirelength; 99 is a no-op\n";
  print "                      -pin_target <n> an absolute pins-per-tile target,\n";
  print "                                     instead of the percentile\n";
  print "                      -pin_max <r>   most a cell may be inflated, default 2.0\n";
  print "                      -spread_order <small|large>\n";
  print "                            which cell an over-full bin gives away.\n";
  print "                            large moves fewer cells and lowers total\n";
  print "                            displacement; small leaves the big drivers\n";
  print "                            alone and routes better, and is the default.\n";
  print "                      -debug\n";
  print "\n";
  print "        -placer <path>   hand the rows, cells and obstacles to an\n";
  print "                         external legalizer instead of legalizing here.\n";
  print "                         ELECTRON_HOME/3RDBIN/legalize_flat is the one\n";
  print "                         that ships: NumPy, and it reserves the rows\n";
  print "                         above a cell taller than one row, which the\n";
  print "                         internal path does not.\n";
  print "        -args <extra>    passed straight to it\n";
  print "        --keep_files     keep <top>.legal.in and <top>.legal.out\n";
  print "\n";
  print "        The code in here is the reference: short, readable, and the\n";
  print "        thing to check an external legalizer against on a small design\n";
  print "        whose cells are all one row tall.\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-grid")        { $gridUm = $_[$i+1]; }
  elsif ($_[$i] eq "-rows")        { $rowWin = $_[$i+1]; }
  elsif ($_[$i] eq "-max_disp")    { $maxDispUm = $_[$i+1]; }
  elsif ($_[$i] eq "-iters")       { $iterCap = $_[$i+1]; }
  elsif ($_[$i] eq "--no_spread")  { $doSpread = 0; }
  elsif ($_[$i] eq "--spread")     { $doSpread = 1; }
  elsif ($_[$i] eq "--no_snap_x")  { $noSnapX = 1; }
  elsif ($_[$i] eq "--report_only"){ $reportOnly = 1; }
  elsif ($_[$i] eq "--incremental"){ $incremental = 1; }
  elsif ($_[$i] eq "-spread_order"){ $spreadOrder = $_[$i+1]; }
  elsif ($_[$i] eq "-dbin")        { $dbinUm = $_[$i+1]; }
  elsif ($_[$i] eq "--no_dbin")    { $dbinUm = -1; }
  elsif ($_[$i] eq "-dbin_rows")   { $dbinRows = $_[$i+1]; }
  elsif ($_[$i] eq "--pin_spread")   { $doPinPad = 1; }
  elsif ($_[$i] eq "--no_pin_spread"){ $doPinPad = 0; }
  elsif ($_[$i] eq "-pin_grid")    { $pinGridUm = $_[$i+1]; }
  elsif ($_[$i] eq "-pin_pctl")    { $pinPctl = $_[$i+1]; }
  elsif ($_[$i] eq "-pin_target")  { $pinTarget = $_[$i+1]; }
  elsif ($_[$i] eq "-pin_max")     { $pinMaxRatio = $_[$i+1]; }
  elsif ($_[$i] eq "-placer")      { $extPlacer = $_[$i+1]; }
  elsif ($_[$i] eq "-args")        { $extArgs = $_[$i+1]; }
  elsif ($_[$i] eq "--keep_files") { $keepExt = 1; }
  elsif ($_[$i] eq "-debug")       { $debug = 1; }
  elsif ($_[$i] =~ m/^-+\w/)       { print "WARN-ALG-LEGAL : 001 : invalid option $_[$i]\n"; }
}

my $dbu = $GLOBAL->dbfGlobalGetDBU;
unless ( defined $dbu && $dbu > 0 ) {
  print "ERR-ALG-LEGAL : 002 : database units are not set\n";
  return;
}

#<!-- A caller can hand this the problem instead of having it read the flat
#     database: legalize_module does, with one module's own cells, its child
#     blocks as obstacles and rows laid over its box.  $LEGAL_SOURCE is a hash
#     of die, rowH (microns), rows (tags as dbFlplanGetRows gives them), mov
#     and obs (as built below); $LEGAL_SINK takes the answer instead of %CADB.
#     Both are consumed here, so a plain legalize_flat is exactly what it was. -->
my $src = $LEGAL_SOURCE;
my $sink = $LEGAL_SINK;
$LEGAL_SOURCE = undef;
$LEGAL_SINK = undef;
my $flplanID = $FLOORPLAN_LOOKUP{"$TOP_MODULE/_self_"};
unless ( $src || ( defined $flplanID && exists $FLOORPLAN_ALREADY{$flplanID} ) ) {
  print "ERR-ALG-LEGAL : 003 : module $TOP_MODULE has no floorplan\n";
  return;
}
my @die = $src ? @{$src->{die}} : $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetSize;
unless ( @die >= 4 && $die[2] > $die[0] && $die[3] > $die[1] ) {
  print "ERR-ALG-LEGAL : 004 : module $TOP_MODULE has no die area\n";
  return;
}

#---------------------------- the rows -----------------------------------#
#<!-- Stored as "name site x0 y0 orient numX numY stepX stepY", the same by
#     read_def and by dbgGenerateRows, all of it in dbu.  Field 3 is the row's
#     y and field 7 its site pitch, which is what dbPlaceGetNearestRow and
#     dbPlaceGetNearestXStep already rely on. -->
my $rowH = $src ? $src->{rowH} : $GLOBAL->dbGlobalGetRowHeight;
unless ( defined $rowH && $rowH > 0 ) {
  print "ERR-ALG-LEGAL : 005 : row height is not set, read a LEF with a site\n";
  return;
}
$rowH = $rowH * $dbu;

my @rowY = ();
my %rowX0 = ();
my %rowX1 = ();
my %rowOrient = ();
my $siteX = 0;
foreach my $tag ( $src ? @{$src->{rows}} : $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetRows ) {
  my @f = split(/\s+/, $tag);
  next unless ( @f >= 8 );
  my ($x0, $y, $numX, $stepX) = ($f[2], $f[3], $f[5], $f[7]);
  next unless ( defined $y && defined $x0 && defined $numX && defined $stepX );
  my $x1 = $x0 + $numX * $stepX;
  #<!-- one entry per y, widened if the same y is given in several records -->
  if ( exists $rowX0{$y} ) {
    $rowX0{$y} = $x0 if ( $x0 < $rowX0{$y} );
    $rowX1{$y} = $x1 if ( $x1 > $rowX1{$y} );
  }
  else {
    push(@rowY, $y);
    $rowX0{$y} = $x0;
    $rowX1{$y} = $x1;
    #<!-- field 4 is the row's orientation, and it is the whole reason a cell
    #     cannot simply be dropped into a different row: rows alternate N and
    #     FS so that neighbours share a power rail, and a cell left N in an FS
    #     row has its rails upside down. -->
    $rowOrient{$y} = ( defined $f[4] && $f[4] ne "" ) ? $f[4] : "N";
  }
  $siteX = $stepX if ( $stepX > $siteX );
}
@rowY = sort { $a <=> $b } @rowY;
my $nRows = @rowY;
unless ( $nRows > 0 ) {
  print "ERR-ALG-LEGAL : 006 : $TOP_MODULE has no ROWs, run floorplan first\n";
  return;
}
if ( $siteX <= 0 ) { $siteX = 1; $noSnapX = 1; }

#------------------------- movable and obstacles --------------------------#
#<!-- Movable is a CORE cell the database calls PLACED.  FIXED never moves, and
#     anything that is not CORE -- a macro, a pad -- is an obstacle: it is not a
#     row object, and sliding one along a row to legalize it would do more harm
#     than leaving it where it is. -->
my @mov = ();          #<!-- [inst, w, h, tx, ty, pins, padded w] in dbu -->
my $totMovW = 0;       #<!-- their total width, for the default bin size -->
my @obs = ();          #<!-- [llx, lly, urx, ury] -->
my ($skipNoCell, $skipNoSize, $unplacedCnt) = (0, 0, 0);
#<!-- Signal pins per master, counted once per master rather than once per
#     instance: a design has millions of instances and a few hundred masters.
#     POWER and GROUND pins do not count -- they are strapped from above and
#     are not what a router escapes out of a tile. -->
my %pinsOf = ();

if ( $src ) {
  foreach my $m ( @{$src->{mov}} ) { push(@mov, [ @$m ]); $totMovW += $m->[1]; }
  foreach my $o ( @{$src->{obs}} ) { push(@obs, [ @$o ]); }
}
foreach my $inst ( $src ? () : sort keys %CADB ) {
  my $cellref = $CADB{$inst}->dbCadbGetCellref;
  unless ( defined $cellref && exists $PLDB{$cellref} ) {
    $skipNoCell++;
    next;
  }
  my @size = $PLDB{$cellref}->dbMdbGetSize;
  unless ( @size >= 2 && $size[0] > 0 && $size[1] > 0 ) {
    $skipNoSize++;
    next;
  }
  my $orient = $CADB{$inst}->dbCadbGetOrient;
  $orient = "N" unless ( defined $orient && $orient ne "" );
  my ($w, $h) = ($size[0] * $dbu, $size[1] * $dbu);
  #<!-- a rotated cell occupies the transposed footprint -->
  if ( $orient eq "E" || $orient eq "FE" || $orient eq "W" || $orient eq "FW" ) {
    ($w, $h) = ($h, $w);
  }

  my $status = $CADB{$inst}->dbCadbGetStatus;
  $status = "" unless ( defined $status );
  my @loc = $CADB{$inst}->dbCadbGetLoc;
  my ($x, $y) = ( (defined $loc[0]) ? $loc[0] : 0, (defined $loc[1]) ? $loc[1] : 0 );

  if ( $status ne "PLACED" && $status ne "FIXED" ) {
    #<!-- nothing to preserve and nothing to legalize: a cell with no location
    #     is the placer's problem, not the legalizer's -->
    $unplacedCnt++;
    next;
  }

  my $class = $PLDB{$cellref}->dbMdbGetClass;
  $class = "" unless ( defined $class );
  my $isCore = ( $class =~ m/^CORE/ ) ? 1 : 0;

  if ( $status eq "FIXED" || ! $isCore ) {
    push(@obs, [$x, $y, $x + $w, $y + $h]);
    next;
  }
  unless ( exists $pinsOf{$cellref} ) {
    my $np = 0;
    foreach my $p ( $PLDB{$cellref}->dbMdbGetPins ) {
      next if ( $PLDB{$cellref}->dbMdbGetPinIsPower($p) );
      next if ( $PLDB{$cellref}->dbMdbGetPinIsGround($p) );
      $np++;
    }
    $pinsOf{$cellref} = $np;
  }
  #<!-- the padded width starts as the real one, so everything downstream is
  #     unchanged until pass 1b widens it -->
  push(@mov, [$inst, $w, $h, $x, $y, $pinsOf{$cellref}, $w]);
  $totMovW += $w;
}

my $nMov = @mov;
my $nObs = @obs;
print "INFO-ALG-LEGAL : 007 : $nMov movable CORE cell(s), $nObs obstacle(s) held\n";
if ( $unplacedCnt > 0 ) {
  print "INFO-ALG-LEGAL : 008 : $unplacedCnt instance(s) have no location and were left for the placer\n";
}
if ( $skipNoCell > 0 ) {
  print "WARN-ALG-LEGAL : 009 : $skipNoCell instance(s) have no cell in the library and were skipped\n";
}
if ( $skipNoSize > 0 ) {
  print "WARN-ALG-LEGAL : 010 : $skipNoSize instance(s) have a cell with no size and were skipped\n";
}
unless ( $nMov > 0 ) {
  print "INFO-ALG-LEGAL : 011 : nothing movable, stopping\n";
  return;
}

#<!-- remember where everything started, to measure the displacement against -->
my %origX = ();
my %origY = ();
foreach my $m ( @mov ) {
  $origX{$m->[0]} = $m->[3];
  $origY{$m->[0]} = $m->[4];
}

#================== hand the whole thing to an external tool ================#
#<!-- -placer forks off here, after the rows, the movable cells and the
#     obstacles have been worked out and before either pass runs, because those
#     three things are what the external tool needs and everything after this
#     point is the algorithm it replaces.
#
#     3RDBIN/legalize_flat is the one that ships: same two passes, NumPy, and
#     it reserves the rows above a multi-row cell, which the code below does
#     not.  Anything that reads the format and writes back "PLACE idx x y" will
#     do.
#
#     The format is deliberately its own rather than the flat placer nodefile:
#     a legalizer needs rows, sites and obstacles, and needs no nets at all, so
#     sharing the placer's format would mean writing a netlist nobody reads.
#     Everything in it is integer DBU.
#
#     The CELL record carries a trailing signal pin count, added for pass 1b.
#     It sits after the name so that a reader written against the old six
#     field record is unaffected; nothing on the far side reads it yet. -->
if ( $src && defined $extPlacer && $extPlacer ne "" ) {
  print "ERR-ALG-LEGAL : 053 : -placer works on the flat database only, not on one module\n";
  return;
}
if ( defined $extPlacer && $extPlacer ne "" ) {
  unless ( -e $extPlacer ) {
    print "ERR-ALG-LEGAL : 022 : no legalizer at $extPlacer\n";
    return;
  }
  #<!-- The pin count goes out in the CELL record below, but no external
  #     legalizer in this tree does anything with it yet.  Running the two
  #     together would quietly give the unpadded answer and call it padded,
  #     which is worse than refusing. -->
  if ( $doPinPad ) {
    print "ERR-ALG-LEGAL : 042 : --pin_spread is not implemented in the external\n";
    print "ERR-ALG-LEGAL : 043 : legalizer path; drop -placer or drop --pin_spread\n";
    return;
  }
  my $inFile  = "$TOP_MODULE.legal.in";
  my $outFile = "$TOP_MODULE.legal.out";
  unlink($outFile) if ( -e $outFile );

  unless ( open(LGL_IN, ">$inFile") ) {
    print "ERR-ALG-LEGAL : 023 : cannot write $inFile : $!\n";
    return;
  }
  print LGL_IN "# electron legalizer input, all integers in dbu\n";
  print LGL_IN "UNITS $dbu\n";
  print LGL_IN "DIE $die[0] $die[1] $die[2] $die[3]\n";
  print LGL_IN "ROWH $rowH\n";
  print LGL_IN "SITEX $siteX\n";
  foreach my $y ( @rowY ) {
    print LGL_IN "ROW $y $rowX0{$y} $rowX1{$y}\n";
  }
  foreach my $o ( @obs ) {
    print LGL_IN "OBS $o->[0] $o->[1] $o->[2] $o->[3]\n";
  }
  #<!-- the index is what comes back, so the mapping has to be kept -->
  my @byIdx = ();
  for ( my $i = 0 ; $i < @mov ; $i++ ) {
    my $m = $mov[$i];
    push(@byIdx, $m->[0]);
    #<!-- the signal pin count goes AFTER the name, not before it, so that a
    #     reader written against the old six-field record still takes field 6
    #     as the name and ignores what follows.  An instance name has no
    #     whitespace in it, so the trailing field is unambiguous. -->
    print LGL_IN "CELL $i $m->[1] $m->[2] $m->[3] $m->[4] $m->[0] $m->[5]\n";
  }
  close(LGL_IN);
  print "INFO-ALG-LEGAL : 024 : wrote $inFile, " . scalar(@mov) . " cell(s)\n";

  #<!-- run it the way the other 3RDBIN tools are run: executable with a
  #     python3 shebang, or through the interpreter if it is neither -->
  my $cmd = ( -x $extPlacer ) ? "$extPlacer $inFile $outFile"
                              : "python3 $extPlacer $inFile $outFile";
  $cmd .= " --grid $gridUm --rows $rowWin --iters $iterCap";
  $cmd .= " --spread-order $spreadOrder";
  $cmd .= " --spread" if ( $doSpread );
  $cmd .= " --no-snap-x" if ( $noSnapX );
  $cmd .= " $extArgs" if ( defined $extArgs && $extArgs ne "" );
  print "INFO-ALG-LEGAL : 025 : $cmd\n";
  my $rc = system($cmd);
  if ( $rc != 0 ) {
    print "ERR-ALG-LEGAL : 026 : the legalizer exited with status $rc, nothing applied\n";
    return;
  }
  unless ( -e $outFile ) {
    print "ERR-ALG-LEGAL : 027 : $outFile was not written, nothing applied\n";
    return;
  }

  unless ( open(LGL_OUT, "<$outFile") ) {
    print "ERR-ALG-LEGAL : 028 : cannot read $outFile : $!\n";
    return;
  }
  my ($extN, $extSum, $extMax, $extMaxInst, $extBad) = (0, 0, 0, "", 0);
  my @extLoc = ();
  while ( my $line = <LGL_OUT> ) {
    next if ( $line =~ /^\s*(#|$)/ );
    my @f = split(/\s+/, $line);
    next unless ( @f >= 4 && $f[0] eq "PLACE" );
    my ($i, $x, $y) = ($f[1], $f[2], $f[3]);
    unless ( $i =~ /^\d+$/ && $i < @byIdx ) { $extBad++; next; }
    my $inst = $byIdx[$i];
    push(@extLoc, [$inst, $x, $y]);
    my $disp = abs($x - $origX{$inst}) + abs($y - $origY{$inst});
    $extSum += $disp;
    if ( $disp > $extMax ) { $extMax = $disp; $extMaxInst = $inst; }
    $extN++;
  }
  close(LGL_OUT);
  if ( $extBad > 0 ) {
    print "WARN-ALG-LEGAL : 029 : $extBad line(s) of $outFile named no cell and were ignored\n";
  }
  unless ( $extN > 0 ) {
    print "ERR-ALG-LEGAL : 030 : $outFile placed nothing, leaving the placement alone\n";
    return;
  }
  #<!-- a cell the tool did not place keeps its own location, exactly as the
  #     internal path leaves a cell that found no row -->
  if ( $extN < @mov ) {
    my $miss = @mov - $extN;
    print "WARN-ALG-LEGAL : 031 : $miss cell(s) came back unplaced and keep their location\n";
  }
  printf("INFO-ALG-LEGAL : 032 : legalized %d cell(s), average move %.3f um, worst %.3f um%s\n",
         $extN, ($extSum / $extN) / $dbu, $extMax / $dbu,
         ( $extMaxInst ne "" ) ? " on $extMaxInst" : "");

  if ( $reportOnly ) {
    print "INFO-ALG-LEGAL : 033 : --report_only given, nothing was changed\n";
    my $t1 = new Benchmark;
    print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
    return;
  }
  my $extReOriented = 0;
  foreach my $n ( @extLoc ) {
    my ($inst, $x, $y) = @$n;
    $CADB{$inst}->dbCadbSetLoc($x, $y);
    $CADB{$inst}->dbCadbSetStatus(PLACED);
    #<!-- same rule as the internal path.  A y the external tool returns that is
    #     not exactly a row's y is left alone rather than guessed at. -->
    if ( exists $rowOrient{$y} ) {
      my $was = $CADB{$inst}->dbCadbGetOrient;
      my $now = &dbfLegalOrientForRow($was, $rowOrient{$y});
      if ( ! defined $was || $was ne $now ) {
        $CADB{$inst}->dbCadbSetOrient($now);
        $extReOriented++;
      }
    }
    if ( exists $PLACE{$TOP_MODULE} && $PLACE{$TOP_MODULE}->dbPlaceGetIsInstFlop($inst) ) {
      $PLACE{$TOP_MODULE}->dbPlaceSetFlopLoc($inst, $x, $y);
    }
  }
  if ( $extReOriented > 0 ) {
    print "INFO-ALG-LEGAL : 038 : $extReOriented cell(s) re-oriented to match their row\n";
  }
  print "INFO-ALG-LEGAL : 034 : updating instance boxes\n";
  &set_inst_box;
  unless ( $keepExt ) { unlink($inFile); unlink($outFile); }
  my $t1 = new Benchmark;
  print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
  return;
}

#<!-- Applying an answer: to the caller's sink (legalize_module), or to the
#     flat database.  Shared by the full run and by --incremental. -->
my $writeBack = sub {
  my ($locs) = @_;
  if ( $sink ) {
    $sink->($locs, \%rowOrient);
    return;
  }
  my $reOriented = 0;
  foreach my $n ( @$locs ) {
    my ($inst, $x, $y) = @$n;
    $CADB{$inst}->dbCadbSetLoc($x, $y);
    $CADB{$inst}->dbCadbSetStatus(PLACED);
    #<!-- and the orientation the row it landed in requires -->
    if ( exists $rowOrient{$y} ) {
      my $was = $CADB{$inst}->dbCadbGetOrient;
      my $now = &dbfLegalOrientForRow($was, $rowOrient{$y});
      if ( ! defined $was || $was ne $now ) {
        $CADB{$inst}->dbCadbSetOrient($now);
        $reOriented++;
      }
    }
    #<!-- the placer keeps a parallel location for flops and reads it back, so it
    #     has to agree with CADB or a later placer step undoes this -->
    if ( exists $PLACE{$TOP_MODULE} && $PLACE{$TOP_MODULE}->dbPlaceGetIsInstFlop($inst) ) {
      $PLACE{$TOP_MODULE}->dbPlaceSetFlopLoc($inst, $x, $y);
    }
  }
  if ( $reOriented > 0 ) {
    print "INFO-ALG-LEGAL : 037 : $reOriented cell(s) re-oriented to match their row\n";
  }
  print "INFO-ALG-LEGAL : 021 : updating instance boxes\n";
  &set_inst_box;
};

#========================= --incremental: repair only ======================#
#<!-- Keep every cell that is already legal exactly where it is and move only
#     the ones that are not into the nearest gap that fits.
#
#     For a placement that is legal almost everywhere -- the hierarchy
#     legalized module by module (legalize_module), then flattened -- where a
#     full run would re-solve millions of cells to fix a few.  A cell is kept
#     when it sits on a row, on the site grid, inside the row, and overlaps
#     nothing kept before it (in y, x, name order, so the result does not
#     depend on hash order).  The kept cells and the obstacles become the
#     occupied part of each row; the rest is gaps, and the cells that were
#     not kept go into them nearest first, tallest first, each cutting the
#     gap it takes. -->
if ( $incremental ) {
  my $tInc = time();
  my %rIdx = ();
  for ( my $r = 0 ; $r < $nRows ; $r++ ) { $rIdx{$rowY[$r]} = $r; }
  my $rowAt = sub {           #<!-- index of the row whose band holds y, or -1 -->
    my ($y) = @_;
    my ($lo, $hi) = (0, $nRows - 1);
    return -1 if ( $y < $rowY[0] || $y >= $rowY[$nRows-1] + $rowH );
    while ( $lo < $hi ) {
      my $mid = int( ($lo + $hi + 1) / 2 );
      if ( $rowY[$mid] <= $y ) { $lo = $mid; } else { $hi = $mid - 1; }
    }
    return $lo;
  };
  my $firstEnd = sub {
    my ($list, $x) = @_;
    my ($lo, $hi) = (0, scalar(@$list));
    while ( $lo < $hi ) {
      my $mid = int( ($lo + $hi) / 2 );
      if ( $list->[$mid][1] > $x ) { $hi = $mid; } else { $lo = $mid + 1; }
    }
    return $lo;
  };
  #<!-- occupied intervals per row, kept sorted and disjoint-or-touching -->
  my @occ = map { [] } (1 .. $nRows);
  my $overlaps = sub {
    my ($r, $x0, $x1) = @_;
    my $L = $occ[$r];
    my $i = $firstEnd->($L, $x0);
    return ( $i < @$L && $L->[$i][0] < $x1 ) ? 1 : 0;
  };
  my $occupy = sub {
    my ($r, $x0, $x1) = @_;
    my $L = $occ[$r];
    my $i = $firstEnd->($L, $x0);
    splice(@$L, $i, 0, [ $x0, $x1 ]);
  };
  foreach my $o ( @obs ) {
    my $ra = $rowAt->($o->[1]);
    $ra = 0 if ( $ra < 0 && $o->[1] < $rowY[0] );
    next if ( $ra < 0 );
    for ( my $r = $ra ; $r < $nRows && $rowY[$r] < $o->[3] ; $r++ ) {
      next if ( $rowY[$r] + $rowH <= $o->[1] );
      #<!-- obstacles may overlap each other; merge rather than double count -->
      my $L = $occ[$r];
      my ($x0, $x1) = ( $o->[0], $o->[2] );
      my $i = $firstEnd->($L, $x0);
      my $j = $i;
      while ( $j < @$L && $L->[$j][0] <= $x1 ) {
        $x0 = $L->[$j][0] if ( $L->[$j][0] < $x0 );
        $x1 = $L->[$j][1] if ( $L->[$j][1] > $x1 );
        $j++;
      }
      splice(@$L, $i, $j - $i, [ $x0, $x1 ]);
    }
  }
  my (@keep, @fix);
  foreach my $m ( sort { $a->[4] <=> $b->[4] || $a->[3] <=> $b->[3] || $a->[0] cmp $b->[0] } @mov ) {
    my ($inst, $w, $h, $x, $y) = @$m;
    my $need = int( ($h + $rowH - 1) / $rowH );
    my $ok = exists $rIdx{$y};
    my $r = $ok ? $rIdx{$y} : -1;
    $ok = 0 if ( $ok && ( $r + $need > $nRows ) );
    if ( $ok ) {
      for ( my $k = 0 ; $k < $need ; $k++ ) {
        my $yy = $rowY[$r + $k];
        if ( $yy != $y + $k * $rowH || $x < $rowX0{$yy} || $x + $w > $rowX1{$yy} ) { $ok = 0; last; }
      }
    }
    $ok = 0 if ( $ok && ! $noSnapX && ( ($x - $rowX0{$y}) % $siteX ) );
    if ( $ok ) {
      for ( my $k = 0 ; $k < $need ; $k++ ) {
        if ( $overlaps->($r + $k, $x, $x + $w) ) { $ok = 0; last; }
      }
    }
    if ( $ok ) {
      $occupy->($r + $_, $x, $x + $w) for ( 0 .. $need - 1 );
      push(@keep, $m);
    }
    else {
      push(@fix, [ $m, $need ]);
    }
  }
  #<!-- the gaps: each row's extent less what is occupied -->
  my @gap = ();
  for ( my $r = 0 ; $r < $nRows ; $r++ ) {
    my $y = $rowY[$r];
    my @g = ();
    my $x = $rowX0{$y};
    foreach my $iv ( @{$occ[$r]} ) {
      push(@g, [ $x, $iv->[0] ]) if ( $iv->[0] > $x );
      $x = $iv->[1] if ( $iv->[1] > $x );
    }
    push(@g, [ $x, $rowX1{$y} ]) if ( $rowX1{$y} > $x );
    $gap[$r] = \@g;
  }
  @occ = ();
  #<!-- nearest x in rows r .. r+need-1, all free, on the site grid -->
  my $fitAt = sub {
    my ($r, $need, $w, $tx) = @_;
    my $base = $gap[$r];
    my $x0row = $rowX0{$rowY[$r]};
    my ($bestX, $bestC);
    my $evalIv = sub {
      my ($a0, $a1) = @_;
      my @cur = ( [ $a0, $a1 ] );
      for ( my $k = 1 ; $k < $need && @cur ; $k++ ) {
        my $nxt = $gap[$r + $k];
        my @out = ();
        my $j = $firstEnd->($nxt, $cur[0][0]);
        my $i = 0;
        while ( $i < @cur && $j < @$nxt ) {
          my $b0 = ( $cur[$i][0] > $nxt->[$j][0] ) ? $cur[$i][0] : $nxt->[$j][0];
          my $b1 = ( $cur[$i][1] < $nxt->[$j][1] ) ? $cur[$i][1] : $nxt->[$j][1];
          push(@out, [ $b0, $b1 ]) if ( $b1 > $b0 );
          if ( $cur[$i][1] < $nxt->[$j][1] ) { $i++; } else { $j++; }
        }
        @cur = @out;
      }
      foreach my $iv ( @cur ) {
        next if ( $iv->[1] - $iv->[0] < $w );
        my $x = $tx;
        $x = $iv->[0] if ( $x < $iv->[0] );
        $x = $iv->[1] - $w if ( $x > $iv->[1] - $w );
        unless ( $noSnapX ) {
          my $n = int( ($x - $x0row) / $siteX + 0.5 );
          $x = $x0row + $n * $siteX;
          $x += $siteX while ( $x < $iv->[0] );
          $x -= $siteX while ( $x + $w > $iv->[1] );
          next if ( $x < $iv->[0] );
        }
        my $c = abs($x - $tx);
        if ( ! defined $bestC || $c < $bestC || ( $c == $bestC && $x < $bestX ) ) { ($bestC, $bestX) = ($c, $x); }
      }
    };
    my $s0 = $firstEnd->($base, $tx);
    for ( my $b = $s0 ; $b < @$base ; $b++ ) {
      my $lb = ( $base->[$b][0] > $tx ) ? $base->[$b][0] - $tx : 0;
      last if ( defined $bestC && $lb >= $bestC );
      $evalIv->( @{$base->[$b]} );
    }
    for ( my $b = $s0 - 1 ; $b >= 0 ; $b-- ) {
      my $lb = $tx - ( $base->[$b][1] - $w );
      last if ( defined $bestC && $lb > $bestC );
      $evalIv->( @{$base->[$b]} );
    }
    return ( $bestX, $bestC );
  };
  my @moved = ();
  my ($sumD, $maxD, $maxI, $noFit) = (0, 0, "", 0);
  foreach my $fm ( sort { $b->[1] <=> $a->[1] || $a->[0][4] <=> $b->[0][4] ||
                          $a->[0][3] <=> $b->[0][3] || $a->[0][0] cmp $b->[0][0] } @fix ) {
    my ($m, $need) = @$fm;
    my ($inst, $w, $h, $tx, $ty) = @$m;
    my $best = $rowAt->($ty);
    $best = ( $ty < $rowY[0] ) ? 0 : $nRows - 1 if ( $best < 0 );
    my ($pR, $pX, $pC);
    #<!-- the usual window, then wider: a cell this pass cannot place is
    #     one more overlap left in a placement that was nearly legal -->
    foreach my $win ( $rowWin, 4 * $rowWin, $nRows ) {
      for ( my $d = 0 ; $d <= $win ; $d++ ) {
        foreach my $r ( ($best - $d), ($best + $d) ) {
          next if ( $d > 0 && $r == $best );
          next if ( $r < 0 || $r + $need > $nRows );
          my $okSpan = 1;
          for ( my $k = 1 ; $k < $need ; $k++ ) {
            if ( $rowY[$r+$k] != $rowY[$r] + $k * $rowH ) { $okSpan = 0; last; }
          }
          next unless ( $okSpan );
          my ($x, $cx) = $fitAt->($r, $need, $w, $tx);
          next unless ( defined $x );
          my $c = $cx + abs($rowY[$r] - $ty);
          if ( ! defined $pC || $c < $pC ) { ($pC, $pR, $pX) = ($c, $r, $x); }
        }
        last if ( defined $pC && $pC <= ($d + 1) * $rowH );
      }
      last if ( defined $pC );
    }
    unless ( defined $pR ) { $noFit++; next; }
    for ( my $k = 0 ; $k < $need ; $k++ ) {
      my $L = $gap[$pR + $k];
      my $i = $firstEnd->($L, $pX);
      my $j = $i;
      my @rep = ();
      while ( $j < @$L && $L->[$j][0] < $pX + $w ) {
        my $iv = $L->[$j];
        push(@rep, [ $iv->[0], $pX ]) if ( $pX > $iv->[0] );
        push(@rep, [ $pX + $w, $iv->[1] ]) if ( $iv->[1] > $pX + $w );
        $j++;
      }
      splice(@$L, $i, $j - $i, @rep);
    }
    push(@moved, [ $inst, $pX, $rowY[$pR] ]);
    my $disp = abs($pX - $tx) + abs($rowY[$pR] - $ty);
    $sumD += $disp;
    if ( $disp > $maxD ) { ($maxD, $maxI) = ($disp, $inst); }
  }
  %LEGAL_STATS = ( mode => "incremental", cells => $nMov, kept => scalar(@keep),
                   placed => scalar(@moved),
                   mean_move_um => @moved ? $sumD / @moved / $dbu : 0, worst_move_um => $maxD / $dbu,
                   no_room => $noFit, rows => $nRows );
  printf("INFO-ALG-LEGAL : 054 : --incremental: %d cell(s) already legal and kept, %d moved, average move %.3f um, worst %.3f um%s, %d s\n",
         scalar(@keep), scalar(@moved), @moved ? $sumD / @moved / $dbu : 0, $maxD / $dbu,
         ( $maxI ne "" ) ? " on $maxI" : "", time() - $tInc);
  if ( $noFit > 0 ) {
    print "WARN-ALG-LEGAL : 055 : $noFit cell(s) found no gap anywhere and keep their location\n";
  }
  if ( $reportOnly ) {
    print "INFO-ALG-LEGAL : 020 : --report_only given, nothing was changed\n";
  }
  else {
    $writeBack->(\@moved);
  }
  my $t1 = new Benchmark;
  print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
  return;
}

#====================== pass 1: spread the density =========================#
if ( $doSpread ) {
  my $bin = $gridUm * $dbu;
  $bin = $rowH if ( $bin < $rowH );        #<!-- a bin shorter than a row is no use -->
  my $nbx = int( ($die[2] - $die[0]) / $bin ) + 1;
  my $nby = int( ($die[3] - $die[1]) / $bin ) + 1;

  #<!-- free area per bin: its own area less whatever an obstacle covers of it -->
  my %cap = ();
  for ( my $bx = 0 ; $bx < $nbx ; $bx++ ) {
    for ( my $by = 0 ; $by < $nby ; $by++ ) {
      my $x0 = $die[0] + $bx * $bin;  my $x1 = $x0 + $bin;
      my $y0 = $die[1] + $by * $bin;  my $y1 = $y0 + $bin;
      $x1 = $die[2] if ( $x1 > $die[2] );
      $y1 = $die[3] if ( $y1 > $die[3] );
      my $a = ($x1 - $x0) * ($y1 - $y0);
      $a = 0 if ( $a < 0 );
      $cap{"$bx,$by"} = $a;
    }
  }
  foreach my $o ( @obs ) {
    my $bx0 = int( ($o->[0] - $die[0]) / $bin );  my $bx1 = int( ($o->[2] - $die[0]) / $bin );
    my $by0 = int( ($o->[1] - $die[1]) / $bin );  my $by1 = int( ($o->[3] - $die[1]) / $bin );
    for ( my $bx = $bx0 ; $bx <= $bx1 ; $bx++ ) {
      next if ( $bx < 0 || $bx >= $nbx );
      for ( my $by = $by0 ; $by <= $by1 ; $by++ ) {
        next if ( $by < 0 || $by >= $nby );
        my $x0 = $die[0] + $bx * $bin;  my $x1 = $x0 + $bin;
        my $y0 = $die[1] + $by * $bin;  my $y1 = $y0 + $bin;
        my $ox = ( ($o->[2] < $x1 ? $o->[2] : $x1) - ($o->[0] > $x0 ? $o->[0] : $x0) );
        my $oy = ( ($o->[3] < $y1 ? $o->[3] : $y1) - ($o->[1] > $y0 ? $o->[1] : $y0) );
        next if ( $ox <= 0 || $oy <= 0 );
        $cap{"$bx,$by"} -= $ox * $oy;
        $cap{"$bx,$by"} = 0 if ( $cap{"$bx,$by"} < 0 );
      }
    }
  }

  my $binOf = sub {
    my ($m) = @_;
    my $bx = int( ($m->[3] + $m->[1]/2 - $die[0]) / $bin );
    my $by = int( ($m->[4] + $m->[2]/2 - $die[1]) / $bin );
    $bx = 0 if ( $bx < 0 ); $bx = $nbx-1 if ( $bx >= $nbx );
    $by = 0 if ( $by < 0 ); $by = $nby-1 if ( $by >= $nby );
    return ($bx, $by);
  };

  my $movedOut = 0;
  my $iter = 0;
  while ( $iter < $iterCap ) {
    $iter++;
    my %load = ();
    my %members = ();
    foreach my $m ( @mov ) {
      my ($bx, $by) = $binOf->($m);
      $load{"$bx,$by"} += $m->[1] * $m->[2];
      push(@{$members{"$bx,$by"}}, $m);
    }
    #<!-- Worst bin first, so the relief goes where it is needed most, and the
    #     bin key as the tie break so that the order is the same every run.
    #
    #     Without the tie break this sorts over "keys %load", and Perl
    #     randomises hash order per process: bins with equal overflow were
    #     relieved in a different order each time, different cells were handed
    #     to neighbours, and the whole legalisation came out different.
    #     Measured on matmul_4x4 before the fix -- two identical runs agreed on
    #     88.8% of 204,816 cells and moved the rest by 11um on average, which
    #     is enough to hide a real regression inside the noise.  This was the
    #     only hash-ordered iteration in the algorithm; the cell loop above
    #     already sorts. -->
    #<!-- The tie break compares the bin indices NUMERICALLY, not the "bx,by"
    #     key as a string: "10,5" sorts before "9,3" as text and after it as a
    #     pair of numbers.  3RDBIN/legalize_flat does the same comparison the
    #     numeric way, and the two have to agree or the reference stops being
    #     one -- it showed up as 48,219 cells rebinned here against 48,216
    #     there on the same design.
    #
    #     Decorated, because a split inside a comparator runs O(n log n) times
    #     and cost nine seconds of the thirty-five on the 855k cell MXU.  This
    #     way the key is built once per bin. -->
    my @over = map  { $_->[0] }
               sort { $b->[1] <=> $a->[1] || $a->[2] <=> $b->[2] }
               map  { my ($qx, $qy) = split(/,/, $_);
                      [ $_, $load{$_} - $cap{$_}, $qx * $nby + $qy ] }
               grep { $load{$_} > $cap{$_} } keys %load;
    last unless ( @over );

    my $movedThisPass = 0;
    #<!-- $bkey, NOT $b.
    #
    #     This loop variable used to be called $b, and the two sorts below
    #     compare $b against $a.  A lexical "my $b" in scope SHADOWS sort's $b,
    #     and sort cannot assign to a lexical, so inside both comparators $b
    #     was the bin key string -- "3,7" -- and $b->[3] was a symbolic deref
    #     of an array that does not exist, i.e. undef.  Each comparator
    #     degenerated to "0 <=> $a->something", which sorts ASCENDING by that
    #     something: exactly the reverse of what both were written to do.
    #
    #     So the spreading pass handed the SMALLEST cell to the neighbour with
    #     the LEAST room, where the comments promise the opposite.  It still
    #     terminated and still produced a legal placement, which is why it
    #     went unnoticed -- it just relieved very little per iteration, ran
    #     into the -iters cap, and left pass 2 to shove cells a long way.  perl
    #     -w reports it as "uninitialized value in multiplication" and nothing
    #     in this tree runs with -w.
    #
    #     Renaming the variable is the whole fix; the comparators were right. -->
    foreach my $bkey ( @over ) {
      my ($bx, $by) = split(/,/, $bkey);
      my $excess = $load{$bkey} - $cap{$bkey};
      next unless ( $excess > 0 );
      #<!-- the cheapest cell to give away is the one nearest a bin with room -->
      my @cand = ();
      foreach my $dx ( -1, 0, 1 ) {
        foreach my $dy ( -1, 0, 1 ) {
          next if ( $dx == 0 && $dy == 0 );
          my ($nx, $ny) = ($bx + $dx, $by + $dy);
          next if ( $nx < 0 || $nx >= $nbx || $ny < 0 || $ny >= $nby );
          my $k = "$nx,$ny";
          my $room = $cap{$k} - ( defined $load{$k} ? $load{$k} : 0 );
          push(@cand, [$k, $nx, $ny, $room]) if ( $room > 0 );
        }
      }
      next unless ( @cand );
      #<!-- most room first, bin indices numerically as the tie break -->
      @cand = sort { $b->[3] <=> $a->[3]
                     || $a->[1] <=> $b->[1] || $a->[2] <=> $b->[2] } @cand;

      #<!-- Which cell to give away, and why the default is the SMALL one.
      #
      #     Largest first relieves the most excess per move, so it moves fewer
      #     cells and comes out with a lower total displacement -- 41.9um
      #     against 43.8um on matmul_4x4.  It also routes measurably worse.
      #     Three runs of nangate_flat each way, same build, same everything:
      #
      #         smallest first   360, 371, 395 nets of 4489 unrouted
      #         largest first    501, 522, 544
      #
      #     Non overlapping, so it is not the placer's run to run spread.  The
      #     reason is that a move here is not a nudge: it retargets the cell to
      #     the CENTRE of a neighbouring bin, a full bin away.  The big cells
      #     are the drivers, they carry the most pins, and tearing one out of
      #     its neighbourhood costs more wire than nudging several small ones
      #     -- which total displacement, summed over cells and blind to pin
      #     count, does not see.
      #
      #     So displacement is the wrong thing to optimise here and this picks
      #     the other way on purpose.  -spread_order large restores it.
      #     Area ties break on the instance name so two runs pick the same
      #     cell. -->
      my @members = ( $spreadOrder eq "large" )
        ? sort { $b->[1]*$b->[2] <=> $a->[1]*$a->[2] || $a->[0] cmp $b->[0] } @{$members{$bkey}}
        : sort { $a->[1]*$a->[2] <=> $b->[1]*$b->[2] || $a->[0] cmp $b->[0] } @{$members{$bkey}};
      foreach my $m ( @members ) {
        last if ( $excess <= 0 );
        my $area = $m->[1] * $m->[2];
        foreach my $c ( @cand ) {
          next if ( $c->[3] < $area );
          #<!-- shift the target just inside the neighbour, keeping the other
          #     axis where it was: the move has to be the smallest one that
          #     changes which bin the cell belongs to -->
          my $tx = $die[0] + $c->[1] * $bin + $bin/2 - $m->[1]/2;
          my $ty = $die[1] + $c->[2] * $bin + $bin/2 - $m->[2]/2;
          $m->[3] = $tx;
          $m->[4] = $ty;
          $c->[3] -= $area;
          $load{$c->[0]} += $area;
          $excess -= $area;
          $movedThisPass++;
          $movedOut++;
          last;
        }
      }
    }
    last unless ( $movedThisPass > 0 );
  }
  print "INFO-ALG-LEGAL : 012 : spreading: $movedOut cell(s) rebinned in $iter pass(es)",
        " over ${gridUm}um bins\n";
}

#============ pin density relief by padding: the map and the maths ==========#
#<!-- See the head of the file for what this is and why it pads rather than
#     moves.  The pass itself is not here -- it cannot be, because it needs a
#     legal placement to measure and pass 2 is what produces one.  What is here
#     is the grid, the two measurements taken on it, and the per-instance size
#     and pin count they need; the padding is worked out between the two runs
#     of pass 2, below.
#
#     Everything it does is to $m->[6], the width pass 2 sees.  The cell's real
#     width, $m->[1], is untouched, so a padded cell is written at the left
#     edge of the slot it was given and the slack falls to its right. -->
my $pinTile = 0;                 #<!-- tile size in dbu, 0 when the pass is off -->
my ($pinNX, $pinNY, $pinT) = (0, 0, 0);
my %pinN = ();
my %cellW = ();
my %cellH = ();

#<!-- pins per tile for a set of cells, given as [x, y, w, h, pins].  Used
#     twice: on the targets before the pass, and on the legalized locations
#     afterwards, so the report measures the same thing both times. -->
my $pinHist = sub {
  my ($cells) = @_;
  my %h = ();
  foreach my $c ( @$cells ) {
    next unless ( $c->[4] > 0 );
    my $bx = int( ($c->[0] + $c->[2]/2 - $die[0]) / $pinTile );
    my $by = int( ($c->[1] + $c->[3]/2 - $die[1]) / $pinTile );
    $bx = 0 if ( $bx < 0 ); $bx = $pinNX - 1 if ( $bx >= $pinNX );
    $by = 0 if ( $by < 0 ); $by = $pinNY - 1 if ( $by >= $pinNY );
    $h{"$bx,$by"} += $c->[4];
  }
  return \%h;
};

#<!-- max, the percentile, and how many tiles are over the target -->
my $pinStats = sub {
  my ($h, $target) = @_;
  my @v = sort { $a <=> $b } values %$h;
  return (0, 0, 0, 0) unless ( @v );
  my $k = int( $pinPctl / 100 * $#v );
  $k = 0 if ( $k < 0 );
  $k = $#v if ( $k > $#v );
  my $over = 0;
  if ( $target > 0 ) {
    foreach my $v ( @v ) { $over++ if ( $v > $target ); }
  }
  return ($v[-1], $v[$k], scalar(@v), $over);
};

#<!-- The padded width per instance, empty until the provisional legalization
#     below has run and the map has been measured on it. -->
my %padOf = ();

if ( $doPinPad ) {
  $pinTile = int( $pinGridUm * $dbu );
  if ( $pinTile < 1 ) { $pinTile = 1; }
  $pinNX = int( ($die[2] - $die[0]) / $pinTile ) + 1;
  $pinNY = int( ($die[3] - $die[1]) / $pinTile ) + 1;
  #<!-- size and pin count by instance, so the map can be rebuilt from a list
  #     of locations alone -->
  foreach my $m ( @mov ) {
    $pinN{$m->[0]} = $m->[5];
    $cellW{$m->[0]} = $m->[1];
    $cellH{$m->[0]} = $m->[2];
  }
}

#====================== pass 2: rows and Abacus ============================#
#<!-- Wall time per phase, so a slow run says where it is slow.  A 6.7M-cell
#     tile sat in here for hours printing nothing, and which phase it was in
#     had to be read off the code. -->
my $tPhase = time();
my $phaseDone = sub {
  my ($what) = @_;
  my $now = time();
  print "INFO-ALG-LEGAL : 052 : $what took " . ($now - $tPhase) . " s\n";
  $tPhase = $now;
};
#<!-- Free intervals per row.  An obstacle covering part of a row's y band cuts
#     it in two, and each piece is legalized on its own: a cell cannot slide
#     through a macro. -->
my %seg = ();          #<!-- y => [ [x0,x1], ... ] -->
foreach my $y ( @rowY ) {
  my @cut = ();
  foreach my $o ( @obs ) {
    next if ( $o->[3] <= $y || $o->[1] >= $y + $rowH );      #<!-- no y overlap -->
    my $a = ( $o->[0] > $rowX0{$y} ) ? $o->[0] : $rowX0{$y};
    my $b = ( $o->[2] < $rowX1{$y} ) ? $o->[2] : $rowX1{$y};
    push(@cut, [$a, $b]) if ( $b > $a );
  }
  @cut = sort { $a->[0] <=> $b->[0] } @cut;
  my @free = ();
  my $x = $rowX0{$y};
  foreach my $c ( @cut ) {
    push(@free, [$x, $c->[0]]) if ( $c->[0] > $x );
    $x = $c->[1] if ( $c->[1] > $x );
  }
  push(@free, [$x, $rowX1{$y}]) if ( $rowX1{$y} > $x );
  $seg{$y} = \@free;
}

#------------------------- cells taller than one row ------------------------#
#<!-- WHY THESE ARE PLACED FIRST, AND SEPARATELY.
#
#     Abacus legalizes one row at a time.  A cell spanning two rows is not a
#     member of one row's problem, it is a member of both, and there is no way
#     to express that to a per-row solver -- so this used to count them, say
#     out loud that the rows above were not reserved, and leave them to overlap
#     whatever was up there.  Nangate is 135 macros all 1.4um tall, so nothing
#     in TESTS ever caught it; a real library will.
#
#     NOTE WHAT DOES NOT WORK, because it is what 3RDBIN/legalize_flat does and
#     it is the obvious idea: subtracting the cell's width from the remaining
#     FREE WIDTH of the rows above.  That reserves width, not place.  The rows
#     above never learn where the tall cell is, Abacus packs them from the left
#     as usual, and the cells land on top of it anyway.  Measured on a
#     synthetic case -- one double height cell, twenty single height ones in
#     the row above -- the NumPy legalizer prints "the rows above them were
#     reserved" and produces two real overlaps.
#
#     What works is to turn the tall cell into an OBSTACLE.  The rows it spans
#     are already cut into free intervals around macros, and a placed tall cell
#     is exactly a small macro: cut the intervals around it too, and every row
#     it spans is then a row with a hole in it that Abacus cannot slide through
#     -- the same mechanism, no special case in the solver, and the overlap is
#     impossible rather than unlikely.
#
#     So they are placed here, greedily, tallest first: nearest row whose whole
#     span is free at some x near the one the placer wanted, and each one cuts
#     the rows it takes before the next is placed.  Greedy is defensible
#     because they are rare -- a few percent of a real netlist -- and because
#     the alternative, solving their placement jointly with everything else, is
#     a different algorithm.
#
#     They are never padded by --pin_spread.  Padding buys its gap from Abacus
#     and these cells do not go through Abacus. -->
my %rowIdxOf = ();
for ( my $r = 0 ; $r < $nRows ; $r++ ) { $rowIdxOf{$rowY[$r]} = $r; }

#<!-- the widest x near $tx at which rows $r .. $r+$need-1 are ALL free for
#     $w, or undef if there is no such x -->
#<!-- First index in a sorted, disjoint interval list whose right end is past
#     $x: the interval holding $x, or the first one to its right. -->
my $firstEndingAfter = sub {
  my ($list, $x) = @_;
  my ($lo, $hi) = (0, scalar(@$list));
  while ( $lo < $hi ) {
    my $mid = int( ($lo + $hi) / 2 );
    if ( $list->[$mid][1] > $x ) { $hi = $mid; } else { $lo = $mid + 1; }
  }
  return $lo;
};

#<!-- the widest x near $tx at which rows $r .. $r+$need-1 are ALL free for
#     $w, or undef if there is no such x.
#
#     Visits row $r's intervals nearest first and intersects only those with
#     the rows above, instead of intersecting every row's whole list on every
#     call: the rows are cut by every tall cell placed before, ~500 intervals a
#     row on a tile of 1.33M of them, and the whole-list version took an hour.
#     Same answer as before, ties included -- the old loop kept the leftmost x
#     at the lowest cost, so walking right an equal cost stops the walk and
#     walking left it does not. -->
my $multiFit = sub {
  my ($r, $need, $w, $tx) = @_;
  my $base = $seg{$rowY[$r]};
  my ($bestX, $bestCost);
  #<!-- the pieces of one base interval that are free in every spanned row -->
  my $pieces = sub {
    my ($iv) = @_;
    my @cur = ( [ $iv->[0], $iv->[1] ] );
    for ( my $k = 1 ; $k < $need && @cur ; $k++ ) {
      my $nxt = $seg{$rowY[$r+$k]};
      my @out = ();
      my $j = $firstEndingAfter->($nxt, $cur[0][0]);
      my $i = 0;
      #<!-- both lists are sorted and disjoint, so one walk intersects them -->
      while ( $i < @cur && $j < @$nxt ) {
        my $a0 = ( $cur[$i][0] > $nxt->[$j][0] ) ? $cur[$i][0] : $nxt->[$j][0];
        my $a1 = ( $cur[$i][1] < $nxt->[$j][1] ) ? $cur[$i][1] : $nxt->[$j][1];
        push(@out, [$a0, $a1]) if ( $a1 > $a0 );
        if ( $cur[$i][1] < $nxt->[$j][1] ) { $i++; } else { $j++; }
      }
      @cur = @out;
    }
    return @cur;
  };
  my $evalPieces = sub {
    foreach my $iv ( @_ ) {
      next if ( $iv->[1] - $iv->[0] < $w );
      my $x = $tx;
      $x = $iv->[0] if ( $x < $iv->[0] );
      $x = $iv->[1] - $w if ( $x > $iv->[1] - $w );
      #<!-- on the site grid, measured from the ROW's origin rather than from the
      #     interval's: the interval starts wherever a macro happens to end, and
      #     snapping to that would put the cell between sites -->
      unless ( $noSnapX ) {
        my $x0 = $rowX0{$rowY[$r]};
        my $n = int( ($x - $x0) / $siteX + 0.5 );
        $x = $x0 + $n * $siteX;
        $x = $iv->[0] + ( ( $iv->[0] - $x0 ) % $siteX ? $siteX - ( ( $iv->[0] - $x0 ) % $siteX ) : 0 )
          if ( $x < $iv->[0] );
        while ( $x + $w > $iv->[1] ) { $x -= $siteX; }
        next if ( $x < $iv->[0] );
      }
      my $c = abs($x - $tx);
      if ( ! defined $bestCost || $c < $bestCost || ( $c == $bestCost && $x < $bestX ) ) {
        $bestCost = $c; $bestX = $x;
      }
    }
  };
  my $start = $firstEndingAfter->($base, $tx);
  for ( my $b = $start ; $b < @$base ; $b++ ) {
    my $lb = ( $base->[$b][0] > $tx ) ? $base->[$b][0] - $tx : 0;
    last if ( defined $bestCost && $lb >= $bestCost );
    $evalPieces->( $pieces->($base->[$b]) );
  }
  for ( my $b = $start - 1 ; $b >= 0 ; $b-- ) {
    my $lb = $tx - ( $base->[$b][1] - $w );
    last if ( defined $bestCost && $lb > $bestCost );
    $evalPieces->( $pieces->($base->[$b]) );
  }
  return $bestX;
};

my @multiLoc = ();     #<!-- [inst, x, y] for the cells placed here -->
my @single = ();       #<!-- everything pass 2 will handle -->
my %isMulti = ();
my ($tooTall, $multiNoRoom) = (0, 0);
{
  my @multi = ();
  foreach my $m ( @mov ) {
    my $need = int( ($m->[2] + $rowH - 1) / $rowH );
    if ( $need > 1 ) { push(@multi, [$m, $need]); $isMulti{$m->[0]} = 1; }
    else             { push(@single, $m); }
  }
  $tooTall = @multi;
  #<!-- tallest first, then by target and name so two runs agree -->
  @multi = sort { $b->[1] <=> $a->[1]
                  || $a->[0][3] <=> $b->[0][3]
                  || $a->[0][0] cmp $b->[0][0] } @multi;

  foreach my $mm ( @multi ) {
    my ($m, $need) = @$mm;
    my ($inst, $w, $tx, $ty) = ($m->[0], $m->[1], $m->[3], $m->[4]);

    my $best;
    {
      my ($lo, $hi) = (0, $nRows - 1);
      while ( $lo < $hi ) {
        my $mid = int( ($lo + $hi) / 2 );
        if ( $rowY[$mid] < $ty ) { $lo = $mid + 1; }
        else                     { $hi = $mid; }
      }
      $best = $lo;
      if ( $lo > 0 && abs($rowY[$lo-1] - $ty) <= abs($rowY[$lo] - $ty) ) { $best = $lo - 1; }
    }

    my ($pickR, $pickX, $pickCost);
    for ( my $d = 0 ; $d <= $rowWin ; $d++ ) {
      foreach my $r ( ($best - $d), ($best + $d) ) {
        next if ( $d > 0 && $r == $best );
        next if ( $r < 0 || $r + $need > $nRows );
        #<!-- the span has to be contiguous at the row pitch.  A DEF may carry
        #     several ROW records with gaps between them, and a cell cannot
        #     bridge a gap. -->
        my $ok = 1;
        for ( my $k = 1 ; $k < $need ; $k++ ) {
          if ( $rowY[$r+$k] != $rowY[$r] + $k * $rowH ) { $ok = 0; last; }
        }
        next unless ( $ok );
        my $x = $multiFit->($r, $need, $w, $tx);
        next unless ( defined $x );
        my $cost = abs($x - $tx) + abs($rowY[$r] - $ty);
        if ( ! defined $pickCost || $cost < $pickCost ) {
          $pickCost = $cost; $pickR = $r; $pickX = $x;
        }
      }
      last if ( defined $pickCost && $pickCost <= ($d + 1) * $rowH );
    }

    unless ( defined $pickR ) {
      #<!-- same contract as WARN 013: it keeps the location it came in with -->
      $multiNoRoom++;
      next;
    }

    #<!-- and now it is an obstacle: cut it out of every row it spans
    #     -- only the intervals it overlaps, spliced in place, rather than the
    #     whole row rebuilt for every tall cell -->
    for ( my $k = 0 ; $k < $need ; $k++ ) {
      my $L = $seg{$rowY[$pickR + $k]};
      my $i = $firstEndingAfter->($L, $pickX);
      my $j = $i;
      my @rep = ();
      while ( $j < @$L && $L->[$j][0] < $pickX + $w ) {
        my $iv = $L->[$j];
        push(@rep, [ $iv->[0], $pickX ]) if ( $pickX > $iv->[0] );
        push(@rep, [ $pickX + $w, $iv->[1] ]) if ( $iv->[1] > $pickX + $w );
        $j++;
      }
      splice(@$L, $i, $j - $i, @rep);
    }
    push(@multiLoc, [$inst, $pickX, $rowY[$pickR]]);
  }
}
$phaseDone->("rows, and the cells taller than one row,");
if ( $tooTall > 0 ) {
  printf("INFO-ALG-LEGAL : 015 : %d cell(s) span more than one row; %d placed first, with the rows they take cut out of the rows below them\n",
         $tooTall, scalar(@multiLoc));
}
if ( $multiNoRoom > 0 ) {
  print "WARN-ALG-LEGAL : 016 : $multiNoRoom multi-row cell(s) found no span of free rows and keep\n";
  print "WARN-ALG-LEGAL : 051 : their current location, which may overlap.  Raise -rows\n";
}

#--------------------- local density cap on the assignment -------------------#
#<!-- WHY THIS EXISTS.
#
#     Below, a cell is given the row nearest its own y whose SEGMENT has room.
#     A segment is a whole free run of a row, and on a die with no macros that
#     is the entire row: 1496um on mxu_256.  So the capacity test was asking
#     "is this 1496um row more than 100% full", and the answer is almost always
#     no -- the design is at 50% utilisation and only 42 of 1068 rows overflow
#     as whole rows.  The cost is abs(wx - tx) + abs(y - ty) with wx clamped
#     only to the segment, so wx == tx, the cost collapses to pure |dy|, and
#     the nearest row wins every time whatever the LOCAL density.
#
#     Measured on mxu_256 after hier_place_all: at 47um columns 22.8% of
#     occupied bins are over capacity and 22.1% of all cell width has to leave
#     its bin.  Abacus then does that the only way it can, by sliding cells
#     along the row, and the bill is mean |dx| 42.9um against mean |dy| 0.36um
#     -- 36.7 metres of horizontal movement against 0.31 of vertical, on a
#     design where 100% of the excess has free space within FOUR ROWS, 5.6um.
#
#     So the fix is to make the capacity test local: bins across each row, and
#     a cell may not take a row whose bin at that x is already full.  The
#     search below already walks rows nearest-first, so pruning candidates this
#     way makes it exactly "the nearest row with room here" -- which is the
#     cheapest possible relief and needs no extra pass.
#
#     AND NOT DENSITY EQUALISATION, which is the trap.  Making every bin's
#     density equal is a transportation problem whose answer drains the dense
#     middle of the die into empty rows hundreds of rows away: simulated on
#     mxu_256 it costs a mean |dy| of 686um, against 2.3um for relieving only
#     the overflow.  That is 300 times the movement for no extra legality, and
#     it is what pass 1 above does -- it aims a cell at the CENTRE of another
#     bin -- which is the best explanation anyone has for why pass 1 multiplies
#     unrouted nets by seven.  Nothing here moves a cell that is not in an
#     over-full bin, and nothing here changes a cell's x.
#
#     Capacity is the FREE width in the bin, not the bin width, so a bin half
#     covered by a macro counts as half a bin and cells are not driven into
#     obstacles. -->
my $dbin = 0;
my %binCap = ();       #<!-- "rowIdx,binIdx" => free width in dbu -->
my %binLoad = ();
my $binX0 = 0;
my $nBins = 0;
if ( $dbinUm >= 0 ) {
  my ($spanLo, $spanHi);
  foreach my $y ( @rowY ) {
    $spanLo = $rowX0{$y} if ( ! defined $spanLo || $rowX0{$y} < $spanLo );
    $spanHi = $rowX1{$y} if ( ! defined $spanHi || $rowX1{$y} > $spanHi );
  }
  $binX0 = ( defined $spanLo ) ? $spanLo : 0;
  my $span = ( defined $spanHi ) ? $spanHi - $binX0 : 0;
  if ( $span > 0 ) {
    if ( $dbinUm > 0 ) { $dbin = $dbinUm * $dbu; }
    else {
      #<!-- A HUNDRED CELLS WIDE, not a fraction of the row.
      #
      #     A fraction of the span was the first try and it is wrong, because
      #     it reads the die size rather than the cell size.  span/16 is 94um
      #     on mxu_256 -- about a hundred cells, which is the size that
      #     measured well -- and 5.32um on the 85um die of nangate_flat, about
      #     five cells.  At five cells this is not relieving overflow any more,
      #     it is demanding uniform density at cell granularity.
      #
      #     A hundred times the mean cell width is scale free and lands on both
      #     sizes that measured well: ~93um on mxu_256, ~21um on nangate_flat
      #     once the span/4 clamp bites.
      #
      #     Clamped below so a bin is always several sites wide, and above so a
      #     small die still gets four columns rather than one. -->
      my $meanW = ( $nMov > 0 ) ? ( $totMovW / $nMov ) : 0;
      $dbin = int( 100 * $meanW );
      my $lo = 8 * $siteX;
      my $hi = int( $span / 4 );
      $dbin = $lo if ( $dbin < $lo );
      $dbin = $hi if ( $hi > 0 && $dbin > $hi );
    }
    $dbin = $siteX if ( $dbin < $siteX );
    $nBins = int( $span / $dbin ) + 1;
    #<!-- free width per bin, from the segments so obstacles are counted -->
    for ( my $r = 0 ; $r < $nRows ; $r++ ) {
      my $y = $rowY[$r];
      foreach my $s ( @{$seg{$y}} ) {
        my ($a, $b) = @$s;
        my $b0 = int( ($a - $binX0) / $dbin );
        my $b1 = int( ($b - $binX0) / $dbin );
        $b0 = 0 if ( $b0 < 0 );
        $b1 = $nBins - 1 if ( $b1 > $nBins - 1 );
        for ( my $bi = $b0 ; $bi <= $b1 ; $bi++ ) {
          my $lo = $binX0 + $bi * $dbin;
          my $hi = $lo + $dbin;
          $lo = $a if ( $a > $lo );
          $hi = $b if ( $b < $hi );
          $binCap{"$r,$bi"} += ($hi - $lo) if ( $hi > $lo );
        }
      }
    }
    printf("INFO-ALG-LEGAL : 039 : local density cap on, %d column(s) of %.2f um, up to %d row(s) away\n",
           $nBins, $dbin / $dbu, $dbinRows);
  }
}
else {
  print "INFO-ALG-LEGAL : 040 : --no_dbin, the row assignment ignores local density\n";
}

#<!-- Abacus on one segment.  Cells arrive in x order; a cell that will not fit
#     after the last cluster starts a new one, otherwise it joins and the
#     cluster slides to the weighted mean of its members' targets, merging into
#     its left neighbour when that now overlaps.  The result is the minimum sum
#     of squared displacement for this set of cells in this segment. -->
my $abacus = sub {
  my ($cells, $xlo, $xhi) = @_;     #<!-- cells: [ [inst,w,tx], ... ] in x order -->
  my @cl = ();                      #<!-- cluster: [x, w, q, width, firstIdx, count] -->
  my @order = ();
  foreach my $c ( @$cells ) {
    push(@order, $c);
    my $i = $#order;
    if ( @cl && $cl[-1]->[0] + $cl[-1]->[3] > $c->[2] ) {
      my $k = $cl[-1];
      $k->[2] += 1 * ( $c->[2] - $k->[3] );     #<!-- q += w_i*(tx - cluster width so far) -->
      $k->[1] += 1;
      $k->[3] += $c->[1];
      $k->[5]++;
    }
    else {
      push(@cl, [ $c->[2], 1, 1 * $c->[2], $c->[1], $i, 1 ]);
    }
    #<!-- collapse from the top down -->
    while ( 1 ) {
      my $k = $cl[-1];
      $k->[0] = $k->[2] / $k->[1];
      $k->[0] = $xlo if ( $k->[0] < $xlo );
      $k->[0] = $xhi - $k->[3] if ( $k->[0] > $xhi - $k->[3] );
      last if ( @cl < 2 );
      my $p = $cl[-2];
      last if ( $p->[0] + $p->[3] <= $k->[0] );
      #<!-- merge k into p -->
      $p->[2] += $k->[2] - $k->[1] * $p->[3];
      $p->[1] += $k->[1];
      $p->[3] += $k->[3];
      $p->[5] += $k->[5];
      pop(@cl);
    }
  }
  #<!-- walk the clusters out into positions -->
  my @out = ();
  my $idx = 0;
  foreach my $k ( @cl ) {
    my $x = $k->[0];
    for ( my $n = 0 ; $n < $k->[5] ; $n++ ) {
      my $c = $order[$idx++];
      push(@out, [$c->[0], $x, $c->[1]]);
      $x += $c->[1];
    }
  }
  return (@out);
};

#<!-- Cost of putting this cell in this segment: the displacement it would
#     suffer, plus what it would cost the cells already there.  Trying every row
#     for every cell is the textbook Abacus and is too slow here, so the search
#     is a window of -rows either side of the cell's own row. -->
my %inSeg = ();        #<!-- "y,segIdx" => [ [inst,w,tx], ... ] -->
my %segFree = ();      #<!-- "y,segIdx" => remaining width -->

#<!-- tallest first: a double height cell has fewer rows that will take it, so
#     let it choose before the single height ones fill them -->
#<!-- @single, not @mov: anything taller than a row was placed above and is an
#     obstacle now, not a candidate. -->
my @byY = sort { $b->[2] <=> $a->[2] || $a->[3] <=> $b->[3] } @single;
my $noRoom = 0;
my ($movedRow, $movedRowSum, $movedRowMax) = (0, 0, 0);
my ($placed, $sumDisp, $maxDisp, $maxDispInst) = (0, 0, 0, "");
my $overLimit = 0;
my $limit = ( defined $maxDispUm ) ? $maxDispUm * $dbu : undef;
my @newLoc = ();

#<!-- THE WHOLE OF PASS 2, PACKAGED SO IT CAN BE RUN TWICE.
#
#     --pin_spread needs the pin density map of a LEGAL placement, and the only
#     way to get one is to legalize.  Measuring it on the placer's own output
#     does not work: that placement still overlaps, cells sit piled on top of
#     one another, and on nangate_flat the average cell moves 12.5um of an 85um
#     die climbing out of those piles.  The dense tiles there are the piles,
#     not the hotspots the router will meet.  Measured that way the padding did
#     relieve the map it was shown -- worst tile 111 pins to 102 -- and spent
#     10.5% of the wirelength doing it, which is not a trade worth making.
#
#     So pass 2 runs once to find out where the cells really go, the map is
#     built from that, the padding is worked out, and pass 2 runs again with
#     the padded widths.  Everything the pass mutates is reset in here rather
#     than at its declaration, so the second run starts where the first did.
#
#     The second run costs what the first did.  That is the whole price of the
#     option and it is only paid when the option is on. -->
#<!-- Dead segments, skipped rather than stepped over.
#
#     A segment with less free width than the narrowest single-height cell can
#     never take another cell, and the search below already rejects it for
#     every cell -- so jumping over it changes no answer.  What it changes is
#     the cost of a crowded region: on a tile whose blocks overlapped, cells
#     travelled 20um and more, and each of them walked across every full
#     segment between it and a gap.  Per row, nextLive/prevLive point at the
#     nearest segment that may still be live, path compressed as dead ones are
#     passed. -->
my (%nextLive, %prevLive);
my $minW;
my $liveR = sub {
  my ($nx, $s, $ns) = @_;
  my $r = $s;
  $r = $nx->[$r] while ( $r < $ns && $nx->[$r] != $r );
  while ( $s < $ns && $nx->[$s] != $s ) { my $t = $nx->[$s]; $nx->[$s] = $r; $s = $t; }
  return $r;
};
my $liveL = sub {
  my ($pv, $s) = @_;
  my $r = $s;
  $r = $pv->[$r] while ( $r >= 0 && $pv->[$r] != $r );
  while ( $s >= 0 && $pv->[$s] != $s ) { my $t = $pv->[$s]; $pv->[$s] = $r; $s = $t; }
  return $r;
};
my $killSeg = sub {
  my ($y, $s) = @_;
  $nextLive{$y}[$s] = $s + 1;
  $prevLive{$y}[$s] = $s - 1;
};
my $rowsAndAbacus = sub {
  %inSeg = ();
  %segFree = ();
  %binLoad = ();
  %nextLive = ();
  %prevLive = ();
  $minW = undef;
  foreach my $m ( @single ) {
    $minW = $m->[6] if ( ! defined $minW || $m->[6] < $minW );
  }
  $minW = 1 unless ( defined $minW && $minW > 0 );
  foreach my $y ( @rowY ) {
    my $ns = @{$seg{$y}};
    $nextLive{$y} = [ 0 .. $ns - 1 ];
    $prevLive{$y} = [ 0 .. $ns - 1 ];
    for ( my $s = 0 ; $s < $ns ; $s++ ) {
      $segFree{"$y,$s"} = $seg{$y}[$s][1] - $seg{$y}[$s][0];
      $inSeg{"$y,$s"} = [];
      $killSeg->($y, $s) if ( $segFree{"$y,$s"} < $minW );
    }
  }
  $noRoom = 0;
  ($movedRow, $movedRowSum, $movedRowMax) = (0, 0, 0);
  ($placed, $sumDisp, $maxDisp, $maxDispInst) = (0, 0, 0, "");
  $overLimit = 0;
  @newLoc = ();

  #<!-- the multi-row cells are already placed and do not move between the two
  #     runs, but they are part of the answer and part of the displacement, so
  #     every run starts by counting them in -->
  foreach my $n ( @multiLoc ) {
    push(@newLoc, [ @$n ]);
    my $disp = abs($n->[1] - $origX{$n->[0]}) + abs($n->[2] - $origY{$n->[0]});
    $sumDisp += $disp;
    if ( $disp > $maxDisp ) { $maxDisp = $disp; $maxDispInst = $n->[0]; }
    $overLimit++ if ( defined $limit && $disp > $limit );
    $placed++;
  }

foreach my $m ( @byY ) {
  #<!-- $w is the width everything below reserves, assigns and clusters on,
  #     and with --pin_spread that is the PADDED width: the cell asks the row
  #     for more space than it occupies and Abacus turns the difference into a
  #     gap.  The real width is never needed here -- the cell is written at the
  #     left edge of the slot it was given, so it cannot overlap whatever the
  #     padding kept away. -->
  my ($inst, $h, $tx, $ty) = ($m->[0], $m->[2], $m->[3], $m->[4]);
  my $w = $m->[6];
  #<!-- Nearest row index to the cell's y, by binary search.
  #
  #     This used to scan every row for every cell, which is O(cells x rows)
  #     -- and rows grow as the square root of cells on a squarish die, so the
  #     whole legalizer came out O(n^1.5).  Measured on the two MXUs: 1069 rows
  #     x 855k cells against 2138 x 3.42M is 8.01 times the work for four times
  #     the cells, and legalize_flat took 7.53 times as long.  That was the
  #     entire superlinearity; everything else here is linear.
  #
  #     @rowY is sorted, so the answer is a bisection.  Arithmetic would do it
  #     in O(1) for uniformly pitched rows, which is what set_floorplan and
  #     every LEF site in practice produce -- but a DEF may carry several ROW
  #     records with gaps between them, and a bisection does not care. -->
  my $best;
  {
    my ($lo, $hi) = (0, $nRows - 1);
    while ( $lo < $hi ) {
      my $mid = int( ($lo + $hi) / 2 );
      if ( $rowY[$mid] < $ty ) { $lo = $mid + 1; }
      else                     { $hi = $mid; }
    }
    #<!-- $lo is the first row at or above $ty; the one below may be nearer -->
    $best = $lo;
    if ( $lo > 0 && abs($rowY[$lo-1] - $ty) <= abs($rowY[$lo] - $ty) ) {
      $best = $lo - 1;
    }
  }
  #<!-- Two attempts: the first honours the local density cap, the second does
  #     not.  A cell whose bin is full in every row of the window has to go
  #     somewhere, and leaving it where it started -- overlapping -- is worse
  #     than putting it in a locally crowded row and letting Abacus slide it.
  #     So the cap is a preference with a guaranteed fallback, never a reason
  #     to fail.  $useCap == 0 is exactly the old behaviour, which is what
  #     --no_dbin selects for the whole run. -->
  my ($pickKey, $pickCost, $pickBin, $pickR);
  foreach my $useCap ( ($dbin > 0) ? (1, 0) : (0) ) {
  ($pickKey, $pickCost, $pickBin, $pickR) = (undef, undef, undef, undef);
  #<!-- the capped attempt looks only $dbinRows rows out; the fallback below
  #     uses the full -rows window, so the bound can never leave a cell
  #     unplaced -- it only limits how far the CAP is allowed to reach. -->
  my $win = ( $useCap ) ? ( ($dbinRows < $rowWin) ? $dbinRows : $rowWin ) : $rowWin;
  for ( my $d = 0 ; $d <= $win ; $d++ ) {
    foreach my $r ( ($best - $d), ($best + $d) ) {
      next if ( $d > 0 && $r == $best );
      next if ( $r < 0 || $r >= $nRows );
      my $y = $rowY[$r];
      #<!-- The segments of a row, nearest first, instead of every one of them.
      #
      #     This loop used to try every segment of every candidate row.  A row
      #     is one segment until something cuts it, so that cost nothing on any
      #     design it had met -- and on a tile with 1.33M double-height cells,
      #     each placed above as an obstacle, every row was ~500 segments and
      #     the 5.4M single-height cells spent hours here.
      #
      #     The segments are sorted and disjoint, so bisect to the first one
      #     ending right of $tx and walk out both ways while a segment could
      #     still win.  A segment to the right costs at least sx0 - tx, one to
      #     the left at least tx - (sx1 - w), and both bounds only grow outward.
      #
      #     The answer is the one the full scan gave, ties included: the scan
      #     kept the FIRST segment at the lowest cost, so on the right an equal
      #     cost never displaces the best (stop at >=) and on the left it does
      #     (stop only at >).  Checked byte for byte against the old scan. -->
      my $segs = $seg{$y};
      my $ns = @$segs;
      my $dy = abs($y - $ty);
      my ($lo2, $hi2) = (0, $ns);
      while ( $lo2 < $hi2 ) {
        my $mid = int( ($lo2 + $hi2) / 2 );
        if ( $segs->[$mid][1] > $tx ) { $hi2 = $mid; } else { $lo2 = $mid + 1; }
      }
      my ($rbCost, $rbS, $rbBi);
      my $tryS = sub {
        my ($s) = @_;
        my $k = "$y,$s";
        return if ( $segFree{$k} < $w );
        my ($sx0, $sx1) = @{$segs->[$s]};
        return if ( $sx1 - $sx0 < $w );
        #<!-- where in this segment it wants to be, and what that costs -->
        my $wx = $tx;
        $wx = $sx0 if ( $wx < $sx0 );
        $wx = $sx1 - $w if ( $wx > $sx1 - $w );
        #<!-- and whether the row is already full AT THAT X.  Charged to the
        #     bin holding the cell's left edge: a cell is narrow next to a
        #     column and splitting it across two bins buys nothing. -->
        my $bi;
        if ( $dbin > 0 ) {
          $bi = int( ($wx - $binX0) / $dbin );
          $bi = 0 if ( $bi < 0 );
          $bi = $nBins - 1 if ( $bi > $nBins - 1 );
          if ( $useCap ) {
            my $cap = $binCap{"$r,$bi"};
            return unless ( defined $cap );
            return if ( $binLoad{"$r,$bi"} + $w > $cap );
          }
        }
        my $cost = abs($wx - $tx) + $dy;
        if ( ! defined $rbCost || $cost < $rbCost || ( $cost == $rbCost && $s < $rbS ) ) {
          ($rbCost, $rbS, $rbBi) = ($cost, $s, $bi);
        }
      };
      my ($nxL, $pvL) = ( $nextLive{$y}, $prevLive{$y} );
      for ( my $s = $liveR->($nxL, $lo2, $ns) ; $s < $ns ; $s = $liveR->($nxL, $s + 1, $ns) ) {
        my $lb = ( $segs->[$s][0] > $tx ) ? $segs->[$s][0] - $tx + $dy : $dy;
        last if ( defined $rbCost && $lb >= $rbCost );
        last if ( defined $pickCost && $lb >= $pickCost );
        $tryS->($s);
      }
      for ( my $s = $liveL->($pvL, $lo2 - 1) ; $s >= 0 ; $s = $liveL->($pvL, $s - 1) ) {
        my $lb = $tx - ( $segs->[$s][1] - $w ) + $dy;
        last if ( defined $rbCost && $lb > $rbCost );
        last if ( defined $pickCost && $lb >= $pickCost );
        $tryS->($s);
      }
      if ( defined $rbCost && ( ! defined $pickCost || $rbCost < $pickCost ) ) {
        $pickCost = $rbCost;
        $pickKey = "$y,$rbS";
        $pickBin = ( defined $rbBi ) ? "$r,$rbBi" : undef;
        $pickR = $r;
      }
    }
    #<!-- Stop widening once no row further out could possibly win.
    #
    #     The cost is |wx - tx| + |y - ty|, so a row d steps away costs at
    #     least d * rowH in the y term alone.  Once the best cost found is no
    #     more than that, nothing further out can beat it and the search is
    #     provably done -- which is the same early exit, made correct.
    #
    #     It used to be "last if ( defined $pickKey && $d >= 1 )": stop as soon
    #     as ANYTHING was found at d >= 1.  That capped the search at three
    #     rows whatever -rows said, so the option was very nearly a no-op --
    #     the default of 6 promised thirteen rows and searched three. -->
    #<!-- The cost is |wx - tx| + |y - ty|, so a row d steps away costs at
    #     least d * rowH in the y term alone; once the best found is no more
    #     than that, nothing further out can beat it.  Still a valid bound with
    #     the cap on, because the cap only removes candidates -- it does not
    #     change what any surviving candidate costs. -->
    last if ( defined $pickCost && $pickCost <= ($d + 1) * $rowH );
  }
  last if ( defined $pickKey );
  }#foreach useCap

  unless ( defined $pickKey ) {
    $noRoom++;
    next;
  }
  push(@{$inSeg{$pickKey}}, [$inst, $w, $tx]);
  $segFree{$pickKey} -= $w;
  if ( $segFree{$pickKey} < $minW ) {
    my ($py, $ps) = split(/,/, $pickKey);
    $killSeg->($py, $ps);
  }
  $binLoad{$pickBin} += $w if ( defined $pickBin );
  #<!-- how many cells the cap pushed off their nearest row, and how far -->
  if ( defined $pickR && $pickR != $best ) {
    $movedRow++;
    my $off = abs($pickR - $best);
    $movedRowMax = $off if ( $off > $movedRowMax );
    $movedRowSum += $off;
  }
}

#--------------------------- solve and write back --------------------------#
$phaseDone->("assigning cells to row segments");
foreach my $y ( @rowY ) {
  for ( my $s = 0 ; $s < @{$seg{$y}} ; $s++ ) {
    my $k = "$y,$s";
    my $cells = $inSeg{$k};
    next unless ( @$cells );
    my ($sx0, $sx1) = @{$seg{$y}[$s]};
    my @sorted = sort { $a->[2] <=> $b->[2] } @$cells;
    my @out = $abacus->(\@sorted, $sx0, $sx1);

    #<!-- Put x on the site grid without giving the overlap back.  Snapping each
    #     cell independently can push it left into its neighbour, so the walk is
    #     left to right with a cursor: a cell goes to its own snapped position or
    #     to the first free site after the one before it, whichever is further
    #     right. -->
    my $cursor = $sx0;
    foreach my $o ( @out ) {
      my ($inst, $x, $w) = @$o;
      unless ( $noSnapX ) {
        my $n = int( ($x - $sx0) / $siteX + 0.5 );
        $x = $sx0 + $n * $siteX;
      }
      if ( $x < $cursor ) {
        my $n = int( ($cursor - $sx0) / $siteX );
        $n++ while ( $sx0 + $n * $siteX < $cursor );
        $x = $noSnapX ? $cursor : $sx0 + $n * $siteX;
      }
      if ( $x + $w > $sx1 ) { $x = $sx1 - $w; }
      $cursor = $x + $w;

      my $dx = abs($x - $origX{$inst});
      my $dy = abs($y - $origY{$inst});
      my $disp = $dx + $dy;
      $sumDisp += $disp;
      if ( $disp > $maxDisp ) { $maxDisp = $disp; $maxDispInst = $inst; }
      $overLimit++ if ( defined $limit && $disp > $limit );
      print "DBG-ALG-LEGAL : 017 : $inst -> $x $y (moved $disp dbu)\n" if ($debug);
      push(@newLoc, [$inst, $x, $y]);
      $placed++;
    }
  }
}
$phaseDone->("Abacus over the segments");
};#sub rowsAndAbacus

#<!-- Run it.  Without --pin_spread that is the whole of pass 2 and the only
#     call; with it, the first call is the provisional legalization the pin
#     density map is measured on and its locations are thrown away. -->
$rowsAndAbacus->();

if ( $doPinPad ) {
  #<!-- Keep the provisional answer.  It is a complete, legal placement, and if
  #     the padded run turns out to be a worse one it is what we fall back to --
  #     see the check after the second run. -->
  my @provLoc = map { [ @$_ ] } @newLoc;
  my $provNoRoom = $noRoom;
  my $provPlaced = $placed;
  my $provSum = $sumDisp;
  my $provMax = $maxDisp;
  my $provMaxInst = $maxDispInst;
  my $provOver = $overLimit;
  my ($provRow, $provRowSum, $provRowMax) = ($movedRow, $movedRowSum, $movedRowMax);

  my @prov = map { [ $_->[1], $_->[2], $cellW{$_->[0]}, $cellH{$_->[0]}, $pinN{$_->[0]} ] } @newLoc;
  my $map = $pinHist->(\@prov);

  #<!-- the target: an absolute count if one was given, otherwise the
  #     percentile of the OCCUPIED tiles.  Empty tiles are not in the map and
  #     must not be, or the percentile of a half empty die is zero and every
  #     occupied tile is over target. -->
  $pinT = int($pinTarget);
  if ( $pinT <= 0 ) {
    my (undef, $pctlV, undef, undef) = $pinStats->($map, 0);
    $pinT = $pctlV;
  }
  $pinT = 1 if ( $pinT < 1 );

  my ($bMax, $bPctl, $bOcc, $bOver) = $pinStats->($map, $pinT);
  printf("INFO-ALG-LEGAL : 044 : pin density: %d occupied tile(s) of %.2f um, worst %d pin(s), p%d %d, target %d, %d over\n",
         $bOcc, $pinTile / $dbu, $bMax, $pinPctl, $bPctl, $pinT, $bOver);

  my ($nPad, $padSum, $padWorst) = (0, 0, 0);
  foreach my $n ( @newLoc ) {
    my $inst = $n->[0];
    next unless ( $pinN{$inst} > 0 );
    #<!-- a multi-row cell counts towards the map -- its pins are as real as
    #     anyone's -- but cannot be padded: padding buys its gap from Abacus,
    #     and these were placed as obstacles before Abacus ran -->
    next if ( $isMulti{$inst} );
    my $bx = int( ($n->[1] + $cellW{$inst}/2 - $die[0]) / $pinTile );
    my $by = int( ($n->[2] + $cellH{$inst}/2 - $die[1]) / $pinTile );
    $bx = 0 if ( $bx < 0 ); $bx = $pinNX - 1 if ( $bx >= $pinNX );
    $by = 0 if ( $by < 0 ); $by = $pinNY - 1 if ( $by >= $pinNY );
    my $p = $map->{"$bx,$by"};
    next unless ( defined $p && $p > $pinT );

    #<!-- the inflation that would take this tile to the target -->
    my $w = $cellW{$inst};
    my $pad = int( $w * ( $p / $pinT - 1 ) + 0.5 );
    my $cap = int( ($pinMaxRatio - 1) * $w );
    $pad = $cap if ( $pad > $cap );
    next if ( $pad <= 0 );
    #<!-- whole sites, or the site snapping at the end of the pass rounds the
    #     gap away again on the narrow cells that most need it -->
    unless ( $noSnapX ) {
      $pad = int( ($pad + $siteX - 1) / $siteX ) * $siteX;
    }
    $padOf{$inst} = $w + $pad;
    $nPad++;
    $padSum += $pad;
    $padWorst = $pad if ( $pad > $padWorst );
  }
  printf("INFO-ALG-LEGAL : 045 : padded %d of %d cell(s), average %.3f um, worst %.3f um\n",
         $nPad, scalar(@mov), ($nPad > 0) ? ($padSum / $nPad) / $dbu : 0, $padWorst / $dbu);

  #<!-- Padding is width the rows have to find.  If it asks for more than they
  #     hold, the second pass cannot place everything and will say so; saying
  #     it here too is cheaper to act on than a WARN 013 at the far end. -->
  my $needW = 0;
  my $haveW = 0;
  foreach my $m ( @mov ) {
    $needW += ( exists $padOf{$m->[0]} ) ? $padOf{$m->[0]} : $m->[1];
  }
  foreach my $y ( @rowY ) { $haveW += $rowX1{$y} - $rowX0{$y}; }
  if ( $haveW > 0 && $needW > $haveW ) {
    printf("WARN-ALG-LEGAL : 046 : padded width is %.1f%% of the row width; lower -pin_max or raise -pin_pctl\n",
           100 * $needW / $haveW);
  }

  #<!-- and legalize again, this time with the padding in the widths -->
  foreach my $m ( @mov ) {
    $m->[6] = ( exists $padOf{$m->[0]} ) ? $padOf{$m->[0]} : $m->[1];
  }
  $rowsAndAbacus->();

  #<!-- PADDING MUST NOT COST LEGALITY, and left to itself it can.
  #
  #     Padding is width the rows have to find, and a row that cannot find it
  #     leaves cells unplaced -- and an unplaced cell keeps the location the
  #     placer gave it, which is the overlapping one this command exists to
  #     remove.  Measured on nangate_flat at -pin_pctl 70: 2183 cells padded,
  #     39 of them found no row inside the window, and an independent integer
  #     sweep over the written DEF then reported 449 overlaps where every other
  #     setting reports zero.
  #
  #     The global width check above does not catch it, and cannot: the design
  #     still fits by total width, it is the rows around the hotspots that
  #     overflow.  So the test is the direct one -- did padding leave more
  #     cells homeless than not padding did -- and the answer is the pass's own
  #     provisional placement, which is legal by construction.
  #
  #     Falling back whole rather than per cell is deliberate.  The cells that
  #     failed are not independent of the ones that succeeded; they lost the
  #     rows they wanted to padded neighbours, so keeping the padded placement
  #     and rescuing the stragglers would mean placing them into a layout that
  #     has no room for them. -->
  if ( $noRoom > $provNoRoom ) {
    printf("WARN-ALG-LEGAL : 048 : padding left %d cell(s) with no row against %d without it;\n",
           $noRoom, $provNoRoom);
    print "WARN-ALG-LEGAL : 049 : keeping the unpadded placement.  Raise -pin_pctl, lower -pin_max,\n";
    print "WARN-ALG-LEGAL : 050 : or raise -rows so the padded cells have somewhere to go\n";
    @newLoc = @provLoc;
    $noRoom = $provNoRoom;
    $placed = $provPlaced;
    $sumDisp = $provSum;
    $maxDisp = $provMax;
    $maxDispInst = $provMaxInst;
    $overLimit = $provOver;
    ($movedRow, $movedRowSum, $movedRowMax) = ($provRow, $provRowSum, $provRowMax);
    $doPinPad = 0;          #<!-- so the "after" report below is not a lie -->
  }
}

if ( $noRoom > 0 ) {
  print "WARN-ALG-LEGAL : 013 : $noRoom cell(s) found no row with room within $rowWin row(s)\n";
  print "WARN-ALG-LEGAL : 014 : they keep their current location.  Raise -rows, try --spread,\n";
  print "WARN-ALG-LEGAL : 035 : or the design does not fit\n";
}
my $avg = ( $placed > 0 ) ? $sumDisp / $placed : 0;
#<!-- what this run did, for a caller collecting metrics (hier_place_all) -->
%LEGAL_STATS = ( mode => "full", cells => $nMov, placed => $placed,
                 mean_move_um => $avg / $dbu, worst_move_um => $maxDisp / $dbu,
                 no_room => $noRoom, multi_row => $tooTall, multi_no_room => $multiNoRoom,
                 moved_row => $movedRow, rows => $nRows );
printf("INFO-ALG-LEGAL : 018 : legalized %d cell(s), average move %.3f um, worst %.3f um%s\n",
       $placed, $avg / $dbu, $maxDisp / $dbu,
       ( $maxDispInst ne "" ) ? " on $maxDispInst" : "");
if ( defined $limit && $overLimit > 0 ) {
  printf("WARN-ALG-LEGAL : 019 : %d cell(s) moved further than %g um\n", $overLimit, $maxDispUm);
}
if ( $movedRow > 0 ) {
  printf("INFO-ALG-LEGAL : 041 : %d cell(s) took a row other than their nearest, %.2f rows on average, %d at most\n",
         $movedRow, $movedRowSum / $movedRow, $movedRowMax);
}

#<!-- What the padding actually bought, measured on the legalized locations
#     rather than on the intent.  The target is held at the one pass 1b
#     derived, so the two numbers are comparable; recomputing the percentile
#     here would move the goalposts with the result. -->
if ( $doPinPad ) {
  my @after = map { [ $_->[1], $_->[2], $cellW{$_->[0]}, $cellH{$_->[0]}, $pinN{$_->[0]} ] } @newLoc;
  my ($aMax, $aPctl, $aOcc, $aOver) = $pinStats->($pinHist->(\@after), $pinT);
  printf("INFO-ALG-LEGAL : 047 : pin density after: %d occupied tile(s), worst %d pin(s), p%d %d, %d over target %d\n",
         $aOcc, $aMax, $pinPctl, $aPctl, $aOver, $pinT);
}

if ( $reportOnly ) {
  print "INFO-ALG-LEGAL : 020 : --report_only given, nothing was changed\n";
  my $t1 = new Benchmark;
  print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";
  return;
}

$writeBack->(\@newLoc);

my $t1 = new Benchmark;
print "Command legalize_flat took:",timestr(timediff($t1,$t0)),"\n";

}# sub legalize_flat

1;
