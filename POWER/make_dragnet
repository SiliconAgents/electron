sub create_hier_list {
  my $moduleName = $_[0];
  my $hier = $_[1];
  my $indent = $_[2];
  my $level = $_[3];

  if(exists $MODULE_ALREADY{$moduleName} ) {
     my @conns = $MODULE_ALREADY{$moduleName}->dbVNOMGetConn;
     foreach my $connLine (@conns){
        $connLine =~ s/\(/\)\,/;
        $connLine =~ s/\s*\)\s*\)\s*\;+.*$/\)/;
        my ($cell,$inst) = ( split(/\s+/, $connLine ))[0,1];
        if(exists $PLDB{$cell}) {
           my @nets = split(/\s*\)\s*\,\s*/, $connLine);
           my $noOfPins = @nets;
           for(my $i = 1 ; $i < $noOfPins ; $i++){
              $nets[$i] =~ s/\s*\(\s*/\|/;
              if( $i == ($noOfPins -1)){
                $nets[$i] =~ s/\s*\)\s*//;
              }
              my ($pin,$net)=(split(/\s*\|\s*/, $nets[$i]))[0,1];
              $pin =~ s/\.//;
              if(($cell !~ /u_PAD_/ && $cell !~ /u_VDD/ && $cell !~ /u_POC_/ && $cell !~ /u_TM_ANA_/ && $net =~ /VDD/ && $pin =~ /VDD/) ||
                ($net =~ /VSS/ && $pin =~ /VDDL/) || # Exception - allow VSS to show up on VDDL in some cases (like spares).  Handle spares in dragnet.
                ($net =~ /VSS/ && $pin =~ /VDDH/) || # Exception - allow VSS to show up on VDDH in some cases (like spares).  Handle spares in dragnet.
#	        ($pin =~ /VBP/ || $pin =~ /V[NP]W/) ||    # TODO FIXME later - devices will have multiple power pins AND these bulk pins
#	        ($cell =~ /inno_usb_phy/ && $net =~ /VCC/ && $pin =~ /VCC/) ||  # Skip VCCA3P3 for now
	        ($cell =~ /inno_usb_phy/ && $net =~ /VCC/ && $pin =~ /VCCCORE/) ||
                ($cell =~ /u_PAD_/       && $net =~ /VDD/ && $pin =~ /VDDL/) ||
                ($cell =~ /u_VDD/        && $net =~ /VDD/ && $pin eq "VDD") ||
                ($cell =~ /u_POC_/       && $net =~ /VDD/ && $pin eq "VDD") ||
                ($cell =~ /u_TM_ANA_/    && $net =~ /VDD/ && $pin eq "VDD") ||
	        ($cell =~ /analog_top/   && $net =~ /VDD/ && $pin =~ /vdd/) ||
                ($cell =~ /u_xO32M/ && (($net =~ /VDD/ && $pin =~ /VDD/) || ($net =~ /vdd/ && $pin =~ /vdd/)))) {

                 my $hierInst = $hier."/".$inst; 
                 $hierInst =~ s/\s//g;
                 $hierInst =~ s/\\//g;
                 $hierInst =~ s/^\///;

                 #print "LVL: $level  $indent ModuleName=$cell HierInstName=$hierInst\n";
                 #print "LVL: $level $indent  $inst  PinName=$pin  NetName=$net\n";

                 if(!exists $inst_list{$hierInst}{"mod"}){
                    $inst_list{$hierInst}{"mod"}  = $cell;
                 }  

                 if(!exists $inst_list{$hierInst}{"pin1"} && !exists $inst_list{$hierInst}{"net1"}){
	            $inst_list{$hierInst}{"pin1"} = $pin;
	            $inst_list{$hierInst}{"net1"} = $net;
                 }else{
                    if(!exists $inst_list{$hierInst}{"pin2"} && !exists $inst_list{$hierInst}{"net2"}){
	               $inst_list{$hierInst}{"pin2"} = $pin;
	               $inst_list{$hierInst}{"net2"} = $net;
                    }else{
                       # Assume that this is a non-leaf cell so it may have many power pins
		       #write_log("NOT_A_LEAF","Warning: Not a leaf cell - more than 2 power pins/nets specified prior to instance $hierIinst:");
                    } 
                 } 
              }
           }#for
        }else {
           $level = $level + 1;
           &create_hier_list($cell, $hier."/".$inst, $indent.'   ', $level);
           $level = $level - 1;
        } 
     }#foreach
  }#if

}#sub create_hier_list

# Accessor function for digging into %inst_list and doing error reporting/handling
sub get_inst {
    my ($i, $k) = @_;
    my $v = "";
    if(defined($inst_list{$i})) {
	if(defined($inst_list{$i}{$k})) {
	    $v = $inst_list{$i}{$k};
	} elsif ($k =~ m/1/ || $k =~ m/mod/) {
	    write_log("NO_INST", "Error: Instance lookup - No matching $k found for $i\n");
	}
    } else {
	write_log("NO_INST", "Error: Instance lookup - No matching leaf instance found for net $i ($k attribute)\n");
    }

    return $v;
}

