# Use regex to tear apart library list and apply only input oxide type to matching cell types
sub load_lib_exception {
    my $lib_fn = shift;
    my $oxin   = shift;
    my $v      = shift;
    my $regex  = shift;

    my @lines = split(/\n/, $lib_fn);
    foreach my $line (@lines) {
	if($line =~ /$regex/) {
	    chomp($line);
	    if(defined($libs{$line})) {
                write_log("DUP_MODULE", "Error: Collision when loading libs: $line already defined as ($libs{$line}{'oxin'}, $libs{$line}{'v'}).  Redefining as ($oxin, $v) per $lib_fn.\n");
	    } 
	    $libs{"$line"}{"oxin"} = $oxin;
	    $libs{"$line"}{"v"}    = $v;
	}
    }
    close ($lib_fh);
}
    
# Read in library and store in %libs, populating each cell with the input oxide type provided
sub load_lib {
    my $lib_fn = shift;
    my $oxin   = shift;
    my $v      = shift;

    load_lib_exception($lib_fn, $oxin, $v, ".");  # Always match
}

# Accessor function for digging into %libs and doing error reporting/handling
sub get_lib_cell {
    my ($i, $k) = @_;
    my $v = "";
    if(defined($libs{$i})) {
	if(defined($libs{$i}{$k})) {
	    $v = $libs{$i}{$k};
	} else {
	    write_log("MISSING_CELL", "Error: Library lookup - No matching $k found for $i\n");
	}
    } else {
	write_log("MISSING_CELL", "Error: Library lookup - No matching cell found for $i\n");
    }

    return $v;
}

