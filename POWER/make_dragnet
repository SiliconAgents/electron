     # Unable to determine switch in u_digital_top/u_ps_switch_aoc/lsr_AOH_AOC_PD_DTCM_GP0_1_C_PG_n
                 $which_switch = $1 . "_" . $2 . "_" . $3 . "_" . $4;
             } else {
