# For macros (BLE, analog, pads), copy domain from CPF rules
sub fixup_bad_domain {
    my $inst    = shift;
    my $pin     = shift;
    my $orig_pd = shift;
    my $pd   = "";

    if($inst =~ /^u_analog_top/) {
        if($pin =~ /^a2d.*vddc$/) {
            $pd = "PD_AOR";
        } elsif($pin =~ /^a2d.*vddadc[\[\]\d]*$/) {
            $pd = "PD_ADC";
        } elsif($pin =~ /^a2d.*vddaudadc[\[\]\d]*$/ ||
                $pin =~ /^a2d.*vddadcaud[\[\]\d]*$/ ||
                $pin =~ /^a2d.*vddaud[\[\]\d]*$/) {
            $pd = "PD_AUDADC";
        } elsif(($pin =~ /^a2d.*vddh$/) ||
                ($pin =~ /^a2d.*gox$/) ||
                ($pin =~ /^as_PAD.*/) ||
                ($pin =~ /^as_digpwrsw.*/) ||
                ($pin =~ /^ANA_PAD.*/)) {
            $pd = "PD_AOH";
        } elsif($pin =~ /^a2d.*vddf$/) {
            $pd = "PD_AOC";
        } else {
            # default
            $pd = "PD_AOH";
        }
    }
    
    #if($inst =~ /^u_pad_top/) {
    #    $pd = "PD_AOH";
    #}

    if($pd eq "") {
        $pd = $orig_pd;
    }

    return($pd);
}
