             }
     
     #        write_log("DEBUG", "ps_lsr_inst $ps_lsr_inst  which_switch $which_switch\n");
             
             $checked = 0;
     #        print "Searching for $which_switch insensitively in power switch list\n";
             foreach $ps_inst (sort keys(%ps_list)) {
     #            print "  ps_inst = $ps_inst\n";
