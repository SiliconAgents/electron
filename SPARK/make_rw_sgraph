
sub write_sgraph {
 use Benchmark;
 my $t0 = new Benchmark;
 my $noOfArguments = @_;
 if($noOfArguments < 0 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP"){ 
    print "Usage : write_sgraph\n";
    print "        -output <output file name (default value is TOP.sgraph)\n";
    print "\n";
    print "The timing graph of the data network: one row per driver pin to sink\n";
    print "pin connection, with the clock and scan pins of sequential cells cut,\n";
    print "so paths start at a Q and end at a D.  Fourteen fields, always:\n";
    print "\n";
    print "  NETS <net> <drvInst> <drvCellref> <drvPin> <status> <x> <y> \\\n";
    print "             <sinkInst> <sinkCellref> <sinkPin> <status> <x> <y>\n";
    print "\n";
    print "status is PLACED, FIXED, UNPLACED or PORT; an unplaced object has\n";
    print "UND UND for its location, and a PORT reports one whether or not it\n";
    print "was ever placed, because PortDB defaults to (0,0).\n";  
 }else {
    my $outFile = $TOP_MODULE.".sgraph";
    for(my $i=0; $i<$noOfArguments; $i++){
        if($_[$i] =~ /-output/){$outFile = $_[$i+1];}
    }#for

    print "Writing graph connectivity for $TOP_MODULE\n";
    open(WRITE,">$outFile");

    if(exists $DIE_ALREADY{dieArea} ) {
       my @die_coords = @{$DIE_ALREADY{dieArea}};
       print WRITE "DIEAREA @die_coords \n";
    }

    #------------------------------------------------NETS SECTION---------------------------------------------#
    foreach my $net (keys %NETS_ALREADY){
      if(exists $NADB{$net}){
         my $netType = $NADB{$net}->dbNadbGetNetType;
         if($netType == 0){
            my @driverInst = &getNetDriver($net);
            my @sinkInst = &getNetSink($net);
            if(@driverInst > 1){
               my $drv = $driverInst[0];
	       my $drvPin = $driverInst[1];
               my $drvCellref = "PIN";
               #<!-- Status and location are ALWAYS emitted, so every row has
               #     the same number of fields.  They did not used to be:
               #     "@drvLoc" interpolates to nothing when a location was
               #     never set, so a row was 12 fields placed, 8 unplaced, and
               #     10 when one end was a port -- a port gets (0,0) from
               #     dbPortGetLoc while an unplaced instance gets nothing.  A
               #     reader keyed on the field count then drops the odd width
               #     silently; it cost 12,138 rows and every output port as a
               #     timing endpoint before anyone noticed. -->
               my $drvStatus = "UNPLACED";
               my @drvLoc = ("UND","UND");
               if(exists $COMP_ALREADY{$drv}){
                  $drvCellref = $CADB{$drv}->dbCadbGetCellref;
		  if(exists $PLDB{$drvCellref}){
		     my $cellFunc = $PLDB{$drvCellref}->dbMdbGetFunction;
	             if($cellFunc eq "flop" || $cellFunc eq "latch"){
		        my $isClock = $PLDB{$drvCellref}->dbMdbGetPinIsClock($drvPin);
		        if($isClock == 1 || $drvPin eq "SI" || $drvPin eq "SE"){
		           next;
		        }
		     }
		  }
                  $drvStatus = $CADB{$drv}->dbCadbGetStatus;
                  $drvStatus = "UNPLACED" if ( !defined $drvStatus || $drvStatus eq "" );
                  #<!-- Take the location only if there actually IS one.  The
                  #     status reads PLACED on a design that was elaborated and
                  #     never placed, and dbCadbGetLoc then returns an EMPTY
                  #     list -- assigned straight into @drvLoc that wipes the
                  #     UND UND default and the row goes narrow again, which is
                  #     the very thing this is here to stop. -->
                  my @l = $CADB{$drv}->dbCadbGetLoc;
                  if ( @l >= 2 && defined $l[0] && defined $l[1] ) { @drvLoc = @l[0,1]; }
                  else { $drvStatus = "UNPLACED"; }
               }elsif(exists $PORTS_ALREADY{$TOP_MODULE}{$drv}){
                  #<!-- PORT rather than PLACED: PortDB::new defaults to (0,0),
                  #     so a port reports a location whether or not anyone
                  #     placed it, and a reader should know not to trust it. -->
                  $drvStatus = "PORT";
                  @drvLoc = $PORTS_ALREADY{$TOP_MODULE}{$drv}->dbPortGetLoc;
               }    
               for(my $i=0; $i<$#sinkInst; $i=$i+2){
                   my $sink = $sinkInst[$i];
		   my $sinkPin = $sinkInst[$i+1];
                   my $sinkCellref = "PIN";
                   my $sinkStatus = "UNPLACED";
                   my @sinkLoc = ("UND","UND");
                   if(exists $COMP_ALREADY{$sink}){
                      $sinkCellref = $CADB{$sink}->dbCadbGetCellref;
		      if(exists $PLDB{$sinkCellref}){
		         my $cellFunc = $PLDB{$sinkCellref}->dbMdbGetFunction;
			 if($cellFunc eq "flop" || $cellFunc eq "latch"){
			    my $isClock = $PLDB{$sinkCellref}->dbMdbGetPinIsClock($sinkPin);
			    if($isClock == 1 || $sinkPin eq "SI" || $sinkPin eq "SE"){
			       next;
			    }
			 }
		      }
                      $sinkStatus = $CADB{$sink}->dbCadbGetStatus;
                      $sinkStatus = "UNPLACED" if ( !defined $sinkStatus || $sinkStatus eq "" );
                      my @sl = $CADB{$sink}->dbCadbGetLoc;
                      if ( @sl >= 2 && defined $sl[0] && defined $sl[1] ) { @sinkLoc = @sl[0,1]; }
                      else { $sinkStatus = "UNPLACED"; }
                   }elsif(exists $PORTS_ALREADY{$TOP_MODULE}{$sink}){
                      $sinkStatus = "PORT";
                      @sinkLoc = $PORTS_ALREADY{$TOP_MODULE}{$sink}->dbPortGetLoc;
                   }    
                   print WRITE "NETS $net $drv $drvCellref $drvPin $drvStatus @drvLoc $sink $sinkCellref $sinkPin $sinkStatus @sinkLoc\n"; 
                   #print "NETS $net drv:$drv sink:$sink\n"; 
               }
            }
         }
      }
    }
    close(WRITE);
    my $t1 = new Benchmark;
    my $td = timediff($t1, $t0);
    print "Command write_sgraph took:",timestr($td),"\n";
 }
}#write_sgraph 

#------------------------------------------------------------------------------------------------#
1;
