
sub write_sgraph {
 use Benchmark;
 my $t0 = new Benchmark;
 my $noOfArguments = @_;
 if($noOfArguments < 0 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP"){ 
    print "Usage : write_sgraph\n";
    print "        -output <output file name (default value is TOP.sgraph)\n";
    print "\n";
    print "The timing graph of the data network: one row per driver pin to sink\n";
    print "pin connection, with the clock and scan pins of sequential cells cut,\n";
    print "so paths start at a Q and end at a D.  Fourteen fields, always:\n";
    print "\n";
    print "  NETS <net> <drvInst> <drvCellref> <drvPin> <status> <x> <y> \\\n";
    print "             <sinkInst> <sinkCellref> <sinkPin> <status> <x> <y>\n";
    print "\n";
    print "status is PLACED, FIXED, UNPLACED or PORT; an unplaced object has\n";
    print "UND UND for its location, and a PORT reports one whether or not it\n";
    print "was ever placed, because PortDB defaults to (0,0).\n";
    print "\n";
    print "Header lines before the rows: DIEAREA <x0 y0 x1 y1> and DBU <per micron>,\n";
    print "the unit of every coordinate.  After the rows, the physical section,\n";
    print "for a reader that places cells (all DBU):\n";
    print "  ROWH <h>  SITE <w>  ROW <y> <x0> <x1> <orient>   the row grid\n";
    print "  CELLS <n> library                               the CELL lines that follow\n";
    print "                                                  are every cell in the LEF\n";
    print "  CELL <cellref> <w> <h> <class>                  each one's size\n";
    print "  INST <inst> <cellref> <status> <x> <y>          placed instances on no\n";
    print "                                                  NETS row (they take room)\n";
    print "  BLOCKAGE <x0> <y0> <x1> <y1>                    a macro's halo (set_macro_halo):\n";
    print "                                                  no cell goes there\n";
 }else {
    my $outFile = $TOP_MODULE.".sgraph";
    for(my $i=0; $i<$noOfArguments; $i++){
        if($_[$i] =~ /-output/){$outFile = $_[$i+1];}
    }#for

    print "Writing graph connectivity for $TOP_MODULE\n";
    open(WRITE,">$outFile");

    if(exists $DIE_ALREADY{dieArea} ) {
       my @die_coords = @{$DIE_ALREADY{dieArea}};
       print WRITE "DIEAREA @die_coords \n";
    }
    #<!-- the coordinates' unit: DBU per micron, from GLOBAL (authoritative --
    #     $DEF_DATABASE_UNIT is overwritten mid-session).  Without it a reader
    #     turning locations into wire lengths had to be told the DBU by hand.
    #     "DBU <n>" as pyspark_cad's nodefile headers spell it; readers take
    #     only NETS rows and skip it. -->
    my $dbu = $GLOBAL->dbfGlobalGetDBU;
    print WRITE "DBU $dbu\n" if ( defined $dbu && $dbu ne "" && $dbu > 0 );

    #<!-- WHY THIS DOES NOT CALL getNetSink
    #
    #     getNetSink rediscovers, for every instance on a net, which of its
    #     pins is the one connected: it fetches the cell's ENTIRE pin list
    #     from PLDB and scans it comparing each pin's net to this one.  That
    #     is four passes on a 4-input gate and six on a flop, to recover
    #     something %NETS_ALREADY already holds directly -- and it calls
    #     getNetDriver again on the way in, so the driver scan runs twice per
    #     net.  Walking %NETS_ALREADY here instead is the same answer without
    #     any of that.
    #
    #     The per-cellref facts are memoised.  dbMdbGetFunction and
    #     dbMdbGetPinIsClock depend only on (cellref, pin), and a real design
    #     has 400 to 800 distinct cellrefs against sixteen million edges, so
    #     those were tens of millions of method dispatches for a few hundred
    #     distinct answers.  Likewise an instance's cellref, status and
    #     location: average fanout is about three, so each was fetched three
    #     times.
    #
    #     Measured before this: 18us per edge, flat across four designs from
    #     4M to 17M edges -- per-edge overhead, not anything algorithmic. -->
    my %cutPin   = ();   # cellref -> pin -> 1 when it is a clock or scan pin
    my %instInfo = ();   # inst    -> [cellref, status, x, y]
    my %onRow    = ();   # inst    -> 1 once it is on a NETS row

    #<!-- A clock or scan pin of a sequential cell is where a timing segment
    #     ends; everything else on the cell is data. -->
    my $isCut = sub {
        my ($ref, $pin) = @_;
        my $c = $cutPin{$ref};
        unless ( defined $c ) {
            $c = $cutPin{$ref} = {};
            if ( exists $PLDB{$ref} ) {
                my $f = $PLDB{$ref}->dbMdbGetFunction;
                if ( defined $f && ($f eq "flop" || $f eq "latch") ) {
                    foreach my $pn ( $PLDB{$ref}->dbMdbGetPins ) {
                        $c->{$pn} = 1 if ( $PLDB{$ref}->dbMdbGetPinIsClock($pn) );
                    }
                    $c->{SI} = 1; $c->{SE} = 1;
                }
            }
        }
        return $c->{$pin};
    };

    #<!-- cellref, status and location for one object, looked up once. -->
    my $info = sub {
        my ($o) = @_;
        my $i = $instInfo{$o};
        return $i if ( defined $i );
        if ( exists $COMP_ALREADY{$o} ) {
            my $ref = $CADB{$o}->dbCadbGetCellref;
            my $st  = $CADB{$o}->dbCadbGetStatus;
            $st = "UNPLACED" if ( !defined $st || $st eq "" );
            my @l = $CADB{$o}->dbCadbGetLoc;
            if ( @l >= 2 && defined $l[0] && defined $l[1] ) { $i = [$ref, $st, $l[0], $l[1]]; }
            else { $i = [$ref, "UNPLACED", "UND", "UND"]; }
        }
        elsif ( exists $PORTS_ALREADY{$TOP_MODULE}{$o} ) {
            #<!-- PORT, not PLACED: PortDB::new defaults to (0,0) so a port
            #     reports a location whether or not anyone placed it. -->
            my @l = $PORTS_ALREADY{$TOP_MODULE}{$o}->dbPortGetLoc;
            $i = ["PIN", "PORT", (@l >= 2 ? ($l[0], $l[1]) : ("UND","UND"))];
        }
        else { $i = ["PIN", "UNPLACED", "UND", "UND"]; }
        return $instInfo{$o} = $i;
    };

    #<!-- Rows are accumulated and written in blocks.  One interpolated print
    #     per edge is sixteen million syscall-ish round trips on a big
    #     design. -->
    my @buf = ();

    #------------------------------------------------NETS SECTION---------------------------------------------#
    foreach my $net (keys %NETS_ALREADY){
      #<!-- A net with no %NADB entry is a signal net, not a net to skip.
      #     %NADB is only what read_def or the flat placer recorded about a
      #     net -- its type among them -- and after hier_place_all it holds
      #     none of them, so this used to write the die area and not one edge:
      #     the graph of every hierarchically placed design was empty. -->
      {
         my $netType = exists $NADB{$net} ? $NADB{$net}->dbNadbGetNetType : 0;
         if($netType == 0){
            my @driverInst = &getNetDriver($net);
            if(@driverInst > 1){
               my $drv    = $driverInst[0];
               my $drvPin = $driverInst[1];
               my $di = $info->($drv);
               next if ( &$isCut($di->[0], $drvPin) );

               my $head = "NETS $net $drv $di->[0] $drvPin $di->[1] $di->[2] $di->[3]";
               my $n0 = @buf;

               #<!-- %NETS_ALREADY{$net} lists the objects on the net, and
               #     %COMP_ALREADY{$inst} is that instance's own pin -> net
               #     map.  Scanning the instance's map rather than the cell's
               #     pin list from PLDB keeps the one case that matters --
               #     an instance with TWO pins on the same net is two sinks --
               #     without the cellref lookup and the pin-list fetch per
               #     pin that getNetSink does.
               #
               #     %NETS_ALREADY{$net}{$inst} alone is not enough: it holds
               #     ONE pin per instance, and nothing usable for a port.
               #     Using it dropped every "flop Q -> output port" edge and
               #     invented a self-edge on every input port. -->
               foreach my $sink ( keys %{$NETS_ALREADY{$net}} ) {
                   if ( exists $COMP_ALREADY{$sink} ) {
                       my $si = $info->($sink);
                       my $pins = $COMP_ALREADY{$sink};
                       foreach my $sinkPin ( keys %$pins ) {
                           next unless ( defined $pins->{$sinkPin} && $pins->{$sinkPin} eq $net );
                           next if ( $sink eq $drv && $sinkPin eq $drvPin );
                           next if ( &$isCut($si->[0], $sinkPin) );
                           push(@buf, "$head $sink $si->[0] $sinkPin $si->[1] $si->[2] $si->[3]\n");
                           $onRow{$sink} = 1;
                       }
                   }
                   elsif ( exists $PORTS_ALREADY{$TOP_MODULE}{$sink} ) {
                       #<!-- A port's pin is itself; it cannot be its own sink -->
                       next if ( $sink eq $drv );
                       my $si = $info->($sink);
                       push(@buf, "$head $sink $si->[0] PIN $si->[1] $si->[2] $si->[3]\n");
                   }
               }
               $onRow{$drv} = 1 if ( @buf > $n0 );
               if ( @buf > 20000 ) { print WRITE @buf; @buf = (); }
            }
         }
      }
    }
    print WRITE @buf if ( @buf );
    @buf = ();

    #<!-- THE PHYSICAL SECTION.  What a reader needs to put a cell somewhere
    #     legal: the row grid (FreeRows::flatRows, as legalize_flat reads it),
    #     the size of every cell in the LEF -- not only the ones placed: a
    #     resize picks cells the design does not use yet, and a drive strength
    #     can be two rows tall where its neighbour in the class is one, which
    #     no area figure reveals -- and the placed instances no NETS row
    #     mentions (tap cells, a cell with only clock pins connected), which
    #     still take room.  Readers of the graph skip these lines. -->
    my $rows = FreeRows::flatRows();
    if ( $rows ) {
        push(@buf, "ROWH $rows->{rowH}\n", "SITE $rows->{siteX}\n");
        push(@buf, "ROW $_ $rows->{X0}{$_} $rows->{X1}{$_} $rows->{O}{$_}\n") foreach ( @{$rows->{Y}} );
        #<!-- set_macro_halo: the same boxes legalize_flat holds -->
        my @halo = &dbfMacroHaloBoxes;
        push(@buf, "BLOCKAGE @$_\n") foreach ( @halo );
        print "INFO-SPK-WR_SG : 001 : " . scalar(@halo) . " macro halo(s) written as BLOCKAGE\n" if ( @halo );
    }
    my %refs = map { $_ => 1 } keys %PLDB;
    foreach my $o ( keys %COMP_ALREADY ) {
        next if ( exists $onRow{$o} || !exists $CADB{$o} );
        my $st = $CADB{$o}->dbCadbGetStatus;
        next unless ( defined $st && ( $st eq "PLACED" || $st eq "FIXED" ) );
        my @l = $CADB{$o}->dbCadbGetLoc;
        next unless ( @l >= 2 && defined $l[0] && defined $l[1] );
        my $ref = $CADB{$o}->dbCadbGetCellref;
        push(@buf, "INST $o $ref $st $l[0] $l[1]\n");
        $refs{$ref} = 1;
    }
    my @cells = grep { exists $PLDB{$_} && scalar(my @s = $PLDB{$_}->dbMdbGetSize) >= 2 } sort keys %refs;
    printf WRITE ("CELLS %d library\n", scalar(@cells));
    foreach my $ref ( @cells ) {
        my @s = $PLDB{$ref}->dbMdbGetSize;
        my $class = $PLDB{$ref}->dbMdbGetClass;
        $class = "UNKNOWN" unless ( defined $class && $class ne "" );
        $class =~ s/\s+/_/g;
        printf WRITE ("CELL %s %d %d %s\n", $ref, int($s[0] * $dbu + 0.5), int($s[1] * $dbu + 0.5), $class);
    }
    print WRITE @buf if ( @buf );
    close(WRITE);
    my $t1 = new Benchmark;
    my $td = timediff($t1, $t0);
    print "Command write_sgraph took:",timestr($td),"\n";
 }
}#write_sgraph 

#------------------------------------------------------------------------------------------------#
#<!-- write_top_positions: what a top-only re-place changed, for a Photon
#     server that already holds the sgraph.  After hier_place_all --keep_shapes
#     -depth 0 the top's children have moved as rigid blocks and only the top's
#     own cells moved freely, so this is the whole difference between two
#     placements: a few thousand lines where write_sgraph writes the design
#     again (3.2 GB, 114 s on a 3M-instance tile).  Ports are left out: the
#     sgraph marks them PORT and Photon's wire estimate counts only PLACED and
#     FIXED pins.  All DBU, in write_sgraph's frame:
#       DBU <per micron>
#       BLOCK <top child instance> <llx> <lly>     its origin in the top
#       INST <top cell> <x> <y>                    each of the top's own cells -->
sub write_top_positions {
 my $noOfArguments = @_;
 if ( $noOfArguments < 2 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP" ) {
    print "Usage : write_top_positions -output <file>\n";
    print "\n";
    print "The positions a top-only re-place changes: each child block's origin in\n";
    print "the top and each of the top's own cells, in DBU -- for photon_server's\n";
    print "move, so a floorplan try is re-timed without writing the sgraph again.\n";
    print "  DBU <per micron>\n";
    print "  BLOCK <child instance> <llx> <lly>\n";
    print "  INST <top cell> <x> <y>        PLACED and FIXED cells only\n";
    return;
 }
 my $out = "";
 for ( my $i = 0 ; $i < $noOfArguments ; $i++ ) {
    $out = $_[$i+1] if ( $_[$i] eq "-output" );
 }
 my $top = $GLOBAL->dbfGlobalGetTOP;
 my $tf = &get_floorplanID_of_module($top);
 if ( $out eq "" || $tf == -1 || ! exists $FLOORPLAN_ALREADY{$tf} ) {
    print "ERR-SPK-WR_TOP_POS : 001 : need -output, and a floorplan of $top\n";
    return;
 }
 open(my $fh, ">", $out) or do { print "ERR-SPK-WR_TOP_POS : 002 : cannot write $out\n"; return; };
 print $fh "DBU " . $GLOBAL->dbfGlobalGetDBU . "\n";
 my ($nb, $nc) = (0, 0);
 foreach my $c ( sort $FLOORPLAN_ALREADY{$tf}->dbFlplanGetHierInstList ) {
    my @e = $FLOORPLAN_ALREADY{$tf}->dbFlplanGetHierInstExtent($c);
    next unless ( @e == 4 );
    print $fh "BLOCK $c $e[0] $e[1]\n";
    $nb++;
 }
 foreach my $o ( sort $FLOORPLAN_ALREADY{$tf}->dbFlplanGetLeafInstList ) {
    next unless ( exists $CADB{$o} );
    my $st = $CADB{$o}->dbCadbGetStatus;
    next unless ( defined $st && ( $st eq "PLACED" || $st eq "FIXED" ) );
    my @l = $CADB{$o}->dbCadbGetLoc;
    print $fh "INST $o $l[0] $l[1]\n";
    $nc++;
 }
 close($fh);
 print "INFO-SPK-WR_TOP_POS : 003 : $nb block origin(s) and $nc cell(s) of $top written to $out\n";
}#write_top_positions

#------------------------------------------------------------------------------------------------#
#<!-- write_moves: what the last rigid re-place changed -- hier_place_all
#     --keep_shapes at -depth 0 or with -only -- as photon_server's moveby
#     reads it.  Relative to the placement before that re-place, so a server
#     that has applied every earlier one stays in step with the session.  DBU:
#       DBU <per micron>
#       SHIFT <instance path> <dx> <dy>    every instance under it moved by that
#       INST <cell> <x> <y>                the re-placed module's own cells -->
sub write_moves {
 my $noOfArguments = @_;
 if ( $noOfArguments < 2 || $_[0] eq "-h" || $_[0] eq "-help" || $_[0] eq "-HELP" ) {
    print "Usage : write_moves -output <file>\n";
    print "\n";
    print "What the last hier_place_all --keep_shapes re-place (-depth 0 or -only)\n";
    print "moved, for photon_server's moveby: each child block's shift and the\n";
    print "re-placed module's own cells, in DBU.\n";
    print "  DBU <per micron>\n";
    print "  SHIFT <instance path> <dx> <dy>\n";
    print "  INST <cell> <x> <y>        PLACED and FIXED cells only\n";
    return;
 }
 my $out = "";
 for ( my $i = 0 ; $i < $noOfArguments ; $i++ ) {
    $out = $_[$i+1] if ( $_[$i] eq "-output" );
 }
 unless ( exists $HIER2FLAT_LAST{shifts} ) {
    print "ERR-SPK-WR_MOVES : 001 : nothing to write: the last hier2flat was not a rigid re-place\n";
    return;
 }
 open(my $fh, ">", $out) or do { print "ERR-SPK-WR_MOVES : 002 : cannot write $out\n"; return; };
 print $fh "DBU " . $GLOBAL->dbfGlobalGetDBU . "\n";
 my ($ns, $nc) = (0, 0);
 foreach my $p ( sort keys %{ $HIER2FLAT_LAST{shifts} } ) {
    my ($dx, $dy) = @{ $HIER2FLAT_LAST{shifts}{$p} };
    print $fh "SHIFT $p $dx $dy\n";
    $ns++;
 }
 foreach my $o ( sort @{ $HIER2FLAT_LAST{cells} } ) {
    next unless ( exists $CADB{$o} );
    my $st = $CADB{$o}->dbCadbGetStatus;
    next unless ( defined $st && ( $st eq "PLACED" || $st eq "FIXED" ) );
    my @l = $CADB{$o}->dbCadbGetLoc;
    print $fh "INST $o $l[0] $l[1]\n";
    $nc++;
 }
 close($fh);
 print "INFO-SPK-WR_MOVES : 003 : $ns block shift(s) and $nc cell(s) written to $out\n";
}#write_moves

#------------------------------------------------------------------------------------------------#
1;
