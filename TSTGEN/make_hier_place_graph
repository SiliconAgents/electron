sub dbfTstgenGetShapeMidPoint {

my $shape = $_[0];

unless ( defined $shape ) {
  return (0, 0);
}

$shape =~ s/\bRECT\s+//;  # get rid of RECT keyword
$shape =~ s/\s*\;\s*$//;  # get rid of semicolon at end

my @xy = split(/\s+/, $shape);
if ( @xy == 5 ) {
  my $midx = ($xy[1] + $xy[3]) / 2;
  my $midy = ($xy[2] + $xy[4]) / 2;
  return ($midx, $midy);
}
else {
  return (0, 0);
}

}# sub dbfTstgenGetShapeMidPoint

