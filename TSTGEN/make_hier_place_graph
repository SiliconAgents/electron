#***** /write_hier_place_graph
#  write_hier_place_graph
# FUNCTION
#
#
#
#
# SYNOPSIS
#  write_hier_place_graph
#
#
#
#
# INPUTS
#
#
#
#
#       options :
#               -module <moduleName> : name of the module whose graph to be output
#
#
#
#       switches :
#               --pin : output pin based graph file
#
#
#
#
# OUTPUTS
#               node file : nodefile
#               lib file : libfile
#               node map file : <moduleName>.nodeMap.txt
#               pin map file : <moduleName>.node_pin_map.txt
#               graph file : <moduleName>.txt
#               xy.out file : mp_xy.in
#
#
#****
#***** /hier_connectivity
#  hier_connectivity
# FUNCTION
#       Reports which instances of a module share a net, ignoring driver and
#       sink.  Reads the conn lines held in VNOM directly, so unlike
#       write_hier_place_graph it needs neither edit_module nor the pseudo
#       database: pin direction and width are never resolved, which is the
#       expensive part of dbfTstgenLoadVNOMNets.
#
#       Two pins count as connected when their net names match exactly, the
#       same rule dbfTstgenLoadVNOMNets uses.  A bit select therefore does not
#       match its parent bus; use write_hier_place_graph if bit accuracy
#       matters.
#
# SYNOPSIS
#  hier_connectivity
#
# INPUTS
#
#       options :
#               -module <moduleName> : module to report, defaults to TOP_MODULE
#               -fanout_limit <n> : drop nets touching n or more instances
#               -out <fileName> : defaults to <moduleName>.conn
#
#       switches :
#               --hier_only : consider hierarchical instances only
#               --ports : report nets tied to a module port as touching PIN
#
# OUTPUTS
#               connectivity file : <moduleName>.conn, one line per net,
#                                   "<net> <inst> <inst> ..."
#               and, on stdout, instance pairs ranked by shared net count
#
#****
#<!-- Which instances each net of a module touches, straight off the VNOM conn
#     lines.  Same parse as the head of dbfTstgenLoadVNOMNets and nothing after
#     it, which is the point: it does not need the module checked out, so it
#     works after edit_module --physical_only, where PSEUDO_VNET_ALREADY is
#     empty and there is no net object to ask.
#
#     Returns two hashes.  The first is net -> inst -> 1, the connectivity
#     itself.  The second is net -> inst -> pin -> 1, which the caller needs if
#     it wants to work out which end of a net drives it; hier_connectivity
#     ignores it, since a connection has no direction as far as it is
#     concerned. -->
sub dbfTstgenHierNetToInst {

my ($module, $hierOnly, $wantPorts) = @_;
my %NET_TO_INST = ();
my %NET_TO_PIN = ();

unless ( defined $module && $module ne "" && exists $MODULE_ALREADY{$module} ) {
  return (\%NET_TO_INST, \%NET_TO_PIN);
}

#<!-- Port names, so a net tied to one can be shown as touching PIN.  Plain
#     VNOM reads, no pseudo module required. -->
my %PORT_NAMES = ();
if ( $wantPorts ) {
  foreach my $port ( $MODULE_ALREADY{$module}->dbVNOMGetInput,
                     $MODULE_ALREADY{$module}->dbVNOMGetOutput,
                     $MODULE_ALREADY{$module}->dbVNOMGetBidi ) {
    $PORT_NAMES{$port} = 1;
  }
}

foreach my $conn ( $MODULE_ALREADY{$module}->dbVNOMGetConn ) {
  $conn =~ s/^\s+//;
  $conn =~ s/\s*\;?\s*$//;

  my $instCell = $conn;
  $instCell =~ s/\(.+$//;
  my ($cellref, $inst) = ( split(/\s+/, $instCell) )[0,1];
  unless ( defined $inst && $inst ne "" ) {
    next;
  }
  if ( $hierOnly ) {
    unless ( $MODULE_ALREADY{$module}->dbVNOMHasHierInst($inst) ) {
      next;
    }
  }

  $conn =~ s/\s*\(\s*/\|/;   # mark leftmost L-paren
  $conn =~ s/^.*\|//;        # remove from left up to the mark
  $conn =~ s/\s+//g;
  $conn =~ s/\)+$//;

  foreach my $pair ( split(/\)\,/, $conn) ) {
    my ($pin, $net) = ( split(/\(/, $pair) )[0,1];
    unless ( defined $net && $net ne "" ) {
      next;
    }

    #<!-- Blast the expression to one name per bit.
    #
    #     Matching net names as written does not work: an instance that takes a
    #     bus writes .sum(q6) while whatever reads a bit of it writes q6[11], so
    #     the two never meet and the signal looks unconnected.  That is not a
    #     corner case -- it is how every bussed connection between a block and
    #     the logic around it is written, and it is why the output ports of a
    #     module came out of the graph with no edges at all.
    #
    #     array_of_blasted_expr is the same expansion read_verilog uses for an
    #     assign: it splits a {a,b} concatenation, expands a[3:0] to its bits,
    #     and looks a bare bus name up in the module's wire and port widths. -->
    my @netList = &array_of_blasted_expr($net, $module);
    unless ( @netList ) {
      push(@netList, $net);   #<!-- nothing known about it, take it as written -->
    }

    foreach my $subNet ( @netList ) {
      if ( $subNet eq "" ) {
        next;
      }
      if ( $subNet =~ m/^\d*'b[01]+$/ ) {
        next;  #<!-- tie constant, not a net -->
      }
      $NET_TO_INST{$subNet}{$inst} = 1;
      if ( defined $pin && $pin ne "" ) {
        #<!-- the conn line writes .a(din), so the split leaves the dot on the
        #     pin.  A port list has no dots, so record the bare name or every
        #     direction lookup misses. -->
        my $bare = $pin;
        $bare =~ s/^\.//;
        $NET_TO_PIN{$subNet}{$inst}{$bare} = 1 if ( $bare ne "" );
      }
      #<!-- A bus port is recorded under its base name, so the net data[0] has
      #     to be matched against data as well as against itself, or no bit of
      #     any bus port is ever seen as reaching a port.  If data is a port
      #     then data[0] is one of its bits; a design with an unrelated internal
      #     net called data[0] has a name collision that is already broken. -->
      my $netBase = $subNet;
      $netBase =~ s/\[.*$//;
      if ( $wantPorts &&
           ( exists $PORT_NAMES{$subNet} || exists $PORT_NAMES{$netBase} ) ) {
        $NET_TO_INST{$subNet}{"PIN"} = 1;
        $NET_TO_PIN{$subNet}{"PIN"}{$subNet} = 1;
      }
    }
  }# foreach pin net pair
}# foreach conn line

return (\%NET_TO_INST, \%NET_TO_PIN);

}# sub dbfTstgenHierNetToInst


#<!-- Union-find over the net/instance incidence graph, used to collapse cones
#     of combinational logic.  Keys are tagged "N:<net>" or "I:<inst>" so the
#     two name spaces cannot collide: a net and an instance may share a name. -->
sub dbfTstgenUFFind {

my ($parent, $key) = @_;
unless ( exists $parent->{$key} ) {
  $parent->{$key} = $key;
  return ($key);
}
#<!-- iterative, with path compression: a long buffer chain would otherwise
#     recurse as deep as the chain is long -->
my $root = $key;
while ( $parent->{$root} ne $root ) {
  $root = $parent->{$root};
}
while ( $parent->{$key} ne $root ) {
  my $next = $parent->{$key};
  $parent->{$key} = $root;
  $key = $next;
}
return ($root);

}# sub dbfTstgenUFFind

sub dbfTstgenUFUnion {

my ($parent, $a, $b) = @_;
my $ra = &dbfTstgenUFFind($parent, $a);
my $rb = &dbfTstgenUFFind($parent, $b);
if ( $ra ne $rb ) {
  $parent->{$rb} = $ra;
}
return ($ra);

}# sub dbfTstgenUFUnion


#<!-- Which port nodes does a net name stand for?
#
#     The nodefile blasts every bussed port to bits, a[0] .. a[7], because that
#     is what a placer has to put somewhere.  A conn line does not have to name
#     the net that way: a child instantiation writes .a(a[3:0]) and a module
#     that passes a bus straight through writes .a(a), so the net is a range or
#     a bare base name and matches no port node at all.
#
#     That is not cosmetic.  The port member of such a net used to be looked up
#     as the net's own name, found nothing, and was dropped, so in any module
#     whose children take buses -- which is most of them -- every port came out
#     of the graph with no edges whatsoever.
#
#     Resolve the three forms: an exact bit, a range which covers the bits in
#     it, and a bare base name which covers the whole bus. -->
sub dbfTstgenPortNodesForNet {

my ($net, $nodeNum, $bitsByBase) = @_;

#<!-- a plain net, or a bit that is a port in its own right -->
if ( exists $nodeNum->{$net} ) {
  return ($net);
}

my ($base, $range) = ($net, "");
if ( $net =~ m/^(.*)\[([^\]]*)\]$/ ) {
  ($base, $range) = ($1, $2);
}

#<!-- a[3:0], and a[0:3] means the same set of bits -->
if ( $range =~ m/^\s*(\d+)\s*:\s*(\d+)\s*$/ ) {
  my ($hi, $lo) = ($1, $2);
  ($hi, $lo) = ($lo, $hi) if ( $lo > $hi );
  my @out = ();
  for ( my $i = $lo ; $i <= $hi ; $i++ ) {
    if ( exists $bitsByBase->{$base}{$i} ) {
      push(@out, $bitsByBase->{$base}{$i});
    }
  }
  return (@out);
}

#<!-- the bare base name of a bus: every bit of it -->
if ( $range eq "" && exists $bitsByBase->{$base} ) {
  my @out = ();
  foreach my $i ( sort { $a <=> $b } keys %{$bitsByBase->{$base}} ) {
    push(@out, $bitsByBase->{$base}{$i});
  }
  return (@out);
}

return ();

}# sub dbfTstgenPortNodesForNet


#<!-- Is this pseudo instance something whose position matters in its own right?
#
#     A hierarchical instance always is: it is a block with a floorplan.  A leaf
#     is one when the library says it holds state or is a hard block -- seq, mem
#     and block in dbfFlatNodeType's vocabulary.  Everything else, which in
#     practice means combinational logic and the physical-only cells, is what
#     gets collapsed away.
#
#     und is deliberately NOT an anchor.  A cell nothing described could be a
#     flop, so treating it as one would invent anchors, and treating it as combi
#     silently hides them; the caller counts them and says so rather than
#     guessing either way. -->
sub dbfTstgenPseudoIsAnchor {

my ($module, $inst) = @_;

unless ( exists $PSEUDO_VINST_ALREADY{$module}{$inst} ) {
  return (0);
}
my $cellref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
unless ( defined $cellref && $cellref ne "" ) {
  return (0);
}
#<!-- a hierarchical child: known to the pseudo database or to VNOM -->
if ( exists $PSEUDO_MODULE_ALREADY{$cellref} || exists $MODULE_ALREADY{$cellref} ) {
  return (1);
}
my $type = &dbfFlatNodeType($cellref);
if ( $type eq "seq" || $type eq "mem" || $type eq "block" ) {
  return (1);
}
return (0);

}# sub dbfTstgenPseudoIsAnchor


sub hier_connectivity {

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $module = $TOP_MODULE;
my $hierOnly = 0;
my $wantPorts = 0;
my $fanoutLimit = 0;
my $outFile;

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : hier_connectivity -module <module name>\n";
  print "                          -fanout_limit <high fan out threshold>\n";
  print "                          -out <file name>\n";
  print "                          --hier_only\n";
  print "                          --ports\n";
  return;
}

for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-module")       { $module = $_[$i+1]; }
  elsif ($_[$i] eq "-out")          { $outFile = $_[$i+1]; }
  elsif ($_[$i] eq "-fanout_limit") { $fanoutLimit = $_[$i+1]; }
  elsif ($_[$i] eq "--hier_only")   { $hierOnly = 1; }
  elsif ($_[$i] eq "--ports")       { $wantPorts = 1; }
  elsif ($_[$i] =~ m/^-+\w/)        { print "WARN-TST-HIER_CONN : 001 : invalid option $_[$i]\n"; }
}

unless ( defined $module && $module ne "" && exists $MODULE_ALREADY{$module} ) {
  print "WARN-TST-HIER_CONN : 002 : module $module does not exist in the design\n";
  return;
}
unless ( defined $outFile && $outFile ne "" ) {
  $outFile = "$module.conn";
}

my ($netToInst, $netToPin) = &dbfTstgenHierNetToInst($module, $hierOnly, $wantPorts);
my %NET_TO_INST = %$netToInst;

unless ( open(WRITE_CONN_RPT, ">$outFile") ) {
  print "WARN-TST-HIER_CONN : 003 : cannot open $outFile for writing\n";
  return;
}

my %PAIR_COUNT = ();
my $netCnt = 0;
my $skipCnt = 0;
foreach my $net ( sort keys %NET_TO_INST ) {
  my @insts = sort keys %{$NET_TO_INST{$net}};
  if ( @insts < 2 ) {
    next;  #<!-- nothing to connect -->
  }
  if ( $fanoutLimit > 0 && @insts >= $fanoutLimit ) {
    $skipCnt++;
    next;
  }
  $netCnt++;
  print WRITE_CONN_RPT "$net @insts\n";
  for (my $i = 0; $i < @insts; $i++) {
    for (my $j = $i + 1; $j < @insts; $j++) {
      $PAIR_COUNT{"$insts[$i] $insts[$j]"}++;
    }
  }
}
close(WRITE_CONN_RPT);

print "INFO-TST-HIER_CONN : 004 : wrote $netCnt nets of module $module to $outFile\n";
if ( $skipCnt > 0 ) {
  print "INFO-TST-HIER_CONN : 005 : $skipCnt high fan out nets skipped\n";
}
foreach my $pair ( sort { $PAIR_COUNT{$b} <=> $PAIR_COUNT{$a} } keys %PAIR_COUNT ) {
  print "  $pair $PAIR_COUNT{$pair}\n";
}

return (\%NET_TO_INST, \%PAIR_COUNT);

}# sub hier_connectivity


#<!-- Is this pin an output of the child cell, so the instance holding it drives
#     the net?  Exact name first, then the bus base, since a conn line carries
#     A[3] while a module's port list carries A.  Returns 1 for yes, 0 for no
#     and -1 for "cannot tell", which is not the same thing: an unknown cell has
#     to be reported, not quietly counted as an input. -->
sub dbfTstgenHierPinDrives {

my ($cellref, $pin) = @_;
unless ( defined $cellref && $cellref ne "" && defined $pin && $pin ne "" ) {
  return (-1);
}
my $base = $pin;
$base =~ s/\[.*$//;

if ( exists $PLDB{$cellref} ) {
  foreach my $p ( $pin, $base ) {
    if ( $PLDB{$cellref}->dbMdbDoesPinExist($p) ) {
      return ( $PLDB{$cellref}->dbMdbGetPinDir($p) == 1 ? 1 : 0 );
    }
  }
  return (-1);
}
if ( exists $PSEUDO_MODULE_ALREADY{$cellref} ) {
  my %out = map { $_ => 1 } $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetOutput;
  if ( exists $out{$pin} || exists $out{$base} ) {
    return (1);
  }
  my %in = map { $_ => 1 } ( $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetInput,
                             $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetBidi );
  if ( exists $in{$pin} || exists $in{$base} ) {
    return (0);
  }
  return (-1);
}
if ( exists $MODULE_ALREADY{$cellref} ) {
  my %out = map { $_ => 1 } $MODULE_ALREADY{$cellref}->dbVNOMGetOutput;
  if ( exists $out{$pin} || exists $out{$base} ) {
    return (1);
  }
  return (0);
}
return (-1);

}# sub dbfTstgenHierPinDrives


#<!-- How big a child of the module being edited is, in microns, when the
#     instance itself carries no box.
#
#     dbfTstgenCalcInstSizeFromChildFlplan is what normally fills the instance
#     bbox in during edit_module, but it gives up on three conditions: the child
#     must be in the pseudo database, the instance must resolve to a floorplan,
#     and that floorplan must be the child module's own.  A child that has never
#     been floorplanned fails all three, and the instance is then left with an
#     empty bbox -- which is a zero size in the nodefile, and a placer given a
#     design of zero area nodes has no density to spread.
#
#     So ask the child what size it is: its pseudo size first, then its VNOM
#     floorplan, then the library if it turned out to be a leaf cell after all. -->
sub dbfTstgenHierChildSize {

my $cellref = $_[0];
unless ( defined $cellref && $cellref ne "" ) {
  return (0, 0);
}

if ( exists $PSEUDO_MODULE_ALREADY{$cellref} ) {
  #<!-- already microns, the accessor divides by the dbu -->
  my @size = $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenGetSize;
  if ( @size >= 4 && defined $size[3] &&
       $size[2] > $size[0] && $size[3] > $size[1] ) {
    return ($size[2] - $size[0], $size[3] - $size[1]);
  }
}

my $flplanID = 0;
if ( exists $MODULE_ALREADY{$cellref} ) {
  $flplanID = $MODULE_ALREADY{$cellref}->dbVNOMGetFloorplanID;
}
if ( (! $flplanID) && exists $FLOORPLAN_LOOKUP{"$cellref/_self_"} ) {
  $flplanID = $FLOORPLAN_LOOKUP{"$cellref/_self_"};
}
if ( $flplanID && exists $FLOORPLAN_ALREADY{$flplanID} ) {
  my $dbu = $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetDBUnit;
  $dbu = 1 unless ( defined $dbu && $dbu > 0 );
  my @size = $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetSize;
  if ( @size >= 4 && defined $size[3] &&
       $size[2] > $size[0] && $size[3] > $size[1] ) {
    return ( ($size[2] - $size[0]) / $dbu, ($size[3] - $size[1]) / $dbu );
  }
}

if ( exists $PLDB{$cellref} ) {
  #<!-- LEF sizes are microns already -->
  my @cs = $PLDB{$cellref}->dbMdbGetSize;
  if ( @cs >= 2 && defined $cs[1] ) {
    return ($cs[0], $cs[1]);
  }
}

return (0, 0);

}# sub dbfTstgenHierChildSize


#****f* /hier_place
#  hier_place
# FUNCTION
#  Interactive hierarchical placement of the module being edited.
#
#  Writes the graph, opens hier_place.py on it, waits, then reads back whatever
#  was saved.  Unlike every other placer in the Place menu this one is a person
#  with a mouse, so proton blocks until the window closes: the read back has to
#  follow the Save, and there is no event loop here to poll a background process
#  from.
#
#  Blocks and ports are placed together, --kinds INST PORT, so the pins land on
#  the die edges alongside the blocks they serve.  Where along which edge, and
#  across how many routing layers, is set inside hier_place's own GUI.
#
#  hier_place saves through a file dialog whose default is the input name with
#  .nodefile replaced by .placed.nodefile.  That is what gets read back, so
#  taking the default is the easy path; -input names the file if you saved it
#  somewhere else.
#****
sub hier_place {

use Benchmark;
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $module = $TOP_MODULE;
my $placer;
my $inFile;
my $kinds = "INST PORT";
my $layer;
#<!-- Lower left, like every other nodefile in this flow.  hier_place.py used to
#     read and write cell centres, which put every block half its own size too
#     far right and up on the way back and pushed a corner block clean off the
#     die; pass -origin center to read a file written by a version that still
#     does that. -->
my $origin = "lower_left";
my $fanoutLimit = 0;
my ($writeOnly, $reportOnly, $keepFiles, $noSize, $noPorts) = (0, 0, 0, 0, 0);
my $hierOnly = 0;
my $extra = "";

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : hier_place -module <module name>\n";
  print "                   -placer <path to hier_place>\n";
  print "                         defaults to ELECTRON_HOME/3RDBIN/hier_place\n";
  print "                   -kinds <\"INST PORT\" | INST>\n";
  print "                   -input <nodefile to read back, if not the default>\n";
  print "                   -layer <layer for pin shapes that have none>\n";
  print "                   -origin <lower_left|center>\n";
  print "                         what hier_place writes; lower_left\n";
  print "                   -fanout_limit <high fan out threshold for the graph>\n";
  print "                   -args <extra options passed straight to hier_place>\n";
  print "                   --report_only\n";
  print "                         parse and summarise without opening a window\n";
  print "                   --write_only\n";
  print "                         write the graph and stop\n";
  print "                   --no_size    do not apply reshaped block sizes\n";
  print "                   --no_ports   do not apply pin locations\n";
  print "                   --hier_only\n";
  print "                         the old graph: hierarchical instances only, with\n";
  print "                         every net that runs through a leaf cell dropped\n";
  print "                   --keep\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-module")        { $module = $_[$i+1]; }
  elsif ($_[$i] eq "-placer")        { $placer = $_[$i+1]; }
  elsif ($_[$i] eq "-kinds")         { $kinds = $_[$i+1]; }
  elsif ($_[$i] eq "-input")         { $inFile = $_[$i+1]; }
  elsif ($_[$i] eq "-layer")         { $layer = $_[$i+1]; }
  elsif ($_[$i] eq "-origin")        { $origin = $_[$i+1]; }
  elsif ($_[$i] eq "-fanout_limit")  { $fanoutLimit = $_[$i+1]; }
  elsif ($_[$i] eq "-args")          { $extra = $_[$i+1]; }
  elsif ($_[$i] eq "--report_only")  { $reportOnly = 1; }
  elsif ($_[$i] eq "--write_only")   { $writeOnly = 1; }
  elsif ($_[$i] eq "--no_size")      { $noSize = 1; }
  elsif ($_[$i] eq "--no_ports")     { $noPorts = 1; }
  elsif ($_[$i] eq "--hier_only")    { $hierOnly = 1; }
  elsif ($_[$i] eq "--keep")         { $keepFiles = 1; }
  elsif ($_[$i] =~ m/^-+\w/)         { print "WARN-TST-HIER_PL : 001 : invalid option $_[$i]\n"; }
}

unless ( defined $module && $module ne "" && exists $PSEUDO_MODULE_ALREADY{$module} ) {
  print "ERR-TST-HIER_PL : 002 : module $module is not being edited, run edit_module first\n";
  return;
}

unless ( defined $placer && $placer ne "" ) {
  $placer = $ENV{HIER_PLACE};
}
#<!-- Shipped with the tool, like every other placer this flow drives: 3RDBIN
#     holds eplacer, mincut_placer, seed_placer and the rest, all resolved the
#     same way off ELECTRON_HOME.  It used to default to a path in somebody's
#     home area, which meant hier_place worked only for that one person. -->
unless ( defined $placer && $placer ne "" ) {
  my $electronHome = $GLOBAL->dbfGlobalGetElectronHome;
  $placer = "$electronHome/3RDBIN/hier_place";
}

my $nodeFile = "$module.pseudo.nodefile";
my $graphFile = "$module.pseudo.txt";
#<!-- hier_place's save dialog defaults to this name -->
my $placedFile = "$module.pseudo.placed.nodefile";
unless ( defined $inFile && $inFile ne "" ) {
  $inFile = $placedFile;
}

#<!-- a saved file from an earlier run would be read back as if it were this
#     one, and the user would never know the Save did not take -->
if ( -e $inFile ) {
  unlink($inFile);
}

#<!-- Read the connectivity in full and thin it afterwards, rather than asking
#     for hierarchical instances only.
#
#     --hier_only drops the leaf cells while the nets are still being collected,
#     so a connection running hier_A -> buffer -> hier_B is two separate nets,
#     neither of which has two hierarchical members, and it is not collapsed but
#     lost.  In a netlist where the blocks talk to each other through any glue
#     logic at all that is most of the connectivity, and the placer was being
#     handed a graph far emptier than the design.
#
#     --anchors keeps the same blocks, plus the sequential cells, memories and
#     hard blocks whose position matters in its own right, plus the ports, and
#     turns each cone of combinational logic between them into one hyperedge --
#     the same reduction anchor_hypergraph.py does for the flat flow. -->
my @writeArgs = ("-module", $module, "-nodefile", $nodeFile,
                 "-graph", $graphFile, ($hierOnly ? "--hier_only" : "--anchors"));
if ( $fanoutLimit > 0 ) {
  push(@writeArgs, "-fanout_limit", $fanoutLimit);
}
&write_pseudo_graph(@writeArgs);

unless ( -e $nodeFile && -e $graphFile ) {
  print "ERR-TST-HIER_PL : 003 : the nodefile and graph were not written, stopping\n";
  return;
}
if ( $writeOnly ) {
  print "INFO-TST-HIER_PL : 004 : --write_only given, $nodeFile and $graphFile left in place\n";
  return;
}
unless ( -e $placer ) {
  print "WARN-TST-HIER_PL : 005 : hier_place not found at $placer\n";
  print "WARN-TST-HIER_PL : 006 : $nodeFile and $graphFile have been written, nothing was placed\n";
  print "WARN-TST-HIER_PL : 007 : set HIER_PLACE or pass -placer, then read_pseudo_nodefile -input $inFile\n";
  return;
}

#<!-- 3RDBIN/hier_place carries a python3 shebang and is executable, so run it
#     the way the other placers are run.  A file handed over with -placer need
#     not be either of those, so fall back to the interpreter for that case. -->
my $cmd = ( -x $placer ) ? "$placer $nodeFile $graphFile"
                         : "python3 $placer $nodeFile $graphFile";
if ( defined $kinds && $kinds ne "" ) { $cmd .= " --kinds $kinds"; }
if ( $reportOnly )                    { $cmd .= " --report-only"; }
if ( defined $extra && $extra ne "" ) { $cmd .= " $extra"; }

if ( $reportOnly ) {
  print "INFO-TST-HIER_PL : 008 : summarising $nodeFile without opening a window\n";
  system($cmd);
  return;
}

print "INFO-TST-HIER_PL : 009 : opening hier_place on $module\n";
print "INFO-TST-HIER_PL : 010 : place the blocks and pins, then press Save \& Close\n";
print "INFO-TST-HIER_PL : 011 : electron is waiting; the default save name is $placedFile\n";
my $rc = system($cmd);
if ( $rc != 0 ) {
  print "ERR-TST-HIER_PL : 012 : hier_place exited with status $rc, nothing read back\n";
  return;
}

unless ( -e $inFile ) {
  print "WARN-TST-HIER_PL : 013 : $inFile was not written, so nothing was saved and nothing is applied\n";
  print "WARN-TST-HIER_PL : 014 : press Save before closing, or pass -input with the name you used\n";
  return;
}

my @readArgs = ("-module", $module, "-input", $inFile);
push(@readArgs, "-origin", $origin) if ( defined $origin && $origin ne "" );
push(@readArgs, "-layer", $layer) if ( defined $layer && $layer ne "" );
push(@readArgs, "--no_size") if ( $noSize );
push(@readArgs, "--no_ports") if ( $noPorts );
&read_pseudo_nodefile(@readArgs);

#<!-- Redraw the Hier-View on what was just read back.
#
#     Everything moved: the blocks the placer arranged and, unless --no_ports,
#     the pins.  activate_HierViewTab is the full redraw the refresh button
#     uses -- it clears the canvas and rebuilds from the pseudo database -- and
#     without it the view still shows the arrangement from before hier_place
#     ran, which is indistinguishable from the placement having done nothing.
#
#     Pins go last and on purpose: activate_HierViewTab does delete('all'),
#     which takes the HIERPINS tag with it, so drawing them first would just
#     have them wiped.  display_hier_inst_pin reports what it could not draw
#     and carries on, so a port with no layer is a warning, not a dead end.
#
#     Guarded twice: there is no canvas at all under --nogui, and the module
#     placed need not be the one the view is showing, which is always
#     TOP_MODULE. -->
if ( $GLOBAL->dbGlobalGetGuiStatus == 1 && defined $hier_canvas ) {
  if ( $module eq $TOP_MODULE ) {
    &activate_HierViewTab;
    unless ( $noPorts ) {
      &display_hier_inst_pin;
    }
    print "INFO-TST-HIER_PL : 016 : the Hier-View has been redrawn on the new placement\n";
  }
  else {
    print "INFO-TST-HIER_PL : 017 : $module is not the module on display ($TOP_MODULE),\n";
    print "INFO-TST-HIER_PL : 018 : so the Hier-View was left alone\n";
  }
}

unless ( $keepFiles ) {
  unlink($nodeFile);
  unlink($graphFile);
  unlink($inFile);
}

my $t1 = new Benchmark;
my $td = timediff($t1, $t0);
print "Command hier_place took:",timestr($td),"\n";

}# sub hier_place


#****f* /read_pseudo_nodefile
#  read_pseudo_nodefile
# FUNCTION
#  Read a nodefile back and apply it to the pseudo database.  The return path
#  for write_pseudo_graph, and the counterpart of read_flat_nodefile, which
#  writes through dbCadbSetLoc into the flat database and so cannot be used
#  here.
#
#  Written for hier_place.py, which rewrites the same nodefile it was given with
#  updated coordinates.  That tool also RESHAPES blocks -- dragging a corner
#  changes a block's width and height -- so this applies the box and not just
#  the location, and pushes a changed size onto the child module as well.  Move
#  the instance box without the child's own size following and Hier-View draws
#  the new box while descending into the child shows the old one, which is the
#  shape-loss failure this flow has hit before.
#
#  Ports are pin locations on the module's own floorplan: the record's box
#  becomes the pin rect, on the layer the pin already had, or -layer, or the
#  bottom routing layer.
#****
sub read_pseudo_nodefile {

use Benchmark;
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $module = $TOP_MODULE;
my $inFile;
my $layer;
my $noSize = 0;
my $noPorts = 0;
my $origin = "lower_left";

if ( $noOfArguments < 1 || $_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP' ) {
  print "Usage : read_pseudo_nodefile -module <module name>\n";
  print "                             -input <placed nodefile>\n";
  print "                             -layer <layer for pin shapes that have none>\n";
  print "                             -origin <lower_left|center>\n";
  print "                                   what the x y in the file mean.  This format is\n";
  print "                                   lower left throughout, which is the default; use\n";
  print "                                   center for a file whose coordinates are cell centres\n";
  print "                             --no_size\n";
  print "                                   move instances, keep their boxes\n";
  print "                             --no_ports\n";
  print "                                   ignore PORT records\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-module")  { $module = $_[$i+1]; }
  elsif ($_[$i] eq "-input")   { $inFile = $_[$i+1]; }
  elsif ($_[$i] eq "-layer")   { $layer = $_[$i+1]; }
  elsif ($_[$i] eq "-origin")  { $origin = $_[$i+1]; }
  elsif ($_[$i] eq "--no_size"){ $noSize = 1; }
  elsif ($_[$i] eq "--no_ports"){ $noPorts = 1; }
  elsif ($_[$i] =~ m/^-+\w/)   { print "WARN-TST-RD_PS_ND : 001 : invalid option $_[$i]\n"; }
}

unless ( defined $module && $module ne "" && exists $PSEUDO_MODULE_ALREADY{$module} ) {
  print "ERR-TST-RD_PS_ND : 002 : module $module is not being edited\n";
  return;
}
unless ( defined $inFile && $inFile ne "" && -e $inFile ) {
  print "ERR-TST-RD_PS_ND : 003 : nodefile $inFile does not exist\n";
  return;
}
unless ( open(READ_PSEUDO_ND, "$inFile") ) {
  print "ERR-TST-RD_PS_ND : 004 : cannot open $inFile for reading\n";
  return;
}

#<!-- A pin shape needs a layer and the nodefile carries none, so the pin's own
#     layer is preferred and this is only the fallback. -->
unless ( $origin =~ m/^cent/i || $origin =~ m/^low/i ) {
  print "WARN-TST-RD_PS_ND : 015 : -origin $origin is not lower_left or center, assuming lower_left\n";
  $origin = "lower_left";
}
if ( $origin =~ m/^cent/i ) {
  print "INFO-TST-RD_PS_ND : 016 : reading x y as cell centres and converting to lower left\n";
}

unless ( defined $layer && $layer ne "" ) {
  my ($topL, $bottomL) = &pldb_layer_info;
  $layer = $bottomL;
}
#<!-- With no tech read there is no routing layer to name, and an empty one
#     would make the shape string start with a space and parse as garbage.
#     NONE is the placeholder hier_place_pins already uses. -->
unless ( defined $layer && $layer ne "" ) {
  $layer = "NONE";
  print "WARN-TST-RD_PS_ND : 010 : no routing layer is known, pin shapes will say NONE\n";
  print "WARN-TST-RD_PS_ND : 011 : read a tech LEF, or pass -layer\n";
}

my $rowHeight = 0;
my ($instCnt, $portCnt, $reshapeCnt, $noLocCnt, $unknownCnt, $sizedPinCnt) = (0,0,0,0,0,0);
my ($polyMovedCnt, $polySquaredCnt) = (0, 0);
my @unknown = ();

while ( my $line = <READ_PSEUDO_ND> ) {
  chomp($line);
  next if ( $line =~ m/^\s*#/ || $line =~ m/^\s*$/ );
  $line =~ s/^\s+//;
  my @f = split(/\s+/, $line);
  if ( @f > 1 && $f[0] eq "ROWHEIGHT" ) {
    $rowHeight = $f[1];
    next;
  }
  next if ( @f > 0 && $f[0] =~ m/^(DBU|DIEAREA|ROWHEIGHT|NODES)$/ );
  next unless ( @f >= 6 );

  my ($node, $name, $kind, $w, $h, $status) = @f[0,1,2,3,4,5];
  #<!-- x and y are fields 6 and 7 when they are there at all.  A record with
  #     no location says the tool left the node alone, so there is nothing to
  #     apply; moving it to the origin would be worse than leaving it. -->
  unless ( @f >= 8 && defined $f[6] && defined $f[7] &&
           $f[6] =~ m/^-?\d+(\.\d+)?$/ && $f[7] =~ m/^-?\d+(\.\d+)?$/ ) {
    $noLocCnt++;
    next;
  }
  my ($x, $y) = ($f[6], $f[7]);

  #<!-- Normalise to lower left immediately, so nothing downstream has to know.
  #
  #     Every nodefile in this flow is lower left: the header says so, and
  #     eplace.py was converted to it so proton would not have to translate.
  #     The switch exists because a centre based writer is a silent failure
  #     rather than a loud one -- its own clamp keeps each BOX inside the die,
  #     so nothing looks wrong in its window, while every block lands half its
  #     own size too far right and up here and one flush to a corner sticks out
  #     by its full extent. -->
  if ( $origin =~ m/^cent/i ) {
    $x -= $w / 2;
    $y -= $h / 2;
  }

  if ( $kind eq "PORT" ) {
    next if ( $noPorts );
    unless ( $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenHasPin($name) ) {
      $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenAddPin($name);
    }
    #<!-- hier_place gives a pin a footprint of its own, but a nodefile written
    #     before any pin placement carries zero size.  A zero area pin rect is
    #     not useful to a router, so fall back to a quarter of the row height,
    #     which is what hier_place itself defaults to. -->
    my ($pw, $ph) = ($w, $h);
    if ( $pw <= 0 || $ph <= 0 ) {
      my $d = ( $rowHeight > 0 ) ? $rowHeight / 4 : 0;
      $pw = $d if ( $pw <= 0 );
      $ph = $d if ( $ph <= 0 );
      $sizedPinCnt++ if ( $d > 0 );
    }
    #<!-- Which layer the shape goes on, most specific first.
    #
    #     A LAYER= token on the record wins.  Nothing writes one today --
    #     hier_place assigns pins across routing layers but its save_nodefile
    #     carries only TYPE=, so that assignment is lost on the way out -- but
    #     reading it costs nothing and means the layer survives the moment the
    #     writer starts emitting it. -->
    my $pinLayer;
    foreach my $tok ( @f[6..$#f] ) {
      if ( defined $tok && $tok =~ m/^LAYER=(\S+)$/ ) {
        $pinLayer = $1;
      }
    }
    #<!-- else the layer the pin was already on -->
    unless ( defined $pinLayer && $pinLayer ne "" ) {
      my @old = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetPinRect($name);
      if ( @old > 0 ) {
        my @v = split(/\s+/, $old[0]);
        if ( @v >= 5 ) {
          $pinLayer = $v[0];
        }
      }
    }
    unless ( defined $pinLayer && $pinLayer ne "" ) {
      $pinLayer = $layer;
    }
    $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenWipePinRect($name);
    my $urx = $x + $pw;
    my $ury = $y + $ph;
    $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenAddPinRect($name,
                                  "$pinLayer $x $y $urx $ury");
    my $pinStatus = ( $status eq "FIXED" ) ? "FIXED" : "PLACED";
    $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenSetPinStatus($name, $pinStatus);
    $portCnt++;
    next;
  }

  unless ( exists $PSEUDO_VINST_ALREADY{$module}{$name} ) {
    $unknownCnt++;
    push(@unknown, $name) if ( @unknown < 5 );
    next;
  }

  my $cellref = $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBGetInstCellref;
  my @rawBox = $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBGetInstRelBbox;
  #<!-- extent of a polygon, not its first two vertices -->
  my @bbox = &dbfTstgenBboxFromCoords(@rawBox);
  my ($newW, $newH) = ($w, $h);
  if ( $noSize || $newW <= 0 || $newH <= 0 ) {
    #<!-- keep whatever box it had, just move it -->
    if ( @bbox >= 4 && defined $bbox[3] &&
         $bbox[2] > $bbox[0] && $bbox[3] > $bbox[1] ) {
      $newW = $bbox[2] - $bbox[0];
      $newH = $bbox[3] - $bbox[1];
    }
  }
  #<!-- A rectilinear instance is held as a polygon.  Writing a rectangle over
  #     it squares it off, which is a real loss, so when only the location is
  #     being applied translate the polygon instead of replacing it: every
  #     vertex shifts by the same delta and the shape survives. -->
  if ( @rawBox > 4 && @bbox >= 4 ) {
    if ( $noSize || (abs($newW - ($bbox[2]-$bbox[0])) < 1e-6 &&
                     abs($newH - ($bbox[3]-$bbox[1])) < 1e-6) ) {
      my $dx = $x - $bbox[0];
      my $dy = $y - $bbox[1];
      my @moved = ();
      for (my $i = 0; $i < @rawBox; $i += 2) {
        push(@moved, $rawBox[$i] + $dx, $rawBox[$i + 1] + $dy);
      }
      $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBSetInstRelBbox(@moved);
      $polyMovedCnt++;
    }
    else {
      $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBSetInstRelBbox(
                                            $x, $y, $x + $newW, $y + $newH);
      $polySquaredCnt++;
    }
  }
  else {
    $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBSetInstRelBbox(
                                          $x, $y, $x + $newW, $y + $newH);
  }
  $PSEUDO_VINST_ALREADY{$module}{$name}->dbPimDBSetInstStatus(
                                        ($status eq "FIXED") ? "FIXED" : "PLACED");
  $instCnt++;

  #<!-- A reshaped instance has to tell its child module, or the box drawn in
  #     the parent and the size seen on descend disagree.
  #
  #     What counts as a reshape needs care.  An instance that was never placed
  #     has no box at all, and write_pseudo_graph filled the size in from the
  #     child, so a difference against an absent box is not a change the user
  #     made -- it is the writer's own fallback coming back.  Compare against
  #     the box if it had a usable one, and against the child's size if it did
  #     not. -->
  unless ( $noSize ) {
    my ($oldW, $oldH) = (0, 0);
    if ( @bbox >= 4 && defined $bbox[3] &&
         $bbox[2] > $bbox[0] && $bbox[3] > $bbox[1] ) {
      $oldW = $bbox[2] - $bbox[0];
      $oldH = $bbox[3] - $bbox[1];
    }
    else {
      ($oldW, $oldH) = &dbfTstgenHierChildSize($cellref);
    }
    if ( abs($newW - $oldW) > 1e-6 || abs($newH - $oldH) > 1e-6 ) {
      if ( defined $cellref && exists $PSEUDO_MODULE_ALREADY{$cellref} ) {
        $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenSetSize(0, 0, $newW, $newH);
        $PSEUDO_MODULE_ALREADY{$cellref}->dbaTstgenSetPhysicalDirty(1);
      }
      $reshapeCnt++;
    }
  }
}
close(READ_PSEUDO_ND);

if ( $instCnt > 0 || $portCnt > 0 ) {
  $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenSetPhysicalDirty(1);
}

print "INFO-TST-RD_PS_ND : 005 : placed $instCnt instance(s) and $portCnt port(s) of $module from $inFile\n";
if ( $reshapeCnt > 0 ) {
  print "INFO-TST-RD_PS_ND : 006 : $reshapeCnt instance(s) were reshaped, their child module size was updated too\n";
}
if ( $polyMovedCnt > 0 ) {
  print "INFO-TST-RD_PS_ND : 012 : $polyMovedCnt rectilinear instance(s) were translated, keeping their shape\n";
}
if ( $polySquaredCnt > 0 ) {
  print "WARN-TST-RD_PS_ND : 013 : $polySquaredCnt rectilinear instance(s) were resized and so squared off\n";
  print "WARN-TST-RD_PS_ND : 014 : pass --no_size to move them without losing the shape\n";
}
if ( $sizedPinCnt > 0 ) {
  print "INFO-TST-RD_PS_ND : 007 : $sizedPinCnt pin(s) had no footprint in the file and were given a quarter of the row height\n";
}
if ( $noLocCnt > 0 ) {
  print "INFO-TST-RD_PS_ND : 008 : $noLocCnt record(s) carry no location and were left alone\n";
}
if ( $unknownCnt > 0 ) {
  print "WARN-TST-RD_PS_ND : 009 : $unknownCnt name(s) in the file are not instances of $module: ",
        join(" ", @unknown), "\n";
}

my $t1 = new Benchmark;
my $td = timediff($t1, $t0);
print "Command read_pseudo_nodefile took:",timestr($td),"\n";

}# sub read_pseudo_nodefile


#****f* /write_pseudo_graph
#  write_pseudo_graph
# FUNCTION
#  The hierarchical counterpart of write_flat_graph: the same nodefile and the
#  same two column edge list, but over the hierarchical instances of a module
#  rather than over the flat components of the design.  That makes the flat
#  placement suite -- flat_graph_placer, eplacer, mincut_placer and seedPlace --
#  usable on a module that is checked out with edit_module, without committing
#  it first.
#
#  Edges come from the VNOM conn lines, through dbfTstgenHierNetToInst, which is
#  what hier_connectivity uses.  That is deliberate: it needs no net objects, so
#  it works after edit_module --physical_only, where PSEUDO_VNET_ALREADY is
#  empty and a net based writer would produce a graph with no edges at all.
#
#  A net there is a set of instances with no direction, while the edge list
#  wants "<driver> <sink>".  Each net is written as a star out of one member.
#  The centre is a real driver when the child cell says so -- an output pin on
#  that net -- and otherwise the first member in sorted order, which is
#  synthetic and counted as such.  All three consumers treat the direction as
#  carrying no information (mincut says so outright, eplace builds an
#  undirected adjacency), so a synthetic centre costs nothing there; it only
#  matters to anchor_hypergraph's loop breaking.
#****
sub write_pseudo_graph {

use Benchmark;
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $module = $TOP_MODULE;
my $nodeFile;
my $graphFile;
my $fanoutLimit = 0;
my $nodeFileOnly = 0;
my $hierOnly = 0;
my $anchorMode = 0;

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : write_pseudo_graph -module <module name>\n";
  print "                           -nodefile <file name>\n";
  print "                           -graph <file name>\n";
  print "                           -fanout_limit <high fan out threshold>\n";
  print "                           --hier_only\n";
  print "                                 only hierarchical instances, no leaf cells.\n";
  print "                                 Nets through a leaf cell are LOST: prefer --anchors\n";
  print "                           --anchors\n";
  print "                                 keep hierarchical instances, sequential cells,\n";
  print "                                 memories, hard blocks and ports, and collapse each\n";
  print "                                 cone of combinational logic between them into one\n";
  print "                                 hyperedge, so connectivity through logic survives\n";
  print "                           --nodefile_only\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-module")        { $module = $_[$i+1]; }
  elsif ($_[$i] eq "-nodefile")      { $nodeFile = $_[$i+1]; }
  elsif ($_[$i] eq "-graph")         { $graphFile = $_[$i+1]; }
  elsif ($_[$i] eq "-fanout_limit")  { $fanoutLimit = $_[$i+1]; }
  elsif ($_[$i] eq "--hier_only")    { $hierOnly = 1; }
  elsif ($_[$i] eq "--anchors")      { $anchorMode = 1; }
  elsif ($_[$i] eq "--nodefile_only"){ $nodeFileOnly = 1; }
  elsif ($_[$i] =~ m/^-+\w/)         { print "WARN-TST-WR_PS_GRPH : 001 : invalid option $_[$i]\n"; }
}

unless ( defined $module && $module ne "" && exists $PSEUDO_MODULE_ALREADY{$module} ) {
  print "ERR-TST-WR_PS_GRPH : 002 : module $module is not being edited, run edit_module first\n";
  return;
}
unless ( defined $nodeFile && $nodeFile ne "" ) { $nodeFile = "$module.pseudo.nodefile"; }
unless ( defined $graphFile && $graphFile ne "" ) { $graphFile = "$module.pseudo.txt"; }

my $dbu = $GLOBAL->dbfGlobalGetDBU;
unless ( defined $dbu && $dbu > 0 ) { $dbu = 1; }
my $rowHeight = $GLOBAL->dbGlobalGetRowHeight;
unless ( defined $rowHeight && $rowHeight > 0 ) { $rowHeight = 0; }

#<!-- dbaTstgenGetSize returns microns already, unlike the flat floorplan -->
my @size = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetSize;
unless ( @size >= 4 && defined $size[3] ) {
  print "ERR-TST-WR_PS_GRPH : 003 : module $module has no floorplan size, nothing to write\n";
  return;
}
if ( $size[2] <= $size[0] || $size[3] <= $size[1] ) {
  my $w = $size[2] - $size[0];
  my $h = $size[3] - $size[1];
  print "ERR-TST-WR_PS_GRPH : 004 : module $module has no area (width $w, height $h)\n";
  return;
}

#-------------------------------- collect the nodes -------------------------------#
#<!-- Ports first then instances, the numbering the flat writer uses, so the
#     files are interchangeable as far as every consumer is concerned. -->
my %PSEUDO_NODE_NUM = ();
my @nodeLines = ();
my %typeCnt = ();
my $nodeCnt = 0;
my $noSizeCnt = 0;
my $polyCnt = 0;
my $collapsedCnt = 0;
my $undCollapsedCnt = 0;

#<!-- Ports.
#
#     dbaTstgenGetPins is the FLOORPLAN's pin list: it only holds pins that have
#     a shape.  A module that has never had pin placement done has logical ports
#     and no floorplan pins at all, so taking that list alone wrote no port
#     nodes.  That is most visible under --hier_only, where the ports are much
#     of what is left after the leaf cells go.
#
#     Take the union instead.  The logical port lists say what exists, the
#     floorplan says where it is.  Buses are blasted to bits, since a net in the
#     conn lines is data[3] while a logical port list carries data, and a base
#     name would match no net and connect to nothing. -->
my %portSeen = ();
my @ports = ();
foreach my $pin ( $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetPins ) {
  next if ( ! defined $pin || $pin eq "" || exists $portSeen{$pin} );
  $portSeen{$pin} = 1;
  push(@ports, $pin);
}
foreach my $port ( $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInput,
                   $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetOutput,
                   $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidi ) {
  next if ( ! defined $port || $port eq "" );
  my @bits = &dbfTstgenBlastModuleBusPins($module, $port);
  unless ( @bits ) {
    @bits = ($port);   #<!-- not a bus, or its width is not recorded -->
  }
  foreach my $bit ( @bits ) {
    next if ( ! defined $bit || $bit eq "" || exists $portSeen{$bit} );
    $portSeen{$bit} = 1;
    push(@ports, $bit);
  }
}

#<!-- bits of each bussed port, keyed by base name, so that a net written as the
#     whole bus or as a range can be resolved back to the port nodes it covers -->
my %PORT_BITS_BY_BASE = ();

my $portLocCnt = 0;
foreach my $pin ( sort @ports ) {
  $PSEUDO_NODE_NUM{$pin} = $nodeCnt;
  if ( $pin =~ m/^(.*)\[(\d+)\]$/ ) {
    $PORT_BITS_BY_BASE{$1}{$2} = $pin;
  }
  my $line = "$nodeCnt $pin PORT 0 0 ";
  #<!-- the pseudo pin status is a number: 3 FIXED, 2 PLACED, 1 GUIDED -->
  my $st = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetPinStatus($pin);
  my @shapes = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetPinRect($pin);
  my ($px, $py);
  if ( @shapes > 0 ) {
    #<!-- "<layer> x1 y1 x2 y2" in microns, take the shape's lower left -->
    my @v = split(/\s+/, $shapes[0]);
    if ( @v >= 4 ) {
      $px = $v[$#v - 3];
      $py = $v[$#v - 2];
    }
  }
  if ( defined $px && defined $py && $st >= 2 ) {
    $line .= ( $st == 3 ? "FIXED" : "PLACED" ) . " $px $py";
    $portLocCnt++;
  }
  else {
    $line .= "UNPLACED";
  }
  $line .= " TYPE=port";
  $typeCnt{port}++;
  push(@nodeLines, $line);
  $nodeCnt++;
}

foreach my $inst ( sort keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
  if ( $inst eq "PIN" ) {
    next;  #<!-- the port pseudo instance, already written above -->
  }
  my $cellref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
  if ( $hierOnly && ! exists $PSEUDO_MODULE_ALREADY{$cellref} &&
       ! exists $MODULE_ALREADY{$cellref} ) {
    next;
  }
  #<!-- anchor mode keeps the same hierarchical instances plus the leaf cells
  #     whose position matters on its own: seq, mem and hard blocks.  The rest
  #     stay out of the nodefile and are collapsed into hyperedges below. -->
  if ( $anchorMode && ! &dbfTstgenPseudoIsAnchor($module, $inst) ) {
    $collapsedCnt++;
    my $t = &dbfFlatNodeType($cellref);
    $undCollapsedCnt++ if ( $t eq "und" );
    next;
  }

  #<!-- RelBbox is in microns: dbfTstgenLoadVNOMFlplan divides by the dbu on
  #     the way in.  Location comes from it and only from it.
  #
  #     And it is a coordinate LIST, not necessarily four numbers: a rectilinear
  #     instance holds a polygon, so bbox[2] and bbox[3] are its second vertex
  #     rather than the upper right corner.  Reading them as an extent is the
  #     same mistake dbfTstgenDownHierFlplan made, where a polygon gave a height
  #     of zero.  dbfTstgenBboxFromCoords is the helper that was added for it. -->
  my @rawBox = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstRelBbox;
  my @bbox = &dbfTstgenBboxFromCoords(@rawBox);
  my ($w, $h) = (0, 0);
  my ($x, $y);
  if ( @bbox >= 4 && defined $bbox[3] ) {
    $w = $bbox[2] - $bbox[0];
    $h = $bbox[3] - $bbox[1];
    ($x, $y) = ($bbox[0], $bbox[1]);
    $polyCnt++ if ( @rawBox > 4 );
  }
  #<!-- Size is a separate question from location, and has a separate answer.
  #
  #     An instance whose bbox was never filled in still has a size, and the
  #     Hier-View already works it out: return_pseudo_vinst_size, which falls
  #     back through the LEF, the child's own pseudo size, and finally an
  #     estimate from the child's cell area at 70% utilization.  edit_module
  #     never writes that back -- dbfTstgenLoadVNOMInsts sets no bbox and
  #     dbfTstgenCalcInstSizeFromChildFlplan only fills one in for a child that
  #     has its own floorplan -- so the database really is empty here while the
  #     GUI shows a box.
  #
  #     Call the same function rather than a second opinion: a placement built
  #     on sizes that disagree with what is on screen is not debuggable. -->
  if ( $w <= 0 || $h <= 0 ) {
    my @guiBox = &return_pseudo_vinst_size($module, $inst);
    if ( @guiBox >= 4 && defined $guiBox[3] ) {
      my $gw = $guiBox[2] - $guiBox[0];
      my $gh = $guiBox[3] - $guiBox[1];
      $w = $gw if ( $gw > 0 );
      $h = $gh if ( $gh > 0 );
    }
  }
  #<!-- and one more source it does not know about, the child's flat floorplan
  #     reached through FLOORPLAN_LOOKUP -->
  if ( $w <= 0 || $h <= 0 ) {
    my ($cw, $ch) = &dbfTstgenHierChildSize($cellref);
    $w = $cw if ( $cw > 0 );
    $h = $ch if ( $ch > 0 );
  }
  if ( $w < 0 ) { $w = 0; }
  if ( $h < 0 ) { $h = 0; }
  if ( $w <= 0 || $h <= 0 ) { $noSizeCnt++; }

  my $status = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstStatus;
  $PSEUDO_NODE_NUM{$inst} = $nodeCnt;
  my $line = "$nodeCnt $inst INST $w $h ";
  if ( defined $x && defined $y &&
       ($status eq "FIXED" || $status eq "PLACED") ) {
    $line .= "$status $x $y";
  }
  else {
    $line .= "UNPLACED";
  }
  my $nodeType = &dbfFlatNodeType($cellref);
  $line .= " TYPE=$nodeType";
  $typeCnt{$nodeType}++;
  push(@nodeLines, $line);
  $nodeCnt++;
}

unless ( $nodeCnt > 0 ) {
  print "ERR-TST-WR_PS_GRPH : 005 : module $module has no instances or pins, nothing to write\n";
  return;
}

#-------------------------------- write the nodefile ------------------------------#
unless ( open(WRITE_PSEUDO_NODE, ">$nodeFile") ) {
  print "ERR-TST-WR_PS_GRPH : 006 : cannot open $nodeFile for writing\n";
  return;
}
print WRITE_PSEUDO_NODE "# hierarchical placement nodes for $module, written by electron\n";
print WRITE_PSEUDO_NODE "# all coordinates and dimensions are in microns\n";
print WRITE_PSEUDO_NODE "# <node> <name> INST|PORT <width> <height> <status> [<x> <y>] TYPE=<node type>\n";
print WRITE_PSEUDO_NODE "# a status of FIXED means the placer must not move the node\n";
print WRITE_PSEUDO_NODE "# node type is one of combi seq mem block phys port, or und when nothing\n";
print WRITE_PSEUDO_NODE "#   described the cell -- read a liberty or a cell function map to fill it in\n";
print WRITE_PSEUDO_NODE "DBU $dbu\n";
print WRITE_PSEUDO_NODE "DIEAREA $size[0] $size[1] $size[2] $size[3]\n";
print WRITE_PSEUDO_NODE "ROWHEIGHT $rowHeight\n";
print WRITE_PSEUDO_NODE "NODES $nodeCnt\n";
foreach my $line ( @nodeLines ) {
  print WRITE_PSEUDO_NODE "$line\n";
}
close(WRITE_PSEUDO_NODE);
print "INFO-TST-WR_PS_GRPH : 007 : wrote $nodeCnt nodes of $module to $nodeFile\n";
my @typeSummary = ();
foreach my $t ( sort keys %typeCnt ) {
  push(@typeSummary, "$t $typeCnt{$t}");
}
print "INFO-TST-WR_PS_GRPH : 008 : node types: ", join(", ", @typeSummary), "\n";
if ( $anchorMode ) {
  print "INFO-TST-WR_PS_GRPH : 023 : $collapsedCnt instance(s) are not anchors and were collapsed into hyperedges\n";
  if ( $undCollapsedCnt > 0 ) {
    print "WARN-TST-WR_PS_GRPH : 024 : $undCollapsedCnt of them have a cell nothing described (und), so\n";
    print "WARN-TST-WR_PS_GRPH : 025 : a sequential cell among them would be collapsed away instead of\n";
    print "WARN-TST-WR_PS_GRPH : 026 : anchored.  Read a liberty or a cell function map to type them.\n";
  }
}
if ( exists $typeCnt{port} && $portLocCnt < $typeCnt{port} ) {
  my $noLoc = $typeCnt{port} - $portLocCnt;
  print "INFO-TST-WR_PS_GRPH : 019 : $noLoc of $typeCnt{port} port(s) have no location and are written UNPLACED\n";
}
if ( $polyCnt > 0 ) {
  print "WARN-TST-WR_PS_GRPH : 020 : $polyCnt instance(s) are rectilinear; their bounding box\n";
  print "WARN-TST-WR_PS_GRPH : 021 : is written instead, and reading a placement back will\n";
  print "WARN-TST-WR_PS_GRPH : 022 : square them off unless read_pseudo_nodefile is given --no_size\n";
}
if ( $noSizeCnt > 0 ) {
  print "WARN-TST-WR_PS_GRPH : 015 : $noSizeCnt instance(s) have no size: neither the\n";
  print "WARN-TST-WR_PS_GRPH : 016 : instance nor its cell knows how big it is.  A placer\n";
  print "WARN-TST-WR_PS_GRPH : 017 : sees them as zero area, so they exert no density.\n";
  print "WARN-TST-WR_PS_GRPH : 018 : floorplan the child modules, or read a LEF for the leaf cells.\n";
}

if ( $nodeFileOnly ) {
  my $t1 = new Benchmark;
  my $td = timediff($t1, $t0);
  print "Command write_pseudo_graph took:",timestr($td),"\n";
  return;
}

#-------------------------------- write the graph ---------------------------------#
#<!-- Anchor mode reads the connectivity in FULL -- hierOnly 0 -- and does its
#     thinning afterwards.  That is the whole point of it: --hier_only drops the
#     leaf cells while the nets are being collected, so a connection that runs
#     hier_A -> buffer -> hier_B is two different nets, neither with two hier
#     members, and it disappears rather than being collapsed. -->
my ($netToInst, $netToPin) =
    &dbfTstgenHierNetToInst($module, ($anchorMode ? 0 : $hierOnly), 1);

unless ( open(WRITE_PSEUDO_GRAPH, ">$graphFile") ) {
  print "ERR-TST-WR_PS_GRPH : 009 : cannot open $graphFile for writing\n";
  return;
}

my $defaultFanout = $GLOBAL->dbfGlobalGetFanoutLimit;
if ( $fanoutLimit == 0 && defined $defaultFanout && $defaultFanout > 0 ) {
  $fanoutLimit = $defaultFanout;
}

#<!-- the module's own inputs, for the port case in the centre pick below -->
my %modInput = map { $_ => 1 }
    ( $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetInput,
      $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetBidi );

my ($netCnt, $edgeCnt, $skipCnt, $noNodeCnt, $synthCnt, $unknownCnt) = (0,0,0,0,0,0);
my $noPortNodeCnt = 0;

#-------------------------- group the nets into hyperedges ------------------------#
#<!-- Normally one net is one hyperedge.  In anchor mode a hyperedge is a whole
#     CONE: the nets and non-anchor instances reachable from each other, which
#     is one connected component of the net/instance incidence graph once the
#     anchors are removed from it.  Union the nets with the non-anchor instances
#     they touch, and every net that shares a buffer, an inverter or a chain of
#     them ends up under one root.
#
#     The anchors themselves are never unioned, so they terminate a cone instead
#     of merging the cones on either side of them -- otherwise the whole design
#     would collapse to a single hyperedge. -->
my @groups = ();
if ( $anchorMode ) {
  my %parent = ();
  foreach my $net ( sort keys %$netToInst ) {
    &dbfTstgenUFFind(\%parent, "N:$net");
    foreach my $inst ( sort keys %{$netToInst->{$net}} ) {
      next if ( $inst eq "PIN" );
      next if ( exists $PSEUDO_NODE_NUM{$inst} );   #<!-- an anchor, stop here -->
      &dbfTstgenUFUnion(\%parent, "N:$net", "I:$inst");
    }
  }
  my %cone = ();
  foreach my $net ( sort keys %$netToInst ) {
    my $root = &dbfTstgenUFFind(\%parent, "N:$net");
    push(@{$cone{$root}}, $net);
  }
  foreach my $root ( sort keys %cone ) {
    push(@groups, $cone{$root});
  }
}
else {
  foreach my $net ( sort keys %$netToInst ) {
    push(@groups, [$net]);
  }
}

foreach my $group ( @groups ) {
  my @groupNets = @$group;
  #<!-- only members that made it into the nodefile.  In anchor mode that is the
  #     anchors, and the non-anchor instances of the cone are what got us here
  #     rather than being endpoints themselves. -->
  my @members = ();
  foreach my $net ( @groupNets ) {
    foreach my $inst ( sort keys %{$netToInst->{$net}} ) {
      if ( exists $PSEUDO_NODE_NUM{$inst} ) {
        push(@members, $inst);
      }
      elsif ( $inst eq "PIN" ) {
        #<!-- the net is tied to a port of this module.  The net may be a bit,
        #     a range or the whole bus, so ask which port nodes it covers
        #     rather than assuming it is named like one. -->
        my @portNodes = &dbfTstgenPortNodesForNet($net, \%PSEUDO_NODE_NUM,
                                                  \%PORT_BITS_BY_BASE);
        if ( @portNodes ) {
          push(@members, @portNodes);
        }
        else {
          $noPortNodeCnt++;
        }
      }
      elsif ( ! $anchorMode ) {
        $noNodeCnt++;
      }
    }
  }
  #<!-- one instance twice on a net is one node, and one node is no edge -->
  my %uniq = map { $PSEUDO_NODE_NUM{$_} => $_ } @members;
  my @nodes = sort { $a <=> $b } keys %uniq;
  if ( @nodes < 2 ) {
    next;
  }
  if ( $fanoutLimit > 0 && @nodes >= $fanoutLimit ) {
    $skipCnt++;
    next;
  }

  #<!-- Pick the star centre: a member whose pin on this net is an output.
  #
  #     A port of the module being edited is its own case, and the sense is
  #     inverted from the outside view: an INPUT port is what drives the net
  #     inside the module, and an output port is driven by it. -->
  my $centre;
  my $sawUnknown = 0;
  foreach my $node ( @nodes ) {
    my $inst = $uniq{$node};
    unless ( exists $PSEUDO_VINST_ALREADY{$module}{$inst} ) {
      #<!-- the port node is a bit, data[0], while the input list holds data -->
      my $portBase = $inst;
      $portBase =~ s/\[.*$//;
      if ( exists $modInput{$inst} || exists $modInput{$portBase} ) {
        $centre = $node;
        last;
      }
      next;
    }
    my $cellref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
    #<!-- a cone spans several nets, and the anchor drives it if it drives any
    #     one of them; outside anchor mode this is the single net as before -->
    foreach my $gnet ( @groupNets ) {
      next unless ( exists $netToPin->{$gnet}{$inst} );
      foreach my $pin ( sort keys %{$netToPin->{$gnet}{$inst}} ) {
        my $drives = &dbfTstgenHierPinDrives($cellref, $pin);
        if ( $drives == 1 ) { $centre = $node; last; }
        if ( $drives < 0 )  { $sawUnknown = 1; }
      }
      last if ( defined $centre );
    }
    last if ( defined $centre );
  }
  unless ( defined $centre ) {
    $centre = $nodes[0];
    $synthCnt++;
    $unknownCnt++ if ( $sawUnknown );
  }

  $netCnt++;
  foreach my $node ( @nodes ) {
    next if ( $node == $centre );
    print WRITE_PSEUDO_GRAPH "$centre $node\n";
    $edgeCnt++;
  }
}
close(WRITE_PSEUDO_GRAPH);

my $groupWord = ( $anchorMode ? "logic cones" : "nets" );
print "INFO-TST-WR_PS_GRPH : 010 : wrote $edgeCnt edges from $netCnt $groupWord of $module to $graphFile\n";
if ( $anchorMode ) {
  my $totalNets = keys %$netToInst;
  print "INFO-TST-WR_PS_GRPH : 027 : $totalNets net(s) of the full graph collapsed into $netCnt cone(s)\n";
}
if ( $synthCnt > 0 ) {
  print "INFO-TST-WR_PS_GRPH : 011 : $synthCnt net(s) had no identifiable driver, ",
        "the first member was used as the star centre\n";
}
if ( $unknownCnt > 0 ) {
  print "WARN-TST-WR_PS_GRPH : 012 : $unknownCnt of those had a pin on a cell that is ",
        "not in the library or the pseudo database, so no direction could be read\n";
}
if ( $skipCnt > 0 ) {
  print "INFO-TST-WR_PS_GRPH : 013 : $skipCnt high fan out nets skipped\n";
}
if ( $noNodeCnt > 0 ) {
  print "INFO-TST-WR_PS_GRPH : 014 : $noNodeCnt connection(s) are to instances not in the nodefile\n";
}
if ( $noPortNodeCnt > 0 ) {
  print "WARN-TST-WR_PS_GRPH : 028 : $noPortNodeCnt net(s) reach a port of $module whose bits are\n";
  print "WARN-TST-WR_PS_GRPH : 029 : not in the nodefile, so those connections were dropped\n";
}

my $t1 = new Benchmark;
my $td = timediff($t1, $t0);
print "Command write_pseudo_graph took:",timestr($td),"\n";

}# sub write_pseudo_graph


sub write_hier_place_graph {
use Benchmark;
my $t0 = new Benchmark;
my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $moduleName = $TOP_MODULE;
my $pinMode = 0;
local $incrMode = 0;
my $fanOutLimit = 0;

if ( $_[0] eq '-h') { print "Usage : write_hier_place_graph -module <module name>\n";
  print "                               --pin\n";
  print "                               --incr\n";
  print "                               -fanout_limit <high fan out threshold>\n";
}
else {
for (my $i = 0; $i < $noOfArguments; $i++) {
if ($_[$i] eq "-module") {$moduleName = $_[$i+1];}
elsif ($_[$i] eq "-fanout_limit") {$fanOutLimit = $_[$i+1];}
elsif ($_[$i] eq "--pin") {$pinMode = 1;}
elsif ($_[$i] eq "--incr") {$incrMode = 1;}
elsif ( $_[$i] =~ m/^-+\w/) { print "WARN-TST-WR_HR_PL_GRPH : 001 : invalid option $_[$i]\n"; }
} # for
&writeHierPlaceGraph($moduleName, $pinMode, $fanOutLimit);

}
my $t1 = new Benchmark;
