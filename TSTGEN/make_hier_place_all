#<!-- hier_place_all: place a whole hierarchy, one module at a time.
#
#     WHAT IT DRIVES
#
#     Everything here already existed as a single-module command.  Placing one
#     module by hand is:
#
#         edit_module   -module M      open M, take its box from the parent
#         hier_place    -module M      blocks, flops and ports
#         hier_place_cells -module M   the combinational logic around them
#         commit_module -module M --physical_only
#
#     and that is exactly what this runs, once per module, walking down from
#     the top.  Nothing new is placed by this file; what is new is the order
#     and the bookkeeping, because getting either wrong silently loses a
#     placement.
#
#     WHY THE ORDER IS TOP DOWN AND WHY EACH LEVEL MUST BE COMMITTED
#
#     A module has no size of its own until something gives it one.  What gives
#     it one is its instance box in the PARENT's floorplan:
#     dbfTstgenCalcModuleSizeFromParentFlplan reads the parent floorplan's hier
#     inst extent and hands it to the child.  The parent floorplan only carries
#     that box once the parent has been committed.
#
#     So the parent must be placed AND committed before the child is opened.
#     Open the child first and it comes up with no box, which a placer reads as
#     zero area -- no density, nothing to spread, and every node lands on top
#     of every other.
#
#     WHY THE WALK IS OVER DISTINCT MODULES, NOT INSTANCES
#
#     A module's internal placement is stored once, in its own floorplan.  Two
#     instances of the same module therefore share one arrangement -- there is
#     nowhere to put a second one.  The walk visits each module once and says
#     so when a module has more than one instance, because the boxes then have
#     to agree: whichever instance the size is taken from, the other instances
#     get the same contents, and a smaller box would have those contents
#     hanging outside it.
#
#     Visiting distinct modules also terminates on a cycle, which a verilog
#     netlist cannot have but a hand-built VNOM can.
#
#     THE TWO MODES THE FLOW ASKED FOR
#
#     Auto, the default: every module in the walk is placed by the tool.
#
#     Interactive top, auto rest -- --skip_placed.  Place the top, or the top
#     few levels, by hand with the GUI, then hand the rest over:
#
#         edit_module --top
#         hier_place                      the window, a person, a mouse
#         commit_module --physical_only
#         hier_place_all --skip_placed
#
#     A module whose floorplan already places something keeps that arrangement:
#     hier_place is not run on it.  hier_place_cells still is, so the
#     combinational logic gets filled in around the hand placement rather than
#     left at the origin -- the blocks and flops a person placed come back
#     PLACED and are written FIXED, so they cannot move.  -depth stops the walk
#     at a level if you would rather do the lower ones yourself.
#
#     WHAT IT DOES NOT DO
#
#     It does not legalise unless asked.  hier_place spreads on a continuous
#     field and snaps nothing to a row, so every level comes out overlapping
#     and off grid.  Either legalize the flat database once, after hier2flat
#     (legalize_flat), or give --legalize and each module is legalized on its
#     own rows before its commit (legalize_module), so hier2flat copies legal
#     arrangements -- the hierarchy's reuse, kept through legalisation.
#
#     It does not route, and it does not size a module by anything but its
#     parent's box: -util is passed to edit_module for the one case where there
#     is no parent box to inherit. -->


#<!-- The floorplan of a module, by cellref.
#
#     Deliberately not get_floorplanID_of_module, whose last resort is
#     $flplanName =~ /$module/ -- an unanchored substring match that hands back
#     a different module's floorplan whenever one name contains another, which
#     in a design of vedic_2x2 and vedic_4x4 is most of them. -->
sub dbfTstgenHierModuleFlplanID {

my ($module) = @_;
unless ( defined $module && $module ne "" ) {
  return 0;
}
if ( exists $FLOORPLAN_LOOKUP{"$module/_self_"} ) {
  return $FLOORPLAN_LOOKUP{"$module/_self_"};
}
if ( exists $FLOORPLAN_LOOKUP{$module} ) {
  return $FLOORPLAN_LOOKUP{$module};
}
foreach my $id ( sort keys %FLOORPLAN_ALREADY ) {
  if ( $FLOORPLAN_ALREADY{$id}->dbFlplanGetCellref eq $module ) {
    return $id;
  }
}
return 0;

}# sub dbfTstgenHierModuleFlplanID


#<!-- Has anything in this module's floorplan actually been placed?
#
#     "Has a box" is not the question.  edit_module gives every instance a box
#     the moment it learns the instance's size, and hier2flat marks a leaf
#     PLACED on the strength of its orientation alone, so an untouched module
#     is full of instances that carry a size and sit at ( 0 0 ).  The question
#     is whether anything sits anywhere ELSE.
#
#     One instance legitimately at exactly the origin therefore reads as
#     unplaced.  That is the direction to be wrong in: the cost is re-placing a
#     module, where believing an unplaced module is placed leaves the whole
#     level stacked in the corner and says nothing. -->
sub dbfTstgenHierModuleIsPlaced {

my ($module) = @_;

my $flplanID = &dbfTstgenHierModuleFlplanID($module);
unless ( $flplanID && exists $FLOORPLAN_ALREADY{$flplanID} ) {
  return 0;
}

foreach my $inst ( $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetHierInstList ) {
  my @ext = $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetHierInstExtent($inst);
  if ( @ext >= 4 && ($ext[0] != 0 || $ext[1] != 0) ) {
    return 1;
  }
}
foreach my $inst ( $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetLeafInstList ) {
  my @loc = $FLOORPLAN_ALREADY{$flplanID}->dbFlplanGetLeafInstLoc($inst);
  if ( @loc >= 2 && ($loc[0] != 0 || $loc[1] != 0) ) {
    return 1;
  }
}

return 0;

}# sub dbfTstgenHierModuleIsPlaced


#<!-- Cell area a module needs, with a whitespace budget at every level.
#
#     edit_module sizes every module at one utilization of its own subtree's
#     cell area, all the way down.  So a parent's box is exactly its own cells
#     at that utilization plus its children's boxes: the children fill it and
#     there is no room to arrange them.  On a 6.7M-cell tile the top level's
#     sixteen column blocks covered 99.6% of their parent and overlapped, and
#     everything below -- placement and legalization -- paid for it.
#
#     effective(m) = own cell area + sum over child instances of
#                    effective(child) / pack
#
#     and box = effective / util.  pack = 1 - whitespace: each level keeps
#     that fraction of its children's area free to arrange them in.  It
#     compounds -- k nested levels of blocks cost pack^k -- which the top level
#     reports when it does not fit.  Memoized per module definition. -->
sub dbfTstgenHierEffArea {

my ($module, $pack, $memo) = @_;
return $memo->{$module} if ( exists $memo->{$module} );
return 0 unless ( exists $MODULE_ALREADY{$module} );
my $own = 0;
foreach my $inst ( $MODULE_ALREADY{$module}->dbVNOMGetLeafInst ) {
  my $ref = $MODULE_ALREADY{$module}->dbVNOMGetLeafInstCell($inst);
  next unless ( defined $ref && exists $PLDB{$ref} );
  my @sz = $PLDB{$ref}->dbMdbGetSize;
  $own += $sz[0] * $sz[1] if ( @sz >= 2 );
}
my $kids = 0;
foreach my $inst ( $MODULE_ALREADY{$module}->dbVNOMGetHierInst ) {
  my $ref = $MODULE_ALREADY{$module}->dbVNOMGetHierInstCell($inst);
  next unless ( defined $ref && exists $MODULE_ALREADY{$ref} );
  $kids += &dbfTstgenHierEffArea($ref, $pack, $memo);
}
$memo->{$module} = $own + $kids / $pack;
return $memo->{$module};

}# sub dbfTstgenHierEffArea


#<!-- How much room a module's children need to be arranged, as a packing
#     factor: 1 when there is nothing to arrange -- no children, one child, or
#     identical children that tile a square grid exactly (the 4x4 columns) --
#     and 1 - mixed whitespace otherwise.  Charging every level the same
#     whitespace compounded: 5% over five levels cost 17 points of die
#     utilization on a tile whose levels were mostly one child or an exact
#     array. -->
sub dbfTstgenHierPack {

my ($module, $packMixed) = @_;
return 1 unless ( exists $MODULE_ALREADY{$module} );
my %byRef = ();
my $n = 0;
foreach my $inst ( $MODULE_ALREADY{$module}->dbVNOMGetHierInst ) {
  my $ref = $MODULE_ALREADY{$module}->dbVNOMGetHierInstCell($inst);
  next unless ( defined $ref && exists $MODULE_ALREADY{$ref} );
  $byRef{$ref}++;
  $n++;
}
return 1 if ( $n <= 1 );
if ( scalar(keys %byRef) == 1 ) {
  my $k = int( sqrt($n) + 0.5 );
  return 1 if ( $k * $k == $n );
}
return $packMixed;

}# sub dbfTstgenHierPack


#<!-- The budget model: the area a module's box needs.
#
#       box(m) = macros(m) x (1 + halo) + own cells(m) / u
#              + sum over child instances of box(child) / pack(m)
#
#     Hard macros take a halo and no utilization slack; standard cells take
#     the one utilization u solved for the whole tree; children take the
#     packing factor of dbfTstgenHierPack.  Memoized per module and u.
#
#     A module's own cell and macro area does not depend on u, and the
#     bisection asks for the whole tree forty times: on a 3M-instance tile,
#     summing the leaf cells again each time was 118 s of a 212 s top-only
#     re-place.  %HIER_OWN_AREA keeps them for one hier_place_all call, which
#     clears it on entry, so a netlist edited between calls is read again. -->
sub dbfTstgenHierBudgetArea {

my ($module, $u, $packMixed, $halo, $memo) = @_;
return $memo->{$module} if ( exists $memo->{$module} );
return 0 unless ( exists $MODULE_ALREADY{$module} );
unless ( exists $HIER_OWN_AREA{$module} ) {
  my ($s, $m) = (0, 0);
  foreach my $inst ( $MODULE_ALREADY{$module}->dbVNOMGetLeafInst ) {
    my $ref = $MODULE_ALREADY{$module}->dbVNOMGetLeafInstCell($inst);
    next unless ( defined $ref && exists $PLDB{$ref} );
    my @sz = $PLDB{$ref}->dbMdbGetSize;
    next unless ( @sz >= 2 );
    my $class = $PLDB{$ref}->dbMdbGetClass;
    if ( defined $class && $class ne "" && $class !~ m/^CORE/ ) { $m += $sz[0] * $sz[1]; }
    else                                                         { $s += $sz[0] * $sz[1]; }
  }
  $HIER_OWN_AREA{$module} = [ $s, $m, &dbfTstgenHierPack($module, $packMixed) ];
}
my ($std, $mac, $pk) = @{$HIER_OWN_AREA{$module}};
my $kids = 0;
foreach my $inst ( $MODULE_ALREADY{$module}->dbVNOMGetHierInst ) {
  my $ref = $MODULE_ALREADY{$module}->dbVNOMGetHierInstCell($inst);
  next unless ( defined $ref && exists $MODULE_ALREADY{$ref} );
  $kids += &dbfTstgenHierBudgetArea($ref, $u, $packMixed, $halo, $memo);
}
$memo->{$module} = $mac * (1 + $halo) + $std / $u + $kids / $pk;
return $memo->{$module};

}# sub dbfTstgenHierBudgetArea


#<!-- What a module is, for the metrics record: its own contents and its
#     children, read from VNOM and the library.  Microns. -->
sub dbfTstgenHierModuleFeatures {

my ($module, $rowHum) = @_;
my %f = ( std_area => 0, macro_area => 0, macros => 0, cells => 0, seq => 0,
          multi_row => 0, child_blocks => 0, distinct_children => 0,
          largest_identical => 0, port_bits => 0 );
return \%f unless ( exists $MODULE_ALREADY{$module} );
my $V = $MODULE_ALREADY{$module};
foreach my $inst ( $V->dbVNOMGetLeafInst ) {
  my $ref = $V->dbVNOMGetLeafInstCell($inst);
  next unless ( defined $ref && exists $PLDB{$ref} );
  my @sz = $PLDB{$ref}->dbMdbGetSize;
  next unless ( @sz >= 2 );
  $f{cells}++;
  my $class = $PLDB{$ref}->dbMdbGetClass;
  if ( defined $class && $class ne "" && $class !~ m/^CORE/ ) {
    $f{macros}++; $f{macro_area} += $sz[0] * $sz[1];
    next;
  }
  $f{std_area} += $sz[0] * $sz[1];
  $f{seq}++ if ( &dbfFlatNodeType($ref) eq "seq" );
  $f{multi_row}++ if ( defined $rowHum && $rowHum > 0 && $sz[1] > 1.5 * $rowHum );
}
my %byRef = ();
foreach my $inst ( $V->dbVNOMGetHierInst ) {
  my $ref = $V->dbVNOMGetHierInstCell($inst);
  next unless ( defined $ref && exists $MODULE_ALREADY{$ref} );
  $byRef{$ref}++;
  $f{child_blocks}++;
}
$f{distinct_children} = scalar(keys %byRef);
foreach my $c ( values %byRef ) { $f{largest_identical} = $c if ( $c > $f{largest_identical} ); }
foreach my $p ( $V->dbVNOMGetInput, $V->dbVNOMGetOutput, $V->dbVNOMGetBidi ) {
  my $bits = 1;
  my $w = $V->dbVNOMGetInputBits($p);
  $w = $V->dbVNOMGetOutputBits($p) unless ( defined $w && $w ne "" );
  $w = $V->dbVNOMGetBidiBits($p) unless ( defined $w && $w ne "" );
  if ( defined $w && $w =~ m/\[\s*(-?\d+)\s*:\s*(-?\d+)\s*\]/ ) { $bits = abs($1 - $2) + 1; }
  $f{port_bits} += $bits;
}
return \%f;

}# sub dbfTstgenHierModuleFeatures


#<!-- The child blocks of a module after its block pass: how much of the box
#     they cover, how much of them overlaps another block, how much hangs
#     outside the box.  Microns squared. -->
sub dbfTstgenHierBlockFit {

my ($module, $W, $H) = @_;
my @b = ();
foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
  next if ( $inst eq "PIN" );
  my $ref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
  next unless ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
  my @bb = &dbfTstgenBboxFromCoords($PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstRelBbox);
  push(@b, [ @bb[0..3] ]) if ( @bb >= 4 && defined $bb[3] );
}
my ($area, $over, $out) = (0, 0, 0);
for ( my $i = 0 ; $i < @b ; $i++ ) {
  my ($l, $t, $r, $u) = @{$b[$i]};
  my $a = ($r - $l) * ($u - $t);
  $area += $a;
  my $il = ( $l > 0 ) ? $l : 0;   my $ir = ( $r < $W ) ? $r : $W;
  my $it = ( $t > 0 ) ? $t : 0;   my $iu = ( $u < $H ) ? $u : $H;
  my $inside = ( $ir > $il && $iu > $it ) ? ($ir - $il) * ($iu - $it) : 0;
  $out += $a - $inside;
  for ( my $j = $i + 1 ; $j < @b ; $j++ ) {
    my ($l2, $t2, $r2, $u2) = @{$b[$j]};
    my $ox = ( ($r < $r2) ? $r : $r2 ) - ( ($l > $l2) ? $l : $l2 );
    my $oy = ( ($u < $u2) ? $u : $u2 ) - ( ($t > $t2) ? $t : $t2 );
    $over += $ox * $oy if ( $ox > 0 && $oy > 0 );
  }
}
my $box = $W * $H;
return { blocks => scalar(@b), fill => ( $box > 0 ) ? $area / $box : 0,
         overlap_frac => ( $area > 0 ) ? $over / $area : 0,
         outside_frac => ( $area > 0 ) ? $out / $area : 0 };

}# sub dbfTstgenHierBlockFit


#<!-- --slice_blocks: a module's child blocks laid out without overlap.
#
#     The block pass is force directed, and at a level of mixed blocks it
#     settles with them still overlapping: 17% to 33% of the block area on a
#     6.7M-cell tile, at every level but the one whose blocks formed an exact
#     array.  Sixteen copies of each overlapping layout put the contents of
#     different blocks on the same rows -- 4.4M cells -- and no legalizer can
#     make that legal: the flat one left 651k cells with no row.
#
#     So, after the block pass, the box is sliced.  Identical siblings are one
#     group (they share a floorplan, so they must share a shape) and are laid
#     out as a grid inside their slice.  Groups are cut apart recursively, in
#     the order the block pass left them, each side getting box area in
#     proportion to its blocks' area -- so the free area of the box is spread
#     as channels between blocks, where the module's own cells will go.  Every
#     cut direction and split point is tried and scored: a group whose shape
#     is already fixed (an earlier parent sliced it) must fit, and no slice may
#     be a sliver.  Each block takes its own area inside its slice, at the
#     slice's aspect, on the site grid and an even number of rows, centred.
#     Blocks cannot overlap because slices do not.
#
#     Returns a summary.  $fixed is module => [w, h] for the shapes an earlier
#     slicing set -- hard here -- and gets every shape set here; $sizes is the
#     table hier_place_all re-applies when a module is opened, and gets them
#     too. -->
sub dbfTstgenHierSliceBlocks {

my ($module, $W, $H, $siteUm, $rowHum, $fixed, $sizes, $spec) = @_;
my $pitchY = 2 * $rowHum;
my %grp = ();
my %box = ();
foreach my $inst ( sort keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
  next if ( $inst eq "PIN" );
  my $ref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
  next unless ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
  my @bb = &dbfTstgenBboxFromCoords($PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstRelBbox);
  next unless ( @bb >= 4 && defined $bb[3] && $bb[2] > $bb[0] && $bb[3] > $bb[1] );
  $box{$inst} = [ @bb[0..3] ];
  push(@{$grp{$ref}}, $inst);
}
#<!-- a spec divides the box by the children's areas, so every child needs a
#     size before it can be used: the walk gives them one with -sizing budget
#     or -whitespace.  Without, the blocks have no box yet and the spec is
#     refused rather than holding blocks that are nowhere. -->
if ( defined $spec ) {
  my @noSize = ();
  foreach my $inst ( sort keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
    next if ( $inst eq "PIN" || exists $box{$inst} );
    my $ref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
    push(@noSize, $inst) if ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
  }
  return { blocks => 0, error => "child block(s) with no size yet, give hier_place_all -sizing budget or -whitespace: @noSize" }
    if ( @noSize || ! %box );
}
return { blocks => 0 } unless ( %box );
my @items = ();
foreach my $ref ( sort keys %grp ) {
  my @ins = @{$grp{$ref}};
  my ($bw, $bh) = ( $box{$ins[0]}[2] - $box{$ins[0]}[0], $box{$ins[0]}[3] - $box{$ins[0]}[1] );
  my ($cx, $cy) = (0, 0);
  foreach my $i ( @ins ) {
    $cx += ($box{$i}[0] + $box{$i}[2]) / 2;
    $cy += ($box{$i}[1] + $box{$i}[3]) / 2;
  }
  push(@items, { ref => $ref, insts => \@ins, k => scalar(@ins),
                 a => $bw * $bh, area => scalar(@ins) * $bw * $bh,
                 cx => $cx / @ins, cy => $cy / @ins,
                 hard => ( exists $fixed->{$ref} ) ? $fixed->{$ref} : undef });
}

#<!-- the grid a group takes in a w x h slice: [rows, cols, badness] -->
my $gridFor = sub {
  my ($it, $w, $h) = @_;
  my $best;
  for ( my $c = 1 ; $c <= $it->{k} ; $c++ ) {
    my $r = POSIX::ceil( $it->{k} / $c );
    next if ( ($r - 1) * $c >= $it->{k} );           #<!-- a whole empty row -->
    my ($cw, $ch) = ( $w / $c, $h / $r );
    my $bad = 0;
    if ( $it->{hard} ) {
      my ($hw, $hh) = @{$it->{hard}};
      my $sw = ( $cw < $hw ) ? $hw - $cw : 0;
      my $sh = ( $ch < $hh ) ? $hh - $ch : 0;
      $bad += 1000 * ( $sw * $hh + $sh * $hw ) / ( $hw * $hh );   #<!-- must fit -->
    }
    my $asp = ( $cw > $ch ) ? $cw / $ch : $ch / $cw;
    $bad += ( $asp > 3 ) ? $asp - 3 : 0;
    $bad += 0.5 * ( $r * $c - $it->{k} ) / $it->{k};               #<!-- empty cells -->
    $best = [ $r, $c, $bad ] if ( ! defined $best || $bad < $best->[2] );
  }
  return $best;
};

#<!-- best slicing of a set of groups into a rectangle: [badness, plan] where a
#     plan is a leaf [item] or [dir, k, order, left plan, right plan, cut] -->
my $solve;
$solve = sub {
  my ($its, $x0, $y0, $x1, $y1, $depth) = @_;
  my ($w, $h) = ( $x1 - $x0, $y1 - $y0 );
  if ( @$its == 1 ) {
    my $g = $gridFor->($its->[0], $w, $h);
    return [ $g->[2], [ 'leaf', $its->[0] ] ];
  }
  my $A = 0;
  $A += $_->{area} foreach ( @$its );
  my $best;
  #<!-- longer side first, so on a tie the cut is across it -->
  foreach my $dir ( ( $w >= $h ) ? ('v', 'h') : ('h', 'v') ) {
    my @s = sort { ( ($dir eq 'v') ? $a->{cx} <=> $b->{cx} : $a->{cy} <=> $b->{cy} )
                   || $a->{ref} cmp $b->{ref} } @$its;
    my $cum = 0;
    for ( my $k = 1 ; $k < @s ; $k++ ) {
      $cum += $s[$k-1]{area};
      my $f = $cum / $A;
      my @L = @s[0 .. $k-1];
      my @R = @s[$k .. $#s];
      my ($l, $r, $cut);
      if ( $dir eq 'v' ) {
        $cut = $x0 + $w * $f;
        $l = $solve->(\@L, $x0, $y0, $cut, $y1, $depth + 1);
        $r = $solve->(\@R, $cut, $y0, $x1, $y1, $depth + 1);
      }
      else {
        $cut = $y0 + $h * $f;
        $l = $solve->(\@L, $x0, $y0, $x1, $cut, $depth + 1);
        $r = $solve->(\@R, $x0, $cut, $x1, $y1, $depth + 1);
      }
      my $bad = $l->[0] + $r->[0] + 0.01 * abs($f - 0.5);
      $best = [ $bad, [ $dir, $cut, $l->[1], $r->[1] ] ] if ( ! defined $best || $bad < $best->[0] );
    }
    #<!-- past a handful of groups, one direction is enough: the search is
    #     exponential and the levels that matter have two to six groups -->
    last if ( @$its > 6 && defined $best );
  }
  return $best;
};

my ($nBlocks, $worstAsp, $minAreaRatio, $hardMiss, $tooSmall) = (0, 1, 1, 0, 0);
my $snapUp = sub { my ($v, $p) = @_; return ( $p > 0 ) ? POSIX::ceil( $v / $p - 1e-9 ) * $p : $v; };
my $snapDn = sub { my ($v, $p) = @_; return ( $p > 0 ) ? POSIX::floor( $v / $p + 1e-9 ) * $p : $v; };
my $apply;
$apply = sub {
  my ($plan, $x0, $y0, $x1, $y1) = @_;
  if ( $plan->[0] eq 'leaf' ) {
    my $it = $plan->[1];
    my ($w, $h) = ( $x1 - $x0, $y1 - $y0 );
    my ($r, $c) = @{ $gridFor->($it, $w, $h) };
    my ($cw, $ch) = ( $w / $c, $h / $r );
    my ($bw, $bh);
    if ( $it->{hard} ) {
      ($bw, $bh) = @{$it->{hard}};
      $hardMiss++ if ( $bw > $cw + 1e-6 || $bh > $ch + 1e-6 );
    }
    else {
      $bw = sqrt( $it->{a} * $cw / $ch );
      $bw = $snapUp->($bw, $siteUm);
      $bw = $snapDn->($cw, $siteUm) if ( $bw > $cw );
      $bh = $snapUp->($it->{a} / $bw, $pitchY);
      $bh = $snapDn->($ch, $pitchY) if ( $bh > $ch );
      #<!-- A slice narrower than one site, or shorter than one row pair,
      #     snapped the block down to nothing, and the aspect below divided by
      #     it: a 4x4 multiplier's 2x2 blocks, each a few cells, came out of
      #     their slices 0 um tall.  Such a block keeps one site and one row
      #     pair -- overhanging its slice, which the legalizer resolves --
      #     and is counted, rather than taking the walk down with it. -->
      my $minW = ( $siteUm > 0 ) ? $siteUm : $cw;
      my $minH = ( $pitchY > 0 ) ? $pitchY : $ch;
      if ( $bw < $minW || $bh < $minH ) {
        $tooSmall++;
        $bw = $minW if ( $bw < $minW );
        $bh = $minH if ( $bh < $minH );
      }
      $minAreaRatio = ($bw * $bh) / $it->{a} if ( ($bw * $bh) / $it->{a} < $minAreaRatio );
    }
    my $asp = ( $bw > $bh ) ? $bw / $bh : $bh / $bw;
    $worstAsp = $asp if ( $asp > $worstAsp );
    #<!-- instances into the grid in the order the block pass left them -->
    my @ord = sort { ( ($box{$a}[1] + $box{$a}[3]) <=> ($box{$b}[1] + $box{$b}[3]) )
                     || ( ($box{$a}[0] + $box{$a}[2]) <=> ($box{$b}[0] + $box{$b}[2]) )
                     || $a cmp $b } @{$it->{insts}};
    for ( my $row = 0 ; $row < $r ; $row++ ) {
      my @rowI = sort { ($box{$a}[0] + $box{$a}[2]) <=> ($box{$b}[0] + $box{$b}[2]) || $a cmp $b }
                 @ord[ $row * $c .. ( ($row + 1) * $c - 1 < $#ord ? ($row + 1) * $c - 1 : $#ord ) ];
      for ( my $col = 0 ; $col < @rowI ; $col++ ) {
        my ($cx0, $cy0) = ( $x0 + $col * $cw, $y0 + $row * $ch );
        my $bx = $snapDn->( $cx0 + ($cw - $bw) / 2, $siteUm );
        $bx = $snapUp->( $cx0, $siteUm ) if ( $bx < $cx0 - 1e-6 );
        my $by = $snapDn->( $cy0 + ($ch - $bh) / 2, $pitchY );
        $by = $snapUp->( $cy0, $pitchY ) if ( $by < $cy0 - 1e-6 );
        $bx = $W - $bw if ( $bx + $bw > $W );
        $by = $H - $bh if ( $by + $bh > $H );
        $PSEUDO_VINST_ALREADY{$module}{$rowI[$col]}->dbPimDBSetInstRelBbox($bx, $by, $bx + $bw, $by + $bh);
        $nBlocks++;
      }
    }
    unless ( $it->{hard} ) {
      $PSEUDO_MODULE_ALREADY{$it->{ref}}->dbaTstgenSetSize(0, 0, $bw, $bh)
        if ( exists $PSEUDO_MODULE_ALREADY{$it->{ref}} );
      $fixed->{$it->{ref}} = [ $bw, $bh ];
      $sizes->{$it->{ref}} = [ $bw, $bh ];
    }
    return;
  }
  my ($dir, $cut, $l, $rr) = @$plan;
  if ( $dir eq 'v' ) { $apply->($l, $x0, $y0, $cut, $y1); $apply->($rr, $cut, $y0, $x1, $y1); }
  else               { $apply->($l, $x0, $y0, $x1, $cut); $apply->($rr, $x0, $cut, $x1, $y1); }
};
#<!-- -floorplan_spec: the cut tree is given instead of searched for.  Every
#     child block is a leaf of its own, named; a part of the box gets area in
#     proportion to the blocks under it, exactly as a searched cut does, and
#     the leaves go through the same $apply -- site and row snapping, and a
#     module's shape set once and held for its other instances. -->
if ( defined $spec ) {
  my @leaves = ();
  my $walk;
  $walk = sub { my ($n) = @_; if ( ref $n ) { $walk->($_) foreach ( @{$n->[1]} ); } else { push(@leaves, $n); } };
  $walk->($spec);
  my %cnt = ();
  $cnt{$_}++ foreach ( @leaves );
  #<!-- "*" is the module's own logic: no block, all of the box the blocks do
  #     not need, left empty for the cell pass to fill -->
  my $starCnt = exists $cnt{'*'} ? delete $cnt{'*'} : 0;
  my @unknown = grep { ! exists $box{$_} } sort keys %cnt;
  my @twice   = grep { $cnt{$_} > 1 } sort keys %cnt;
  my @missing = grep { ! exists $cnt{$_} } sort keys %box;
  my $blockA = 0;
  $blockA += ( $box{$_}[2] - $box{$_}[0] ) * ( $box{$_}[3] - $box{$_}[1] ) foreach ( keys %box );
  my $freeA = $W * $H - $blockA;
  if ( @unknown || @twice || @missing || $starCnt > 1 || ( $starCnt && $freeA <= 0 ) ) {
    my @why = ();
    push(@why, "* given more than once") if ( $starCnt > 1 );
    push(@why, "* given but the blocks leave no free area") if ( $starCnt && $freeA <= 0 );
    push(@why, "not blocks of $module: @unknown") if ( @unknown );
    push(@why, "named twice: @twice") if ( @twice );
    push(@why, "not named: @missing") if ( @missing );
    return { blocks => 0, error => join("; ", @why) };
  }
  my %leaf = ();
  foreach my $i ( grep { $_ ne '*' } @leaves ) {
    my $ref = $PSEUDO_VINST_ALREADY{$module}{$i}->dbPimDBGetInstCellref;
    my $a = ( $box{$i}[2] - $box{$i}[0] ) * ( $box{$i}[3] - $box{$i}[1] );
    $leaf{$i} = { ref => $ref, insts => [ $i ], k => 1, a => $a, area => $a,
                  cx => ( $box{$i}[0] + $box{$i}[2] ) / 2, cy => ( $box{$i}[1] + $box{$i}[3] ) / 2 };
  }
  my $areaOf;
  $areaOf = sub { my ($n) = @_; return ( $n eq '*' ? $freeA : $leaf{$n}{area} ) unless ( ref $n );
                  my $A = 0; $A += $areaOf->($_) foreach ( @{$n->[1]} ); return $A; };
  my $blockAreaOf;
  $blockAreaOf = sub { my ($n) = @_; return ( $n eq '*' ? 0 : $leaf{$n}{area} ) unless ( ref $n );
                       my $A = 0; $A += $blockAreaOf->($_) foreach ( @{$n->[1]} ); return $A; };
  #<!-- the least room a part needs, from the blocks in it whose shape is
  #     fixed (an earlier parent, another instance, --keep_shapes): an H row is
  #     as tall as its tallest and as wide as all of them, a V column the other
  #     way round.  A block free to take any shape needs nothing. -->
  my $needOf;
  $needOf = sub {
    my ($n) = @_;
    unless ( ref $n ) {
      return (0, 0) if ( $n eq '*' );
      my $ref = $leaf{$n}{ref};
      return exists $fixed->{$ref} ? @{$fixed->{$ref}} : (0, 0);
    }
    my ($dir, $kids) = @$n;
    my ($w, $h) = (0, 0);
    foreach my $k ( @$kids ) {
      my ($kw, $kh) = $needOf->($k);
      if ( $dir eq 'H' ) { $w += $kw; $h = $kh if ( $kh > $h ); }
      else               { $h += $kh; $w = $kw if ( $kw > $w ); }
    }
    return ($w, $h);
  };
  my $place;
  $place = sub {
    my ($n, $x0, $y0, $x1, $y1) = @_;
    unless ( ref $n ) {
      return if ( $n eq '*' );
      my $it = $leaf{$n};
      #<!-- a module an earlier leaf (or an earlier parent) shaped keeps it -->
      $it->{hard} = $fixed->{$it->{ref}} if ( exists $fixed->{$it->{ref}} );
      $apply->([ 'leaf', $it ], $x0, $y0, $x1, $y1);
      return;
    }
    my ($dir, $kids) = @$n;
    #<!-- each part gets at least what it cannot do without -- the room its
    #     fixed blocks need, and for its free blocks their area over the
    #     cut's depth -- then what is left is shared by area.  With no fixed
    #     shape anywhere that is the plain area split.  "*" has no floor: it is
    #     cells, and may be squeezed.  A free block may not: fixed blocks that
    #     only just fit once left one 0.013 um of a 97 um row.  If the floors
    #     do not fit, plain area split and $apply counts the misses. -->
    my $span = ( $dir eq 'H' ) ? $x1 - $x0 : $y1 - $y0;
    my @need = map { my @wh = $needOf->($_); ( $dir eq 'H' ) ? $wh[0] : $wh[1] } @$kids;
    my @area = map { $areaOf->($_) } @$kids;
    my ($sumN, $sumA) = (0, 0);
    $sumN += $_ foreach ( @need );
    $sumA += $_ foreach ( @area );
    my $depthX = ( $dir eq 'H' ) ? $y1 - $y0 : $x1 - $x0;
    my @floor = map { my $s = ( $depthX > 0 ) ? $blockAreaOf->($kids->[$_]) / $depthX : 0;
                      ( $need[$_] > $s ) ? $need[$_] : $s } 0 .. $#$kids;
    my $sumF = 0;
    $sumF += $_ foreach ( @floor );
    my @len;
    if ( $sumN > 0 && $sumF <= $span ) { @len = map { $floor[$_] + ( $span - $sumF ) * $area[$_] / $sumA } 0 .. $#$kids; }
    else                               { @len = map { $span * $area[$_] / $sumA } 0 .. $#$kids; }
    my $acc = 0;
    for ( my $i = 0 ; $i < @$kids ; $i++ ) {
      my ($a0, $a1) = ( $acc, $acc + $len[$i] );
      $acc = $a1;
      #<!-- H left to right; V top to bottom, the way a floorplan is drawn -->
      if ( $dir eq 'H' ) { $place->($kids->[$i], $x0 + $a0, $y0, $x0 + $a1, $y1); }
      else               { $place->($kids->[$i], $x0, $y1 - $a1, $x1, $y1 - $a0); }
    }
  };
  $place->($spec, 0, 0, $W, $H);
  return { blocks => $nBlocks, groups => scalar(@leaves) - $starCnt, worst_aspect => $worstAsp,
           min_area_ratio => $minAreaRatio, hard_misses => $hardMiss, too_small => $tooSmall, spec => 1,
           own_region => ( $starCnt ? $freeA : 0 ) };
}

my $sol = $solve->(\@items, 0, 0, $W, $H, 0);
$apply->($sol->[1], 0, 0, $W, $H);
return { blocks => $nBlocks, groups => scalar(@items), worst_aspect => $worstAsp,
         min_area_ratio => $minAreaRatio, hard_misses => $hardMiss, too_small => $tooSmall };

}# sub dbfTstgenHierSliceBlocks


#<!-- --legalize_blocks: a module's child blocks laid out without overlap, as
#     near their targets as fits -- the alternative to --slice_blocks.
#
#     Slicing keeps only the order the block pass left: a block can only sit
#     at the end of a cut, so a small block whose partners are where two big
#     ones meet (a 24 x 19 um block between a vector unit's register-file
#     column and an FP unit's, on a 3M-instance tile) ends at the end of a
#     row, in a die corner, every time; and the free area falls where the cuts
#     do, not where the module's own logic needs it.  Here each block keeps
#     its shape and has a target centre -- where the block pass put it, or
#     where -block_targets says (a plan) -- and 3RDBIN/block_legalize finds
#     the arrangement nearest the targets with no overlap, slicing or not:
#     each pair kept apart along the axis their targets leave more room on,
#     then a linear program per axis.
#
#     Shapes: a module an earlier parent or instance shaped keeps that shape
#     ($fixed); any other is reshaped -- its area from the sizing walk kept,
#     its aspect within 1:3, on the site and row-pair grid, one shape for
#     every instance of it here -- and is then fixed, so its other instances
#     match.  No slicing behind it: what still overlaps is left to
#     legalize_flat, and reported when it is more than a few percent (068, 069).  $targets is inst => [cx, cy] in microns of
#     this module's frame, or undef for the block pass's own centres.
#     Returns a summary. -->
sub dbfTstgenHierLegalizeBlocks {

my ($module, $W, $H, $siteUm, $rowHum, $fixed, $sizes, $targets, $aspect) = @_;
my $pitchY = 2 * $rowHum;
$aspect = 3 unless ( defined $aspect && $aspect > 1 );
my %box = ();
my %refOf = ();
foreach my $inst ( sort keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
  next if ( $inst eq "PIN" );
  my $ref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
  next unless ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
  my @bb = &dbfTstgenBboxFromCoords($PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstRelBbox);
  next unless ( @bb >= 4 && defined $bb[3] && $bb[2] > $bb[0] && $bb[3] > $bb[1] );
  $box{$inst} = [ @bb[0..3] ];
  $refOf{$inst} = $ref;
}
if ( defined $targets ) {
  my @noSize = ();
  foreach my $inst ( sort keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
    next if ( $inst eq "PIN" || exists $box{$inst} );
    my $ref = $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBGetInstCellref;
    push(@noSize, $inst) if ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
  }
  return { blocks => 0, error => "child block(s) with no size yet, give hier_place_all -sizing budget or -whitespace: @noSize" }
    if ( @noSize );
}
return { blocks => 0 } unless ( %box );
my @noTarget = ();
my $in = "$module.blocks.tsv"; my $out = "$module.blocks.placed.tsv";
$in =~ s/[\/\\\[\]]/_/g; $out =~ s/[\/\\\[\]]/_/g;
my $fh;
unless ( open($fh, ">", $in) ) { return { blocks => 0, error => "cannot write $in: $!" }; }
printf $fh "BOX\t%.6f\t%.6f\t%.6f\t%.6f\n", $W, $H, $siteUm, $pitchY;
my %shape = ();
foreach my $inst ( sort keys %box ) {
  my ($bw, $bh) = exists $fixed->{$refOf{$inst}} ? @{$fixed->{$refOf{$inst}}}
                                                 : ( $box{$inst}[2] - $box{$inst}[0], $box{$inst}[3] - $box{$inst}[1] );
  $shape{$inst} = [ $bw, $bh ];
  my ($cx, $cy) = ( ($box{$inst}[0] + $box{$inst}[2]) / 2, ($box{$inst}[1] + $box{$inst}[3]) / 2 );
  if ( defined $targets ) {
    if ( exists $targets->{$inst} ) { ($cx, $cy) = @{$targets->{$inst}}; }
    else                            { push(@noTarget, $inst); }
  }
  printf $fh "BLOCK\t%s\t%.6f\t%.6f\t%.6f\t%.6f\t1\t%d\t%s\n", $inst, $bw, $bh, $cx, $cy,
             exists $fixed->{$refOf{$inst}} ? 1 : 0, $refOf{$inst};
}
close($fh);
my $tool = $GLOBAL->dbfGlobalGetElectronHome . "/3RDBIN/block_legalize";
#<!-- judged by what it wrote, not by its exit status: electron's SIGCHLD
#     reaper takes the child before a backtick or system() can read it -->
unlink($out);
my $log = "$in.log";
system("python3 $tool $in $out --aspect $aspect > $log 2>&1");
my $msg = "";
if ( open(my $lf, "<", $log) ) { local $/; $msg = <$lf>; close($lf); }
$msg = ( $msg =~ m/^(block_legalize: \d+ block.*)$/m ) ? $1 : $msg;
unless ( -s $out && $msg =~ m/^block_legalize: \d+ block/ ) { chomp($msg); return { blocks => 0, error => "block_legalize failed: $msg" }; }
my $n = 0;
open($fh, "<", $out) or return { blocks => 0, error => "cannot read $out: $!" };
while ( my $l = <$fh> ) {
  chomp($l);
  my ($k, $inst, $x, $y, $bw, $bh) = split(/\t/, $l);
  next unless ( defined $bh && $k eq "BLOCK" && exists $shape{$inst} );
  #<!-- the helper's shape: reshaped (area kept, aspect within 1:3, on the
  #     site and row-pair grid) unless the module's shape was already fixed -->
  $PSEUDO_VINST_ALREADY{$module}{$inst}->dbPimDBSetInstRelBbox($x, $y, $x + $bw, $y + $bh);
  my $ref = $refOf{$inst};
  unless ( exists $fixed->{$ref} ) {
    $PSEUDO_MODULE_ALREADY{$ref}->dbaTstgenSetSize(0, 0, $bw, $bh) if ( exists $PSEUDO_MODULE_ALREADY{$ref} );
    $fixed->{$ref} = [ $bw, $bh ];
    $sizes->{$ref} = [ $bw, $bh ];
  }
  $n++;
}
close($fh);
my %r = ( blocks => $n, summary => $msg, no_target => scalar(@noTarget) );
$r{overlaps} = $1 if ( $msg =~ m/(\d+) overlap\(s\)/ );
$r{overrun}  = $1 if ( $msg =~ m/box overrun ([\d.]+) um/ );
$r{overlap_pct} = $1 if ( $msg =~ m/([\d.]+)% of block area/ );
#<!-- the tolerance: a few percent of the block area, within a row pair of
#     the box, spreads cells by a few microns in legalize_flat (0.8 um on
#     average where two vedic levels kept 4%); a third of it -- what the
#     force-directed pass alone leaves -- stacks blocks and does not legalize -->
$r{too_much} = ( ( $r{overlap_pct} // 0 ) > 3 || ( $r{overrun} // 0 ) > $pitchY + 1e-6 ) ? 1 : 0;
($r{mean_um}, $r{worst_um}) = ($1, $2) if ( $msg =~ m/mean ([\d.]+) um, worst ([\d.]+) um/ );
return \%r;

}# sub dbfTstgenHierLegalizeBlocks


#<!-- -block_targets <file>: where a plan wants each module's child blocks.
#     One line per block: "module<TAB>instance<TAB>cx<TAB>cy", the block's
#     centre as a fraction (0..1) of its parent's box, left to right and
#     bottom to top -- the frame hier_place_all places that module in, so a
#     plan made flat (a register-level placement of the critical paths) says
#     where blocks go without saying where any cell goes.  # starts a comment.
#     Returns module => inst => [fx, fy]. -->
sub dbfTstgenReadBlockTargets {
my ($file) = @_;
my $fh;
unless ( open($fh, "<", $file) ) {
  print "ERR-TST-HR_PL_ALL : 055 : cannot read -block_targets $file : $!\n";
  return undef;
}
my %t = ();
my ($n, $bad) = (0, 0);
while ( my $l = <$fh> ) {
  $l =~ s/#.*//; next unless ( $l =~ m/\S/ );
  chomp($l);
  my ($m, $i, $fx, $fy) = split(/\t/, $l);
  if ( ! defined $fy || $fx !~ m/^-?[\d.]+(e-?\d+)?$/ || $fy !~ m/^-?[\d.]+(e-?\d+)?$/ ) { $bad++; next; }
  $t{$m}{$i} = [ $fx, $fy ];
  $n++;
}
close($fh);
if ( $bad ) {
  print "ERR-TST-HR_PL_ALL : 056 : -block_targets $file: $bad line(s) are not module<TAB>instance<TAB>cx<TAB>cy\n";
  return undef;
}
return \%t;
}# sub dbfTstgenReadBlockTargets


#<!-- -floorplan_spec <file>: module => cut tree, the arrangement of that
#     module's child blocks given rather than placed.  One module per entry,
#     "module : expression", where an expression is an instance name or
#     V( e e ... ) -- stacked, the first on top -- or H( e e ... ) -- side by
#     side, the first on the left.  Nests; may run over several lines; # starts
#     a comment.  Every hierarchical child of the module is named exactly once.
#     "*" may stand once for the module's own logic: it gets all the area the
#     blocks leave free, nothing is placed there, and the cell pass fills it --
#     without it that free area is spread round every block.
#
#         mc_top : V( \core_hi  H( mem0 mem1 )  \core_lo )
#
#     It says which block sits beside which and nothing about microns: the
#     sizes come from the sizing the walk already does, so a spec written
#     from a hierBlame report, by a person or a language model, cannot ask for
#     an arrangement that does not fit. -->
sub dbfTstgenReadFloorplanSpec {
my ($file) = @_;
my $fh;
unless ( open($fh, "<", $file) ) {
  print "ERR-TST-HR_PL_ALL : 038 : cannot read -floorplan_spec $file : $!\n";
  return undef;
}
my @entries = ();                                #<!-- [module, text, line] -->
my $depth = 0;
while ( my $l = <$fh> ) {
  $l =~ s/#.*$//;
  next unless ( $l =~ m/\S/ );
  if ( $depth == 0 && $l =~ m/^\s*([^\s:()]+)\s*:(.*)$/ ) {
    push(@entries, [ $1, $2, $. ]);
  }
  elsif ( @entries ) {
    $entries[-1][1] .= " $l";
  }
  else {
    print "ERR-TST-HR_PL_ALL : 039 : $file line $.: expected \"module : expression\"\n";
    close($fh);
    return undef;
  }
  my $t = $entries[-1][1];
  $depth = ( () = $t =~ m/\(/g ) - ( () = $t =~ m/\)/g );
}
close($fh);
my %spec = ();
foreach my $e ( @entries ) {
  my ($mod, $text, $line) = @$e;
  my @t = ( $text =~ m/([VH]\(|\)|[^\s()]+)/g );
  my $pos = 0;
  my $parse;
  $parse = sub {
    my $tok = $t[$pos++];
    return undef unless ( defined $tok && $tok ne ")" );
    return $tok unless ( $tok =~ m/^([VH])\($/ );
    my ($dir, @kids) = ($1);
    while ( $pos < @t && $t[$pos] ne ")" ) {
      my $k = $parse->();
      return undef unless ( defined $k );
      push(@kids, $k);
    }
    return undef unless ( $pos < @t && @kids );
    $pos++;
    return [ $dir, \@kids ];
  };
  my $tree = $parse->();
  unless ( defined $tree && $pos == @t ) {
    print "ERR-TST-HR_PL_ALL : 040 : $file line $line: cannot read the expression for $mod\n";
    return undef;
  }
  if ( exists $spec{$mod} ) {
    print "ERR-TST-HR_PL_ALL : 041 : $file line $line: $mod is given twice\n";
    return undef;
  }
  $spec{$mod} = $tree;
}
return \%spec;
}# sub dbfTstgenReadFloorplanSpec


#<!-- --keep_shapes: a module's size as its COMMITTED floorplan has it, in
#     microns -- not the pseudo model's, which edit_module of its parent resets.
#     (0, 0) for a module with no floorplan yet. -->
sub dbfTstgenHierCommittedSize {
my ($module) = @_;
my $id = 0;
$id = $MODULE_ALREADY{$module}->dbVNOMGetFloorplanID if ( exists $MODULE_ALREADY{$module} );
$id = $FLOORPLAN_LOOKUP{"$module/_self_"} if ( ! $id && exists $FLOORPLAN_LOOKUP{"$module/_self_"} );
return (0, 0) unless ( $id && exists $FLOORPLAN_ALREADY{$id} );
my $dbu = $FLOORPLAN_ALREADY{$id}->dbFlplanGetDBUnit;
$dbu = 1 unless ( defined $dbu && $dbu > 0 );
my @sz = $FLOORPLAN_ALREADY{$id}->dbFlplanGetSize;
return (0, 0) unless ( @sz >= 4 && defined $sz[3] && $sz[2] > $sz[0] && $sz[3] > $sz[1] );
return ( ($sz[2] - $sz[0]) / $dbu, ($sz[3] - $sz[1]) / $dbu );
}# sub dbfTstgenHierCommittedSize


#<!-- The module's own box, in microns, as the pseudo database has it. -->
sub dbfTstgenHierPseudoSize {

my ($module) = @_;
unless ( exists $PSEUDO_MODULE_ALREADY{$module} ) {
  return (0, 0);
}
#<!-- dbaTstgenGetSize returns microns already, unlike the flat floorplan -->
my @size = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetSize;
unless ( @size >= 4 && defined $size[2] && defined $size[3] ) {
  return (0, 0);
}
return ($size[2] - $size[0], $size[3] - $size[1]);

}# sub dbfTstgenHierPseudoSize


#<!-- Depth first pre-order over the distinct modules under $mod.
#
#     Pre-order, so a parent is always in the list before its children: that is
#     the order the placement has to happen in, because a child takes its size
#     from the parent's committed floorplan.
#
#     %$seen keys the modules already in the list and values the instance paths
#     each was reached by, so the caller can report a module used more than
#     once.  It is also what terminates the walk: a module is expanded once,
#     cycle or no cycle. -->
#<!-- every instance path of every module below $mod, as flat nets name them
#     ("" for the top, then inst, inst/inst ...): $out->{module} = [paths] -->
sub dbfTstgenHierAllInstPaths {
my ($mod, $path, $out) = @_;
push(@{$out->{$mod}}, $path);
return unless ( exists $MODULE_ALREADY{$mod} );
foreach my $inst ( $MODULE_ALREADY{$mod}->dbVNOMGetHierInst ) {
  my $cellref = $MODULE_ALREADY{$mod}->dbVNOMGetHierInstCell($inst);
  next unless ( defined $cellref && $cellref ne "" && $cellref ne "UND" && exists $MODULE_ALREADY{$cellref} );
  &dbfTstgenHierAllInstPaths($cellref, ( $path eq "" ? $inst : "$path/$inst" ), $out);
}
}# sub dbfTstgenHierAllInstPaths

sub dbfTstgenHierPlaceWalk {

my ($mod, $depth, $path, $maxDepth, $order, $seen, $instCnt) = @_;

if ( exists $seen->{$mod} ) {
  push(@{$seen->{$mod}}, $path);
  return;
}
$seen->{$mod} = [ $path ];
push(@$order, [ $mod, $depth, $path ]);

if ( $maxDepth >= 0 && $depth >= $maxDepth ) {
  return;
}
unless ( exists $MODULE_ALREADY{$mod} ) {
  return;
}

my %childInsts = ();
foreach my $inst ( $MODULE_ALREADY{$mod}->dbVNOMGetHierInst ) {
  my $cellref = $MODULE_ALREADY{$mod}->dbVNOMGetHierInstCell($inst);
  #<!-- dbVNOMGetHierInstCell answers UND for an instance it has no cell for -->
  unless ( defined $cellref && $cellref ne "" && $cellref ne "UND" ) {
    next;
  }
  #<!-- A cell in the library is a leaf whatever VNOM filed it under: its
  #     contents are the LEF's business and there is nothing to place inside
  #     it. -->
  unless ( exists $MODULE_ALREADY{$cellref} ) {
    next;
  }
  push(@{$childInsts{$cellref}}, $inst);
  $instCnt->{$cellref}++;
}

foreach my $child ( sort keys %childInsts ) {
  my $inst = (sort @{$childInsts{$child}})[0];
  &dbfTstgenHierPlaceWalk($child, $depth + 1, "$path/$inst",
                          $maxDepth, $order, $seen, $instCnt);
}

}# sub dbfTstgenHierPlaceWalk


#<!-- --child_pins: a child block's pins put where the parent's nets reach it.
#
#     Without it a block's ports are placed when the block itself is opened,
#     by hier_place, at the edge point nearest the block's OWN contents: the
#     other end of each net is in the parent, which the block cannot see.  On
#     a 3M-cell design the cells inside a block on nets crossing its boundary
#     sat only 8% to 17% nearer the side their partners were on than a random
#     cell of the block, and three blocks faced away from them.
#
#     So, after the parent's cell pass, when everything in the parent has a
#     place: each child port bit goes to the point of the child's boundary
#     nearest the centroid of its net's other members -- cells, other blocks,
#     the parent's own ports.  The points of one edge are spread a pin pitch
#     apart in the order their nets want, and stored on the child FIXED, as a
#     point, "NONE x y x y".  A child pin is gone after hier2flat; it only has
#     to steer the child's placement, so it needs a place and no shape or
#     layer.  commit_module --physical_only writes it into the child's
#     floorplan with no connectivity work, edit_module reads it back, and
#     hier_place keeps a FIXED port where it is.
#
#     A module has one floorplan, so identical siblings get one set of pins:
#     each at the average of what the instances want, put back onto the
#     nearest edge.  A module under several parents keeps what its first
#     parent gave it ($done).  A port bit whose net has no placed member, or
#     more members than the fan out limit, is left to the child as before.
#
#     Returns a summary for the metrics record. -->
sub dbfTstgenHierProjectChildPins {

my ($module, $done, $fanoutLimit, $skipPlaced) = @_;
$fanoutLimit = 1000 unless ( defined $fanoutLimit && $fanoutLimit > 0 );
my %sum = ( children => 0, pins => 0, no_partner => 0, high_fanout => 0,
            width_mismatch => 0, rotated => 0, kept => 0 );

#<!-- every placed instance's centre, and the child blocks' boxes -->
my %centre = ();
my %child = ();
foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$module}} ) {
  next if ( $inst eq "PIN" );
  my $v = $PSEUDO_VINST_ALREADY{$module}{$inst};
  next if ( $v->dbPimDBGetInstStatus eq "UNPLACED" );
  my @bb = &dbfTstgenBboxFromCoords($v->dbPimDBGetInstRelBbox);
  next unless ( @bb >= 4 && defined $bb[3] );
  $centre{$inst} = [ ($bb[0] + $bb[2]) / 2, ($bb[1] + $bb[3]) / 2 ];
  my $ref = $v->dbPimDBGetInstCellref;
  next unless ( defined $ref && exists $PSEUDO_MODULE_ALREADY{$ref} && exists $MODULE_ALREADY{$ref} );
  next unless ( $bb[2] > $bb[0] && $bb[3] > $bb[1] );
  $child{$inst} = { ref => $ref, box => [ @bb[0..3] ], orient => $v->dbPimDBGetInstOrient };
}
return \%sum unless ( %child );

#<!-- One pass over the conn lines: the placed members of every net bit, and
#     which net bit each child port bit is on.  The parse is
#     dbfTstgenHierNetToInst's, which drops the pin's own bits; those are
#     needed here, paired with the net's by position as verilog pairs them. -->
my %members = ();
my %childPinNet = ();
foreach my $conn ( $MODULE_ALREADY{$module}->dbVNOMGetConn ) {
  $conn =~ s/^\s+//;
  $conn =~ s/\s*\;?\s*$//;
  my $instCell = $conn;
  $instCell =~ s/\(.+$//;
  my $inst = ( split(/\s+/, $instCell) )[1];
  next unless ( defined $inst && $inst ne "" );
  my $at = $centre{$inst};
  my $kid = $child{$inst};
  next unless ( defined $at || defined $kid );
  $conn =~ s/\s*\(\s*/\|/;
  $conn =~ s/^.*\|//;
  $conn =~ s/\s+//g;
  $conn =~ s/\)+$//;
  foreach my $pair ( split(/\)\,/, $conn) ) {
    my ($pin, $net) = ( split(/\(/, $pair) )[0,1];
    next unless ( defined $pin && defined $net && $net ne "" );
    $pin =~ s/^\.//;
    my @nb = &array_of_blasted_expr($net, $module);
    @nb = ($net) unless ( @nb );
    if ( defined $at ) {
      foreach my $b ( @nb ) {
        next if ( ! defined $b || $b eq "" || $b =~ m/^\d*'/ );
        push(@{$members{$b}}, [ $at->[0], $at->[1], $inst ]);
      }
    }
    if ( defined $kid ) {
      my @pb = &array_of_blasted_expr($pin, $kid->{ref});
      @pb = ($pin) unless ( @pb );
      if ( @pb != @nb ) {
        $sum{width_mismatch}++;
        next;
      }
      for ( my $k = 0; $k < @pb; $k++ ) {
        next if ( ! defined $nb[$k] || $nb[$k] eq "" || $nb[$k] =~ m/^\d*'/ );
        $childPinNet{$inst}{$pb[$k]} = $nb[$k];
      }
    }
  }
}

#<!-- What each child port bit wants, in the child's own frame, summed over
#     the instances of its module -->
my %want = ();
my %dims = ();
my %skipRef = ();
foreach my $inst ( sort keys %childPinNet ) {
  my $kid = $child{$inst};
  my $ref = $kid->{ref};
  next if ( exists $skipRef{$ref} );
  if ( exists $done->{$ref} || ( $skipPlaced && &dbfTstgenHierModuleIsPlaced($ref) ) ) {
    $skipRef{$ref} = 1;
    $sum{kept}++;
    next;
  }
  my $o = $kid->{orient};
  $o = "N" unless ( defined $o && $o ne "" );
  unless ( $o =~ m/^(N|R0|S|R180|FN|MY|FS|MX)$/ ) {
    $sum{rotated}++;
    next;
  }
  my ($x0, $y0, $x1, $y1) = @{$kid->{box}};
  my ($w, $h) = ($x1 - $x0, $y1 - $y0);
  $dims{$ref} = [ $w, $h ] unless ( exists $dims{$ref} );
  foreach my $pb ( keys %{$childPinNet{$inst}} ) {
    my $net = $childPinNet{$inst}{$pb};
    my @pts = grep { $_->[2] ne $inst } @{ exists $members{$net} ? $members{$net} : [] };
    #<!-- the parent's own port on this net, where its placement put it -->
    if ( $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenHasPin($net) ) {
      my @r = $PSEUDO_MODULE_ALREADY{$module}->dbaTstgenGetPinRect($net);
      if ( @r ) {
        my @v = split(/\s+/, $r[0]);
        push(@pts, [ $v[-4], $v[-3], "PIN" ]) if ( @v >= 4 );
      }
    }
    unless ( @pts ) {
      $sum{no_partner}++;
      next;
    }
    if ( @pts > $fanoutLimit ) {
      $sum{high_fanout}++;
      next;
    }
    my ($ox, $oy) = (0, 0);
    foreach my $p ( @pts ) {
      $ox += $p->[0];
      $oy += $p->[1];
    }
    $ox /= @pts;
    $oy /= @pts;
    #<!-- the boundary point nearest the partners: clamped onto the box from
    #     outside, or out to the nearest edge from inside it -->
    my ($px, $py) = ( $ox < $x0 ? $x0 : ( $ox > $x1 ? $x1 : $ox ),
                      $oy < $y0 ? $y0 : ( $oy > $y1 ? $y1 : $oy ) );
    if ( $px > $x0 && $px < $x1 && $py > $y0 && $py < $y1 ) {
      my %d = ( W => $px - $x0, E => $x1 - $px, S => $py - $y0, N => $y1 - $py );
      my $side = ( sort { $d{$a} <=> $d{$b} or $a cmp $b } keys %d )[0];
      if    ( $side eq "W" ) { $px = $x0; }
      elsif ( $side eq "E" ) { $px = $x1; }
      elsif ( $side eq "S" ) { $py = $y0; }
      else                   { $py = $y1; }
    }
    my ($lx, $ly) = ($px - $x0, $py - $y0);
    $lx = $w - $lx if ( $o =~ m/^(S|R180|FN|MY)$/ );
    $ly = $h - $ly if ( $o =~ m/^(S|R180|FS|MX)$/ );
    my $acc = ( $want{$ref}{$pb} ||= [ 0, 0, 0 ] );
    $acc->[0] += $lx;
    $acc->[1] += $ly;
    $acc->[2]++;
  }
}

#<!-- Onto the edges, spread, and stored on the child -->
my $pitch = $GLOBAL->dbGlobalGetRowHeight;
$pitch = ( defined $pitch && $pitch > 0 ) ? $pitch / 4 : 0.05;
foreach my $ref ( sort keys %want ) {
  my ($w, $h) = @{$dims{$ref}};
  my %onEdge = ();
  foreach my $pb ( keys %{$want{$ref}} ) {
    my ($sx, $sy, $n) = @{$want{$ref}{$pb}};
    my ($lx, $ly) = ($sx / $n, $sy / $n);
    #<!-- an average of boundary points can fall inside: the nearest edge -->
    my %d = ( W => $lx, E => $w - $lx, S => $ly, N => $h - $ly );
    my $side = ( sort { $d{$a} <=> $d{$b} or $a cmp $b } keys %d )[0];
    push(@{$onEdge{$side}}, [ ( $side eq "W" || $side eq "E" ) ? $ly : $lx, $pb ]);
  }
  my $pseudo = $PSEUDO_MODULE_ALREADY{$ref};
  my $fp = $pseudo->dbaTstgenGetFloorplan;
  $pseudo->dbaTstgenSetFloorplan("$ref/_self_") unless ( defined $fp && $fp ne "" );
  foreach my $side ( sort keys %onEdge ) {
    my $vertical = ( $side eq "W" || $side eq "E" );
    my $len = $vertical ? $h : $w;
    my @p = sort { $a->[0] <=> $b->[0] or $a->[1] cmp $b->[1] } @{$onEdge{$side}};
    my $step = ( @p * $pitch > $len ) ? $len / @p : $pitch;
    #<!-- least displacement in the wanted order: sweep forward, then back if
    #     the far end overflowed -->
    my $prev;
    foreach my $q ( @p ) {
      my $v = ( $q->[0] < 0 ) ? 0 : $q->[0];
      $v = $prev + $step if ( defined $prev && $v < $prev + $step );
      $q->[0] = $v;
      $prev = $v;
    }
    if ( $p[-1][0] > $len ) {
      my $next;
      foreach my $q ( reverse @p ) {
        my $v = ( $q->[0] > $len ) ? $len : $q->[0];
        $v = $next - $step if ( defined $next && $v > $next - $step );
        $v = 0 if ( $v < 0 );
        $q->[0] = $v;
        $next = $v;
      }
    }
    foreach my $q ( @p ) {
      my ($x, $y) = $vertical ? ( ( $side eq "W" ? 0 : $w ), $q->[0] )
                              : ( $q->[0], ( $side eq "S" ? 0 : $h ) );
      $pseudo->dbaTstgenAddPin($q->[1]) unless ( $pseudo->dbaTstgenHasPin($q->[1]) );
      $pseudo->dbaTstgenWipePinRect($q->[1]);
      $pseudo->dbaTstgenAddPinRect($q->[1], "NONE $x $y $x $y");
      $pseudo->dbaTstgenSetPinStatus($q->[1], "FIXED");
      $sum{pins}++;
    }
  }
  $pseudo->dbaTstgenSetPhysicalDirty(1);
  $done->{$ref} = 1;
  $sum{children}++;
}

return \%sum;

}# sub dbfTstgenHierProjectChildPins


#****f* /hier_place_all
#  hier_place_all
# FUNCTION
#  Place every module of a hierarchy, walking down from the top.
#
#  Runs edit_module, hier_place, hier_place_cells and commit_module once per
#  distinct module, parents before children, then reopens the top and expands
#  the result into the flat database with hier2flat.
#****
sub hier_place_all {

use Benchmark;
my $t0 = new Benchmark;

my $noOfArguments = @_;
#----------------- Defaults --------------------#
my $top = $GLOBAL->dbfGlobalGetTOP;
my $batch = 400;
my $cellsBatch;
my $maxDepth = -1;
my $util;
my $placer;
my $cellsPlacer;
my $netWeights = "";
my $weightScale = 10;
my $weightPower = 3;
my $fpSpecFile = "";
my $keepShapes = 0;
my $only = "";
my $cellsAnchor = "";
my $freeFlops = 0;
my $seqAnchorLimit = 2000;
my $legalize = 0;
my $whitespace = 0;
my $sizing = "";
my $mixedWs = 10;
my $macroHalo = 15;
my $metricsFile = "hier_place_all.metrics.jsonl";
my $sliceBlocks = 0;
my $legalizeBlocks = 0;
my $blockTargetsFile = "";
my $blockAspect = 3;
my $childPins = 0;
my %childPinsDone = ();
my $fanoutLimit = 0;
my $extra = "";
my ($noCells, $noFlatten, $skipPlaced, $reportOnly, $keepFiles) = (0, 0, 0, 0, 0);
#<!-- -snapshot writes the whole chip, as the walk has it so far, after every
#     module.  There is otherwise no way to watch this command work: the flat
#     database it would be seen in does not exist until hier2flat at the end. -->
my $snapPrefix;
my $snapArgs = "";
my $snapCnt = 0;

if ( $noOfArguments > 0 && ($_[0] eq '-h' || $_[0] eq '-help' || $_[0] eq 'HELP') ) {
  print "Usage : hier_place_all -module <top module>    default: the current top\n";
  print "                       -batch <steps>          blocks and ports, per module, default 400\n";
  print "                       -cells_batch <steps>    cells, per module, default -batch\n";
  print "                       -depth <levels>         0 is the top only, unset is the whole tree\n";
  print "                       -util <percent>         for a module with no parent box to inherit\n";
  print "                       -placer <path>          defaults to ELECTRON_HOME/3RDBIN/hier_place\n";
  print "                       -net_weights <file> weight the cell pass for timing: Photon's\n";
  print "                                          netCriticality (flat nets on violating paths);\n";
  print "                                          a placer that reads weights (qp) pulls those\n";
  print "                                          cones tight.  -weight_scale <K>, default 10;\n";
  print "                                          -weight_power <P>, default 3\n";
  print "                       -floorplan_spec <file>  the arrangement of some modules' child\n";
  print "                                          blocks, given as a cut tree per module:\n";
  print "                                          \"mod : V( a H( b c ) d )\", V stacked top\n";
  print "                                          to bottom, H left to right; * once for\n";
  print "                                          the module's own logic.  Sizes come\n";
  print "                                          from -sizing as usual; the block pass then\n";
  print "                                          places only the ports and flops around them\n";
  print "                       --keep_shapes           every module already placed keeps its exact\n";
  print "                                          width x height: sizing and a spec only move\n";
  print "                                          it, so its internal placement stays valid.  For\n";
  print "                                          re-placing only the top (-depth 0 --no_cells)\n";
  print "                                          in a session that has placed everything\n";
  print "                       -only <module>          place that module alone, in the box it has,\n";
  print "                                          with --keep_shapes: its children move as\n";
  print "                                          blocks by its -floorplan_spec line, its own\n";
  print "                                          cells are placed again, nothing else moves\n";
  print "                       -cells_anchor <command> hier_place_cells -anchor for every module\n";
  print "                                          placed (with -only, that one): e.g.\n";
  print "                                          3RDBIN/array_anchor for a register file\n";
  print "                       -cells_placer <path>|qp the cell pass only, default -placer.  qp\n";
  print "                                               is ELECTRON_HOME/3RDBIN/hier_place_qp,\n";
  print "                                               the analytic one: seconds where\n";
  print "                                               hier_place takes hours on a big module\n";
  print "                       --free_flops            the cell pass places the flops too\n";
  print "                       -whitespace <pct>       size every child block with this much\n";
  print "                                               room to arrange it in, at every level;\n";
  print "                                               0 (the default) keeps the old sizes\n";
  print "                       -sizing budget          size every child block by the budget\n";
  print "                                               model: macros with a halo, cells at\n";
  print "                                               one utilization solved so the top fits\n";
  print "                                               its die, and whitespace only where\n";
  print "                                               children are mixed\n";
  print "                       -mixed_whitespace <pct> for -sizing budget, default 10\n";
  print "                       -macro_halo <pct>       for -sizing budget, default 15\n";
  print "                       --slice_blocks          after each block pass, lay the child\n";
  print "                                               blocks out without overlap by slicing\n";
  print "                                               the box (identical siblings as a grid)\n";
  print "                       --legalize_blocks       after each block pass, lay the child\n";
  print "                                               blocks out without overlap as near as\n";
  print "                                               fits to where the pass put them, not\n";
  print "                                               by slicing: a small block may sit\n";
  print "                                               between big ones (3RDBIN/block_legalize)\n";
  print "                       -block_targets <file>   --legalize_blocks toward a plan: lines of\n";
  print "                                               module<TAB>instance<TAB>cx<TAB>cy, the\n";
  print "                                               centre as a fraction of the parent's box;\n";
  print "                                               a module listed is laid out before its\n";
  print "                                               block pass and held there, as a\n";
  print "                                               -floorplan_spec line holds it\n";
  print "                       -block_aspect <r>       --legalize_blocks may reshape a block to\n";
  print "                                               any aspect within 1:r (default 3)\n";
  print "                       --child_pins            after each cell pass, put every child\n";
  print "                                               block's pins where the parent's nets\n";
  print "                                               reach it, FIXED, so the child is placed\n";
  print "                                               toward its partners rather than its own\n";
  print "                                               contents\n";
  print "                       -metrics <file>         one JSON line per module per run,\n";
  print "                                               appended; default\n";
  print "                                               hier_place_all.metrics.jsonl\n";
  print "                       --no_metrics            write none\n";
  print "                       --legalize              legalize_module every module before\n";
  print "                                               its commit: hier2flat then copies a\n";
  print "                                               legal arrangement into every instance\n";
  print "                       -seq_anchor_limit <n>   with --free_flops, a module with more\n";
  print "                                               than n flops and latches leaves them out\n";
  print "                                               of its block pass (default 2000)\n";
  print "                       -snapshot <prefix>      write <prefix>NNN.hiercells after every\n";
  print "                                               module: the whole chip as the walk has it\n";
  print "                                               so far, for 3RDBIN/def_raster --cells\n";
  print "                       -snapshot_args <opts>   passed to write_hier_cells, e.g. --blocks\n";
  print "                       -fanout_limit <n>       high fan out threshold for the graphs\n";
  print "                       -args <extra>           passed straight to hier_place\n";
  print "                       --skip_placed           keep an existing placement, fill in the cells\n";
  print "                       --no_cells              blocks and ports only\n";
  print "                       --no_flatten            skip the closing hier2flat\n";
  print "                       --report_only           show the walk, place nothing\n";
  print "                       --keep                  keep the per module graph files\n";
  print "\n";
  print "        Places every module under the top, parents first: a module takes its\n";
  print "        size from its instance box in the parent's floorplan, so the parent\n";
  print "        has to be placed and committed before the child is opened.\n";
  print "\n";
  print "        --skip_placed is the hand off.  Place the top levels yourself with\n";
  print "        the hier_place window, commit them, then run this: a module whose\n";
  print "        floorplan already places something keeps that arrangement and only\n";
  print "        gets its combinational cells filled in around it.\n";
  print "\n";
  print "        It does not legalise unless given --legalize.  Without it, run\n";
  print "        legalize_flat afterwards: the placer snaps nothing to a row.\n";
  return;
}
for (my $i = 0; $i < $noOfArguments; $i++) {
  if    ($_[$i] eq "-module")        { $top = $_[$i+1]; }
  elsif ($_[$i] eq "-batch")         { $batch = $_[$i+1]; }
  elsif ($_[$i] eq "-cells_batch")   { $cellsBatch = $_[$i+1]; }
  elsif ($_[$i] eq "-depth")         { $maxDepth = $_[$i+1]; }
  elsif ($_[$i] eq "-util")          { $util = $_[$i+1]; }
  elsif ($_[$i] eq "-placer")        { $placer = $_[$i+1]; }
  elsif ($_[$i] eq "-cells_placer")  { $cellsPlacer = $_[$i+1];
                                       if ( $cellsPlacer eq "qp" ) {
                                         $cellsPlacer = $GLOBAL->dbfGlobalGetElectronHome . "/3RDBIN/hier_place_qp";
                                       } }
  elsif ($_[$i] eq "--free_flops")   { $freeFlops = 1; }
  elsif ($_[$i] eq "--legalize")     { $legalize = 1; }
  elsif ($_[$i] eq "-whitespace")    { $whitespace = $_[$i+1]; }
  elsif ($_[$i] eq "-sizing")        { $sizing = $_[$i+1]; }
  elsif ($_[$i] eq "-mixed_whitespace") { $mixedWs = $_[$i+1]; }
  elsif ($_[$i] eq "-macro_halo")    { $macroHalo = $_[$i+1]; }
  elsif ($_[$i] eq "-metrics")       { $metricsFile = $_[$i+1]; }
  elsif ($_[$i] eq "--no_metrics")   { $metricsFile = ""; }
  elsif ($_[$i] eq "--slice_blocks") { $sliceBlocks = 1; }
  elsif ($_[$i] eq "--legalize_blocks") { $legalizeBlocks = 1; }
  elsif ($_[$i] eq "-block_targets") { $blockTargetsFile = $_[$i+1]; $legalizeBlocks = 1; }
  elsif ($_[$i] eq "-block_aspect")  { $blockAspect = $_[$i+1]; }
  elsif ($_[$i] eq "--child_pins")   { $childPins = 1; }
  elsif ($_[$i] eq "-seq_anchor_limit") { $seqAnchorLimit = $_[$i+1]; }
  elsif ($_[$i] eq "-fanout_limit")  { $fanoutLimit = $_[$i+1]; }
  elsif ($_[$i] eq "-args")          { $extra = $_[$i+1]; $i++; }
  elsif ($_[$i] eq "--skip_placed")  { $skipPlaced = 1; }
  elsif ($_[$i] eq "--no_cells")     { $noCells = 1; }
  elsif ($_[$i] eq "--no_flatten")   { $noFlatten = 1; }
  elsif ($_[$i] eq "--report_only")  { $reportOnly = 1; }
  elsif ($_[$i] eq "--keep")         { $keepFiles = 1; }
  elsif ($_[$i] eq "-net_weights")   { $netWeights = $_[$i+1]; }
  elsif ($_[$i] eq "-weight_scale")  { $weightScale = $_[$i+1]; }
  elsif ($_[$i] eq "-weight_power")  { $weightPower = $_[$i+1]; }
  elsif ($_[$i] eq "-floorplan_spec"){ $fpSpecFile = $_[$i+1]; }
  elsif ($_[$i] eq "--keep_shapes")  { $keepShapes = 1; }
  elsif ($_[$i] eq "-only")          { $only = $_[$i+1]; }
  elsif ($_[$i] eq "-cells_anchor")  { $cellsAnchor = $_[$i+1]; }
  elsif ($_[$i] eq "-snapshot")      { $snapPrefix = $_[$i+1]; }
  elsif ($_[$i] eq "-snapshot_args") { $snapArgs = $_[$i+1]; }
  elsif ($_[$i] =~ m/^-+\w/)         { print "WARN-TST-HR_PL_ALL : 001 : invalid option $_[$i]\n"; }
}

unless ( defined $top && $top ne "" && exists $MODULE_ALREADY{$top} ) {
  print "ERR-TST-HR_PL_ALL : 002 : there is no module $top to place, read a netlist first\n";
  return;
}
unless ( defined $cellsBatch && $cellsBatch ne "" ) {
  $cellsBatch = $batch;
}

#--------------------------------------------------------------------------
# The walk
#--------------------------------------------------------------------------
my @order = ();
my %seen = ();
my %instCnt = ();
#<!-- -only <module>: that module alone, in the box its parent gave it, its
#     children kept as they are (--keep_shapes) and moved as blocks by its line
#     of -floorplan_spec, its own cells placed again.  The fast loop one level
#     down: the parent is not touched, so nothing outside the module moves. -->
my @onlyPaths = ();
if ( $only ne "" ) {
  unless ( exists $MODULE_ALREADY{$only} ) {
    print "ERR-TST-HR_PL_ALL : 047 : -only $only: no such module\n";
    return;
  }
  unless ( $keepShapes ) {
    print "ERR-TST-HR_PL_ALL : 048 : -only re-places one level inside placed blocks; it needs --keep_shapes\n";
    return;
  }
  my %allPaths = ();
  &dbfTstgenHierAllInstPaths($top, "", \%allPaths);
  @onlyPaths = sort @{ $allPaths{$only} || [] };
  unless ( @onlyPaths ) {
    print "ERR-TST-HR_PL_ALL : 049 : -only $only: not instantiated under $top\n";
    return;
  }
  my ($cw, $ch) = &dbfTstgenHierCommittedSize($only);
  unless ( $cw > 0 && $ch > 0 ) {
    print "ERR-TST-HR_PL_ALL : 050 : -only $only: it has no committed floorplan yet -- place the design first\n";
    return;
  }
  printf("INFO-TST-HR_PL_ALL : 051 : -only %s: %d instance(s), %.3f x %.3f um, its children kept\n",
         $only, scalar(@onlyPaths), $cw, $ch);
}

#<!-- --keep_shapes -depth 0 (or -only) moves one module's children as rigid
#     blocks and nothing inside them.  Note where each one is now, so the
#     closing hier2flat can shift the flat cells under it by how far it moved
#     rather than rebuild all of them from the floorplans: 85 s of a 212 s
#     re-place on a 3M-instance tile.  This takes the flat database to agree
#     with the committed floorplans, as it does after hier2flat -- or after
#     legalize_flat, whose legal positions the shift then keeps. -->
%HIER2FLAT_RIGID = ();
my $rigidMod = ( $only ne "" ) ? $only : $top;
if ( $keepShapes && ( $only ne "" || $maxDepth == 0 ) && ! $noFlatten && $top eq $GLOBAL->dbfGlobalGetTOP ) {
  my $rf = &get_floorplanID_of_module($rigidMod);
  if ( $rf != -1 && exists $FLOORPLAN_ALREADY{$rf} ) {
    my %kids = ();
    foreach my $c ( $FLOORPLAN_ALREADY{$rf}->dbFlplanGetHierInstList ) {
      my @e = $FLOORPLAN_ALREADY{$rf}->dbFlplanGetHierInstExtent($c);
      next unless ( @e == 4 );
      $kids{$c} = [ $e[0], $e[1], $FLOORPLAN_ALREADY{$rf}->dbFlplanGetHierInstOrient($c) ];
    }
    %HIER2FLAT_RIGID = ( module => $rigidMod, kids => \%kids,
                         paths => ( $only ne "" ? [ @onlyPaths ] : [ "" ] ) );
  }
}
if ( $only ne "" ) {
  push(@order, [ $only, 0, "$top/$onlyPaths[0]" ]);
  $seen{$only} = [ "$top/$onlyPaths[0]" ];
  $instCnt{$only} = scalar(@onlyPaths);
}
else {
  &dbfTstgenHierPlaceWalk($top, 0, $top, $maxDepth, \@order, \%seen, \%instCnt);
}
#<!-- -net_weights names FLAT nets (mc_fp/foo); write_pseudo_graph finds a
#     module's own by stripping each instance path the walk reached it by,
#     less the top's name (mc2/mc_fp -> mc_fp; the top itself -> "") -->
%HIER_PLACE_NET_PREFIXES = ();
my $fpSpec = {};
if ( $fpSpecFile ne "" ) {
  $fpSpec = &dbfTstgenReadFloorplanSpec($fpSpecFile);
  return unless ( defined $fpSpec );
  my @unknown = grep { ! exists $MODULE_ALREADY{$_} } sort keys %$fpSpec;
  if ( @unknown ) {
    print "ERR-TST-HR_PL_ALL : 042 : -floorplan_spec names module(s) not in the design: @unknown\n";
    return;
  }
  print "INFO-TST-HR_PL_ALL : 043 : floorplan spec for " . scalar(keys %$fpSpec) . " module(s) from $fpSpecFile: " .
        join(" ", sort keys %$fpSpec) . "\n";
}
my $blockTargets = {};
if ( $blockTargetsFile ne "" ) {
  $blockTargets = &dbfTstgenReadBlockTargets($blockTargetsFile);
  return unless ( defined $blockTargets );
  my @unknown = grep { ! exists $MODULE_ALREADY{$_} } sort keys %$blockTargets;
  if ( @unknown ) {
    print "ERR-TST-HR_PL_ALL : 057 : -block_targets names module(s) not in the design: @unknown\n";
    return;
  }
  my $nb = 0; $nb += scalar(keys %{$blockTargets->{$_}}) foreach ( keys %$blockTargets );
  print "INFO-TST-HR_PL_ALL : 058 : block targets for $nb block(s) of " . scalar(keys %$blockTargets) . " module(s) from $blockTargetsFile\n";
}
if ( $legalizeBlocks && $sliceBlocks ) {
  print "WARN-TST-HR_PL_ALL : 059 : --legalize_blocks and --slice_blocks both given: blocks are legalized, not sliced\n";
  $sliceBlocks = 0;
}
if ( $netWeights ne "" ) {
  #<!-- every instance of every module: the walk above expands one instance
  #     per module, and a module's other instances (three of four lanes)
  #     would otherwise get no weights -->
  my %allPaths = ();
  &dbfTstgenHierAllInstPaths($top, "", \%allPaths);
  %HIER_PLACE_NET_PREFIXES = %allPaths;
  my $np = 0; $np += scalar(@{$allPaths{$_}}) foreach ( keys %allPaths );
  print "INFO-TST-HR_PL_ALL : 037 : $np instance path(s) of " . scalar(keys %allPaths) . " module(s) for the timing weights\n";
  print "INFO-TST-HR_PL_ALL : 036 : cell placement weighted for timing from $netWeights (scale $weightScale, power $weightPower)\n";
}

my $modCnt = @order;
print "INFO-TST-HR_PL_ALL : 003 : $modCnt module(s) to place under $top\n";
foreach my $rec ( @order ) {
  my ($mod, $depth, $path) = @{$rec};
  my $indent = "  " x $depth;
  my $n = $instCnt{$mod};
  my $note = "";
  if ( defined $n && $n > 1 ) { $note = "   ($n instances, one shared floorplan)"; }
  if ( $skipPlaced && &dbfTstgenHierModuleIsPlaced($mod) ) {
    $note .= "   (already placed)";
  }
  print "    $indent$mod$note\n";
}

#<!-- One floorplan per module, so every instance of a module gets the same
#     contents.  Worth saying out loud: the size comes from one instance box
#     and the others have to match it, and nothing downstream checks that. -->
my @shared = ();
foreach my $rec ( @order ) {
  my $mod = $rec->[0];
  if ( defined $instCnt{$mod} && $instCnt{$mod} > 1 ) { push(@shared, $mod); }
}
if ( @shared ) {
  my $verb = ( @shared > 1 ) ? "are" : "is";
  print "WARN-TST-HR_PL_ALL : 004 : @shared $verb instantiated more than once\n";
  print "WARN-TST-HR_PL_ALL : 005 : a module has one floorplan, so every instance of it gets the\n";
  print "WARN-TST-HR_PL_ALL : 006 : same internal placement, sized from the first instance found;\n";
  print "WARN-TST-HR_PL_ALL : 007 : an instance given a smaller box will have its contents outside it\n";
}

if ( $reportOnly ) {
  print "INFO-TST-HR_PL_ALL : 008 : --report_only given, nothing was placed\n";
  return;
}

#--------------------------------------------------------------------------
# Place, one module at a time, parents first
#--------------------------------------------------------------------------
my ($doneCnt, $keptCnt, $failCnt) = (0, 0, 0);
my %wsMemo = ();
%HIER_OWN_AREA = ();    #<!-- see dbfTstgenHierBudgetArea -->
my %wsSize = ();        #<!-- module => [w, h] that -whitespace gave it -->
my %sliceShape = ();    #<!-- module => [w, h] a slicing fixed -->
#<!-- --keep_shapes: every module that already has a committed floorplan is a
#     fixed shape from the start.  The slicer then only places it, the budget
#     sizing below leaves its box alone, and the placement inside it -- which
#     this walk may never revisit (-depth 0) -- still fits. -->
if ( $keepShapes ) {
  my $n = 0;
  foreach my $m ( sort keys %MODULE_ALREADY ) {
    next if ( $m eq $top );
    my ($cw, $ch) = &dbfTstgenHierCommittedSize($m);
    next unless ( $cw > 0 && $ch > 0 );
    $sliceShape{$m} = [ $cw, $ch ];
    $wsSize{$m} = [ $cw, $ch ];
    $n++;
  }
  print "INFO-TST-HR_PL_ALL : 046 : --keep_shapes: $n module(s) keep the shape of their committed floorplan\n";
}
my $wsSiteUm = 0;
my $budget = ( $sizing eq "budget" ) ? 1 : 0;
if ( $sizing ne "" && ! $budget ) {
  print "WARN-TST-HR_PL_ALL : 029 : -sizing $sizing is not known; budget is the one there is\n";
}
my ($bU, $bPack, $bHalo) = (0, 1 - $mixedWs / 100, $macroHalo / 100);
if ( $whitespace > 0 || $budget || $sliceBlocks ) {
  my $tfp = $FLOORPLAN_LOOKUP{"$top/_self_"};
  if ( defined $tfp && exists $FLOORPLAN_ALREADY{$tfp} ) {
    my $tdbu = $FLOORPLAN_ALREADY{$tfp}->dbFlplanGetDBUnit;
    $tdbu = $GLOBAL->dbfGlobalGetDBU unless ( defined $tdbu && $tdbu > 0 );
    foreach my $tag ( $FLOORPLAN_ALREADY{$tfp}->dbFlplanGetRows ) {
      my @f = split(/\s+/, $tag);
      if ( @f >= 8 && $f[7] > 0 ) { $wsSiteUm = $f[7] / $tdbu; last; }
    }
  }
}
#<!-- -sizing budget: the one cell utilization at which the whole tree, sized
#     by the budget model, fills the top's box -- the die set_floorplan made.
#     The loosest that fits: the top's slack spread to every level, rather
#     than every level packed at edit_module's 70% and the slack left at the
#     top.  Bisection; the box only grows as u falls. -->
if ( $budget ) {
  my ($tw, $th) = &dbfTstgenHierPseudoSize($top);
  my $target = 0.97 * $tw * $th;
  my $fits = sub { return &dbfTstgenHierBudgetArea($top, $_[0], $bPack, $bHalo, {}) <= $target; };
  if ( $fits->(0.95) ) {
    my ($lo, $hi) = (0.05, 0.95);
    for ( my $k = 0 ; $k < 40 ; $k++ ) {
      my $mid = ($lo + $hi) / 2;
      if ( $fits->($mid) ) { $hi = $mid; } else { $lo = $mid; }
    }
    $bU = $hi;
    printf("INFO-TST-HR_PL_ALL : 030 : -sizing budget: cells at %.1f%% utilization fill %s's %.1f x %.1f um; mixed levels keep %g%% free, macros a %g%% halo\n",
           100 * $bU, $top, $tw, $th, $mixedWs, $macroHalo);
  }
  else {
    $bU = 0.95;
    my $need = &dbfTstgenHierBudgetArea($top, $bU, $bPack, $bHalo, {});
    printf("WARN-TST-HR_PL_ALL : 031 : -sizing budget: %s does not fit its %.1f x %.1f um even at 95%%; it needs %.0f um2 of the %.0f there is\n",
           $top, $tw, $th, $need, $tw * $th);
  }
}

#<!-- metrics: how many times each module is instantiated, a run id, the file -->
my %copies = ();
{
  #<!-- top down by depth, so a module's count is complete before its
  #     children take theirs from it (a module reached at two different
  #     depths is counted from the order the walk has it in) -->
  $copies{$top} = 1;
  foreach my $r ( sort { $a->[1] <=> $b->[1] } @order ) {
    my $m = $r->[0];
    next unless ( exists $MODULE_ALREADY{$m} && exists $copies{$m} );
    foreach my $inst ( $MODULE_ALREADY{$m}->dbVNOMGetHierInst ) {
      my $ref = $MODULE_ALREADY{$m}->dbVNOMGetHierInstCell($inst);
      next unless ( defined $ref && exists $MODULE_ALREADY{$ref} );
      $copies{$ref} += $copies{$m};
    }
  }
}
my $runId = sprintf("%d-%d", time(), $$);
my $metricsFh;
if ( defined $metricsFile && $metricsFile ne "" ) {
  unless ( open($metricsFh, ">>", $metricsFile) ) {
    print "WARN-TST-HR_PL_ALL : 032 : cannot append to $metricsFile, no metrics written\n";
    undef $metricsFh;
  }
}
my $metricsCnt = 0;

my $step = 0;

foreach my $rec ( @order ) {
  my ($mod, $depth, $path) = @{$rec};
  $step++;
  my %mrec = ();

  #<!-- Don't reopen a module that is already open with a size.
  #
  #     The first module in the walk is normally the one the flow just set up
  #     by hand -- "edit_module --top -util 50" -- and reopening it throws that
  #     away: edit_module has no memory of -util, so with no floorplan to load
  #     yet it re-estimates the size at the default 70% and the die silently
  #     shrinks by sqrt(50/70).  A module that is open, sized, and has its
  #     instances loaded needs nothing done to it.
  #
  #     A child is never in that state on the way down: opening its parent
  #     leaves it with pins and, after the parent commits, a size, but no
  #     instances and no nets -- so it is opened properly here. -->
  my ($openW, $openH) = &dbfTstgenHierPseudoSize($mod);
  if ( $TOP_MODULE eq $mod && exists $PSEUDO_VINST_ALREADY{$mod} &&
       $openW > 0 && $openH > 0 ) {
    print "INFO-TST-HR_PL_ALL : 019 : $mod is already open at its current size, using it as it is\n";
  }
  else {
    my @editArgs = ("-module", $mod);
    push(@editArgs, "-util", $util) if ( defined $util && $util ne "" );
    &editModule(@editArgs);
  }

  #<!-- edit_module reloads the module's pseudo model and sizes it again: from
  #     its own floorplan, else its parent's, else its cell area at 70%.  The
  #     parent route gives up for a module instantiated more than once (it
  #     sees one parent per instance), so a block -whitespace resized came
  #     back here at the old estimate and its whitespaced children did not
  #     fit -- 108% of a 16-copy column.  Put back the size its parent placed. -->
  if ( exists $wsSize{$mod} && exists $PSEUDO_MODULE_ALREADY{$mod} ) {
    $PSEUDO_MODULE_ALREADY{$mod}->dbaTstgenSetSize(0, 0, @{$wsSize{$mod}});
  }

  unless ( exists $PSEUDO_MODULE_ALREADY{$mod} ) {
    print "WARN-TST-HR_PL_ALL : 009 : $mod could not be opened for edit, skipping it\n";
    $failCnt++;
    next;
  }

  #<!-- No box means no area, and a placer handed a design of zero area has no
  #     density to spread: every node ends up on top of every other.  Say which
  #     module and why rather than placing into nothing. -->
  my ($w, $h) = &dbfTstgenHierPseudoSize($mod);
  if ( $w <= 0 || $h <= 0 ) {
    print "WARN-TST-HR_PL_ALL : 010 : $mod has no size, so there is nothing to place into\n";
    print "WARN-TST-HR_PL_ALL : 011 : its instance box in the parent floorplan is empty; commit the\n";
    print "WARN-TST-HR_PL_ALL : 012 : parent first, or give -util so the size is estimated from cell area\n";
    $failCnt++;
    next;
  }

  my $keepExisting = ( $skipPlaced && &dbfTstgenHierModuleIsPlaced($mod) );

  printf("INFO-TST-HR_PL_ALL : 013 : [%d/%d] %s, %.3f x %.3f um at depth %d\n",
         $step, $modCnt, $mod, $w, $h, $depth);
  %mrec = ( run => $runId, top => $top, module => $mod, depth => $depth,
            copies => ( exists $copies{$mod} ? $copies{$mod} : 1 ),
            box_w => $w, box_h => $h,
            features => &dbfTstgenHierModuleFeatures($mod, $GLOBAL->dbGlobalGetRowHeight),
            sizing => ( $budget ? "budget" : ( $whitespace > 0 ? "whitespace" : "edit_module" ) ),
            util => ( $budget ? $bU : ( ( defined $util && $util > 0 ) ? $util / 100 : 0.70 ) ),
            pack => ( $budget ? &dbfTstgenHierPack($mod, $bPack)
                              : ( $whitespace > 0 ? 1 - $whitespace / 100 : 1 ) ),
            options => { whitespace => $whitespace, mixed_whitespace => $mixedWs,
                         macro_halo => $macroHalo, free_flops => $freeFlops,
                         legalize => $legalize, batch => $batch, cells_batch => $cellsBatch,
                         extra => $extra } );

  #<!-- -whitespace: resize this module's child modules before its block pass
  #     places them.  Square, rounded up to whole sites and an even number of
  #     rows, so a child can be dropped onto the row grid without losing a row
  #     (legalize_module snaps blocks to even rows).  The parent's own box was
  #     set when ITS parent was placed, so this is the last moment the size of
  #     a child can still change. -->
  if ( ( $whitespace > 0 || $budget ) && ! $keepExisting ) {
    my $pack = $budget ? &dbfTstgenHierPack($mod, $bPack) : 1 - $whitespace / 100;
    my $u = ( defined $util && $util > 0 ) ? $util / 100 : 0.70;
    my $rowHum = $GLOBAL->dbGlobalGetRowHeight;
    my $siteUm = $wsSiteUm;
    my %seen = ();
    my $sumBox = 0;
    my $nResized = 0;
    foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$mod}} ) {
      next if ( $inst eq "PIN" );
      my $ref = $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstCellref;
      next unless ( defined $ref && exists $PSEUDO_MODULE_ALREADY{$ref} );
      my $side = $budget ? sqrt( &dbfTstgenHierBudgetArea($ref, $bU, $bPack, $bHalo, \%wsMemo) )
                         : sqrt( &dbfTstgenHierEffArea($ref, $pack, \%wsMemo) / $u );
      my $bw = ( $siteUm > 0 ) ? POSIX::ceil( $side / $siteUm - 1e-9 ) * $siteUm : $side;
      my $bh = ( $rowHum > 0 ) ? POSIX::ceil( $side / (2 * $rowHum) - 1e-9 ) * 2 * $rowHum : $side;
      #<!-- --keep_shapes: an already placed child keeps the box it was placed in -->
      ($bw, $bh) = @{$sliceShape{$ref}} if ( $keepShapes && exists $sliceShape{$ref} );
      $sumBox += $bw * $bh;
      #<!-- the instance box too, not just the module: the block pass takes a
      #     block's size from its instance box, which edit_module filled in
      #     when this module was opened, and reads the module's size only for
      #     an instance that has none.  Resizing only the module changed
      #     nothing.  The lower left stays where it was. -->
      my @bb = &dbfTstgenBboxFromCoords($PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstRelBbox);
      my ($bx, $by) = ( @bb >= 2 && defined $bb[1] ) ? ($bb[0], $bb[1]) : (0, 0);
      $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBSetInstRelBbox($bx, $by, $bx + $bw, $by + $bh);
      next if ( $seen{$ref}++ );
      $PSEUDO_MODULE_ALREADY{$ref}->dbaTstgenSetSize(0, 0, $bw, $bh);
      $wsSize{$ref} = [ $bw, $bh ];
      $nResized++;
    }
    if ( $nResized > 0 ) {
      my $fill = $sumBox / ( $w * $h );
      printf("INFO-TST-HR_PL_ALL : 026 : %s: %d child module(s) resized, their blocks fill %.1f%% of %s\n",
             $budget ? "-sizing budget" : "-whitespace $whitespace", $nResized, 100 * $fill, $mod);
      @mrec{qw(children_resized children_box_fill)} = ($nResized, $fill);
      if ( $budget && $fill > $pack + 0.02 ) {
        printf("WARN-TST-HR_PL_ALL : 033 : %s's blocks fill %.1f%% of it, more than the %.0f%% the budget allows\n",
               $mod, 100 * $fill, 100 * $pack);
      }
      if ( ! $budget && $fill > $pack + 1e-6 ) {
        #<!-- the die utilization at which this module's contents would fit:
        #     its raw cell area over the box its whitespaced area asks for -->
        my $raw = &dbfTstgenHierEffArea($mod, 1, {});
        my $need = 100 * $raw * $u / &dbfTstgenHierEffArea($mod, $pack, \%wsMemo);
        printf("WARN-TST-HR_PL_ALL : 027 : that leaves less than %g%% free: %s's own box is too small for\n", $whitespace, $mod);
        printf("WARN-TST-HR_PL_ALL : 028 : its contents with this whitespace -- at the top, set_floorplan at about %.0f%% utilization\n",
               $need * 0.95);
      }
    }
  }

  #<!-- -floorplan_spec: cut this module's box by the given tree, before the
  #     block pass, and hold the blocks there FIXED, so the pass only places
  #     the ports and the flops around them.  A spec that does not name the
  #     module's blocks exactly is reported and the module placed as usual. -->
  my @specHeld = ();
  if ( exists $fpSpec->{$mod} && ! $keepExisting ) {
    my $sum = &dbfTstgenHierSliceBlocks($mod, $w, $h, $wsSiteUm, $GLOBAL->dbGlobalGetRowHeight,
                                        \%sliceShape, \%wsSize, $fpSpec->{$mod});
    if ( exists $sum->{error} ) {
      print "WARN-TST-HR_PL_ALL : 044 : floorplan spec for $mod not used, it is placed as usual: $sum->{error}\n";
    }
    else {
      foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$mod}} ) {
        next if ( $inst eq "PIN" );
        my $ref = $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstCellref;
        next unless ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
        my @bb = &dbfTstgenBboxFromCoords($PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstRelBbox);
        next unless ( @bb >= 4 && defined $bb[3] && $bb[2] > $bb[0] && $bb[3] > $bb[1] );
        $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBSetInstStatus("FIXED");
        push(@specHeld, $inst);
      }
      $mrec{floorplan_spec} = $sum;
      printf("INFO-TST-HR_PL_ALL : 045 : %s arranged by the floorplan spec: %d block(s), worst aspect %.2f%s%s%s\n",
             $mod, $sum->{blocks}, $sum->{worst_aspect},
             $sum->{own_region} ? sprintf(", %.0f um2 kept for its own logic", $sum->{own_region}) : "",
             $sum->{hard_misses} ? ", $sum->{hard_misses} fixed shape(s) did not fit" : "",
             $sum->{too_small} ? ", $sum->{too_small} slice(s) too small, block given one row pair" : "");
    }
  }

  #<!-- -block_targets: a module the plan names is laid out toward its
  #     targets before the block pass and held FIXED through it, as a spec
  #     line holds one -- the pass then only places ports and flops around
  #     the blocks.  A spec line wins: it is the person's explicit word. -->
  if ( $legalizeBlocks && exists $blockTargets->{$mod} && ! @specHeld && ! $keepExisting ) {
    my %tg = map { $_ => [ $blockTargets->{$mod}{$_}[0] * $w, $blockTargets->{$mod}{$_}[1] * $h ] } keys %{$blockTargets->{$mod}};
    my $sum = &dbfTstgenHierLegalizeBlocks($mod, $w, $h, $wsSiteUm, $GLOBAL->dbGlobalGetRowHeight,
                                           \%sliceShape, \%wsSize, \%tg, $blockAspect);
    if ( exists $sum->{error} ) {
      print "WARN-TST-HR_PL_ALL : 060 : block targets for $mod not used, it is placed as usual: $sum->{error}\n";
    }
    elsif ( $sum->{blocks} > 0 ) {
      foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$mod}} ) {
        next if ( $inst eq "PIN" );
        my $ref = $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstCellref;
        next unless ( defined $ref && ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} ) );
        $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBSetInstStatus("FIXED");
        push(@specHeld, $inst);
      }
      $mrec{block_targets} = $sum;
      $mrec{blocks_after_legalize} = &dbfTstgenHierBlockFit($mod, $w, $h);
      printf("INFO-TST-HR_PL_ALL : 061 : %s laid out toward its block targets: %s%s\n", $mod, $sum->{summary},
             $sum->{no_target} ? "; $sum->{no_target} block(s) had no target and kept the sizing walk's centre" : "");
      print "WARN-TST-HR_PL_ALL : 068 : $mod: blocks still overlap by $sum->{overlap_pct}% of their area, $sum->{overrun} um over the box -- more than legalize_flat should be left\n" if ( $sum->{too_much} );
    }
  }
  elsif ( exists $blockTargets->{$mod} && @specHeld ) {
    print "WARN-TST-HR_PL_ALL : 062 : $mod has both a floorplan spec line and block targets: the spec is used\n";
  }

  if ( $keepExisting ) {
    print "INFO-TST-HR_PL_ALL : 014 : $mod is already placed, keeping that arrangement\n";
    $keptCnt++;
  }
  else {
    my @placeArgs = ("-module", $mod, "-kinds", "INST,PORT", "-batch", $batch);
    push(@placeArgs, "-placer", $placer) if ( defined $placer && $placer ne "" );
    push(@placeArgs, "-fanout_limit", $fanoutLimit) if ( $fanoutLimit > 0 );
    push(@placeArgs, "-args", $extra) if ( defined $extra && $extra ne "" );
    push(@placeArgs, "--keep") if ( $keepFiles );
    #<!-- With --free_flops the cell pass places the flops anyway, so a module
    #     with thousands of them leaves them out of this pass: carried as nodes
    #     they cost 20 and 37 minutes on a tile's top level and on a latch-array
    #     register bank, for positions the cell pass then moves.  Below the
    #     limit they stay: on a design whose block passes take seconds,
    #     dropping them everywhere cost 7% wirelength, because the pins and
    #     blocks lose what the flops say about where they belong. -->
    if ( $freeFlops ) {
      my $seqCnt = 0;
      foreach my $inst ( keys %{$PSEUDO_VINST_ALREADY{$mod}} ) {
        next if ( $inst eq "PIN" );
        my $ref = $PSEUDO_VINST_ALREADY{$mod}{$inst}->dbPimDBGetInstCellref;
        next unless ( defined $ref && $ref ne "" );
        next if ( exists $PSEUDO_MODULE_ALREADY{$ref} || exists $MODULE_ALREADY{$ref} );
        $seqCnt++ if ( &dbfFlatNodeType($ref) eq "seq" );
      }
      if ( $seqCnt > $seqAnchorLimit ) {
        print "INFO-TST-HR_PL_ALL : 024 : $mod has $seqCnt flops and latches, more than $seqAnchorLimit:\n";
        print "INFO-TST-HR_PL_ALL : 025 : the block pass leaves them to the cell pass\n";
        push(@placeArgs, "--block_anchors");
      }
    }
    &hier_place(@placeArgs);
    $mrec{blocks_after_block_pass} = &dbfTstgenHierBlockFit($mod, $w, $h);
    #<!-- held only for the block pass: PLACED again, like any other block -->
    $PSEUDO_VINST_ALREADY{$mod}{$_}->dbPimDBSetInstStatus("PLACED") foreach ( @specHeld );
    if ( $legalizeBlocks && ! @specHeld ) {
      my $sum = &dbfTstgenHierLegalizeBlocks($mod, $w, $h, $wsSiteUm, $GLOBAL->dbGlobalGetRowHeight,
                                             \%sliceShape, \%wsSize, undef, $blockAspect);
      if ( exists $sum->{error} ) {
        print "WARN-TST-HR_PL_ALL : 063 : blocks of $mod not legalized: $sum->{error}\n";
      }
      elsif ( $sum->{blocks} > 0 ) {
        $mrec{legalize_blocks} = $sum;
        $mrec{blocks_after_legalize} = &dbfTstgenHierBlockFit($mod, $w, $h);
        printf("INFO-TST-HR_PL_ALL : 064 : blocks of %s legalized: overlap %.1f%% -> %.1f%%; %s\n", $mod,
               100 * $mrec{blocks_after_block_pass}{overlap_frac}, 100 * $mrec{blocks_after_legalize}{overlap_frac}, $sum->{summary});
        print "WARN-TST-HR_PL_ALL : 069 : $mod: blocks still overlap by $sum->{overlap_pct}% of their area, $sum->{overrun} um over the box -- more than legalize_flat should be left\n" if ( $sum->{too_much} );
      }
    }
    if ( $sliceBlocks && ! @specHeld ) {
      my $sum = &dbfTstgenHierSliceBlocks($mod, $w, $h, $wsSiteUm, $GLOBAL->dbGlobalGetRowHeight,
                                          \%sliceShape, \%wsSize);
      if ( $sum->{blocks} > 0 ) {
        $mrec{slice} = $sum;
        $mrec{blocks_after_slice} = &dbfTstgenHierBlockFit($mod, $w, $h);
        printf("INFO-TST-HR_PL_ALL : 035 : %d block(s) in %d group(s) of %s sliced: overlap %.1f%% -> %.1f%%, worst aspect %.2f%s%s\n",
               $sum->{blocks}, $sum->{groups}, $mod,
               100 * $mrec{blocks_after_block_pass}{overlap_frac}, 100 * $mrec{blocks_after_slice}{overlap_frac},
               $sum->{worst_aspect},
               $sum->{hard_misses} ? ", $sum->{hard_misses} fixed shape(s) did not fit" : "",
               $sum->{too_small} ? ", $sum->{too_small} slice(s) too small, block given one row pair" : "");
      }
    }
    $mrec{seq_left_to_cell_pass} = ( grep { $_ eq "--block_anchors" } @placeArgs ) ? 1 : 0;
  }

  #<!-- The second pass, and it runs for a hand placed module too: that is the
  #     whole point of --skip_placed.  hier_place_cells writes the anchors
  #     FIXED, so whatever was placed above -- by the tool or by a person --
  #     holds still while the combinational logic arranges itself around it. -->
  unless ( $noCells ) {
    my @cellArgs = ("-module", $mod, "-batch", $cellsBatch);
    #<!-- -cells_placer, when given, replaces the placer for this pass only:
    #     the block pass is still hier_place, which is what it was built for -->
    my $cp = ( defined $cellsPlacer && $cellsPlacer ne "" ) ? $cellsPlacer : $placer;
    push(@cellArgs, "-placer", $cp) if ( defined $cp && $cp ne "" );
    push(@cellArgs, "--free_flops") if ( $freeFlops );
    push(@cellArgs, "-fanout_limit", $fanoutLimit) if ( $fanoutLimit > 0 );
    push(@cellArgs, "--keep") if ( $keepFiles );
    push(@cellArgs, "-net_weights", $netWeights, "-weight_scale", $weightScale, "-weight_power", $weightPower) if ( $netWeights ne "" );
    push(@cellArgs, "-anchor", $cellsAnchor) if ( $cellsAnchor ne "" );
    &hier_place_cells(@cellArgs);
    $mrec{cell_pass} = $HIER_PLACE_CELL_STATS{$mod} if ( exists $HIER_PLACE_CELL_STATS{$mod} );
  }

  #<!-- --child_pins: the children's pins from where this module's nets reach
  #     them, before the commit writes them into the children's floorplans --
  #     after the cell pass, so the partners are real cells, not block centres -->
  if ( $childPins ) {
    my $cp = &dbfTstgenHierProjectChildPins($mod, \%childPinsDone, $fanoutLimit, $skipPlaced);
    $mrec{child_pins} = $cp;
    if ( $cp->{pins} > 0 || $cp->{kept} > 0 ) {
      printf("INFO-TST-HR_PL_ALL : 052 : %s: %d pin(s) of %d child module(s) placed toward their nets%s\n",
             $mod, $cp->{pins}, $cp->{children},
             $cp->{kept} ? ", $cp->{kept} kept the pins they already had" : "");
    }
    my $left = $cp->{no_partner} + $cp->{high_fanout} + $cp->{width_mismatch};
    if ( $left > 0 ) {
      printf("INFO-TST-HR_PL_ALL : 053 : %s: %d child port bit(s) left to the child: %d with no placed partner, %d over the fan out limit, %d connection(s) of mismatched width\n",
             $mod, $left, $cp->{no_partner}, $cp->{high_fanout}, $cp->{width_mismatch});
    }
    if ( $cp->{rotated} > 0 ) {
      print "WARN-TST-HR_PL_ALL : 054 : $mod: $cp->{rotated} child instance(s) are rotated, their pins are left to the child\n";
    }
  }

  #<!-- Commit before descending.  The child's size is read out of this
  #     floorplan by dbfTstgenCalcModuleSizeFromParentFlplan when edit_module
  #     opens it, and until the commit runs the floorplan does not have the
  #     instance box to read.
  #
  #     --physical_only: this places, it does not rewrite netlists.  A full
  #     commit would rebuild the module's conn lines out of the pseudo
  #     database, which is a lot of risk for no placement. -->
  #<!-- --legalize: the module's own cells onto rows inside its box, its
  #     blocks snapped to the row grid first, before the commit copies it all
  #     into the floorplan the children and hier2flat read -->
  if ( $legalize ) {
    %LEGAL_STATS = ();
    &legalize_module("-module", $mod);
    $mrec{legalize} = { %LEGAL_STATS } if ( %LEGAL_STATS );
  }

  &commitModule("-module", $mod, "--physical_only");

  #<!-- one line per module per run: what it was, what was decided, what came
  #     of it -- the record a sizing model will be trained on -->
  if ( defined $metricsFh ) {
    print $metricsFh JSON->new->canonical->encode(\%mrec), "\n";
    $metricsCnt++;
  }
  $doneCnt++;

  #<!-- A frame, after the commit rather than before it: the commit is what
  #     puts this module's instance box into its parent's floorplan, and until
  #     it has run the module is not yet part of the picture the walk is
  #     building.
  #
  #     Rooted at $top and not at $TOP_MODULE, which edit_module has just moved
  #     to $mod -- write_hier_cells defaults to dbfGlobalGetTOP for the same
  #     reason, but say it here too rather than depend on it. -->
  if ( defined $snapPrefix && $snapPrefix ne "" ) {
    $snapCnt++;
    my $f = sprintf("%s%03d.hiercells", $snapPrefix, $snapCnt);
    my @snapOpts = ("-out", $f, "-module", $top);
    push(@snapOpts, split(/\s+/, $snapArgs)) if ( $snapArgs ne "" );
    &write_hier_cells(@snapOpts);
  }
}

#--------------------------------------------------------------------------
# Put the design top back
#--------------------------------------------------------------------------
#<!-- edit_module moves $TOP_MODULE to whatever it opened, and the walk ends on
#     the deepest module it touched.  $TOP_MODULE is what write_def means by
#     the design: it names the DESIGN line, picks the floorplan for DIEAREA and
#     the rows, and reads PORTS_ALREADY{$TOP_MODULE} for the PINS section.
#     Leave it on a leaf module and write_def emits that module -- the die the
#     size of the block, no pins, and every component of the real design
#     outside the boundary.  That is what this looked like before the restore
#     was here, and it looked like a placement bug rather than a name.
#
#     Note that edit_module does NOT move GLOBAL's copy of the top, which is
#     what hier2flat reads, so the two disagree while the walk is running.
#     $TOP_MODULE is the one to compare and the one to put back.
#
#     Reopening also leaves the session where an interactive user expects it,
#     which is where edit_module --top would have left it. -->
if ( $TOP_MODULE ne $top ) {
  print "INFO-TST-HR_PL_ALL : 015 : reopening $top, the walk ended on $TOP_MODULE\n";
  &editModule("-module", $top);
}

unless ( $noFlatten ) {
  &hier2flat("--physical");
}

#<!-- Redraw the Hier-View on the top.
#
#     hier_place redraws it for each module it places, so with the GUI up the
#     walk leaves the view showing the LAST module it touched -- halfAdder, at
#     the bottom of the tree, which looks like the placement went badly wrong.
#     Put the top back on screen, the same way the refresh button does.
#
#     Pins go after, on purpose: activate_HierViewTab does delete('all'), which
#     takes the HIERPINS tag with it, so drawing them first would just have them
#     wiped.
#
#     The flat view is deliberately NOT touched.  design_display is a command;
#     whether the flat side is on screen at all is the caller's business, and a
#     flow that wants it says so. -->
if ( $GLOBAL->dbGlobalGetGuiStatus == 1 && defined $hier_canvas ) {
  &activate_HierViewTab;
  &display_hier_inst_pin;
  print "INFO-TST-HR_PL_ALL : 020 : the Hier-View has been redrawn on $top\n";
}

if ( defined $metricsFh ) {
  close($metricsFh);
  print "INFO-TST-HR_PL_ALL : 034 : $metricsCnt module record(s) appended to $metricsFile, run $runId\n";
}
print "INFO-TST-HR_PL_ALL : 016 : $doneCnt module(s) placed";
print ", $keptCnt kept as found" if ( $keptCnt > 0 );
print ", $failCnt skipped" if ( $failCnt > 0 );
print "\n";
if ( $failCnt > 0 ) {
  print "WARN-TST-HR_PL_ALL : 017 : $failCnt module(s) were skipped and are not placed, see above\n";
}
unless ( $noFlatten || $legalize ) {
  print "INFO-TST-HR_PL_ALL : 018 : the placement is not legal; run legalize_flat to snap it to rows\n";
}

my $t1 = new Benchmark;
my $td = timediff($t1, $t0);
print "Command hier_place_all took:",timestr($td),"\n";

}# sub hier_place_all

1;
