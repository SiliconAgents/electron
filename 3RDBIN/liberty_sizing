#!/usr/bin/env python3
"""The library facts a drive-repair pass needs, from liberty, in one small table.

    liberty_sizing -o sizing.tsv [-j N] <cells.lib> [<more.lib> ...]
    liberty_sizing -o sizing.tsv --config library.config --foundry F --node N --layer L [<more.lib> ...]

With --config the library's own entry says everything that depends on its
naming: the liberties are its std-cell-synth-libs, each under the Vt it is
listed as; a cell is a clock cell when its base name (drive and what follows
taken off) matches a CLOCK pattern of the entry's cell-func-map; and when the
entry's cell-families give a "vt-in-name" pattern for a cell's family (a
library whose Vt code sits inside the cell name, between its footprint and
its channel length, rather than at the end), the
family column is the name after its stem and drive with that group taken out,
so the Vts of one footprint can replace each other.  A family with no such
pattern leaves the column empty and Photon reads the family from the name
(the Vt as a suffix, N02's BWP...CPDSVT).

One row per cell:

    cell  vt  area  leakage  drive  class  dont_use  seq  pins  [clock  family]

    leakage  average leakage power in the library's leakage unit (header): the
           sum of the cell's leakage_power groups that carry no `when`, one per
           power pin -- the state-averaged values; the per-state ones are not
           added.  Lower-Vt cells carry more load at the same area, so a
           repair that weighs area alone would always pick the leakiest
    drive  the strength in the name (D4 -> 4, D0P7 -> 0.7), 0 if none
    class  cells with the same class are interchangeable: a single-output
           combinational cell's class is its name stem, its pin names and its
           output's truth table, so two cells share one only when either can
           replace the other; a sequential or multi-output cell's is its stem
           and pin names
    pins   pin:dir:cap[:maxcap[:maxtran]] separated by ';', dir i, o, or k for an
           input the liberty marks `clock : true` -- a load like any input, but
           a net that reaches one is a clock net, which is CTS's to buffer;
           capacitance and max_capacitance in the library's load unit (header),
           max_transition in its time unit; an output with no max_transition of
           its own takes the default_max_transition of the liberty the cell
           came from (they differ between liberties, so the header's is only
           the first one's)

WHY.  A cell driving more than its liberty max_capacitance is outside the
characterised table: STA tools disagree about it (OpenSTA extrapolates, others
clamp at the edge) and placement inherits the problem.  Synthesis that maps one
module at a time cannot see loads in the modules below, so it leaves such
drivers on every net that crosses a boundary -- 19 to 3,259 max_cap violators
per design on five 1.2M-3.9M-cell designs.  Repairing them needs input pin
capacitances, output limits and which cells may replace which -- a few hundred
kilobytes, against the gigabytes of liberty they come from.  Arc stores built
for timing carry the capacitances but not the limits or the functions.

Read once per library and kept; reading the result costs nothing.
"""
import argparse
import concurrent.futures as cf
import gzip
import importlib.machinery
import os
import re
import sys

_here = os.path.dirname(os.path.abspath(__file__))
_lw = importlib.machinery.SourceFileLoader("rtlil_leaf_wrappers",
                                           os.path.join(_here, "rtlil_leaf_wrappers")).load_module()
liberty_expr_to_sv, DRIVE_RE, drive_of = _lw.liberty_expr_to_sv, _lw.DRIVE_RE, _lw.drive_of
# A second naming convention: the strength as a suffix, INV_X1 / INV_X4.  Tried
# first -- the D<n> rule reads AND2_X1 as stem "AN" with drive 2, and finds no
# drive at all in BUF_X1, which would make every buffer a class of its own.
X_DRIVE_RE = re.compile(r"^(.+)_X(\d+)(?:P(\d+))?$")


def stem_and_drive(cell):
    m = X_DRIVE_RE.match(cell)
    if m:
        return m.group(1), float(f"{m.group(2)}.{m.group(3) or 0}")
    d = DRIVE_RE.match(cell)
    return (d.group(1), drive_of(cell)) if d else (cell, 0.0)

CELL_RE = re.compile(r'^\s*cell\s*\(\s*"?([^")\s]+)"?\s*\)')
PIN_RE = re.compile(r'^\s*pin\s*\(\s*"?([^")\s]+)"?\s*\)')
KV_RE = re.compile(r'^\s*(\w+)\s*:\s*"?([^";]*)"?\s*;')
SEQ_RE = re.compile(r"^\s*(ff|latch|statetable|ff_bank|latch_bank)\s*\(")
# without --config, the Vt is guessed from N02's file names; with it, the
# config says which Vt each liberty is
VT_RE = re.compile(r"_(svt|lvt|lvtll|ulvt|ulvtll|elvt)(?:tt|ss|ff)", re.I)


def read_one(job):
    """(header, [row]) for one liberty file; job is a path or (path, vt)."""
    path, vt = job if isinstance(job, tuple) else (job, None)
    op = gzip.open if path.endswith(".gz") else open
    if vt is None:
        m = VT_RE.search(os.path.basename(path))
        vt = m.group(1).lower() if m else ""
    hdr = {"load_unit": "", "time_unit": "", "default_max_transition": "", "leakage_unit": ""}
    rows = []
    cell, depth, cdepth, pin, pins, seq, area, dont = None, 0, 0, None, {}, False, None, False
    leak, lk = 0.0, None          # lk: [depth the group opened at, value, has a when]
    with op(path, "rt", errors="replace") as fh:
        for line in fh:
            if cell is None:
                u = re.match(r'^\s*leakage_power_unit\s*:\s*"?([^";]+)', line)
                if u:
                    hdr["leakage_unit"] = u.group(1).strip()
                if "capacitive_load_unit" in line:
                    u = re.search(r"\(\s*([\d.]+)\s*,\s*(\w+)", line)
                    if u:
                        hdr["load_unit"] = f"{u.group(1)}{u.group(2).lower()}"
                else:
                    k = KV_RE.match(line)
                    # default_max_transition: matched on its own, because one
                    # vendor's files write it with no terminating semicolon
                    t = re.match(r"^\s*default_max_transition\s*:\s*([\d.eE+-]+)", line)
                    if k and k.group(1) == "time_unit":
                        hdr["time_unit"] = k.group(2).strip()
                    elif t:
                        hdr["default_max_transition"] = t.group(1)
                m = CELL_RE.match(line)
                if m:
                    cell, cdepth, pins, pin, seq, area, dont = m.group(1), depth, {}, None, False, None, False
                    leak, lk = 0.0, None
            else:
                if SEQ_RE.match(line):
                    seq = True
                if pin is None and lk is None and re.match(r"^\s*leakage_power\s*\(\s*\)", line):
                    lk = [depth, None, False]
                elif lk is not None:
                    k = KV_RE.match(line)
                    if k and k.group(1) == "value":
                        lk[1] = float(k.group(2))
                    elif k and k.group(1) == "when":
                        lk[2] = True
                m = PIN_RE.match(line)
                if m and pin is None:
                    pin = m.group(1)
                    pins.setdefault(pin, {})
                else:
                    m = KV_RE.match(line)
                    if m:
                        k, v = m.group(1), m.group(2).strip()
                        if pin is not None and k in ("direction", "function", "capacitance",
                                                     "max_capacitance", "max_transition", "clock"):
                            pins[pin].setdefault(k, v)
                        elif pin is None and k == "area":
                            area = float(v)
                        elif pin is None and k == "dont_use" and v == "true":
                            dont = True
            depth += line.count("{") - line.count("}")
            if lk is not None and depth <= lk[0]:
                if lk[1] is not None and not lk[2]:
                    leak += lk[1]
                lk = None
            if cell is not None and pin is not None and depth <= cdepth + 1:
                pin = None
            if cell is not None and depth <= cdepth:
                rows.append(row(cell, vt, area, leak, dont, seq, pins, hdr["default_max_transition"]))
                cell = None
    return hdr, [r for r in rows if r]


def row(cell, vt, area, leak, dont, seq, pins, dflt_tran=""):
    if area is None:
        return None
    ins = sorted(n for n, d in pins.items() if d.get("direction") == "input")
    outs = sorted(n for n, d in pins.items() if d.get("direction") == "output")
    stem, drive = stem_and_drive(cell)
    cls = f"{stem}|{','.join(ins)}|{','.join(outs)}"
    if not seq and len(outs) == 1 and pins[outs[0]].get("function"):
        try:
            py = liberty_expr_to_sv(pins[outs[0]]["function"]).replace("1'b0", "0").replace("1'b1", "1")
            tt = 0
            for k in range(1 << len(ins)):
                if eval(py, {}, {n: (k >> i) & 1 for i, n in enumerate(ins)}) & 1:
                    tt |= 1 << k
            cls += f"|{tt:x}"
        except (ValueError, SyntaxError, NameError):
            pass
    fields = []
    for n in ins + outs:
        p = pins[n]
        d = ("k" if p.get("clock") == "true" else "i") if n in ins else "o"
        f = f"{n}:{d}:{p.get('capacitance', '')}"
        if n in outs:
            # an output with no max_transition of its own takes its own
            # library's default -- the defaults differ between libraries
            f += f":{p.get('max_capacitance', '')}:{p.get('max_transition', dflt_tran)}"
        fields.append(f)
    return [cell, vt, f"{area:g}", f"{leak:g}", f"{drive:g}", cls,
            "1" if dont else "0", "1" if seq else "0", ";".join(fields)]


def config_entry(path, foundry, node, layer):
    import json
    c = json.load(open(path))
    for n in c.get(foundry, {}).get("node", []):
        if n.get("type") != node:
            continue
        for f in n.get("files", []):
            if str(f.get("layer")) == str(layer):
                return f
    sys.exit(f"liberty_sizing: no {foundry} {node} layer {layer} in {path}")


def func_map(path):
    """[(glob, family)] in order, first match wins -- the cell-func-map format"""
    import fnmatch
    out = []
    for l in open(path):
        if l.startswith("#") or not l.strip():
            continue
        f = l.split()
        if len(f) >= 3:
            out.append((re.compile(fnmatch.translate(f[0])), f[2]))
    return out


def base_name(cell):
    """the cell name with its drive and everything after it taken off, as the
    cell-func-maps define it: AOI21D4<suffix> and AOI21_D4_<suffix> are
    both AOI21"""
    stem, _ = stem_and_drive(cell)
    return stem.rstrip("_")


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("-o", "--out", required=True)
    ap.add_argument("-j", "--jobs", type=int, default=8)
    ap.add_argument("--config"); ap.add_argument("--foundry"); ap.add_argument("--node"); ap.add_argument("--layer")
    ap.add_argument("liberty", nargs="*")
    a = ap.parse_args()
    jobs, fmap, fams = list(a.liberty), None, {}
    if a.config:
        e = config_entry(a.config, a.foundry, a.node, a.layer)
        synth = e.get("std-cell-synth-libs") or {}
        if not synth:
            sys.exit("liberty_sizing: the entry has no std-cell-synth-libs")
        # a synthesis list may carry memory liberties beside the cells (N02's
        # does, for yosys); a liberty the entry declares as a macro is not a
        # standard cell and is not sized
        macros = set(e.get("macro-libs") or []) | {p for v in (e.get("macro-sta-libs") or {}).values() for p in v}
        jobs = [(p, vt) for vt, ps in synth.items() for p in ps if p not in macros] + list(a.liberty)
        m = e.get("cell-func-map")
        fmap = func_map(m[0] if isinstance(m, list) else m) if m else None
        fams = e.get("cell-families") or {}
    if not jobs:
        sys.exit("liberty_sizing: no liberty given")
    with cf.ProcessPoolExecutor(max_workers=max(1, a.jobs)) as ex:
        results = list(ex.map(read_one, jobs))
    units = {(h["load_unit"], h["time_unit"], h["leakage_unit"]) for h, _ in results}
    if len(units) > 1:
        sys.exit(f"liberty_sizing: the libraries disagree on units: {sorted(units)}")
    hdr = results[0][0]
    seen, out = set(), []
    for _, rows in results:
        for r in rows:
            if r[0] not in seen:
                seen.add(r[0]); out.append(r)
    extra = a.config is not None
    if extra:
        def clock(cell):
            if not fmap:
                return "0"
            b = base_name(cell)
            for rx, fam in fmap:
                if rx.match(b):
                    return "1" if fam == "CLOCK" else "0"
            return "0"
        def family(cell):
            for key, fd in fams.items():
                pat = fd.get("vt-in-name") if isinstance(fd, dict) else None
                if pat and fd.get("match", "").lower() in cell.lower():
                    stem, _ = stem_and_drive(cell)
                    rest = re.sub(r"^(?:D\d+(?:P\d+)?|_X\d+(?:P\d+)?)", "", cell[len(stem):])
                    m = re.search(pat, rest)
                    return rest[:m.start(1)] + rest[m.end(1):] if m else ""
            return ""
        out = [r + [clock(r[0]), family(r[0])] for r in out]
    tmp = a.out + ".part"
    with open(tmp, "w") as fh:
        fh.write(f"# liberty_sizing: {len(out)} cell(s) from {len(jobs)} liberty file(s)" +
                 (f" ({a.config} {a.foundry} {a.node} layer {a.layer})" if extra else "") + "\n")
        if extra:
            fh.write("# clock: 1 for a CLOCK cell of the config's cell-func-map -- never sized as logic\n")
            fh.write("# family: cells with the same non-empty family may replace each other; empty = by name\n")
        fh.write(f"# load_unit {hdr['load_unit']}  time_unit {hdr['time_unit']}  "
                 f"leakage_unit {hdr['leakage_unit']}  "
                 f"default_max_transition {hdr['default_max_transition']}\n")
        for j in jobs:
            p, vt = j if isinstance(j, tuple) else (j, None)
            fh.write(f"# from {p}" + (f"  ({vt})" if vt else "") + "\n")
        fh.write("cell\tvt\tarea\tleakage\tdrive\tclass\tdont_use\tseq\tpins" + ("\tclock\tfamily" if extra else "") + "\n")
        for r in out:
            fh.write("\t".join(r) + "\n")
    os.replace(tmp, a.out)
    print(f"liberty_sizing: {len(out)} cell(s) from {len(jobs)} file(s) -> {a.out}" +
          (f"; {sum(r[-2] == '1' for r in out)} clock cell(s), {sum(bool(r[-1]) for r in out)} with a family" if extra else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
