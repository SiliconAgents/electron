#!/usr/bin/env python3
"""Min-cut bisection placer driver for proton's mincut_placer command.

Called as

    mincut_placer <graph> <nodefile> <xyout> [extra mincut args...]

Runs recursive min-cut bisection over the graph and nodefile that
write_flat_graph produces, then writes the "<node> <x> <y>" file
read_flat_graph_placement expects.  Same interface as the eplacer driver, so
the two are interchangeable from proton's side.

What it is for
--------------
mincut partitions the netlist: it halves the die, splits the cells so as few
nets as possible cross the cut, gives each side free area in proportion to the
cell area put into it, and recurses.  Density therefore comes out uniform by
construction rather than by convergence, which is the difference from eplace,
where density is a penalty term that is only approximately met.  It is seeded
by the placement it is handed -- the initial bisection at every level is the one
the current coordinates already imply -- so it is meant to run after a global
placement, not instead of one.

Coordinate convention
---------------------
mincut.py reads and writes x,y as the LOWER LEFT corner of the cell, the same as
eplace.py, whose nodefile reader it imports.  That is what a proton nodefile
record holds and what the database stores, so nothing is translated here.

--fix status
------------
mincut defaults to holding ports and macros.  We ask it to honour exactly what
the nodefile says instead, so a node proton marked FIXED stays put and nothing
else is held by accident.  Pass your own --fix to override.

The placer can be pointed elsewhere with MINCUT.
"""

import os
import subprocess
import sys

DEFAULT_MINCUT = "/proj_pd/user_dev/rsrivastava/pyspark_cad/python/mincut.py"


def die(msg):
    sys.stderr.write("ERR-MINCUT : %s\n" % msg)
    sys.exit(1)


def main(argv):
    args = argv[1:]
    if len(args) < 3:
        sys.stderr.write(__doc__)
        sys.stderr.write("\nusage: mincut_placer <graph> <nodefile> <xyout> "
                         "[extra mincut args]\n")
        return 1

    graph, nodefile, xyout = args[0], args[1], args[2]
    extra = args[3:]

    for f in (graph, nodefile):
        if not os.path.exists(f):
            die("%s does not exist" % f)

    mincut = os.environ.get("MINCUT", DEFAULT_MINCUT)
    if not os.path.exists(mincut):
        die("mincut not found at %s\n"
            "             set MINCUT to point at it" % mincut)

    #<!-- named off the graph rather than the xy file, whose name already ends
    #     in .xy.out and would give TOP.mincut.xy.mincut.png -->
    base = os.path.splitext(os.path.basename(graph))[0]
    csv = base + ".csv"
    png = base + ".png"

    cmd = ["python3", mincut,
           "--format", "full",
           "-o", csv,
           "--plot", png,
           graph, nodefile]
    #<!-- an explicit --fix from the caller wins over our default -->
    if not any(a == "--fix" or a.startswith("--fix=") for a in extra):
        cmd += ["--fix", "status"]
    cmd += extra

    sys.stderr.write("INFO-MINCUT : running %s\n" % " ".join(cmd))
    rc = subprocess.call(cmd)
    if rc != 0:
        die("%s exited with status %d" % (os.path.basename(mincut), rc))
    if not os.path.exists(csv):
        die("%s produced no %s" % (os.path.basename(mincut), csv))

    # id,name,kind,width,height,status,x,y,dx,dy -> "<node> <x> <y>"
    nout = 0
    nfixed = 0
    try:
        with open(csv) as fin, open(xyout, "w") as fh:
            fh.write("# <node> <x> <y> in microns, lower left corners\n")
            first = True
            for line in fin:
                line = line.strip()
                if not line:
                    continue
                if first:
                    first = False
                    if line.lower().startswith("id,"):
                        continue
                f = line.split(",")
                if len(f) < 8:
                    continue
                try:
                    nid = f[0]
                    x, y = float(f[6]), float(f[7])
                except ValueError:
                    continue
                if len(f) >= 6 and f[5] == "FIXED":
                    nfixed += 1
                fh.write("%s %.4f %.4f\n" % (nid, x, y))
                nout += 1
    except IOError as exc:
        die("cannot write %s: %s" % (xyout, exc))

    if nout == 0:
        die("%s held no usable rows" % csv)

    sys.stderr.write("INFO-MINCUT : wrote %d nodes to %s, %d of them held "
                     "fixed\n" % (nout, xyout, nfixed))
    sys.stderr.write("INFO-MINCUT : density plot in %s\n" % png)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
