# Node type -> RGB fill. 'und' is what the writer emits when nothing described the
# cell, so it is deliberately drab: it means the type is unknown, not that it is special.
# Pin fill by direction, so which way a bus faces is visible without reading a name
DIR_RGB = {
    "input":   (120, 200, 255),
    "output":  (255, 170, 110),
    "bidir":   (200, 150, 255),
    "unknown": (190, 190, 140),
}

def flyline_rgb(norm: float) -> Tuple[int, int, int]:
    """
    Colour a fly line by how much connectivity it stands for.

    A grey ramp cannot be read against a dark canvas once the lines overlap, so this
    runs cool to hot: a faint blue pair carries a handful of nets, a red one carries
    thousands. norm is the log-normalised weight, already in 0..1.
    """
    t = max(0.0, min(1.0, norm))
    if t < 0.5:
        u = t * 2.0
        return (int(70 + 60 * u), int(110 + 90 * u), int(190 + 40 * u))   # blue -> cyan
    u = (t - 0.5) * 2.0
    return (int(130 + 125 * u), int(200 - 60 * u), int(230 - 190 * u))    # cyan -> hot


