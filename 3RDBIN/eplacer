#!/usr/bin/env python3
"""ePlace driver for proton's eplacer command.

Called as

    eplacer <graph> <nodefile> <xyout> [extra eplace args...]

Runs the electrostatic global placer over the graph and nodefile that
write_flat_graph produces, then writes the "<node> <x> <y>" file
read_flat_graph_placement expects.

Coordinate convention
---------------------
eplace.py reads and writes x,y as the LOWER LEFT corner of the cell, which is
what a proton nodefile record holds and what the database stores, so nothing is
translated here.  If eplace ever moves to treating them as cell centres, every
node will come back offset by half its own width and height, and this is the
place to put the correction back.

--fix status
------------
eplace defaults to holding ports and macros.  We ask it to honour exactly what
the nodefile says instead, so a node proton marked FIXED stays put and nothing
else is held by accident.  Pass your own --fix to override.

Placed nodes keep their locations in the nodefile, so eplace starts from the
current placement and spreads density out from there rather than starting over,
which is what keeps the wirelength close to where it began.  UNPLACED nodes
start at the die centre, per eplace's own documentation.

The placer can be pointed elsewhere with EPLACE.
"""

import os
import subprocess
import sys

DEFAULT_EPLACE = "/proj_pd/user_dev/rsrivastava/pyspark_cad/python/eplace.py"


def die(msg):
    sys.stderr.write("ERR-EPLACER : %s\n" % msg)
    sys.exit(1)


def main(argv):
    args = argv[1:]
    if len(args) < 3:
        sys.stderr.write(__doc__)
        sys.stderr.write("\nusage: eplacer <graph> <nodefile> <xyout> "
                         "[extra eplace args]\n")
        return 1

    graph, nodefile, xyout = args[0], args[1], args[2]
    extra = args[3:]

    for f in (graph, nodefile):
        if not os.path.exists(f):
            die("%s does not exist" % f)

    eplace = os.environ.get("EPLACE", DEFAULT_EPLACE)
    if not os.path.exists(eplace):
        die("eplace not found at %s\n"
            "              set EPLACE to point at it" % eplace)

    #<!-- named off the graph rather than the xy file, whose name already ends
    #     in .xy.out and would give TOP.eplace.xy.eplace.png -->
    base = os.path.splitext(os.path.basename(graph))[0]
    csv = base + ".csv"
    png = base + ".png"

    cmd = ["python3", eplace,
           "--format", "full",
           "-o", csv,
           "--plot", png,
           graph, nodefile]
    #<!-- an explicit --fix from the caller wins over our default -->
    if not any(a == "--fix" or a.startswith("--fix=") for a in extra):
        cmd += ["--fix", "status"]
    cmd += extra

    sys.stderr.write("INFO-EPLACER : running %s\n" % " ".join(cmd))
    rc = subprocess.call(cmd)
    if rc != 0:
        die("%s exited with status %d" % (os.path.basename(eplace), rc))
    if not os.path.exists(csv):
        die("%s produced no %s" % (os.path.basename(eplace), csv))

    # id,name,kind,width,height,status,x,y,dx,dy -> "<node> <x> <y>"
    nout = 0
    nfixed = 0
    try:
        with open(csv) as fin, open(xyout, "w") as fh:
            fh.write("# <node> <x> <y> in microns, lower left corners\n")
            first = True
            for line in fin:
                line = line.strip()
                if not line:
                    continue
                if first:
                    first = False
                    if line.lower().startswith("id,"):
                        continue
                f = line.split(",")
                if len(f) < 8:
                    continue
                try:
                    nid = f[0]
                    x, y = float(f[6]), float(f[7])
                except ValueError:
                    continue
                if len(f) >= 6 and f[5] == "FIXED":
                    nfixed += 1
                fh.write("%s %.4f %.4f\n" % (nid, x, y))
                nout += 1
    except IOError as exc:
        die("cannot write %s: %s" % (xyout, exc))

    if nout == 0:
        die("%s held no usable rows" % csv)

    sys.stderr.write("INFO-EPLACER : wrote %d nodes to %s, %d of them held "
                     "fixed\n" % (nout, xyout, nfixed))
    sys.stderr.write("INFO-EPLACER : density plot in %s\n" % png)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
