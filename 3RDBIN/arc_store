#!/usr/bin/env python3
"""Print the Spark arc store a library config names for one foundry/node/layer.

    arc_store --config library.config --foundry nangate --node 45nm --layer 6

The store is the node's liberty converted to Parquet for segment timing on
Spark (pyspark_cad's libertyToArcs); the config records where it lives under
"sta-arc-store", beside "cell-stubs", so every flow reads one store instead of
building its own.  $VAR and ${VAR} expand as electron's config reader expands
them, with ELECTRON_HOME falling back to this checkout.

Prints nothing and exits 1 when the config names no store.

    arc_store --config library.config --foundry F --node N --wire-rc

prints instead the node's wire estimate for timing from placement:
"<ohm per um> <fF per um>", from "wire_resistance_per_micron" (ohm) and
"wire_capacitance_per_micron" (farads, as the config stores it), so a flow
hands Photon its own technology's numbers rather than Photon's built-in guess.
Exits 1 when the node has neither.

    arc_store --config library.config --foundry F --node N --wire-model

    arc_store --config library.config --foundry F --node N --layer L --cell-sizing

prints the layer's "cell-sizing" table (3RDBIN/liberty_sizing: which cells
may replace which, with Vt, drive, area, leakage), which Photon's
optimisation advisor needs.  Exits 1 when there is none.

    arc_store ... --layer L --opt-cell-sizing

prints the layer's "opt-cell-sizing" table instead when the config names one,
else its "cell-sizing" table: the one place_opt sizes with.  It may list
cells synthesis must not use -- two-row variants that are only legal on one
row of each pair, which only a legalizer that knows it can place -- and a
"family" column saying which cells may replace each other.

    arc_store ... --wire-model

prints the node's "wire-model": a table of R and C per micron by net length
and pin density, calibrated on routed designs, which Photon's estimate uses in
place of the two constants above.  Exits 1 when the node has none.
"""
import argparse
import json
import os
import re
import sys


def expand(path):
    home = os.environ.get("ELECTRON_HOME") or os.path.dirname(
        os.path.dirname(os.path.abspath(__file__)))

    def sub(m):
        name = m.group(1) or m.group(2)
        val = home if name == "ELECTRON_HOME" else os.environ.get(name)
        return val if val else m.group(0)
    return re.sub(r"\$\{([A-Za-z_]\w*)\}|\$([A-Za-z_]\w*)", sub, path)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--config", required=True)
    ap.add_argument("--foundry", required=True)
    ap.add_argument("--node", required=True)
    ap.add_argument("--layer", default="")
    ap.add_argument("--wire-rc", action="store_true", help="print the node's wire ohm/um and fF/um")
    ap.add_argument("--wire-model", action="store_true", help="print the node's calibrated wire model table")
    ap.add_argument("--cell-sizing", action="store_true", help="print the layer's cell-sizing table")
    ap.add_argument("--opt-cell-sizing", action="store_true",
                    help="print the layer's opt-cell-sizing table, or its cell-sizing table when it has none")
    a = ap.parse_args()
    c = json.load(open(a.config))
    for n in c.get(a.foundry, {}).get("node", []):
        if n.get("type") != a.node:
            continue
        if a.wire_model:
            m = n.get("wire-model")
            if not m:
                return 1
            print(expand(m))
            return 0
        if a.wire_rc:
            r, f = n.get("wire_resistance_per_micron"), n.get("wire_capacitance_per_micron")
            if r is None or f is None:
                return 1
            print(f"{float(r):g} {float(f) * 1e15:g}")
            return 0
        for f in n.get("files", []):
            if a.cell_sizing or a.opt_cell_sizing:
                key = "opt-cell-sizing" if a.opt_cell_sizing and f.get("opt-cell-sizing") else "cell-sizing"
                if str(f.get("layer")) == str(a.layer) and f.get(key):
                    print(expand(f[key]))
                    return 0
                continue
            if str(f.get("layer")) == str(a.layer) and f.get("sta-arc-store"):
                print(expand(f["sta-arc-store"]))
                return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
