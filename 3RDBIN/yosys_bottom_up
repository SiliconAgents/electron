#!/usr/bin/env python3
"""Synthesise a design one hierarchy level at a time, deepest first.

    rtlil_bottom_up design.il --level all --extract lvl/
    yosys_bottom_up --levels lvl/ --liberty slim.lib --blackbox cells.v \
                    --out netlists/ --jobs 10

WHY NOT ONE YOSYS RUN

yosys-slang's --keep-hierarchy emits one module per INSTANCE. One large design
was 119,351 of them and 111 distinct structures; a flat run optimises the same
one-cell wrapper 35,968 times and does not finish. Synthesising each distinct module
once is 111 small runs, each of which does.

HOW THE LEVELS COMPOSE

Level 0 is the modules that instantiate no other module. Each level after it
reads the netlists already produced as BLACKBOXES -- interfaces only -- so the
module being synthesised sees its children's ports and nothing else, and the
netlist it writes still instantiates them by name.

That is the point of doing it this way rather than flattening: what comes out
is a hierarchical netlist, which is what a hierarchical floorplanner wants.
Flattening would make each run bigger than the last and give the placer back
the one enormous module it cannot help with.

Children are read with `read_verilog -lib`, which keeps the interface and drops
the body, so a level never re-reads the logic underneath it however deep the
design goes. The cost per level is the level's own cells.

WHAT IT ASSUMES

That rtlil_bottom_up wrote the levels, because it renames each class to a
canonical name AND rewrites its children's instantiations to theirs. Without
that rewrite a module extracted at level N instantiates names from the
uniquified dump that no level N-1 netlist defines, and `hierarchy -check`
stops on every one of them.
"""

import argparse
import concurrent.futures as cf
import gzip
import os
import re
import subprocess
import sys
import time

# WHY THE SCRIPT IS THIS SHORT, AND WHY abc HAS NO -fast
#
# `abc -fast` was measured against full abc on the seven modules that carry
# most of one large design, and it is not a speed/quality trade here -- it is
# pure loss:
#
#     a parity checker     11,080 -> 281     -97%
#     a multiplier front      597 -> 307     -49%
#     a rounding block      2,103 -> 1,133   -46%
#     a wide mux tree      43,555 -> 32,607  -25%
#
# for 15.9s against 15.5s, because abc is under 1% of a run. The run is
# dominated by reading the 961 MB liberty and the 14,491 blackboxes, and that
# cost is the same either way.
#
# The passes a full `synth` would add -- wreduce, peepopt, alumacc, share,
# opt -full -- were measured on the same seven modules and are a WASH once abc
# is doing its job: between -5% and +6%, averaging nothing, for twice the
# runtime. They were in a draft of this script and came out again. Add one back
# only with a measurement that says it earns its place on the design at hand.
SCRIPT = """
read_verilog -lib {blackbox}
{children}
read_rtlil {src}
{absorb}
hierarchy -check -top {top}
{flatten}
proc
opt -fast
memory_map
techmap
opt -fast
dfflibmap -liberty {liberty}
abc {abc}-liberty {liberty}
setundef -zero
clean -purge
stat -top {top}
write_verilog -noattr {dest}
"""


def read_design(levels_dir):
    """canonical -> (level, copies, cells, {child: instances}) from DESIGN.tsv."""
    out = {}
    with open(os.path.join(levels_dir, "DESIGN.tsv")) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            name, lvl, copies, cells, kids = line.rstrip("\n").split("\t")
            ch = {}
            if kids != "-":
                for part in kids.split(","):
                    k, n = part.rsplit(":", 1)
                    ch[k] = int(n)
            out[name] = (int(lvl), int(copies), int(cells), ch)
    return out


def subtree_cells(design, name, memo=None, stack=frozenset()):
    """Pre-synthesis cells in a module and everything under it."""
    memo = {} if memo is None else memo
    if name in memo:
        return memo[name]
    if name in stack or name not in design:
        return 0
    _, _, cells, kids = design[name]
    v = cells + sum(n * subtree_cells(design, c, memo, stack | {name})
                    for c, n in kids.items())
    memo[name] = v
    return v


def choose_boundaries(design, threshold, top):
    """The modules that stay hierarchy boundaries; the rest get flattened in.

    Size is the criterion because it is also the placement criterion: a block
    a floorplanner can do something with is a block big enough to have a shape.
    A one-cell wrapper was never a useful boundary, and keeping it costs real
    area, because a boundary is a wall abc cannot optimise across.

    Measured on one large design: flattening a datapath lane's subtree into it
    takes it from 16,016 cells to 12,552, a 21.6% saving. The same experiment
    on a wide, shallow block gained 1.6%, inside the run-to-run noise -- deep
    stacks of small modules are where the walls cost something, wide blocks
    with few children are not.
    """
    memo = {}
    keep = {m for m in design if subtree_cells(design, m, memo) >= threshold}
    keep.add(top)
    return keep, memo


def plan_flatten(design, boundaries, name):
    """(descendants to absorb, boundary children to read as blackboxes).

    Walks down from `name` and stops at the first boundary on each path: what
    is above the stop line gets flattened in, what is on it stays an instance.
    """
    absorb, bchild = set(), set()
    stack = list(design[name][3])
    while stack:
        c = stack.pop()
        if c in boundaries:
            bchild.add(c)
        elif c not in absorb:
            absorb.add(c)
            stack += list(design[c][3])
    return absorb, bchild


def modules_of(level_dir, manifest="MODULES.tsv"):
    """[(canonical, copies)] for one level, biggest first."""
    out = []
    path = os.path.join(level_dir, manifest)
    with open(path) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            name, copies, _ = line.rstrip("\n").split("\t")
            out.append((name, int(copies)))
    # by RTLIL size, so the long pole of a level starts at t=0 and not last
    out.sort(key=lambda r: -os.path.getsize(os.path.join(level_dir, r[0] + ".il")))
    return out


_CELLS = re.compile(r"^\s+(\d+)\s+cells\s*$", re.M)


def run_one(job):
    name, copies, src, args, children, absorb = job
    dest = os.path.join(args.out, name + ".v")
    log = os.path.join(args.out, name + ".log")
    # `flatten` leaves the absorbed modules DEFINED but no longer instantiated,
    # and write_verilog would then emit each of them into every netlist that
    # absorbed it -- the same module defined in a dozen files. The second
    # `hierarchy -top` drops what nothing references any more.
    flatten = f"flatten\nhierarchy -top {name}" if absorb else ""
    script = SCRIPT.format(blackbox=args.blackbox, children=children, src=src,
                           absorb=absorb, flatten=flatten,
                           top=name, liberty=args.liberty, dest=dest,
                           abc="-fast " if args.abc_fast else "")
    t = time.time()
    p = subprocess.run([args.yosys, "-p", script], capture_output=True, text=True)
    with open(log, "w") as fh:
        fh.write(p.stdout)
        fh.write(p.stderr)
    cells = 0
    if p.returncode == 0:
        tail = p.stdout.split("Printing statistics.")[-1]
        m = _CELLS.search(tail)
        cells = int(m.group(1)) if m else 0
    err = ""
    if p.returncode != 0:
        for line in (p.stdout + p.stderr).splitlines():
            if line.startswith("ERROR"):
                err = line
        err = err or f"rc={p.returncode}"
    return {"name": name, "copies": copies, "cells": cells, "rc": p.returncode,
            "err": err, "secs": time.time() - t, "log": log, "dest": dest}


def main():
    ap = argparse.ArgumentParser(description="synthesise bottom up, level by level")
    ap.add_argument("--levels", required=True,
                    help="the directory rtlil_bottom_up --level all wrote")
    ap.add_argument("--liberty", required=True)
    ap.add_argument("--blackbox", required=True, help="standard cell stubs (lef_blackbox)")
    ap.add_argument("--out", required=True, help="where the netlists go")
    ap.add_argument("--yosys", default="yosys")
    ap.add_argument("--jobs", type=int, default=8)
    ap.add_argument("--manifest", default="MODULES.tsv")
    ap.add_argument("--flatten-below", type=int, metavar="CELLS", default=0,
                    help="keep as a hierarchy boundary only a module whose "
                         "subtree is at least this many cells; flatten the "
                         "rest into their parents. Fewer, better-optimised "
                         "modules and a netlist whose boundaries are the ones "
                         "a floorplanner can use (try 2000)")
    ap.add_argument("--abc-fast", action="store_true",
                    help="map with `abc -fast`. DO NOT, unless you are timing "
                         "something: on a large design it cost 44%% of the cell "
                         "count and saves nothing (see the note on SCRIPT)")
    ap.add_argument("--verify", action="store_true",
                    help="reload every netlist afterwards and let yosys walk "
                         "the hierarchy for the real cell count")
    ap.add_argument("--keep-going", action="store_true",
                    help="carry on past a level with failures (the next level "
                         "will fail too, but it reports every break at once)")
    args = ap.parse_args()

    levels = sorted(
        (int(d[3:]), os.path.join(args.levels, d))
        for d in os.listdir(args.levels)
        if d.startswith("lvl") and d[3:].isdigit())
    if not levels:
        sys.exit(f"yosys_bottom_up: no lvl<N>/ under {args.levels}")
    os.makedirs(args.out, exist_ok=True)

    # canonical name -> its extracted RTLIL, wherever its level put it
    il = {}
    for _, d in levels:
        for f in os.listdir(d):
            if f.endswith(".il"):
                il[f[:-3]] = os.path.join(d, f)

    design = boundaries = None
    if args.flatten_below:
        design = read_design(args.levels)
        top_name = max(design, key=lambda m: design[m][0])
        boundaries, memo = choose_boundaries(design, args.flatten_below, top_name)
        # Named by their own cell count, NOT their subtree size: the top's
        # subtree is the whole design, and reporting that as the size of a
        # boundary suggests a run that is not about to happen.
        big = sorted(((design[m][2], m) for m in boundaries), reverse=True)
        print(f"yosys_bottom_up: --flatten-below {args.flatten_below:,} keeps "
              f"{len(boundaries)} of {len(design)} module(s) as boundaries; "
              f"the rest are absorbed by their parents")
        print(f"yosys_bottom_up: boundaries are "
              f"{', '.join(m for _, m in big[:4])} ...")

    done = []                      # netlists written so far, read as blackboxes
    failed_any = False
    grand = time.time()
    for L, d in levels:
        mods = modules_of(d, args.manifest)
        if boundaries is not None:
            mods = [(n, c) for n, c in mods if n in boundaries]
            if not mods:
                continue
        # every netlist from a lower level, interfaces only
        children = "\n".join(f"read_verilog -lib {p}" for p in done)
        jobs = []
        for n, c in mods:
            absorb = ""
            if boundaries is not None:
                take, _ = plan_flatten(design, boundaries, n)
                absorb = "\n".join(f"read_rtlil {il[m]}" for m in sorted(take)
                                   if m in il)
            jobs.append((n, c, il[n], args, children, absorb))
        t = time.time()
        rows = []
        with cf.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as ex:
            for r in ex.map(run_one, jobs):
                rows.append(r)
                if r["rc"] != 0:
                    print(f"  FAILED {r['name']}: {r['err']}")
                    print(f"         see {r['log']}")
        bad = [r for r in rows if r["rc"] != 0]
        cells = sum(r["cells"] for r in rows)
        weighted = sum(r["cells"] * r["copies"] for r in rows)
        # `weighted` multiplies each module's cells by how many copies the
        # ORIGINAL dump held, so it is an upper bound: opt and clean -purge
        # drop instances a parent turns out not to use. On one large design it
        # comes out 7% over what reloading the netlists actually counts, which
        # is what --verify is for.
        print(f"level {L:>2}: {len(rows):>3} module(s), {len(bad)} failed, "
              f"{cells:>9,} cells ({weighted:>12,} x pre-synth copies), "
              f"{time.time() - t:>6.1f}s")
        if bad:
            failed_any = True
            if not args.keep_going:
                print("\nyosys_bottom_up: stopping -- the next level reads these "
                      "as blackboxes and would fail on every one.")
                return 1
        done += [r["dest"] for r in rows if r["rc"] == 0]

    print(f"\nyosys_bottom_up: {len(done)} netlist(s) in {args.out}, "
          f"{time.time() - grand:.1f}s total")
    if failed_any:
        return 1
    top = os.path.basename(done[-1])[:-2] if done else "?"
    print(f"yosys_bottom_up: top is {top}; the design is the whole directory, "
          f"one file per distinct module.")
    if args.verify:
        return verify(args, done, top)
    return 0


def verify(args, netlists, top):
    """Read every netlist back and let yosys count the hierarchy.

    Worth the ninety seconds: the per-level totals above are arithmetic over
    the instance counts of the dump, and this is the design that was actually
    written. It also proves the netlists COMPOSE -- that every child a parent
    instantiates is defined with the ports the parent expects -- which nothing
    in the per-module runs can check, because each one saw its children as
    blackboxes.
    """
    script = [f"read_verilog -lib {args.blackbox}"]
    script += [f"read_verilog {p}" for p in netlists]
    script += [f"hierarchy -check -top {top}", f"stat -top {top}"]
    log = os.path.join(args.out, "verify.log")
    t = time.time()
    p = subprocess.run([args.yosys, "-p", "\n".join(script)],
                       capture_output=True, text=True)
    with open(log, "w") as fh:
        fh.write(p.stdout)
        fh.write(p.stderr)
    if p.returncode != 0:
        err = [l for l in (p.stdout + p.stderr).splitlines() if l.startswith("ERROR")]
        print(f"yosys_bottom_up: VERIFY FAILED -- {err[-1] if err else p.returncode}")
        print(f"yosys_bottom_up: see {log}")
        return 1
    tail = p.stdout.split("=== design hierarchy ===")[-1]
    ours = {os.path.basename(n)[:-2] for n in netlists}
    total, cells = leaf_cells(tail, ours)
    print(f"\nyosys_bottom_up: verified in {time.time() - t:.1f}s -- "
          f"{top} is {total:,} standard cell(s) of {len(cells)} type(s)")
    seq = {k: v for k, v in cells.items() if k in sequential_cells(args.liberty)}
    if seq:
        top4 = sorted(seq.items(), key=lambda kv: -kv[1])[:4]
        named = ", ".join("{:,} {}".format(v, k.split("_N_")[0]) for k, v in top4)
        print(f"yosys_bottom_up: {sum(seq.values()):,} sequential ({named})")
    print(f"yosys_bottom_up: {log}")
    return 0


_CELL_OPEN = re.compile(r"^\s*cell\s*\(\s*([^)\s]+)\s*\)")
_FF_OPEN = re.compile(r"^\s*(?:ff|ff_bank|latch|latch_bank)\s*\(")


def sequential_cells(liberty, _cache={}):
    """Cell names the LIBERTY says hold state -- an ff or latch group.

    Not a guess from the name. A first version tested for "DFF", "LAT", "ICG"
    or "SDF" as substrings, which is one PDK's naming convention dressed up as
    a rule: on a library whose flops are EDFQ.../DFQT.../DFRPQ... it matched
    only the synchronizers and reported 1,094 sequential cells in a design that
    has 406,000. The number was wrong by a factor of 370 and nothing else in
    the run disagreed with it.

    Note the group keyword may be written with or without a space before its
    paren; both forms appear in vendor liberties.
    """
    if liberty in _cache:
        return _cache[liberty]
    seq, cur = set(), None
    opener = gzip.open if liberty.endswith(".gz") else open
    try:
        with opener(liberty, "rt", errors="replace") as fh:
            for line in fh:
                m = _CELL_OPEN.match(line)
                if m:
                    cur = m.group(1)
                    continue
                if cur and _FF_OPEN.match(line):
                    seq.add(cur)
                    cur = None
    except OSError:
        pass
    _cache[liberty] = seq
    return seq


_STAT_CELL = re.compile(r"^\s+(\d+)\s+([A-Za-z][A-Za-z0-9_]*)\s*$", re.M)

# stat's own row labels. They are formatted exactly like a cell-type row --
# "  4718269 cells" sits in the same column as "   476029   NAND2_D1..." -- so
# summing every row that parses gives three times the real number, with "cells"
# and "wires" as the two largest "cell types" in the design.
_STAT_WORDS = {"cells", "wires", "ports", "submodules", "processes",
               "memories", "bits", "public"}


def leaf_cells(text, ours):
    """(total, {cell type: count}) from a `stat -top` design-hierarchy section.

    The total is stat's own "N cells" line rather than a sum of the type rows:
    the two differ slightly, and the one yosys printed is the one to quote.

    The same section lists this run's own modules, indented, so anything we
    wrote a netlist for is skipped by name -- not by guessing at the library's
    naming convention, which would not survive the next PDK.
    """
    import collections
    out = collections.Counter()
    total = 0
    for n, name in _STAT_CELL.findall(text):
        if name == "cells":
            total = max(total, int(n))
        if name in _STAT_WORDS or name in ours:
            continue
        out[name] += int(n)
    return (total or sum(out.values())), out


if __name__ == "__main__":
    sys.exit(main())
